//> This file contains rendering-related functions and asset loading

import "raylib.h" as rl;
import "rlgl.h";

raw {
    #include "raymath.h"
}

// Screen configuration
def SCREEN_WIDTH = 1920;
def SCREEN_HEIGHT = 1080;
def TITLE = "Zen Craft";

// Global textures and shaders
let tex_atlas: rl::Texture2D;
let tex_grass: rl::Texture2D;
let tex_sun: rl::Texture2D;
let tex_moon: rl::Texture2D;
let sh_lighting: rl::Shader;
let sh_grass: rl::Shader; // New: Grass Shader

// Uniform Locations (Lighting)
let loc_light_dir: int;
let loc_light_col: int;
let loc_ambient: int;
let loc_view_pos: int; // New: View Pos for lighting
let loc_time: int;     // New: Time for lighting

// Uniform Locations (Grass)
let loc_grass_light_dir: int;
let loc_grass_light_col: int;
let loc_grass_ambient: int;
let loc_grass_view_pos: int;
let loc_grass_time: int;

fn load_texture_from_memory(_data: char*, _len: int) -> rl::Texture2D {
    let tex: rl::Texture2D;
    raw {
        Image img = LoadImageFromMemory(".png", (unsigned char*)_data, _len);
        tex = LoadTextureFromImage(img);
        SetTextureFilter(tex, TEXTURE_FILTER_POINT);
        UnloadImage(img);
    }
    return tex;
}

fn load_shader_from_memory(_vs: char*, _vs_len: int, _fs: char*, _fs_len: int) -> rl::Shader {
    let sh: rl::Shader;
    raw {
        char* vs = (char*)MemAlloc(_vs_len + 1);
        memcpy(vs, _vs, _vs_len);
        vs[_vs_len] = '\0';

        char* fs = (char*)MemAlloc(_fs_len + 1);
        memcpy(fs, _fs, _fs_len);
        fs[_fs_len] = '\0';

        sh = LoadShaderFromMemory(vs, fs);

        MemFree(vs);
        MemFree(fs);
    }
    return sh;
}

fn init_textures() {
    // Load individual images
    let dirt_data = embed "./assets/dirt.png";
    let grass_side_data = embed "./assets/grass_side.png";
    let grass_top_data = embed "./assets/grass.png";
    let stone_data = embed "./assets/stone.png";
    let log_data = embed "./assets/log.png";
    let leaves_data = embed "./assets/leaves.png";
    
    let sun_data = embed "./assets/sun.png";
    let moon_data = embed "./assets/moon.png";
    let plant_data = embed "./assets/hierba_sprite.png";
    
    let vs_data = embed "./assets/lighting.vs";
    let fs_data = embed "./assets/lighting.fs";
    
    let vs_grass_data = embed "./assets/grass.vs";
    let fs_grass_data = embed "./assets/grass.fs";


    // Create Atlas Programmatically (4 cols x 2 rows)
    // Col 0: Dirt, Grass_Side
    // Col 1: Grass_Top, Stone
    // Col 2: Log, Leaves
    // Col 3: Log_Top(Log), (Empty)
    
    // Original images are likely square. Assume 16x16 or similar.
    // We'll load them as Images, verify size, then draw onto atlas.
    
    raw {
        Image img_dirt = LoadImageFromMemory(".png", (unsigned char*)dirt_data.data, dirt_data.len);
        Image img_grass_s = LoadImageFromMemory(".png", (unsigned char*)grass_side_data.data, grass_side_data.len);
        Image img_grass_t = LoadImageFromMemory(".png", (unsigned char*)grass_top_data.data, grass_top_data.len);
        Image img_stone = LoadImageFromMemory(".png", (unsigned char*)stone_data.data, stone_data.len);
        Image img_log = LoadImageFromMemory(".png", (unsigned char*)log_data.data, log_data.len);
        Image img_leaves = LoadImageFromMemory(".png", (unsigned char*)leaves_data.data, leaves_data.len);
        
        int w = img_dirt.width;
        int h = img_dirt.height;
        
        // Create Atlas: 4 * w, 3 * h (Added row for Sand)
        Image atlas = GenImageColor(w * 4, h * 3, BLANK);
        
        // Row 0 (Top half)
        // (0,0) Dirt
        ImageDraw(&atlas, img_dirt, (Rectangle){0,0,w,h}, (Rectangle){0,0,w,h}, WHITE);
        // (1,0) Grass Top
        ImageDraw(&atlas, img_grass_t, (Rectangle){0,0,w,h}, (Rectangle){w,0,w,h}, WHITE);
        // (2,0) Log Side
        ImageDraw(&atlas, img_log, (Rectangle){0,0,w,h}, (Rectangle){w*2,0,w,h}, WHITE);
        // (3,0) Log Top (reuse log side for now)
        ImageDraw(&atlas, img_log, (Rectangle){0,0,w,h}, (Rectangle){w*3,0,w,h}, WHITE);
        
        // Row 1 (Bottom half)
        // (0,1) Grass Side
        ImageDraw(&atlas, img_grass_s, (Rectangle){0,0,w,h}, (Rectangle){0,h,w,h}, WHITE);
        // (1,1) Stone
        ImageDraw(&atlas, img_stone, (Rectangle){0,0,w,h}, (Rectangle){w,h,w,h}, WHITE);
        // (2,1) Leaves
        ImageDraw(&atlas, img_leaves, (Rectangle){0,0,w,h}, (Rectangle){w*2,h,w,h}, WHITE);
        
        // (3,1) Torch (Procedural) - Fill entire tile
        // Background: dark brown/black for the stick
        ImageDrawRectangle(&atlas, w*3, h, w, h, (Color){40, 30, 20, 255}); // Dark brown background
        
        // Main stick body (fills most of the texture)
        ImageDrawRectangle(&atlas, w*3 + 2, h + 4, w-4, h-8, (Color){101, 67, 33, 255}); // Brown stick
        
        // Flame at top (upper 1/3 of texture)
        ImageDrawRectangle(&atlas, w*3 + 3, h + 2, w-6, 6, ORANGE); // Orange flame
        ImageDrawRectangle(&atlas, w*3 + 4, h + 1, w-8, 3, YELLOW); // Yellow core

        // Row 2 (New)
        // (0,2) Sand (Assets)
        if (!FileExists("assets/sand.png")) {
             // Generate and Save if missing (since external generation failed)
             // Base color: Beige / Sandy Yellow
             Color sand_base = (Color){237, 201, 145, 255};
             Image gen_sand = GenImageColor(16, 16, sand_base);
             
             // Add Noise
             for (int i = 0; i < 40; i++) {
                 int nx = rand() % 16;
                 int ny = rand() % 16;
                 ImageDrawPixel(&gen_sand, nx, ny, (Color){210, 180, 140, 255});
             }
             for (int i = 0; i < 20; i++) {
                 int nx = rand() % 16;
                 int ny = rand() % 16;
                 ImageDrawPixel(&gen_sand, nx, ny, (Color){245, 222, 179, 255}); 
             }
             
             ExportImage(gen_sand, "assets/sand.png");
             UnloadImage(gen_sand);
        }

        Image img_sand = LoadImage("assets/sand.png"); 
        if (img_sand.data == 0) {
            // Fallback if still missing (e.g. write failed)
            ImageDrawRectangle(&atlas, 0, h*2, w, h, (Color){237, 201, 145, 255});
        } else {
            ImageDraw(&atlas, img_sand, (Rectangle){0,0,img_sand.width,img_sand.height}, (Rectangle){0,h*2,w,h}, WHITE);
            UnloadImage(img_sand);
        }
        
        tex_atlas = LoadTextureFromImage(atlas);
        SetTextureFilter(tex_atlas, TEXTURE_FILTER_POINT);
        
        // Cleanup
        UnloadImage(img_dirt);
        UnloadImage(img_grass_s);
        UnloadImage(img_grass_t);
        UnloadImage(img_stone);
        UnloadImage(img_log);
        UnloadImage(img_leaves);
        UnloadImage(atlas);
    }

    tex_grass = load_texture_from_memory(plant_data.data, plant_data.len);
    tex_sun = load_texture_from_memory(sun_data.data, sun_data.len);
    tex_moon = load_texture_from_memory(moon_data.data, moon_data.len);
    
    sh_lighting = load_shader_from_memory(vs_data.data, vs_data.len, fs_data.data, fs_data.len);
    sh_grass = load_shader_from_memory(vs_grass_data.data, vs_grass_data.len, fs_grass_data.data, fs_grass_data.len);


        // Get Uniform Locations
    raw {
        // Lighting Shader Locations
        loc_light_dir = GetShaderLocation(sh_lighting, "uLightDir");
        loc_light_col = GetShaderLocation(sh_lighting, "uLightCol");
        loc_ambient = GetShaderLocation(sh_lighting, "uAmbient");
        loc_view_pos = GetShaderLocation(sh_lighting, "viewPos");
        loc_time = GetShaderLocation(sh_lighting, "time");
        
        // Grass Shader Locations
        loc_grass_light_dir = GetShaderLocation(sh_grass, "uLightDir");
        loc_grass_light_col = GetShaderLocation(sh_grass, "uLightCol");
        loc_grass_ambient = GetShaderLocation(sh_grass, "uAmbient");
        loc_grass_view_pos = GetShaderLocation(sh_grass, "viewPos");
        loc_grass_time = GetShaderLocation(sh_grass, "time");
        
        // Set default values (Mid-day)
        Vector3 d = {0.8f, 1.0f, 0.5f};
        Vector3 c = {0.9f, 0.9f, 0.85f};
        Vector3 a = {0.5f, 0.5f, 0.55f};
        
        SetShaderValue(sh_lighting, loc_light_dir, &d, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_lighting, loc_light_col, &c, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_lighting, loc_ambient, &a, SHADER_UNIFORM_VEC3);
        
        SetShaderValue(sh_grass, loc_grass_light_dir, &d, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_grass, loc_grass_light_col, &c, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_grass, loc_grass_ambient, &a, SHADER_UNIFORM_VEC3);
    }

    // No longer need individual models - chunks build their own meshes
}

fn update_lighting_uniforms(dir: rl::Vector3, col: rl::Vector3, amb: rl::Vector3) {
    raw {
        // Update Lighting Shader
        SetShaderValue(sh_lighting, loc_light_dir, &dir, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_lighting, loc_light_col, &col, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_lighting, loc_ambient, &amb, SHADER_UNIFORM_VEC3);
        
        // Update Grass Shader
        SetShaderValue(sh_grass, loc_grass_light_dir, &dir, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_grass, loc_grass_light_col, &col, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_grass, loc_grass_ambient, &amb, SHADER_UNIFORM_VEC3);
    }
}

// New: Update Frame Uniforms (Time, Camera Position)
fn update_frame_uniforms(cam_pos: rl::Vector3, time: float) {
    raw {
        SetShaderValue(sh_lighting, loc_view_pos, &cam_pos, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_lighting, loc_time, &time, SHADER_UNIFORM_FLOAT);
        
        SetShaderValue(sh_grass, loc_grass_view_pos, &cam_pos, SHADER_UNIFORM_VEC3);
        SetShaderValue(sh_grass, loc_grass_time, &time, SHADER_UNIFORM_FLOAT);
    }
}

fn get_tex_atlas() -> rl::Texture2D {
    return tex_atlas;
}

fn get_tex_grass() -> rl::Texture2D {
    return tex_grass;
}

fn get_shader_lighting() -> rl::Shader {
    return sh_lighting;
}

fn get_shader_grass() -> rl::Shader {
    return sh_grass;
}

fn update_day_night_cycle(day_time: float) {
    // day_time: 0.0 (6 AM) -> 0.25 (12 PM) -> 0.5 (6 PM) -> 0.75 (12 AM) -> 1.0 (6 AM)
    
    // 1. Calculate Sun Direction
    // We want Zenith (Y=1) at 0.25.
    // angle = day_time * 2PI.
    // 0.25 * 2PI = PI/2 -> sin(PI/2) = 1. Correct.
    let angle = (day_time * 2.0 * 3.14159); 
    
    let sun_y = (float)sin(angle);
    let sun_x = (float)cos(angle);
    
    // Swap X/Z to rotate around Z axis (East-West) if needed, or keep X/Y for visual path
    // Let's assume standard Sun Rise East (+X?), Set West (-X?)
    // If cos(0)=1, Sun is at +X at 6AM?
    // Usually 6AM is Sunrise.
    
    let dir = rl::Vector3{ x: sun_x, y: sun_y, z: 0.2f };

    // 2. Interpolation based on User Schedule
    // 0.0 = 6:00 AM (Start Rise)
    // 0.166 = 10:00 AM (End Rise, Full Day)
    // 0.5 = 6:00 PM (Start Set)
    // 0.666 = 10:00 PM (End Set, Full Night)
    // 1.0 = 6:00 AM
    
    let col = rl::Vector3{x: 1.0, y: 1.0, z: 1.0};
    let amb = rl::Vector3{x: 0.001, y: 0.001, z: 0.001};
    
    if (day_time < 0.166) {
        // RISE: 6 AM -> 10 AM
        // Progressive lightening
        let t = day_time / 0.166; // 0..1
        
        // Color: Orange/Red -> White
        col.x = 1.0;
        col.y = 0.4 + t * 0.6; // 0.4 -> 1.0
        col.z = 0.2 + t * 0.8; // 0.2 -> 1.0
        
        // Ambient: Dark -> Bright
        amb.x = 0.001 + t * 0.4; // 0.001 -> 0.4
        amb.y = 0.001 + t * 0.4;
        amb.z = 0.002 + t * 0.4; // Blue tint?
    }
    else if (day_time < 0.5) {
        // DAY: 10 AM -> 6 PM
        // Full Brightness
        col = rl::Vector3{x: 1.0, y: 1.0, z: 1.0};
        amb = rl::Vector3{x: 0.4, y: 0.4, z: 0.4};
    }
    else if (day_time < 0.666) {
        // SET: 6 PM -> 10 PM
        // Progressive darkening
        let t = (day_time - 0.5) / 0.166; // 0..1
        
        // Color: White -> Orange -> Dark
        col.x = 1.0 - t * 0.95; // 1.0 -> 0.05 (Moonlight color)
        col.y = 1.0 - t * 0.95; 
        col.z = 1.0 - t * 0.90; // Keep slightly blue?
        
        // Ambient: Bright -> Dark
        amb.x = 0.4 - t * 0.399; // 0.4 -> 0.001
        amb.y = 0.4 - t * 0.399;
        amb.z = 0.4 - t * 0.398; // 0.4 -> 0.002
    }
    else {
        // NIGHT: 10 PM -> 6 AM
        // Full Darkness
        col = rl::Vector3{x: 0.05, y: 0.05, z: 0.1}; // Moonlight
        amb = rl::Vector3{x: 0.001, y: 0.001, z: 0.002}; // Pitch Black + Tiny Blue
    }

    update_lighting_uniforms(dir, col, amb);
}

fn draw_sky(camera: rl::Camera3D, day_time: float) {
    rl::BeginMode3D(camera);
        
        let sun_angle = (day_time * 2.0 * 3.14159); // Match update logic

        let sun_pos = rl::Vector3{
            x: camera.position.x + (float)cos(sun_angle) * 400.0, 
            y: camera.position.y + (float)sin(sun_angle) * 400.0, 
            z: camera.position.z
        };
        
        let moon_pos = rl::Vector3{
            x: camera.position.x - (float)cos(sun_angle) * 400.0, 
            y: camera.position.y - (float)sin(sun_angle) * 400.0, 
            z: camera.position.z 
        };

        raw {
            rlDisableDepthMask();
            DrawBillboard(camera, tex_sun, sun_pos, 50.0f, WHITE);
            DrawBillboard(camera, tex_moon, moon_pos, 40.0f, WHITE);
            rlEnableDepthMask();
        }
    rl::EndMode3D();
}

// Cloud System
let mesh_clouds: rl::Mesh;
let cloud_mesh_built: int = 0;

fn init_clouds() {
    raw {
        // Generate Cloud Map
        // 100x100 grid, scaled by 6.0 = 600x600 world area
        int w = 100;
        int h = 100;
        float scale = 6.0f; // Smaller cubes (was 12.0)
        
        Image noise = GenImagePerlinNoise(w, h, 0, 0, 0.15f); // Frequency increase slightly
        Color* pixels = LoadImageColors(noise);
        
        // Count cloud cubes
        int count = 0;
        for(int i=0; i<w*h; i++) {
            if(pixels[i].r > 100) count++; // Threshold (Denser)
        }
        
        // Debug
        TraceLog(LOG_INFO, TextFormat("CLOUDS: Generated %d cloud cubes from %dx%d noise", count, w, h));
        
        // Construct Mesh manually
        mesh_clouds = (Mesh){ 0 };
        mesh_clouds.vertexCount = count * 24; // 4 verts * 6 faces
        mesh_clouds.triangleCount = count * 12; // 2 tris * 6 faces
        
        mesh_clouds.vertices = (float*)MemAlloc(mesh_clouds.vertexCount * 3 * sizeof(float));
        mesh_clouds.texcoords = (float*)MemAlloc(mesh_clouds.vertexCount * 2 * sizeof(float));
        mesh_clouds.normals = (float*)MemAlloc(mesh_clouds.vertexCount * 3 * sizeof(float));
        mesh_clouds.indices = (unsigned short*)MemAlloc(mesh_clouds.triangleCount * 3 * sizeof(unsigned short));
        
        int v_idx = 0;
        int i_idx = 0;
        int idx_offset = 0;
        
        for(int y=0; y<h; y++) {
            for(int x=0; x<w; x++) {
                if(pixels[y*w+x].r > 100) {
                    float cx = (float)(x - w/2) * scale;
                    float cz = (float)(y - h/2) * scale;
                    float cy = 0.0f; // Relative to cloud layer height
                    
                    float size = scale;
                    float height = 2.0f; // Flatter (was 4.0)
                    
                    // Helper macro for vertex
                    #define ADD_VERT(px, py, pz, nx, ny, nz) \
                        mesh_clouds.vertices[v_idx*3+0] = px; \
                        mesh_clouds.vertices[v_idx*3+1] = py; \
                        mesh_clouds.vertices[v_idx*3+2] = pz; \
                        mesh_clouds.normals[v_idx*3+0] = nx; \
                        mesh_clouds.normals[v_idx*3+1] = ny; \
                        mesh_clouds.normals[v_idx*3+2] = nz; \
                        mesh_clouds.texcoords[v_idx*2+0] = 0.0f; \
                        mesh_clouds.texcoords[v_idx*2+1] = 0.0f; \
                        v_idx++;
                    
                    float x1 = cx; float x2 = cx + size;
                    float y1 = cy; float y2 = cy + height;
                    float z1 = cz; float z2 = cz + size;
                    
                    // Top
                    ADD_VERT(x1, y2, z1, 0,1,0); ADD_VERT(x1, y2, z2, 0,1,0); ADD_VERT(x2, y2, z2, 0,1,0); ADD_VERT(x2, y2, z1, 0,1,0);
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+1; mesh_clouds.indices[i_idx++] = idx_offset+2;
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+2; mesh_clouds.indices[i_idx++] = idx_offset+3;
                    idx_offset += 4;
                    
                    // Bottom
                    ADD_VERT(x1, y1, z2, 0,-1,0); ADD_VERT(x1, y1, z1, 0,-1,0); ADD_VERT(x2, y1, z1, 0,-1,0); ADD_VERT(x2, y1, z2, 0,-1,0);
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+1; mesh_clouds.indices[i_idx++] = idx_offset+2;
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+2; mesh_clouds.indices[i_idx++] = idx_offset+3;
                    idx_offset += 4;
                    
                    // Front (Z-)
                    ADD_VERT(x1, y1, z1, 0,0,-1); ADD_VERT(x1, y2, z1, 0,0,-1); ADD_VERT(x2, y2, z1, 0,0,-1); ADD_VERT(x2, y1, z1, 0,0,-1);
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+1; mesh_clouds.indices[i_idx++] = idx_offset+2;
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+2; mesh_clouds.indices[i_idx++] = idx_offset+3;
                    idx_offset += 4;
                    
                    // Back (Z+)
                    ADD_VERT(x1, y1, z2, 0,0,1); ADD_VERT(x2, y1, z2, 0,0,1); ADD_VERT(x2, y2, z2, 0,0,1); ADD_VERT(x1, y2, z2, 0,0,1);
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+1; mesh_clouds.indices[i_idx++] = idx_offset+2;
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+2; mesh_clouds.indices[i_idx++] = idx_offset+3;
                    idx_offset += 4;
                    
                    // Left (X-)
                    ADD_VERT(x1, y1, z2, -1,0,0); ADD_VERT(x1, y2, z2, -1,0,0); ADD_VERT(x1, y2, z1, -1,0,0); ADD_VERT(x1, y1, z1, -1,0,0);
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+1; mesh_clouds.indices[i_idx++] = idx_offset+2;
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+2; mesh_clouds.indices[i_idx++] = idx_offset+3;
                    idx_offset += 4;

                    // Right (X+)
                    ADD_VERT(x2, y1, z1, 1,0,0); ADD_VERT(x2, y2, z1, 1,0,0); ADD_VERT(x2, y2, z2, 1,0,0); ADD_VERT(x2, y1, z2, 1,0,0);
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+1; mesh_clouds.indices[i_idx++] = idx_offset+2;
                    mesh_clouds.indices[i_idx++] = idx_offset+0; mesh_clouds.indices[i_idx++] = idx_offset+2; mesh_clouds.indices[i_idx++] = idx_offset+3;
                    idx_offset += 4;
                    
                    #undef ADD_VERT
                }
            }
        }
        
        UnloadImageColors(pixels);
        UnloadImage(noise);
        
        UploadMesh(&mesh_clouds, false);
        cloud_mesh_built = 1;
    }
}

fn draw_clouds(camera: rl::Camera3D, time: float, day_time: float) {
    if (cloud_mesh_built == 0) return;
    
    // Cloud Layer Height
    let cloud_y = 100.0f;
    
    // Animate drift
    let drift_speed = 4.0f; // Faster (was 1.0)
    let offset_x = time * drift_speed;
    
    // Infinite Scroll Logic
    let loop_dist = 600.0f; // 100 * 6.0
    
    // Snap camera to grid
    let cam_snap_x = (float)((int)(camera.position.x / loop_dist)) * loop_dist;
    let cam_snap_z = (float)((int)(camera.position.z / loop_dist)) * loop_dist;
    
    // Calculate local drift (0 to loop_dist)
    let local_drift = 0.0f;
    raw {
        local_drift = fmod(offset_x, loop_dist);
    }
    
    // Calculate Cloud Color based on Day Time
    let c_r = 255;
    let c_g = 255;
    let c_b = 255;
    let c_a = 200; // Semi-transparent
    
    if (day_time < 0.166) {
        // Rise (0 -> 1)
        let t = day_time / 0.166;
        // Night (Grey/Black) -> Day (White)
        // Add Orange Tint in middle
        c_r = (int)(255.0 * t); // 0 -> 255
        c_g = (int)(100.0 * t + 155.0 * t * t); // Orange -> White
        c_b = (int)(100.0 * t + 155.0 * t * t);
        c_a = (int)(100.0 * t + 100.0); // Fade in opacity
    }
    else if (day_time < 0.5) {
        // Day (White)
        c_r = 255; c_g = 255; c_b = 255; c_a = 200;
    }
    else if (day_time < 0.666) {
        // Set
        let t = (day_time - 0.5) / 0.166;
        // White -> Orange -> Dark
        c_r = (int)(255.0 * (1.0 - t*0.5)); // 255 -> 128
        c_g = (int)(255.0 * (1.0 - t) + 100.0 * t); // White -> Orange
        c_b = (int)(255.0 * (1.0 - t)); // White -> Black
        c_a = (int)(200.0 * (1.0 - t*0.5)); // Fade out slightly
    }
    else {
        // Night (Dark Grey/Blue)
        c_r = 10; c_g = 10; c_b = 20; c_a = 50; // Very faint
    }
    
    rl::BeginMode3D(camera);
    raw {
        rlDisableBackfaceCulling(); 
        rlDisableDepthMask(); // Don't write to depth buffer (clouds are background)
        rlSetBlendMode(BLEND_ALPHA);
        
        Material mat = LoadMaterialDefault();
        mat.maps[MATERIAL_MAP_DIFFUSE].color = (Color){c_r, c_g, c_b, c_a}; 
        
        // Draw 3x3 grid around player
        for(int x=-1; x<=1; x++) {
             for(int z=-1; z<=1; z++) {
                 float px = cam_snap_x + (float)x * loop_dist + local_drift;
                 float pz = cam_snap_z + (float)z * loop_dist;
                 
                 // Render
                 DrawMesh(mesh_clouds, mat, MatrixTranslate(px, cloud_y, pz));
             }
        }
        
        rlEnableDepthMask();
        rlEnableBackfaceCulling();
    }
    rl::EndMode3D();
}
