//> Zibi character implementation
import "player.zc"; // Access to check_collision and chunk utilities
import "chunk.zc"; // Explicitly import for get_chunk_index
import "raylib.h" as rl;
import "math.h";

struct Zibi {
    x: float;
    y: float;
    z: float;
    vx: float;
    vy: float;
    vz: float;
    yaw: float;
    
    // Behavior state
    state: int; // 0=Idle, 1=Walk
    state_timer: float;
    target_yaw: float;
    
    // Animation
    anim_time: float;
    
    // Lifecycle
    active: int;
}

// Zibi Constants
def ZIBI_WIDTH = 0.4;  // 0.8 * 0.5 = 0.4
def ZIBI_HEIGHT = 0.9; // 1.8 * 0.5 = 0.9
def ZIBI_SPEED = 2.5;

impl Zibi {
    static fn new(x: float, y: float, z: float) -> Zibi {
        let inst: Zibi;
        inst.x = x;
        inst.y = y;
        inst.z = z;
        inst.vx = 0.0;
        inst.vy = 0.0;
        inst.vz = 0.0;
        inst.yaw = 0.0;
        inst.state = 0;
        inst.state_timer = 2.0;
        inst.target_yaw = 0.0;
        inst.anim_time = 0.0;
        inst.active = 1;
        return inst;
    }

    // Returns 1 if still active, 0 if despawned
    fn update(self, chunks: Chunk*, num_chunks: int, dt: float) -> int {
        if self.active == 0 { return 0; }
        
        // --- Check if in loaded chunk ---
        let cx = (int)floor(self.x / 16.0);
        let cz = (int)floor(self.z / 16.0);
        
        let idx = get_chunk_index(cx, cz);
        
        // Safety: Check bounds or invalid index
        if idx < 0 || idx >= num_chunks {
            self.active = 0;
            return 0;
        }

        // If chunk is not loaded or not matching coordinates, DESPAWN
        if (chunks[idx].x != cx || chunks[idx].z != cz) {
            self.active = 0;
            return 0;
        }

        // --- 1. AI / Behavior ---
        self.state_timer -= dt;
        self.anim_time += dt;
        
        if self.state_timer <= 0.0 {
            // Pick new state
            let r = rl::GetRandomValue(0, 100);
            
            if r < 40 {
                // Determine new state: IDLE
                self.state = 0;
                self.state_timer = (float)rl::GetRandomValue(10, 30) / 10.0; // 1.0 - 3.0s
            } else {
                // Determine new state: WALK
                self.state = 1;
                self.state_timer = (float)rl::GetRandomValue(20, 50) / 10.0; // 2.0 - 5.0s
                // Pick random direction
                self.target_yaw = (float)rl::GetRandomValue(0, 360) * 0.0174533;
            }
        }
        
        // Smooth rotation
        // Simple lerp for rotation could be added here, currently instant snap for target
        self.yaw = self.target_yaw;
        
        // --- 2. Physics & Movement ---
        if self.state == 1 {
            // Walking
            self.vx = (float)cos(self.yaw) * ZIBI_SPEED;
            self.vz = (float)sin(self.yaw) * ZIBI_SPEED;
            
            // Wall avoidance / Jump check / Water detection
            let front_x = self.x + self.vx * 0.8; // Look further ahead
            let front_z = self.z + self.vz * 0.8;
            
            let block_at_front = get_block(chunks, num_chunks, (int)front_x, (int)self.y, (int)front_z);
            let block_below_front = get_block(chunks, num_chunks, (int)front_x, (int)self.y - 1, (int)front_z);
            
            if check_collision(chunks, num_chunks, front_x, self.y, front_z, ZIBI_WIDTH, 0.5) || block_at_front == BLOCK_WATER || block_below_front == BLOCK_WATER {
                 // Wall or Water detected
                 // Only try to jump if it was a WALL, not water
                 if block_at_front != BLOCK_WATER && block_below_front != BLOCK_WATER && !check_collision(chunks, num_chunks, front_x, self.y + 1.1, front_z, ZIBI_WIDTH, 0.5) {
                      // Only jump if on ground
                      if check_collision(chunks, num_chunks, self.x, self.y - 0.1, self.z, ZIBI_WIDTH, 0.5) {
                          self.vy = 9.0;
                      }
                 } else {
                      // Cannot jump (wall too high) OR detected water
                      self.state = 0; // Stop
                      self.state_timer = 1.0;
                      // Change yaw randomly to turn away
                      self.yaw += ((float)rl::GetRandomValue(0, 32767) / 32767.0) * 6.28;
                 }
            }
            
        } else {
            // Idle
            self.vx = 0.0;
            self.vz = 0.0;
        }

        // Gravity
        self.vy -= 18.0 * dt;
        
        // Integration (Collision)
        // X axis
        self.x += self.vx * dt;
        if check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
            self.x -= self.vx * dt;
        }

        // Z axis
        self.z += self.vz * dt;
        if check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
            self.z -= self.vz * dt;
        }

        // Y axis
        self.y += self.vy * dt;
        if check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
            self.y -= self.vy * dt;
            self.vy = 0.0;
        }
        
        if self.y < -50.0 { 
             // Fell out of world - DESPAWN
             self.active = 0;
             return 0;
        }
        
        return 1;
    }

    fn draw(self, chunks: Chunk*, num_chunks: int, day_time: float) {
        if self.active == 0 { return; }
        
        // --- ZIBI RENDERING (SHREK STYLE) ---
        
        // --- Lighting Calc ---
        let lx = (int)floor(self.x);
        let ly = (int)floor(self.y + 0.8);
        let lz = (int)floor(self.z);
        
        let packed_light = get_light_levels(chunks, num_chunks, lx, ly, lz);
        let block_light = (float)(packed_light & 0xF);
        let sky_light = (float)((packed_light >> 4) & 0xF);
        
        let sun_str = 0.0;
        
        if day_time < 0.5 { // Dawn -> Sunset
             if day_time < 0.166 { 
                 sun_str = 0.05 + (day_time/0.166)*0.95; 
             }
             else if day_time < 0.5 { 
                 sun_str = 1.0;
             }
             else if day_time < 0.666 { 
                 sun_str = 1.0 - ((day_time-0.5)/0.166)*0.99;
             }
             else { 
                 sun_str = 0.01;
             }
        } else {
             // Fallback/Safety
             if day_time < 0.666 { sun_str = 0.05; }
             else { sun_str = 0.01; }
        }
        
        // Combine lights
        let effective_sky = (sky_light / 15.0) * sun_str;
        let effective_block = (block_light / 15.0);
        effective_block = (float)pow(effective_block, 1.2);
        
        let intensity = effective_sky + effective_block;
        if intensity > 1.0 { intensity = 1.0; }
        if intensity < 0.001 { intensity = 0.001; } // Minimum ambient (Darker)
        
        // Colors based on the image
        let c_skin = rl::Color{ r: (int)(104.0*intensity), g: (int)(194.0*intensity), b: (int)(58.0*intensity), a: 255 };
        let c_tunic = rl::Color{ r: (int)(120.0*intensity), g: (int)(86.0*intensity), b: (int)(50.0*intensity), a: 255 };
        let c_pants = rl::Color{ r: (int)(56.0*intensity), g: (int)(42.0*intensity), b: (int)(29.0*intensity), a: 255 };
        let c_white = rl::Color{ r: (int)(255.0*intensity), g: (int)(255.0*intensity), b: (int)(255.0*intensity), a: 255 };
        let c_black = rl::BLACK;
        
        // Animation variables
        let limb_swing = 0.0;
        if self.state == 1 { 
            // Fast oscillation for short steps
            limb_swing = (float)sin(self.anim_time * 12.0);
        }

        rl::rlPushMatrix();
        
        // Global Position and Rotation
        rl::rlTranslatef(self.x, self.y, self.z);
        rl::rlRotatef(self.yaw * 57.2958, 0.0, -1.0, 0.0);
        rl::rlScalef(0.5, 0.5, 0.5);
        
        // --- 1. LEGS (With Animation) ---
        // Left Leg (+Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 0.6, 0.15);
        rl::rlRotatef(limb_swing * 40.0, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.3, z: 0.0}, 0.25, 0.6, 0.2, c_pants);
        rl::DrawCube(rl::Vector3{x: 0.05, y: -0.65, z: 0.0}, 0.35, 0.1, 0.22, c_skin);
        rl::rlPopMatrix();
        
        // Right Leg (-Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 0.6, -0.15);
        rl::rlRotatef(-limb_swing * 40.0, 0.0, 0.0, 1.0); 
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.3, z: 0.0}, 0.25, 0.6, 0.2, c_pants);
        rl::DrawCube(rl::Vector3{x: 0.05, y: -0.65, z: 0.0}, 0.35, 0.1, 0.22, c_skin);
        rl::rlPopMatrix();

        // --- 2. BODY (Tunic) ---
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.95, z: 0.0}, 0.35, 0.7, 0.55, c_tunic);
        
        // --- 3. ARMS (With Animation) ---
        // Left Arm (+Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 1.2, 0.35);
        rl::rlRotatef(-limb_swing * 40.0, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.25, z: 0.0}, 0.18, 0.6, 0.18, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 0.2, 0.25, 0.2, c_tunic);
        rl::rlPopMatrix();
        
        // Right Arm (-Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 1.2, -0.35);
        rl::rlRotatef(limb_swing * 40.0, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.25, z: 0.0}, 0.18, 0.6, 0.18, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 0.2, 0.25, 0.2, c_tunic);
        rl::rlPopMatrix();

        // --- 4. HEAD ---
        let head_y = 1.55;
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y, z: 0.0}, 0.45, 0.55, 0.5, c_skin);
        
        // Ears (Trumpets)
        // Left (+Z)
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: 0.3}, 0.08, 0.08, 0.2, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: 0.4}, 0.15, 0.15, 0.05, c_skin); 
        // Right (-Z)
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: -0.3}, 0.08, 0.08, 0.2, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: -0.4}, 0.15, 0.15, 0.05, c_skin); 

        // Face (Eyes)
        // Left Eye (+Z)
        rl::DrawCube(rl::Vector3{x: 0.23, y: head_y + 0.05, z: 0.12}, 0.05, 0.12, 0.12, c_white);
        rl::DrawCube(rl::Vector3{x: 0.26, y: head_y + 0.05, z: 0.12}, 0.02, 0.04, 0.04, c_black); 
        // Right Eye (-Z)
        rl::DrawCube(rl::Vector3{x: 0.23, y: head_y + 0.05, z: -0.12}, 0.05, 0.12, 0.12, c_white);
        rl::DrawCube(rl::Vector3{x: 0.26, y: head_y + 0.05, z: -0.12}, 0.02, 0.04, 0.04, c_black); 
        
        // Mouth
        rl::DrawCube(rl::Vector3{x: 0.23, y: head_y - 0.15, z: 0.0}, 0.02, 0.03, 0.2, c_pants);
        
        rl::rlPopMatrix();
    }
}