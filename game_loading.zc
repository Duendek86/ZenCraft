//> Loading Screen & Initial World Generation
import "raylib.h" as rl;
import "math.h";
import "chunk_core.zc";
import "chunk_mesh.zc";
import "chunk_light.zc";
import "persistence.zc";
import "blocks.zc";
import "raycast.zc";

let load_start_x: float = 10.0;
let load_start_y: float = 20.0;
let load_start_z: float = 10.0;
let load_start_yaw: float = 0.0;
let load_start_pitch: float = 0.0;
let player_is_loaded: int = 0;
let save_was_found: int = 0;
let loading_is_done: int = 0;
let raw_load_progress: float = 0.0;

fn process_loading_step(chunks: Chunk*, draw_distance: int) {
    if player_is_loaded == 0 {
        save_was_found = load_player_data((any)&load_start_x, (any)&load_start_y, (any)&load_start_z, (any)&load_start_yaw, (any)&load_start_pitch, (any)&load_start_yaw); // Pasamos un dummy pointer para el bloque seleccionado
        rl::DisableCursor();
        player_is_loaded = 1;
    }
    
    let pcx = (int)floor(load_start_x / 16.0);
    let pcz = (int)floor(load_start_z / 16.0);
    let range_limit = draw_distance + 1;
    let loads_this_frame = 0;
    let max_loads = 16;
    
    // Cargar Chunks
    for dx in -draw_distance..range_limit {
        for dz in -draw_distance..range_limit {
            let cx = pcx + dx; let cz = pcz + dz;
            let idx = get_chunk_index(cx, cz);
            if chunks[idx].x != cx || chunks[idx].z != cz {
                if loads_this_frame < max_loads {
                    load_chunk_into((any)&chunks[idx], cx, cz);
                    propagate_light_in_chunk(&chunks[idx], chunks, MAX_CHUNKS);
                    
                    let neighbor_offsets = [-1, 0, 1, 0, 0, -1, 0, 1];
                    for ni in 0..4 {
                        let ncx = cx + neighbor_offsets[ni * 2]; let ncz = cz + neighbor_offsets[ni * 2 + 1];
                        let nidx = get_chunk_index(ncx, ncz);
                        if chunks[nidx].x == ncx && chunks[nidx].z == ncz {
                            propagate_light_in_chunk(&chunks[nidx], chunks, MAX_CHUNKS);
                            chunks[nidx].mesh_dirty = 1;
                        }
                    }
                    
                    let cm = compute_chunk_mesh(&chunks[idx], chunks, MAX_CHUNKS);
                    upload_chunk_mesh(&chunks[idx], cm);
                    let pm = compute_plant_mesh(&chunks[idx]);
                    upload_plant_mesh(&chunks[idx], pm);
                    
                    loads_this_frame++;
                }
            }
        }
    }
    
    // Comprobar Progreso
    let ready_count = 0;
    let total_to_load = (2 * draw_distance + 1) * (2 * draw_distance + 1);
    let all_ready = 1;
    
    for dx in -draw_distance..range_limit {
        for dz in -draw_distance..range_limit {
            let cx = pcx + dx; let cz = pcz + dz;
            let idx = get_chunk_index(cx, cz);
            if chunks[idx].x == cx && chunks[idx].z == cz && chunks[idx].mesh_built == 1 {
                ready_count++;
            } else { all_ready = 0; }
        }
    }
    
    raw_load_progress = (float)ready_count / (float)total_to_load;
    
    // Calcular Spawn Seguro si es partida nueva
    if all_ready == 1 && loading_is_done == 0 {
        if save_was_found == 0 {
            load_start_x = (float)((int)load_start_x) + 0.5;
            load_start_z = (float)((int)load_start_z) + 0.5;
            
            for h in 0..CHUNK_HEIGHT {
                let y = (CHUNK_HEIGHT - 1) - h;
                let blk = get_block(chunks, MAX_CHUNKS, (int)load_start_x, y, (int)load_start_z);
                if blk != BLOCK_AIR && blk != 10 {
                    let test_y = (float)(y + 1) + 0.1;
                    for k in 0..10 {
                        if check_collision(chunks, MAX_CHUNKS, load_start_x, test_y, load_start_z, 0.6, 1.8) == 1 {
                            test_y = test_y + 1.0;
                        } else {
                            load_start_y = test_y;
                            break;
                        }
                    }
                    break;
                }
            }
        }
        loading_is_done = 1;
    }
}

fn draw_loading_screen() {
    rl::BeginDrawing();
    rl::ClearBackground(rl::Color{r: 20, g: 20, b: 30, a: 255});
    
    let sw = rl::GetScreenWidth(); let sh = rl::GetScreenHeight();
    let dots = ((int)(rl::GetTime() * 2.0) % 4);
    let loading_text: char*;
    
    if dots == 0 { loading_text = "Generating World."; }
    else if dots == 1 { loading_text = "Generating World.."; }
    else if dots == 2 { loading_text = "Generating World..."; }
    else { loading_text = "Generating World"; }
    
    rl::DrawText(loading_text, sw / 2 - 100, sh / 2, 20, rl::WHITE);
    
    let bar_w = 400; let bar_h = 10;
    let bar_x = sw / 2 - bar_w / 2; let bar_y = sh / 2 + 50;
    
    rl::DrawRectangle(bar_x, bar_y, bar_w, bar_h, rl::DARKGRAY);
    rl::DrawRectangle(bar_x, bar_y, (int)((float)bar_w * raw_load_progress), bar_h, rl::LIME);
    rl::DrawRectangleLines(bar_x, bar_y, bar_w, bar_h, rl::GRAY);
    
    rl::EndDrawing();
}