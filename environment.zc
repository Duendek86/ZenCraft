//> Environment, Lighting and Day/Night Cycle
import "raylib.h" as rl;
import "math.h";
import "assets.zc"; // Access to globals, textures, and uniform locations

fn update_lighting_uniforms(dir: rl::Vector3, col: rl::Vector3, amb: rl::Vector3) {
    rl::SetShaderValue(sh_lighting, loc_light_dir, &dir, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_lighting, loc_light_col, &col, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_lighting, loc_ambient, &amb, rl::SHADER_UNIFORM_VEC3);
    
    rl::SetShaderValue(sh_grass, loc_grass_light_dir, &dir, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_grass, loc_grass_light_col, &col, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_grass, loc_grass_ambient, &amb, rl::SHADER_UNIFORM_VEC3);
}

fn update_frame_uniforms(cam_pos: rl::Vector3, time: float) {
    rl::SetShaderValue(sh_lighting, loc_view_pos, &cam_pos, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_lighting, loc_time, &time, rl::SHADER_UNIFORM_FLOAT);
    
    rl::SetShaderValue(sh_grass, loc_grass_view_pos, &cam_pos, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_grass, loc_grass_time, &time, rl::SHADER_UNIFORM_FLOAT);
}

fn set_grass_use_tex(use_tex: int) {
    rl::SetShaderValue(sh_grass, loc_grass_use_tex, &use_tex, rl::SHADER_UNIFORM_INT);
}

fn update_day_night_cycle(day_time: float) {
    let angle = (day_time * 2.0 * 3.14159); 
    
    let sun_y = (float)sin(angle);
    let sun_x = (float)cos(angle);
    
    let orbit_tilt = 0.5;
    let dir = rl::Vector3{ x: sun_x, y: sun_y, z: sun_y * orbit_tilt + 0.3 };
    
    let col = rl::Vector3{x: 1.0, y: 1.0, z: 1.0};
    let amb = rl::Vector3{x: 0.001, y: 0.001, z: 0.001};
    
    if day_time < 0.166 {
        let t = day_time / 0.166;
        col.x = 1.0;
        col.y = 0.4 + t * 0.6;
        col.z = 0.2 + t * 0.8;
        amb.x = 0.001 + t * 0.4;
        amb.y = 0.001 + t * 0.4;
        amb.z = 0.002 + t * 0.4;
    } else if day_time < 0.5 {
        col = rl::Vector3{x: 1.0, y: 1.0, z: 1.0};
        amb = rl::Vector3{x: 0.4, y: 0.4, z: 0.4};
    } else if day_time < 0.666 {
        let t = (day_time - 0.5) / 0.166;
        col.x = 1.0 - t * 0.95;
        col.y = 1.0 - t * 0.95;
        col.z = 1.0 - t * 0.90;
        amb.x = 0.4 - t * 0.399;
        amb.y = 0.4 - t * 0.399;
        amb.z = 0.4 - t * 0.398;
    } else {
        col = rl::Vector3{x: 0.05, y: 0.05, z: 0.1};
        amb = rl::Vector3{x: 0.001, y: 0.001, z: 0.002};
    }

    update_lighting_uniforms(dir, col, amb);
}

fn draw_sky(camera: rl::Camera3D, day_time: float) {
    rl::BeginMode3D(camera);
        let sun_angle = (day_time * 2.0 * 3.14159);
        let sun_pos = rl::Vector3{
            x: camera.position.x + (float)cos(sun_angle) * 400.0, 
            y: camera.position.y + (float)sin(sun_angle) * 400.0, 
            z: camera.position.z
        };
        let moon_pos = rl::Vector3{
            x: camera.position.x - (float)cos(sun_angle) * 400.0, 
            y: camera.position.y - (float)sin(sun_angle) * 400.0, 
            z: camera.position.z 
        };
        
        rl::rlDisableDepthMask();
        rl::DrawBillboard(camera, tex_sun, sun_pos, 50.0, rl::WHITE);
        rl::DrawBillboard(camera, tex_moon, moon_pos, 40.0, rl::WHITE);
        rl::rlEnableDepthMask();
    rl::EndMode3D();
}