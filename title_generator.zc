//> Title Screen Generator - Zen Island Edition
import "raylib.h" as rl;
import "chunk.zc";
import "persistence.zc";
import "blocks.zc"; // [cite: 1]

let title_tick_accum: float = 0.0;

// Helper to set block in raw ChunkData
fn set_block_raw(data: ChunkData*, x: int, y: int, z: int, type: int) {
    if x >= 0 && x < 16 && y >= 0 && y < CHUNK_HEIGHT && z >= 0 && z < 16 {
        data.blocks[x][y][z] = type;
        // Simple lighting logic: Air and Water let light through
        if type == 0 || type == 8 || type == 6 { // Air, Water, Leaves let light in
            data.light[x][y][z] = 15; 
        } else {
            data.light[x][y][z] = 0;
        }
    }
}

    raw {
    // Forward declare helper
    void set_block_raw(ChunkData* data, int x, int y, int z, int type);

    // --- MAPPING CONSTANTS TO BLOCKS.ZC ---
    // Using definitions from your uploaded file
    #define T_AIR 0
    #define T_DIRT 1      // [cite: 1]
    #define T_GRASS 2     // [cite: 2]
    #define T_STONE 3     // [cite: 2]
    #define T_TALLGRASS 4 // [cite: 2]
    #define T_LOG 5       // [cite: 2]
    #define T_LEAVES 6    // [cite: 3]
    #define T_GOLD_ORE 7  // [cite: 3]
    #define T_WATER 8     // [cite: 3]
    #define T_SAND 9      // [cite: 3]
    #define T_TORCH 10    // [cite: 4]

    // --- NOISE HELPERS ---
    float noise2(int x, int z) {
        int n = x + z * 57;
        n = (n << 13) ^ n;
        return (1.0 - ((n * (n * n * 15731 + 789221) + 1376312589) & 0x7fffffff) / 1073741824.0);
    }

    float smooth_noise(float x, float z) {
        int ix = (int)floor(x);
        int iz = (int)floor(z);
        float fx = x - ix;
        float fz = z - iz;
        
        float v1 = noise2(ix, iz);
        float v2 = noise2(ix+1, iz);
        float v3 = noise2(ix, iz+1);
        float v4 = noise2(ix+1, iz+1);
        
        float i1 = v1*(1-fx) + v2*fx;
        float i2 = v3*(1-fx) + v4*fx;
        
        return i1*(1-fz) + i2*fz;
    }

    // --- TREE GENERATION ---
    void draw_classic_tree(ChunkData* data, int x, int y, int z) {
        int height = 5 + (x % 2); 
        // Trunk
        for(int i=0; i<height; i++) {
            if(y+i < CHUNK_HEIGHT) set_block_raw(data, x, y+i, z, T_LOG);
        }
        
        // Leaves
        int top = y + height;
        for(int ly=0; ly<=1; ly++) {
            for(int lx=-2; lx<=2; lx++) {
                for(int lz=-2; lz<=2; lz++) {
                    if (abs(lx) + abs(lz) <= 3)
                         set_block_raw(data, x+lx, top-ly, z+lz, T_LEAVES);
                }
            }
        }
        // Top cap
        set_block_raw(data, x, top+1, z, T_LEAVES);
        set_block_raw(data, x+1, top+1, z, T_LEAVES);
        set_block_raw(data, x-1, top+1, z, T_LEAVES);
        set_block_raw(data, x, top+1, z+1, T_LEAVES);
        set_block_raw(data, x, top+1, z-1, T_LEAVES);
    }

    // --- TEXT GENERATION ---
    int get_text_block(int gx, int gy, int gz) {
        // Center text on the island
        int z_plane = 8; 
        if (gz != z_plane) return 0;

        // Position adjusted for new island height
        int y_zen = 16;   // High up
        int y_craft = 10; // Slightly lower
        
        // --- ZEN --- (Gold)
        if (gy >= y_zen && gy < y_zen + 5) {
            int ly = gy - y_zen;
            // Z (Starts at x = -6)
            int lx = gx - (-6); 
            if (lx >= 0 && lx < 4) {
                 if (ly==0 || ly==4) return T_GOLD_ORE;
                 if (lx == ly ) return T_GOLD_ORE; 
            }
            // E (Starts at x = -1)
            lx = gx - (-1);
            if (lx >= 0 && lx < 4) {
                if (lx==0) return T_GOLD_ORE;
                if (ly==0 || ly==2 || ly==4) return T_GOLD_ORE;
            }
            // N (Starts at x = 4)
            lx = gx - (4);
            if (lx >= 0 && lx < 4) {
                if (lx==0 || lx==3) return T_GOLD_ORE;
                if (lx == ly && lx < 3) return T_GOLD_ORE;
            }
        }

        // --- CRAFT --- (Log/Stone)
        if (gy >= y_craft && gy < y_craft + 5) {
            int ly = gy - y_craft;
            int mat = T_LOG;
            
            // C (x = -10)
            int lx = gx - (-10);
            if (lx >= 0 && lx < 4) {
                if (ly>0 && ly<4 && lx==0) return mat;
                if ((ly==0 || ly==4) && lx>0) return mat;
            }
            // R (x = -5)
            lx = gx - (-5);
            if (lx >= 0 && lx < 4) {
                if (lx==0) return mat;
                if ((ly==2 || ly==4) && lx<3) return mat;
                if (ly==3 && lx==3) return mat;
                if (ly>1 && lx==3 && ly!=3) return 0; 
                if (ly==1 && lx==3) return mat; 
            }
            // A (x = 0)
            lx = gx - (0);
            if (lx >= 0 && lx < 4) {
                 if (ly!=4 && (lx==0 || lx==3)) return mat;
                 if (ly==4 && (lx>0 && lx<3)) return mat;
                 if (ly==2) return mat;
            }
            // F (x = 5)
            lx = gx - (5);
            if (lx >= 0 && lx < 4) {
                if (lx==0) return mat;
                if (ly==4 || ly==2) return mat;
            }
            // T (x = 9)
            lx = gx - (9);
            if (lx >= 0 && lx < 3) {
                if (lx==1) return mat;
                if (ly==4) return mat;
            }
        }
        return 0;
    }

    // --- MAIN GENERATOR ---
    void generate_title_chunk(ChunkData* data, int chunk_x, int chunk_z) {
        int WATER_LEVEL = 4;
        
        for(int cx=0; cx<16; cx++) {
            for(int cz=0; cz<16; cz++) {
                int gx = chunk_x * 16 + cx;
                int gz = chunk_z * 16 + cz;
                
                // --- INVERTED SHAPE: ISLAND ---
                float dist = sqrt(gx*gx + gz*gz);
                
                // Base Noise
                float n_terrain = smooth_noise(gx * 0.04, gz * 0.04);
                
                // Island Formula: Max Height minus Distance
                // Starts high at center (approx 12-14), drops to negative
                float island_base = 14.0 - (dist * 0.6); 
                
                int h = (int)(island_base + (n_terrain * 4.0));
                
                // Clamp limits
                if (h < 2) h = 2; // Ocean floor minimum
                if (h > 30) h = 30;

                // Block Loop
                for(int cy=0; cy<CHUNK_HEIGHT; cy++) {
                    int type = T_AIR;
                    
                    // Terrain
                    if (cy <= h) {
                        if (cy == 0) type = T_STONE; // Bedrock placeholder
                        else if (cy < h - 3) type = T_STONE;
                        else {
                            // Surface Layer
                            if (h <= WATER_LEVEL + 1) type = T_SAND; // Beach level
                            else type = T_GRASS; // High ground
                        }
                    }
                    // Water
                    else if (cy <= WATER_LEVEL) {
                        type = T_WATER;
                    }

                    // Text Overlay
                    int text_b = get_text_block(gx, cy, gz);
                    if (text_b != 0) type = text_b;

                    data->blocks[cx][cy][cz] = type;

                    // Light
                    if (type == T_AIR || type == T_WATER || type == T_LEAVES || type == T_TALLGRASS) {
                        data->light[cx][cy][cz] = 15;
                    } else {
                        data->light[cx][cy][cz] = 0;
                    }
                }
                
                // Vegetation (Only on Grass, above water)
                if (h > WATER_LEVEL + 1 && data->blocks[cx][h][cz] == T_GRASS) {
                    // Avoid putting trees inside the text
                    if (gz < 7 || gz > 9) {
                        float n_veg = smooth_noise(gx * 0.5, gz * 0.5);
                        
                        // Tallgrass [cite: 2]
                        if (n_veg > 0.2 && (gx+gz)%3 != 0) { 
                             if(h+1 < CHUNK_HEIGHT) set_block_raw(data, cx, h+1, cz, T_TALLGRASS);
                        }
                        
                        // Trees
                        if (n_veg > 0.7) {
                            // Spacing check
                            if (cx > 2 && cx < 13 && cz > 2 && cz < 13) {
                                draw_classic_tree(data, cx, h+1, cz);
                            }
                        }
                    }
                }
                
                // Torches (Front of Text)
                // Text is approx z=8. Focus on z=10 area.
                if (gz == 10 && (gx % 5 == 0) && gx >= -5 && gx <= 5) {
                    // Place torch at x=-5, 0, 5 at z=10
                     if (h > WATER_LEVEL && h < CHUNK_HEIGHT - 1) {
                         if (data->blocks[cx][h+1][cz] == T_AIR) {
                             set_block_raw(data, cx, h+1, cz, T_TORCH);
                         }
                     }
                }
            }
        }
    }
}

// Standard Update Function (No changes needed here usually, just calls generator)
fn update_title_screen(chunks: Chunk*, num_chunks: int, dt: float) {
    for x in -1..1 {
         for z in -1..1 {
             let idx = get_chunk_index(x, z);
             if idx >= 0 && idx < num_chunks {
                 if chunks[idx].x != x || chunks[idx].z != z {
                     chunks[idx].x = x;
                     chunks[idx].z = z;
                     chunks[idx].mesh_built = 0;
                     
                     raw {
                         ChunkData d;
                         void generate_title_chunk(ChunkData* data, int x, int z);
                         
                         memset(d.blocks, 0, sizeof(d.blocks));
                         memset(d.light, 0, sizeof(d.light));
                         d.plant_count = 0;
                         
                         generate_title_chunk(&d, x, z);
                         
                         memcpy(chunks[idx].blocks, d.blocks, sizeof(chunks[idx].blocks));
                         // Allow lighting engine to set light later.
                         // But we copy 0/15 initial values for now.
                         memcpy(chunks[idx].light, d.light, sizeof(chunks[idx].light));
                     }
                     
                     // Enable Full Lighting Calculation!
                     // This fixes flat lighting by adding shadows and torch light.
                     recalculate_chunk_lighting(&chunks[idx], chunks, num_chunks);
                     
                     chunks[idx].plant_count = 0;
                     chunks[idx].mesh_dirty = 1;
                 }
             }
         }
    }
    
    title_tick_accum = title_tick_accum + dt;
    while title_tick_accum >= 0.05 {
        for x in -1..1 {
             for z in -1..1 {
                 let idx = get_chunk_index(x, z);
                 if idx >= 0 && idx < num_chunks && chunks[idx].x != -9999 {
                     tick_chunk(&chunks[idx], chunks, num_chunks);
                 }
             }
        }
        title_tick_accum = title_tick_accum - 0.05;
    }
}