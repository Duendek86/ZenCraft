//> Chest UI and rendering — inventory management interface
import "raylib.h" as rl;
import "rlgl.h";
import "math.h";
import "../ui/inventory.zc";
import "../world/chunk_core.zc";
import "../world/blocks.zc";
import "../render/rendering.zc";

// --- Chest UI State ---
let chest_ui_open: int = 0;
let chest_ui_chunk_idx: int = -1;
let chest_ui_chest_idx: int = -1;
let chest_hover_slot: int = -1;  // Which slot is hovered (-1=none)
let chest_hover_panel: int = 0;  // 0=scepter, 1=chest

// Open the chest UI for a specific chest
fn open_chest_ui(chunk_idx: int, chest_idx: int) {
    chest_ui_open = 1;
    chest_ui_chunk_idx = chunk_idx;
    chest_ui_chest_idx = chest_idx;
    rl::EnableCursor();
}

fn close_chest_ui() {
    chest_ui_open = 0;
    chest_ui_chunk_idx = -1;
    chest_ui_chest_idx = -1;
    rl::DisableCursor();
}

fn is_chest_ui_open() -> int {
    return chest_ui_open;
}

// Draw a single inventory slot
fn draw_inv_slot(x: int, y: int, size: int, stack: ItemStack*, hovered: int) {
    // Background
    let bg = rl::Color{r: 30, g: 35, b: 45, a: 255};
    if hovered == 1 { bg = rl::Color{r: 50, g: 55, b: 65, a: 255}; }
    rl::DrawRectangle(x, y, size, size, bg);
    
    if hovered == 1 {
        rl::DrawRectangleLinesEx(rl::Rectangle{x: (float)x - 2.0, y: (float)y - 2.0, width: (float)size + 4.0, height: (float)size + 4.0}, 3.0, rl::GOLD);
    } else {
        rl::DrawRectangleLinesEx(rl::Rectangle{x: (float)x, y: (float)y, width: (float)size, height: (float)size}, 2.0, rl::Color{r: 50, g: 50, b: 60, a: 255});
    }
    
    if stack.block_type != BLOCK_AIR && stack.count > 0 {
        // Draw block color icon
        let ic = get_block_color(stack.block_type);
        let pad = 8;
        rl::DrawRectangle(x + pad, y + pad, size - pad*2, size - pad*2, ic);
        // Draw slight 3D effect
        let dark = rl::Color{r: (int)((float)ic.r * 0.6), g: (int)((float)ic.g * 0.6), b: (int)((float)ic.b * 0.6), a: 255};
        rl::DrawRectangle(x + pad, y + size - pad - 6, size - pad*2, 6, dark);
        
        // Count text
        if stack.count > 1 {
            let txt = rl::TextFormat("%d", stack.count);
            let tw = rl::MeasureText(txt, 18);
            rl::DrawText(txt, x + size - tw - 6, y + size - 20, 18, rl::WHITE);
        }
    }
}

// Draw the full chest inventory UI
fn draw_chest_ui(chunks: Chunk*) {
    if chest_ui_open == 0 { return; }
    if chest_ui_chunk_idx < 0 || chest_ui_chest_idx < 0 { return; }
    
    let chest = &chunks[chest_ui_chunk_idx].chests[chest_ui_chest_idx];
    
    let screen_w = rl::GetScreenWidth();
    let screen_h = rl::GetScreenHeight();
    
    // Dim background
    rl::DrawRectangle(0, 0, screen_w, screen_h, rl::Color{r: 0, g: 0, b: 0, a: 150});
    
    // Panel dimensions
    let panel_w = 400;
    let panel_h = 450;
    let gap = 40;
    
    let slot_size = 64;
    let cols = 9;
    let padding = 25;
    
    // Recalculate panel width to fit 9 slots
    panel_w = cols * slot_size + padding * 2 + (cols - 1) * 6;
    let total_w = panel_w * 2 + gap;
    let start_x = (screen_w - total_w) / 2;
    let start_y = (screen_h - panel_h) / 2;
    
    let mx = rl::GetMouseX();
    let my = rl::GetMouseY();
    let clicked = rl::IsMouseButtonPressed(rl::MOUSE_BUTTON_LEFT);
    
    // ======== LEFT PANEL: SCEPTER ========
    let lx = start_x;
    let ly = start_y;
    
    // Panel background
    let border_col = rl::Color{r: 25, g: 30, b: 45, a: 240};
    rl::DrawRectangle(lx, ly, panel_w, panel_h, border_col);
    rl::DrawRectangle(lx + 8, ly + 8, panel_w - 16, panel_h - 16, rl::Color{r: 15, g: 15, b: 20, a: 255});
    rl::DrawRectangleLinesEx(rl::Rectangle{x: (float)lx, y: (float)ly, width: (float)panel_w, height: (float)panel_h}, 3.0, rl::GOLD);
    
    // Title Header
    rl::DrawRectangle(lx + 8, ly + 8, panel_w - 16, 50, border_col);
    rl::DrawLine(lx + 8, ly + 58, lx + panel_w - 8, ly + 58, rl::GOLD);
    
    let title_s = "INVENTORY";
    let tw_s = rl::MeasureText(title_s, 28);
    rl::DrawText(title_s, lx + (panel_w - tw_s) / 2, ly + 20, 28, rl::RAYWHITE);
    
    // Slots
    let slot_y_start = ly + 80;
    for i in 0..INV_SLOTS {
        let col = i % cols;
        let row = i / cols;
        let sx = lx + padding + col * (slot_size + 6);
        let sy = slot_y_start + row * (slot_size + 6);
        
        let hovered = (mx >= sx && mx < sx + slot_size && my >= sy && my < sy + slot_size);
        draw_inv_slot(sx, sy, slot_size, &scepter_inv.slots[i], hovered);
        
        if hovered && clicked {
            // Transfer from scepter to chest
            inv_transfer(&scepter_inv, &chest.items, i);
        }
        
        // Tooltip on hover
        if hovered && scepter_inv.slots[i].block_type != BLOCK_AIR {
            let name = get_block_name(scepter_inv.slots[i].block_type);
            rl::DrawText(rl::TextFormat("%s", name), mx + 15, my - 5, 16, rl::YELLOW);
        }
    }
    
    // ======== RIGHT PANEL: CHEST ========
    let rx = start_x + panel_w + gap;
    let ry = start_y;
    
    // Panel background
    rl::DrawRectangle(rx, ry, panel_w, panel_h, border_col);
    rl::DrawRectangle(rx + 8, ry + 8, panel_w - 16, panel_h - 16, rl::Color{r: 15, g: 15, b: 20, a: 255});
    rl::DrawRectangleLinesEx(rl::Rectangle{x: (float)rx, y: (float)ry, width: (float)panel_w, height: (float)panel_h}, 3.0, rl::GOLD);
    
    // Title
    rl::DrawRectangle(rx + 8, ry + 8, panel_w - 16, 50, border_col);
    rl::DrawLine(rx + 8, ry + 58, rx + panel_w - 8, ry + 58, rl::GOLD);
    
    let title_c = "CHEST";
    let tw_c = rl::MeasureText(title_c, 28);
    rl::DrawText(title_c, rx + (panel_w - tw_c) / 2, ry + 20, 28, rl::RAYWHITE);
    
    // Slots
    for i in 0..INV_SLOTS {
        let col = i % cols;
        let row = i / cols;
        let cx = rx + padding + col * (slot_size + 6);
        let cy = slot_y_start + row * (slot_size + 6);
        
        let chovered = (mx >= cx && mx < cx + slot_size && my >= cy && my < cy + slot_size);
        draw_inv_slot(cx, cy, slot_size, &chest.items.slots[i], chovered);
        
        if chovered && clicked {
            // Transfer from chest to scepter
            inv_transfer(&chest.items, &scepter_inv, i);
        }
        
        // Tooltip on hover
        if chovered && chest.items.slots[i].block_type != BLOCK_AIR {
            let name = get_block_name(chest.items.slots[i].block_type);
            rl::DrawText(rl::TextFormat("%s", name), mx + 15, my - 5, 16, rl::YELLOW);
        }
    }
    
    // ======== TRANSFER ARROWS ========
    let arrow_y = start_y + panel_h / 2;
    let arrow_x = start_x + panel_w + gap / 2;
    rl::DrawText(">>>", arrow_x - 12, arrow_y - 20, 20, rl::Color{r: 200, g: 200, b: 100, a: 200});
    rl::DrawText("<<<", arrow_x - 12, arrow_y + 5, 20, rl::Color{r: 100, g: 200, b: 200, a: 200});
    
    // ======== CLOSE HINT ========
    let hint = "ESC to close";
    let hw = rl::MeasureText(hint, 18);
    rl::DrawText(hint, (screen_w - hw) / 2, start_y + panel_h + 20, 18, rl::Color{r: 180, g: 180, b: 180, a: 200});
    
    // Handle close
    if rl::IsKeyPressed(rl::KEY_ESCAPE) || rl::IsKeyPressed(rl::KEY_E) {
        close_chest_ui();
    }
}

// --- 3D Chest Rendering ---
fn draw_chests_3d(chunks: Chunk*, num_chunks: int, day_time: float) {
    let sh = get_shader_lighting();
    let loc_use_entity = rl::GetShaderLocation(sh, "uUseEntityLight");
    let loc_entity_light = rl::GetShaderLocation(sh, "uEntityLight");
    
    rl::BeginShaderMode(sh);
    let use_ent = 1;
    if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
    
    for ci in 0..num_chunks {
        if chunks[ci].x == -9999 { continue; }
        
        let base_x = (float)(chunks[ci].x * 16);
        let base_z = (float)(chunks[ci].z * 16);
        
        for i in 0..chunks[ci].chest_count {
            if chunks[ci].chests[i].active == 0 { continue; }
            
            let wx = base_x + (float)chunks[ci].chests[i].x + 0.5;
            let wy = (float)chunks[ci].chests[i].y;
            let wz = base_z + (float)chunks[ci].chests[i].z + 0.5;
            
            // Light at chest position
            let lx = (int)floor(wx);
            let ly = (int)floor(wy + 0.5);
            let lz = (int)floor(wz);
            let packed = get_light_levels(chunks, num_chunks, lx, ly, lz);
            let el = rl::Vector2{x: (float)(packed & 0xF) / 15.0, y: (float)((packed >> 4) & 0xF) / 15.0};
            if loc_entity_light != -1 { rl::SetShaderValue(sh, loc_entity_light, &el, rl::SHADER_UNIFORM_VEC2); }
            
            // Chest colors
            let c_body = rl::Color{r: 139, g: 90, b: 43, a: 255};  // Dark wood
            let c_top = rl::Color{r: 160, g: 110, b: 55, a: 255}; // Lighter top
            let c_latch = rl::Color{r: 200, g: 180, b: 60, a: 255}; // Gold latch
            
            rl::rlPushMatrix();
            rl::rlTranslatef(wx, wy, wz);
            
            let c_dir = chunks[ci].chests[i].active - 1;
            let rot_angle = 0.0;
            if c_dir == 0 { rot_angle = 90.0; }
            else if c_dir == 1 { rot_angle = 0.0; }
            else if c_dir == 2 { rot_angle = -90.0; }
            else if c_dir == 3 { rot_angle = 180.0; }
            rl::rlRotatef(rot_angle, 0.0, 1.0, 0.0);
            
            // Body (bottom part) — slightly smaller than a full block
            rl::DrawCube(rl::Vector3{x: 0.0, y: 0.3, z: 0.0}, 0.85, 0.55, 0.75, c_body);
            
            // Lid (top) — hinged effect with open animation
            let open_angle = chunks[ci].chests[i].open * 60.0; // 0 to 60 degrees
            rl::rlPushMatrix();
            rl::rlTranslatef(0.0, 0.575, -0.375);  // Hinge point at back
            rl::rlRotatef(-open_angle, 1.0, 0.0, 0.0); // Rotate lid open
            rl::DrawCube(rl::Vector3{x: 0.0, y: 0.065, z: 0.375}, 0.85, 0.12, 0.75, c_top);
            rl::rlPopMatrix();
            
            // Latch (front of chest)
            rl::DrawCube(rl::Vector3{x: 0.0, y: 0.4, z: 0.38}, 0.12, 0.12, 0.04, c_latch);
            
            rl::rlPopMatrix();
        }
    }
    
    rl::EndShaderMode();
    use_ent = 0;
    if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
}

// Find a chest at world position. Returns chunk_idx via out params, -1 if not found.    
fn find_chest_at(chunks: Chunk*, num_chunks: int, wx: int, wy: int, wz: int, out_chunk: int*, out_chest: int*) -> int {
    let cx = (int)floor((float)wx / 16.0);
    let cz = (int)floor((float)wz / 16.0);
    let lx = wx - cx * 16;
    let lz = wz - cz * 16;
    
    for ci in 0..num_chunks {
        if chunks[ci].x == cx && chunks[ci].z == cz {
            for i in 0..chunks[ci].chest_count {
                if chunks[ci].chests[i].active == 1 &&
                   chunks[ci].chests[i].x == lx &&
                   chunks[ci].chests[i].y == wy &&
                   chunks[ci].chests[i].z == lz {
                    *out_chunk = ci;
                    *out_chest = i;
                    return 1;
                }
            }
            return 0;
        }
    }
    return 0;
}

// Register a new chest in a chunk
fn place_chest(chunks: Chunk*, num_chunks: int, wx: int, wy: int, wz: int, player_yaw: float) -> int {
    let cx = (int)floor((float)wx / 16.0);
    let cz = (int)floor((float)wz / 16.0);
    let lx = wx - cx * 16;
    let lz = wz - cz * 16;
    
    for ci in 0..num_chunks {
        if chunks[ci].x == cx && chunks[ci].z == cz {
            if chunks[ci].chest_count >= 8 { return 0; } // Max chests per chunk
            let idx = chunks[ci].chest_count;
            chunks[ci].chests[idx].x = lx;
            chunks[ci].chests[idx].y = wy;
            chunks[ci].chests[idx].z = lz;
            chunks[ci].chests[idx].open = 0.0;
            
            let yaw_norm = player_yaw;
            while yaw_norm < 0.0 { yaw_norm = yaw_norm + 6.2831853; }
            while yaw_norm >= 6.2831853 { yaw_norm = yaw_norm - 6.2831853; }
            
            let dir_idx = 0; // 0=East(+X), 1=South(+Z), 2=West(-X), 3=North(-Z)
            if yaw_norm < 0.785398 || yaw_norm >= 5.497787 { dir_idx = 0; }
            else if yaw_norm < 2.356194 { dir_idx = 1; }
            else if yaw_norm < 3.926991 { dir_idx = 2; }
            else { dir_idx = 3; }
            
            // Reverse rotation by 180 degrees so Chest faces the player immediately
            dir_idx = (dir_idx + 2) % 4;
            
            chunks[ci].chests[idx].active = 1 + dir_idx;
            init_inventory(&chunks[ci].chests[idx].items);
            chunks[ci].chest_count++;
            return 1;
        }
    }
    return 0;
}

// Remove a chest at world position
fn remove_chest_at(chunks: Chunk*, num_chunks: int, wx: int, wy: int, wz: int) {
    let out_ci = 0; let out_chi = 0;
    if (find_chest_at(chunks, num_chunks, wx, wy, wz, &out_ci, &out_chi) == 1) {
        chunks[out_ci].chests[out_chi].active = 0;
        
        // [FIX] Shift remaining chests to fill the gap and decrement count
        for i in out_chi..chunks[out_ci].chest_count - 1 {
            chunks[out_ci].chests[i] = chunks[out_ci].chests[i + 1];
        }
        chunks[out_ci].chest_count--;
    }
}
