//> Game UI, HUD & Settings Menu
import "raylib.h" as rl;
import "rlgl.h";
import "../entities/player.zc";
import "../world/chunk_core.zc";
import "../world/persistence.zc";
import "spellbook.zc";

fn get_spell_name(spell_id: int) -> char* {
    if spell_id == 0 { return "Place Block"; }
    else if spell_id == 1 { return "Fireball"; }
    else if spell_id == 2 { return "Miner Banner"; }
    else if spell_id == 3 { return "Lumber Banner"; }
    else if spell_id == 4 { return "Archer Banner"; }
    return "Empty";
}

fn draw_spell_icon(spell_id: int, x: int, y: int, size: int) {
    if spell_id == 0 {
        // Block icon - stone cube
        rl::DrawRectangle(x + 4, y + 4, size - 8, size - 8, rl::Color{r: 130, g: 130, b: 140, a: 255});
        rl::DrawRectangle(x + 6, y + 6, size - 12, size - 16, rl::Color{r: 160, g: 160, b: 170, a: 255});
    } else if spell_id == 1 {
        // Fireball icon
        rl::DrawRectangle(x + 8, y + 6, size - 16, size - 10, rl::Color{r: 255, g: 100, b: 0, a: 255});
        rl::DrawRectangle(x + 12, y + 10, size - 24, size - 18, rl::Color{r: 255, g: 200, b: 50, a: 255});
    } else if spell_id == 2 {
        // Miner banner icon
        rl::DrawRectangle(x + size/2 - 2, y + 4, 4, size - 8, rl::Color{r: 139, g: 90, b: 43, a: 255});
        rl::DrawRectangle(x + 6, y + 6, size - 12, size/3, rl::Color{r: 220, g: 220, b: 200, a: 255});
        rl::DrawRectangle(x + 10, y + 8, 4, size/3 - 4, rl::Color{r: 150, g: 30, b: 30, a: 255});
    } else if spell_id == 3 {
        // Lumber banner icon
        rl::DrawRectangle(x + size/2 - 2, y + 4, 4, size - 8, rl::Color{r: 139, g: 90, b: 43, a: 255});
        rl::DrawRectangle(x + 6, y + 6, size - 12, size/3, rl::Color{r: 140, g: 220, b: 140, a: 255});
        rl::DrawRectangle(x + 10, y + 8, 4, size/3 - 4, rl::Color{r: 30, g: 100, b: 30, a: 255});
    } else if spell_id == 4 {
        // Archer banner icon
        rl::DrawRectangle(x + size/2 - 2, y + 4, 4, size - 8, rl::Color{r: 139, g: 90, b: 43, a: 255});
        rl::DrawRectangle(x + 6, y + 6, size - 12, size/3, rl::Color{r: 220, g: 100, b: 100, a: 255});
        rl::DrawRectangle(x + 10, y + 8, 4, size/3 - 4, rl::Color{r: 150, g: 20, b: 20, a: 255});
        // target
        rl::DrawCircle(x + size/2, y + 8 + (size/3 - 4) / 2, 3.0, rl::WHITE);
        rl::DrawCircle(x + size/2, y + 8 + (size/3 - 4) / 2, 1.0, rl::RED);
    } else {
        // Empty slot
        rl::DrawRectangle(x + 10, y + 10, size - 20, size - 20, rl::Color{r: 40, g: 40, b: 50, a: 100});
    }
}

fn draw_diamond(cx: int, cy: int, size: int, c: rl::Color) {
    let half = (float)size / 2.0;
    let fcx = (float)cx; let fcy = (float)cy;
    rl::DrawTriangle(rl::Vector2{x: fcx, y: fcy - half}, rl::Vector2{x: fcx - half, y: fcy}, rl::Vector2{x: fcx + half, y: fcy}, c);
    rl::DrawTriangle(rl::Vector2{x: fcx - half, y: fcy}, rl::Vector2{x: fcx, y: fcy + half}, rl::Vector2{x: fcx + half, y: fcy}, c);
}

fn draw_diamond_lines(cx: int, cy: int, size: int, thick: float, c: rl::Color) {
    let half = (float)size / 2.0;
    let fcx = (float)cx; let fcy = (float)cy;
    rl::DrawLineEx(rl::Vector2{x: fcx, y: fcy - half}, rl::Vector2{x: fcx - half, y: fcy}, thick, c);
    rl::DrawLineEx(rl::Vector2{x: fcx - half, y: fcy}, rl::Vector2{x: fcx, y: fcy + half}, thick, c);
    rl::DrawLineEx(rl::Vector2{x: fcx, y: fcy + half}, rl::Vector2{x: fcx + half, y: fcy}, thick, c);
    rl::DrawLineEx(rl::Vector2{x: fcx + half, y: fcy}, rl::Vector2{x: fcx, y: fcy - half}, thick, c);
}

fn draw_hud(p: Player*, sb_state: SpellbookState*, version: char*, obelisk_count: int, day_time: float) {
    raw { rlDisableDepthTest(); }
    let screen_w = rl::GetScreenWidth(); let screen_h = rl::GetScreenHeight();
    let cx = screen_w / 2; let cy = screen_h / 2;
    
    // ===== CROSSHAIR =====
    rl::DrawRectangle(cx - 6, cy - 2, 12, 4, rl::Color{r: 0, g: 0, b: 0, a: 140});
    rl::DrawRectangle(cx - 2, cy - 6, 4, 12, rl::Color{r: 0, g: 0, b: 0, a: 140});
    rl::DrawRectangle(cx - 5, cy - 1, 10, 2, rl::Color{r: 255, g: 255, b: 255, a: 200});
    rl::DrawRectangle(cx - 1, cy - 5, 2, 10, rl::Color{r: 255, g: 255, b: 255, a: 200});
    // Dot center
    rl::DrawRectangle(cx - 1, cy - 1, 2, 2, rl::Color{r: 255, g: 220, b: 80, a: 255});

    // ===== PROFESSIONAL HOTBAR (bottom center) =====
    let slot_size = 48;
    let slot_pad = 6;
    let hotbar_slots = 7;
    let hotbar_w = hotbar_slots * slot_size + (hotbar_slots - 1) * slot_pad;
    let hotbar_x = cx - hotbar_w / 2;
    let hotbar_y = screen_h - slot_size - 24;
    
    // Background panel
    let panel_pad = 12;
    rl::DrawRectangle(hotbar_x - panel_pad, hotbar_y - panel_pad, hotbar_w + panel_pad*2, slot_size + panel_pad*2 + 4, rl::Color{r: 25, g: 30, b: 45, a: 210});
    rl::DrawRectangleLinesEx(rl::Rectangle{x: (float)(hotbar_x - panel_pad), y: (float)(hotbar_y - panel_pad), width: (float)(hotbar_w + panel_pad*2), height: (float)(slot_size + panel_pad*2 + 4)}, 2.0, rl::Color{r: 15, g: 20, b: 35, a: 255});
    // Inner bevel
    rl::DrawRectangle(hotbar_x - panel_pad + 2, hotbar_y - panel_pad + 2, hotbar_w + panel_pad*2 - 4, 2, rl::Color{r: 50, g: 60, b: 80, a: 180});
    
    for i in 0..hotbar_slots {
        let sx = hotbar_x + i * (slot_size + slot_pad);
        let sy = hotbar_y;
        
        let spell_id = sb_state.hotbar[i];
        let is_selected = i == sb_state.hotbar_selected;
        
        let border_color = rl::Color{r: 15, g: 20, b: 35, a: 255};
        let bg_color = rl::Color{r: 35, g: 42, b: 60, a: 255};
        
        if is_selected {
            // Gold border
            border_color = rl::Color{r: 220, g: 180, b: 60, a: 255};
            bg_color = rl::Color{r: 50, g: 55, b: 70, a: 255};
        }
        
        // Slot border & bg
        rl::DrawRectangle(sx, sy, slot_size, slot_size, border_color);
        rl::DrawRectangle(sx + 2, sy + 2, slot_size - 4, slot_size - 4, bg_color);
        
        // Inner shadow
        rl::DrawRectangle(sx + 2, sy + 2, slot_size - 4, 4, rl::Color{r: 0, g: 0, b: 0, a: 60});
        
        // Icon
        draw_spell_icon(spell_id, sx, sy, slot_size);
        
        // Diamond Number Box (Top Left)
        draw_diamond(sx + 4, sy + 4, 16, rl::Color{r: 20, g: 25, b: 40, a: 255});
        draw_diamond_lines(sx + 4, sy + 4, 16, 1.5, rl::Color{r: 150, g: 150, b: 160, a: 255});
        rl::DrawText(rl::TextFormat("%d", i + 1), sx - 1, sy - 1, 10, rl::WHITE);
    }
    
    // Active spell name
    let active_spell = sb_state.hotbar[sb_state.hotbar_selected];
    let spell_name = get_spell_name(active_spell);
    let name_w = rl::MeasureText(spell_name, 16);
    rl::DrawText(spell_name, cx - name_w / 2, hotbar_y - 24, 16, rl::Color{r: 240, g: 240, b: 230, a: 255});
    
    // ===== RPG STYLE HP & MANA BARS (centered above hotbar) =====
    let bar_w = 420; let bar_h = 24;
    let base_x = cx - bar_w / 2; 
    let bar_y_mp = hotbar_y - 24 - bar_h - 16;
    let bar_y_hp = bar_y_mp - bar_h - 12;
    let border_col = rl::Color{r: 25, g: 30, b: 45, a: 255}; // Dark slate frame
    
    // ---- HP Bar ----
    // Diamond cap left
    draw_diamond(base_x, bar_y_hp + bar_h/2, 48, border_col);
    // Outer frame
    rl::DrawRectangle(base_x + 10, bar_y_hp - 2, bar_w, bar_h + 4, border_col);
    // Inner background
    rl::DrawRectangle(base_x + 10, bar_y_hp, bar_w - 2, bar_h, rl::Color{r: 15, g: 15, b: 20, a: 255});
    // Fill
    let hp_fill = (int)((float)(bar_w - 4) * (p.health / 100.0));
    if hp_fill > 0 {
        rl::DrawRectangle(base_x + 10, bar_y_hp + 2, hp_fill, bar_h - 4, rl::Color{r: 200, g: 40, b: 50, a: 255});
        // Gradient highlight
        rl::DrawRectangle(base_x + 10, bar_y_hp + 2, hp_fill, (bar_h - 4)/2, rl::Color{r: 240, g: 80, b: 90, a: 255});
    }
    
    // Inner diamond motif
    draw_diamond(base_x, bar_y_hp + bar_h/2, 32, rl::Color{r: 15, g: 20, b: 35, a: 255});
    draw_diamond(base_x, bar_y_hp + bar_h/2, 18, rl::Color{r: 240, g: 80, b: 90, a: 255}); // Red heart substitute
    draw_diamond_lines(base_x, bar_y_hp + bar_h/2, 32, 2.0, rl::Color{r: 80, g: 90, b: 110, a: 255}); // Trim

    // Text
    rl::DrawText(rl::TextFormat("%.0f / 100", p.health), base_x + 36, bar_y_hp + 5, 16, rl::WHITE);

    // ---- Mana Bar ----
    draw_diamond(base_x, bar_y_mp + bar_h/2, 42, border_col);
    rl::DrawRectangle(base_x + 10, bar_y_mp - 2, bar_w - 20, bar_h + 4, border_col);
    rl::DrawRectangle(base_x + 10, bar_y_mp, bar_w - 22, bar_h, rl::Color{r: 15, g: 15, b: 20, a: 255});
    
    let mp_fill = (int)((float)(bar_w - 24) * (p.mana / 100.0));
    if mp_fill > 0 {
        rl::DrawRectangle(base_x + 10, bar_y_mp + 2, mp_fill, bar_h - 4, rl::Color{r: 40, g: 140, b: 220, a: 255});
        rl::DrawRectangle(base_x + 10, bar_y_mp + 2, mp_fill, (bar_h - 4)/2, rl::Color{r: 80, g: 180, b: 250, a: 255});
    }
    
    draw_diamond(base_x, bar_y_mp + bar_h/2, 24, rl::Color{r: 15, g: 20, b: 35, a: 255});
    draw_diamond(base_x, bar_y_mp + bar_h/2, 12, rl::Color{r: 80, g: 180, b: 250, a: 255}); // Blue crystal base
    draw_diamond_lines(base_x, bar_y_mp + bar_h/2, 24, 2.0, rl::Color{r: 80, g: 90, b: 110, a: 255});
    
    rl::DrawText(rl::TextFormat("%.0f / 100", p.mana), base_x + 36, bar_y_mp + 5, 16, rl::WHITE);

    // End caps for bars
    rl::DrawLineEx(rl::Vector2{x:(float)(base_x+10+bar_w), y:(float)(bar_y_hp-2)}, rl::Vector2{x:(float)(base_x+10+bar_w), y:(float)(bar_y_hp+bar_h+2)}, 4.0, border_col);
    rl::DrawLineEx(rl::Vector2{x:(float)(base_x+10+bar_w-20), y:(float)(bar_y_mp-2)}, rl::Vector2{x:(float)(base_x+10+bar_w-20), y:(float)(bar_y_mp+bar_h+2)}, 4.0, border_col);
    
    // ===== VERSION TEXT =====
    rl::DrawText(version, screen_w - rl::MeasureText(version, 14) - 10, 10, 14, rl::Color{r: 180, g: 180, b: 180, a: 120});
    
    // ===== DAY/NIGHT SOLAR CLOCK =====
    let clock_r = 28;
    let clock_x = screen_w - clock_r - 20;
    let clock_y = 60;
    
    // Background bezel
    rl::DrawCircle(clock_x, clock_y, clock_r + 4, rl::Color{r: 25, g: 30, b: 45, a: 255});
    rl::DrawCircleLines(clock_x, clock_y, clock_r + 4, rl::Color{r: 15, g: 20, b: 35, a: 255}); // Outer border
    rl::DrawCircleLines(clock_x, clock_y, clock_r + 5, rl::GOLD); // Outer gold ring
    
    let time_angle = (day_time * 360.0) + 90.0; // Rotate the disc
    
    // Draw Day sector
    rl::DrawCircleSector(rl::Vector2{x: (float)clock_x, y: (float)clock_y}, (float)clock_r, time_angle, time_angle + 180.0, 36, rl::Color{r: 255, g: 220, b: 100, a: 255});
    // Draw Night sector
    rl::DrawCircleSector(rl::Vector2{x: (float)clock_x, y: (float)clock_y}, (float)clock_r, time_angle + 180.0, time_angle + 360.0, 36, rl::Color{r: 20, g: 30, b: 80, a: 255});
    
    // Frame over the sectors
    rl::DrawCircleLines(clock_x, clock_y, clock_r, rl::Color{r: 15, g: 20, b: 35, a: 255});
    
    // Center pin of the clock
    draw_diamond(clock_x, clock_y, 8, rl::Color{r: 25, g: 30, b: 45, a: 255});
    draw_diamond_lines(clock_x, clock_y, 8, 1.5, rl::GOLD);
    
    // Indicator arrow pointing fixed downwards (reading the time from the top)
    rl::DrawTriangle(
        rl::Vector2{x: (float)clock_x - 6.0, y: (float)clock_y - clock_r - 8.0},
        rl::Vector2{x: (float)clock_x + 6.0, y: (float)clock_y - clock_r - 8.0},
        rl::Vector2{x: (float)clock_x,       y: (float)clock_y - clock_r + 2.0},
        rl::Color{r: 220, g: 60, b: 60, a: 255}
    );
    rl::DrawTriangleLines(
        rl::Vector2{x: (float)clock_x - 6.0, y: (float)clock_y - clock_r - 8.0},
        rl::Vector2{x: (float)clock_x + 6.0, y: (float)clock_y - clock_r - 8.0},
        rl::Vector2{x: (float)clock_x,       y: (float)clock_y - clock_r + 2.0},
        rl::Color{r: 15, g: 20, b: 35, a: 255}
    );

    // ===== OBELISK NOTIFICATION =====
    if obelisk_count == 0 {
        let notif_text = "Place an Obelisk to start a village.";
        let font_size = 20;
        let pad = 15;
        let txt_w = rl::MeasureText(notif_text, font_size);
        
        let bg_w = txt_w + pad * 2;
        let bg_h = font_size + pad * 2;
        let bg_x = screen_w - bg_w - 20;
        let bg_y = 20;
        
        rl::DrawRectangle(bg_x, bg_y, bg_w, bg_h, rl::Color{r: 30, g: 30, b: 40, a: 220});
        rl::DrawRectangleLines(bg_x, bg_y, bg_w, bg_h, rl::GOLD);
        rl::DrawText(notif_text, bg_x + pad, bg_y + pad, font_size, rl::WHITE);
    }
}

fn draw_debug_info(p: Player*, chunks: Chunk*, dt: float, day_time: float, draw_distance: int, worker_count: int, wolf_count: int) {
    let loaded_chunks = 0;
    for i in 0..MAX_CHUNKS { if chunks[i].x != -9999 { loaded_chunks++; } }
    
    let dy = 120;
    rl::DrawFPS(10, dy); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Chunks: %d / %d", loaded_chunks, MAX_CHUNKS), 10, dy, 20, rl::LIME); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Workers: %d", worker_count), 10, dy, 20, rl::LIME); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Wolves: %d", wolf_count), 10, dy, 20, rl::Color{ r: 255, g: 80, b: 80, a: 255 }); dy = dy + 25;
    rl::DrawText(rl::TextFormat("XYZ: %.2f, %.2f, %.2f", p.x, p.y, p.z), 10, dy, 20, rl::LIME); dy = dy + 25;
    
    let frame_time_ms = dt * 1000.0;
    
    let pending_load = get_pending_load_count();
    let pending_mesh = get_pending_mesh_count();
    
    rl::DrawText(rl::TextFormat("Frame: %.2f ms", frame_time_ms), 10, dy, 20, rl::YELLOW); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Load/Gen Q: %d", pending_load), 10, dy, 20, rl::YELLOW); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Mesh Q: %d", pending_mesh), 10, dy, 20, rl::YELLOW); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Draw Dist: %d", draw_distance), 10, dy, 20, rl::YELLOW); dy = dy + 30;
    
    let hour_float = (day_time * 24.0) + 6.0;
    if hour_float >= 24.0 { hour_float = hour_float - 24.0; }
    let hour = (int)hour_float;
    let minute = (int)((hour_float - (float)hour) * 60.0);
    
    if hour == 0 { rl::DrawText(rl::TextFormat("Time: 12:%02d AM", minute), 10, dy, 20, rl::WHITE); } 
    else if hour < 12 { rl::DrawText(rl::TextFormat("Time: %d:%02d AM", hour, minute), 10, dy, 20, rl::WHITE); } 
    else if hour == 12 { rl::DrawText(rl::TextFormat("Time: 12:%02d PM", minute), 10, dy, 20, rl::WHITE); } 
    else { rl::DrawText(rl::TextFormat("Time: %d:%02d PM", hour - 12, minute), 10, dy, 20, rl::WHITE); }
    dy = dy + 30;
    
    let prof = get_profiling_stats();
    rl::DrawText("Profiling (Last Op):", 10, dy, 20, rl::ORANGE); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Mesh Gen: %.2f ms", prof.mesh_ms), 20, dy, 20, rl::ORANGE); dy = dy + 25;
    rl::DrawText(rl::TextFormat("World Gen: %.2f ms", prof.gen_ms), 20, dy, 20, rl::ORANGE); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Light Prop: %.2f ms", prof.prop_ms), 20, dy, 20, rl::ORANGE);
}

extern fn get_master_vol() -> float;
extern fn set_master_vol(v: float);
extern fn get_sfx_vol() -> float;
extern fn set_sfx_vol(v: float);

fn draw_settings_menu(draw_distance: int*, grass_dist: float*) {
    let screen_w = rl::GetScreenWidth(); let screen_h = rl::GetScreenHeight();
    let mx = rl::GetMouseX(); let my = rl::GetMouseY();
    let clicked = rl::IsMouseButtonPressed(rl::MOUSE_BUTTON_LEFT);
    let click_held = rl::IsMouseButtonDown(rl::MOUSE_BUTTON_LEFT);
    
    // Centered, larger main panel
    let menu_w = 400; let menu_h = 340;
    let menu_x = screen_w/2 - menu_w/2; let menu_y = screen_h/2 - menu_h/2;
    
    // Background with dark slate panel and styling
    let border_col = rl::Color{r: 25, g: 30, b: 45, a: 240};
    rl::DrawRectangle(menu_x, menu_y, menu_w, menu_h, border_col);
    rl::DrawRectangle(menu_x + 6, menu_y + 6, menu_w - 12, menu_h - 12, rl::Color{r: 15, g: 15, b: 20, a: 255});
    rl::DrawRectangleLinesEx(rl::Rectangle{x: (float)menu_x, y: (float)menu_y, width: (float)menu_w, height: (float)menu_h}, 2.0, rl::GOLD);
    
    // Header
    rl::DrawRectangle(menu_x + 6, menu_y + 6, menu_w - 12, 40, border_col);
    draw_diamond_lines(menu_x + menu_w/2, menu_y + 26, 24, 2.0, rl::GOLD);
    rl::DrawText("GAME SETTINGS", menu_x + menu_w/2 - rl::MeasureText("GAME SETTINGS", 20)/2, menu_y + 16, 20, rl::RAYWHITE);
    rl::DrawLine(menu_x + 6, menu_y + 46, menu_x + menu_w - 6, menu_y + 46, rl::GOLD);
    
    let m_vol = get_master_vol();
    // --- Master Volume ---
    rl::DrawText("Master Volume", menu_x + 30, menu_y + 70, 20, rl::LIGHTGRAY);
    let vol_pct = (int)(m_vol * 100.0);
    rl::DrawText(rl::TextFormat("%d%%", vol_pct), menu_x + 30, menu_y + 95, 15, rl::GRAY);
    
    let btn_bg = rl::Color{r: 35, g: 40, b: 55, a: 255};
    let btn_v_m_rect = rl::Rectangle{x: (float)(menu_x + 240), y: (float)(menu_y + 65), width: 40.0, height: 40.0};
    let btn_v_p_rect = rl::Rectangle{x: (float)(menu_x + 320), y: (float)(menu_y + 65), width: 40.0, height: 40.0};
    let v_m_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_v_m_rect);
    let v_p_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_v_p_rect);
    
    if v_m_hover { rl::DrawRectangleRec(btn_v_m_rect, rl::ColorTint(btn_bg, rl::WHITE)); } else { rl::DrawRectangleRec(btn_v_m_rect, btn_bg); }
    rl::DrawRectangleLinesEx(btn_v_m_rect, 2.0, rl::Color{r: 15, g: 15, b: 20, a: 255});
    if v_m_hover { rl::DrawRectangleLinesEx(btn_v_m_rect, 1.0, rl::GOLD); }
    rl::DrawText("-", (int)btn_v_m_rect.x + 20 - rl::MeasureText("-", 20)/2, (int)btn_v_m_rect.y + 10, 20, rl::RAYWHITE);
    
    if v_p_hover { rl::DrawRectangleRec(btn_v_p_rect, rl::ColorTint(btn_bg, rl::WHITE)); } else { rl::DrawRectangleRec(btn_v_p_rect, btn_bg); }
    rl::DrawRectangleLinesEx(btn_v_p_rect, 2.0, rl::Color{r: 15, g: 15, b: 20, a: 255});
    if v_p_hover { rl::DrawRectangleLinesEx(btn_v_p_rect, 1.0, rl::GOLD); }
    rl::DrawText("+", (int)btn_v_p_rect.x + 20 - rl::MeasureText("+", 20)/2, (int)btn_v_p_rect.y + 10, 20, rl::RAYWHITE);
    
    rl::DrawText(rl::TextFormat("%d", vol_pct), (int)btn_v_m_rect.x + 45, (int)btn_v_m_rect.y + 10, 20, rl::GOLD);
    
    if clicked == 1 {
         if v_m_hover && m_vol > 0.0 { m_vol = m_vol - 0.1; if m_vol < 0.0 { m_vol = 0.0; } set_master_vol(m_vol); }
         if v_p_hover && m_vol < 1.0 { m_vol = m_vol + 0.1; if m_vol > 1.0 { m_vol = 1.0; } set_master_vol(m_vol); }
    }
    
    let sf_vol = get_sfx_vol();
    // --- SFX Volume ---
    rl::DrawText("SFX Volume", menu_x + 30, menu_y + 120, 20, rl::LIGHTGRAY);
    let sfx_pct = (int)(sf_vol * 100.0);
    rl::DrawText(rl::TextFormat("%d%%", sfx_pct), menu_x + 30, menu_y + 145, 15, rl::GRAY);
    
    let btn_sfx_m_rect = rl::Rectangle{x: (float)(menu_x + 240), y: (float)(menu_y + 115), width: 40.0, height: 40.0};
    let btn_sfx_p_rect = rl::Rectangle{x: (float)(menu_x + 320), y: (float)(menu_y + 115), width: 40.0, height: 40.0};
    let sfx_m_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_sfx_m_rect);
    let sfx_p_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_sfx_p_rect);
    
    if sfx_m_hover { rl::DrawRectangleRec(btn_sfx_m_rect, rl::ColorTint(btn_bg, rl::WHITE)); } else { rl::DrawRectangleRec(btn_sfx_m_rect, btn_bg); }
    rl::DrawRectangleLinesEx(btn_sfx_m_rect, 2.0, rl::Color{r: 15, g: 15, b: 20, a: 255});
    if sfx_m_hover { rl::DrawRectangleLinesEx(btn_sfx_m_rect, 1.0, rl::GOLD); }
    rl::DrawText("-", (int)btn_sfx_m_rect.x + 20 - rl::MeasureText("-", 20)/2, (int)btn_sfx_m_rect.y + 10, 20, rl::RAYWHITE);
    
    if sfx_p_hover { rl::DrawRectangleRec(btn_sfx_p_rect, rl::ColorTint(btn_bg, rl::WHITE)); } else { rl::DrawRectangleRec(btn_sfx_p_rect, btn_bg); }
    rl::DrawRectangleLinesEx(btn_sfx_p_rect, 2.0, rl::Color{r: 15, g: 15, b: 20, a: 255});
    if sfx_p_hover { rl::DrawRectangleLinesEx(btn_sfx_p_rect, 1.0, rl::GOLD); }
    rl::DrawText("+", (int)btn_sfx_p_rect.x + 20 - rl::MeasureText("+", 20)/2, (int)btn_sfx_p_rect.y + 10, 20, rl::RAYWHITE);
    
    rl::DrawText(rl::TextFormat("%d", sfx_pct), (int)btn_sfx_m_rect.x + 45, (int)btn_sfx_m_rect.y + 10, 20, rl::GOLD);
    
    if clicked == 1 {
         if sfx_m_hover && sf_vol > 0.0 { sf_vol = sf_vol - 0.1; if sf_vol < 0.0 { sf_vol = 0.0; } set_sfx_vol(sf_vol); }
         if sfx_p_hover && sf_vol < 1.0 { sf_vol = sf_vol + 0.1; if sf_vol > 1.0 { sf_vol = 1.0; } set_sfx_vol(sf_vol); }
    }
    
    // --- Grass Deco Toggle ---
    rl::DrawText("Grass Decorations", menu_x + 30, menu_y + 170, 20, rl::LIGHTGRAY);
    let is_on = *grass_dist > 0.1;
    
    let btn_grass_rect = rl::Rectangle{x: (float)(menu_x + 280), y: (float)(menu_y + 165), width: 80.0, height: 30.0};
    let btn_grass_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_grass_rect);
    
    let g_col = rl::Color{r: 200, g: 40, b: 50, a: 255}; let g_text = "OFF"; // Red
    if is_on { g_col = rl::Color{r: 40, g: 150, b: 40, a: 255}; g_text = "ON"; } // Green
    
    // Button background & hover effect
    if btn_grass_hover { rl::DrawRectangleRec(btn_grass_rect, rl::ColorTint(g_col, rl::Color{r: 200, g: 200, b: 200, a: 255})); }
    else { rl::DrawRectangleRec(btn_grass_rect, g_col); }
    
    rl::DrawRectangleLinesEx(btn_grass_rect, 2.0, rl::Color{r: 15, g: 15, b: 20, a: 255});
    if btn_grass_hover { rl::DrawRectangleLinesEx(btn_grass_rect, 1.0, rl::GOLD); }
    rl::DrawText(g_text, (int)btn_grass_rect.x + 40 - rl::MeasureText(g_text, 18)/2, (int)btn_grass_rect.y + 6, 18, rl::RAYWHITE);
    
    if clicked == 1 && btn_grass_hover {
        if is_on { *grass_dist = 0.0; } else { *grass_dist = 64.0; } // Safe grass distance
    }
    
    // --- Render Distance ---
    rl::DrawText("Render Distance", menu_x + 30, menu_y + 220, 20, rl::LIGHTGRAY);
    rl::DrawText(rl::TextFormat("%d Chunks", *draw_distance), menu_x + 30, menu_y + 245, 15, rl::GRAY);
    
    let btn_minus_rect = rl::Rectangle{x: (float)(menu_x + 240), y: (float)(menu_y + 215), width: 40.0, height: 40.0};
    let btn_plus_rect = rl::Rectangle{x: (float)(menu_x + 320), y: (float)(menu_y + 215), width: 40.0, height: 40.0};
    
    let minus_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_minus_rect);
    let plus_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_plus_rect);
    
    // Minus Button
    if minus_hover { rl::DrawRectangleRec(btn_minus_rect, rl::ColorTint(btn_bg, rl::WHITE)); } else { rl::DrawRectangleRec(btn_minus_rect, btn_bg); }
    rl::DrawRectangleLinesEx(btn_minus_rect, 2.0, rl::Color{r: 15, g: 15, b: 20, a: 255});
    if minus_hover { rl::DrawRectangleLinesEx(btn_minus_rect, 1.0, rl::GOLD); }
    rl::DrawText("-", (int)btn_minus_rect.x + 20 - rl::MeasureText("-", 20)/2, (int)btn_minus_rect.y + 10, 20, rl::RAYWHITE);
    
    // Plus Button
    if plus_hover { rl::DrawRectangleRec(btn_plus_rect, rl::ColorTint(btn_bg, rl::WHITE)); } else { rl::DrawRectangleRec(btn_plus_rect, btn_bg); }
    rl::DrawRectangleLinesEx(btn_plus_rect, 2.0, rl::Color{r: 15, g: 15, b: 20, a: 255});
    if plus_hover { rl::DrawRectangleLinesEx(btn_plus_rect, 1.0, rl::GOLD); }
    rl::DrawText("+", (int)btn_plus_rect.x + 20 - rl::MeasureText("+", 20)/2, (int)btn_plus_rect.y + 10, 20, rl::RAYWHITE);
    
    // Current Value display
    rl::DrawText(rl::TextFormat("%d", *draw_distance), (int)btn_minus_rect.x + 45, (int)btn_minus_rect.y + 10, 20, rl::GOLD);
    
    if clicked == 1 {
        if minus_hover && *draw_distance > 2 { *draw_distance = *draw_distance - 1; }
        // Clamp to 10 to prevent exceeding 1024 MAX_CHUNKS (10 radius = 21x21 = 441 chunks)
        // With unload_dist = 12 -> 25x25 = 625 slots needed. Very safe.
        if plus_hover && *draw_distance < 10 { *draw_distance = *draw_distance + 1; }
    }
    
    // --- Footer ---
    rl::DrawLine(menu_x, menu_y + menu_h - 40, menu_x + menu_w, menu_y + menu_h - 40, rl::Color{r: 100, g: 100, b: 110, a: 255});
    rl::DrawText("Press F1 to Resume", menu_x + menu_w/2 - rl::MeasureText("Press F1 to Resume", 15)/2, menu_y + menu_h - 25, 15, rl::GRAY);
}