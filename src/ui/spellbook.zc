//> spellbook.zc
import "raylib.h" as rl;
import "rlgl.h";
import "inventory.zc";

import "../world/chunk.zc";

struct SpellbookState {
    show: int;
    selected_spell: int; // 0 = Place Block
    current_tab: int; // 0 = Blocks, 1 = Structures
    hotbar: int[7];        // Spell IDs assigned to each hotbar slot (-1=empty)
    hotbar_selected: int;  // Currently active hotbar slot (0-6)
}

extern fn get_total_obelisk_count(chunks: Chunk*, num_chunks: int) -> int;

// Function to draw the spellbook UI
// Returns 1 if a selection changed, 0 otherwise
fn draw_spellbook(state: SpellbookState*, selected_block: int*, chunks: Chunk*, max_chunks: int) {
    let screen_w = rl::GetScreenWidth();
    let screen_h = rl::GetScreenHeight();
    let cx = screen_w / 2;
    let cy = screen_h / 2;
    
    // Book Dimensions
    let book_w = 800;
    let book_h = 500;
    let book_x = cx - book_w / 2;
    let book_y = cy - book_h / 2;
    
    // Draw Book Background (Brown Cover, Cream Pages)
    rl::DrawRectangle(book_x - 10, book_y - 10, book_w + 20, book_h + 20, rl::Color{r: 60, g: 40, b: 20, a: 255}); // Cover
    rl::DrawRectangle(book_x, book_y, book_w / 2 - 5, book_h, rl::Color{r: 240, g: 230, b: 200, a: 255}); // Left Page
    rl::DrawRectangle(book_x + book_w / 2 + 5, book_y, book_w / 2 - 5, book_h, rl::Color{r: 240, g: 230, b: 200, a: 255}); // Right Page
    rl::DrawRectangle(book_x + book_w / 2 - 5, book_y, 10, book_h, rl::Color{r: 50, g: 30, b: 10, a: 255}); // Spine
    
    // --- LEFT PAGE: SPELLS ---
    rl::DrawText("SPELLS", book_x + 80, book_y + 30, 20, rl::BLACK);
    
    let mx = rl::GetMouseX();
    let my = rl::GetMouseY();
    let clicked = rl::IsMouseButtonPressed(rl::MOUSE_BUTTON_LEFT);
    
    // Spell 1: Place Block
    let s1_x = book_x + 30;
    let s1_y = book_y + 70;
    let s1_w = 240;
    let s1_h = 40;
    
    if (state.selected_spell == 0) {
        rl::DrawRectangle(s1_x, s1_y, s1_w, s1_h, rl::Color{r: 200, g: 200, b: 255, a: 255}); // Highlight
    }
    rl::DrawRectangleLines(s1_x, s1_y, s1_w, s1_h, rl::BLACK);
    rl::DrawText("Place Block", s1_x + 10, s1_y + 10, 20, rl::BLACK);
    
    if (clicked && mx >= s1_x && mx <= s1_x + s1_w && my >= s1_y && my <= s1_y + s1_h) {
        state.selected_spell = 0;
    }
    
    // Spell 2: Fireball
    let s2_x = book_x + 30;
    let s2_y = book_y + 120;
    let s2_w = 240;
    let s2_h = 40;
    
    if (state.selected_spell == 1) {
        rl::DrawRectangle(s2_x, s2_y, s2_w, s2_h, rl::Color{r: 255, g: 180, b: 100, a: 255}); // Fire highlight
    }
    rl::DrawRectangleLines(s2_x, s2_y, s2_w, s2_h, rl::BLACK);
    rl::DrawRectangle(s2_x + 5, s2_y + 8, 24, 24, rl::Color{r: 255, g: 100, b: 0, a: 255}); // Fire icon
    rl::DrawRectangle(s2_x + 11, s2_y + 14, 12, 12, rl::Color{r: 255, g: 200, b: 50, a: 255}); // Inner flame
    rl::DrawText("Fireball", s2_x + 35, s2_y + 5, 20, rl::Color{r: 180, g: 50, b: 0, a: 255});
    rl::DrawText("20 Mana", s2_x + 35, s2_y + 24, 12, rl::DARKGRAY);
    
    if (clicked && mx >= s2_x && mx <= s2_x + s2_w && my >= s2_y && my <= s2_y + s2_h) {
        state.selected_spell = 1;
    }
    
    // --- Zibi Control Category ---
    rl::DrawText("ZIBI CONTROL", book_x + 60, book_y + 180, 18, rl::Color{r: 50, g: 100, b: 50, a: 255});
    rl::DrawLine(book_x + 30, book_y + 200, book_x + 270, book_y + 200, rl::Color{r: 50, g: 100, b: 50, a: 150});
    
    // Spell 3: Miner
    let s3_x = book_x + 30;
    let s3_y = book_y + 215;
    let s3_w = 240;
    let s3_h = 40;
    
    if (state.selected_spell == 2) {
        rl::DrawRectangle(s3_x, s3_y, s3_w, s3_h, rl::Color{r: 180, g: 230, b: 180, a: 255}); // Green highlight
    }
    rl::DrawRectangleLines(s3_x, s3_y, s3_w, s3_h, rl::BLACK);
    // Pickaxe icon
    rl::DrawRectangle(s3_x + 8, s3_y + 8, 4, 20, rl::Color{r: 139, g: 90, b: 43, a: 255}); // Handle
    rl::DrawRectangle(s3_x + 3, s3_y + 6, 14, 4, rl::Color{r: 160, g: 170, b: 180, a: 255}); // Head
    rl::DrawText("Miner Banner", s3_x + 35, s3_y + 5, 20, rl::Color{r: 40, g: 100, b: 40, a: 255});
    rl::DrawText("15 Mana", s3_x + 35, s3_y + 24, 12, rl::DARKGRAY);
    
    if (clicked && mx >= s3_x && mx <= s3_x + s3_w && my >= s3_y && my <= s3_y + s3_h) {
        state.selected_spell = 2;
    }
    
    rl::DrawLine(book_x + 30, s3_y + s3_h + 5, book_x + 270, s3_y + s3_h + 5, rl::Color{r: 50, g: 100, b: 50, a: 150});
    
    // Spell 4: Lumberjack
    let s4_x = book_x + 30;
    let s4_y = s3_y + s3_h + 10;
    let s4_w = 240;
    let s4_h = 40;
    
    if (state.selected_spell == 3) {
        rl::DrawRectangle(s4_x, s4_y, s4_w, s4_h, rl::Color{r: 180, g: 230, b: 180, a: 255});
    }
    rl::DrawRectangleLines(s4_x, s4_y, s4_w, s4_h, rl::BLACK);
    // Axe icon
    rl::DrawRectangle(s4_x + 8, s4_y + 8, 4, 20, rl::Color{r: 101, g: 67, b: 33, a: 255}); // Handle
    rl::DrawRectangle(s4_x + 3, s4_y + 6, 10, 8, rl::Color{r: 120, g: 120, b: 130, a: 255}); // Blade
    rl::DrawText("Lumber Banner", s4_x + 35, s4_y + 5, 20, rl::Color{r: 40, g: 100, b: 40, a: 255});
    rl::DrawText("15 Mana", s4_x + 35, s4_y + 24, 12, rl::DARKGRAY);
    
    if (clicked && mx >= s4_x && mx <= s4_x + s4_w && my >= s4_y && my <= s4_y + s4_h) {
        state.selected_spell = 3;
    }
    
    // --- HOTBAR ASSIGNMENT ---
    rl::DrawLine(book_x + 30, s4_y + s4_h + 10, book_x + 270, s4_y + s4_h + 10, rl::Color{r: 80, g: 80, b: 80, a: 150});
    rl::DrawText("HOTBAR SLOTS", book_x + 60, s4_y + s4_h + 15, 16, rl::Color{r: 180, g: 180, b: 180, a: 255});
    
    let hb_y = s4_y + s4_h + 35;
    let hb_btn = 30;
    let hb_pad = 5;
    for slot in 0..7 {
        let bx = book_x + 30 + slot * (hb_btn + hb_pad);
        let by = hb_y;
        
        // Background - highlight if this slot has the currently selected spell
        let is_active = state.hotbar[slot] == state.selected_spell;
        if is_active {
            rl::DrawRectangle(bx, by, hb_btn, hb_btn, rl::GOLD);
        } else {
            rl::DrawRectangle(bx, by, hb_btn, hb_btn, rl::Color{r: 60, g: 60, b: 70, a: 220});
        }
        rl::DrawRectangleLines(bx, by, hb_btn, hb_btn, rl::Color{r: 120, g: 120, b: 130, a: 255});
        
        // Slot number
        rl::DrawText(rl::TextFormat("%d", slot + 1), bx + 10, by + 7, 16, rl::WHITE);
        
        // Click to assign current selected_spell to this slot
        if clicked && mx >= bx && mx <= bx + hb_btn && my >= by && my <= by + hb_btn {
            state.hotbar[slot] = state.selected_spell;
        }
    }
    
    // Show what each slot currently has
    let hb_label_y = hb_y + hb_btn + 3;
    for slot in 0..7 {
        let bx = book_x + 30 + slot * (hb_btn + hb_pad);
        let spell_id = state.hotbar[slot];
        let label = "-";
        if spell_id == 0 { label = "B"; }      // Block
        else if spell_id == 1 { label = "F"; }  // Fireball
        else if spell_id == 2 { label = "M"; }  // Miner
        else if spell_id == 3 { label = "L"; }  // Lumber
        rl::DrawText(label, bx + 10, hb_label_y, 12, rl::LIGHTGRAY);
    }
    
    // --- RIGHT PAGE: INVENTORY ---
    // Tabs
    let tab_x = book_x + book_w/2 + 20;
    let tab_y = book_y + 20;
    let tab_w = 100;
    let tab_h = 25;
    
    // Tab 1: Blocks
    if (state.current_tab == 0) rl::DrawRectangle(tab_x, tab_y, tab_w, tab_h, rl::GOLD);
    else rl::DrawRectangle(tab_x, tab_y, tab_w, tab_h, rl::GRAY);
    rl::DrawText("Blocks", tab_x + 20, tab_y + 5, 20, rl::BLACK);
    if (clicked && mx >= tab_x && mx <= tab_x + tab_w && my >= tab_y && my <= tab_y + tab_h) { state.current_tab = 0; }
    
    // Tab 2: Structures
    if (state.current_tab == 1) rl::DrawRectangle(tab_x + 110, tab_y, tab_w, tab_h, rl::GOLD);
    else rl::DrawRectangle(tab_x + 110, tab_y, tab_w, tab_h, rl::GRAY);
    rl::DrawText("Structures", tab_x + 115, tab_y + 5, 20, rl::BLACK);
    if (clicked && mx >= tab_x + 110 && mx <= tab_x + 110 + tab_w && my >= tab_y && my <= tab_y + tab_h) { state.current_tab = 1; }

    
    // Grid Setup
    let grid_start_x = book_x + book_w/2 + 30;
    let grid_start_y = book_y + 70;
    let cell_size = 50;
    let padding = 10;
    
    if (state.current_tab == 0) {
        // --- BLOCKS TAB ---
    
    let col = 0;
    let row = 0;
    
    for b in 1..15 { // Blocks 1 to 14
        let display_block = b;
        if (b >= 11 && b <= 14) continue; // Skip wall torches
        
        let cell_x = grid_start_x + col * (cell_size + padding);
        let cell_y = grid_start_y + row * (cell_size + padding);
        
        // Highlight if selected
        if (*selected_block == display_block) {
            rl::DrawRectangle(cell_x - 3, cell_y - 3, cell_size + 6, cell_size + 6, rl::GOLD);
        }
        
        rl::DrawRectangleLines(cell_x, cell_y, cell_size, cell_size, rl::BLACK);
        
        // Draw Block Preview
        let b_col: rl::Color = rl::WHITE; // Explicit type check
        if (display_block == 1) b_col = rl::BROWN;
        else if (display_block == 2) b_col = rl::LIME;
        else if (display_block == 3) b_col = rl::GRAY;
        else if (display_block == 4) b_col = rl::Color{r: 101, g: 67, b: 33, a: 255}; // Wood
        else if (display_block == 5) b_col = rl::DARKGREEN;
        else if (display_block == 8) b_col = rl::BEIGE; // Sand
        else if (display_block == 9) b_col = rl::SKYBLUE; // Glass
        else if (display_block == 10) b_col = rl::YELLOW; // Torch
        else b_col = rl::MAGENTA; 
        
        let has_block = scepter_has_block(display_block);
        if (has_block == 0) {
            b_col.r = (char)((int)b_col.r / 4);
            b_col.g = (char)((int)b_col.g / 4);
            b_col.b = (char)((int)b_col.b / 4);
            b_col.a = 200;
        }
        
        rl::DrawRectangle(cell_x + 5, cell_y + 5, cell_size - 10, cell_size - 10, b_col);
        
        // Draw cross if not owned
        if (has_block == 0) {
            rl::DrawLine(cell_x + 5, cell_y + 5, cell_x + cell_size - 5, cell_y + cell_size - 5, rl::Color{r: 100, g: 0, b: 0, a: 150});
            rl::DrawLine(cell_x + cell_size - 5, cell_y + 5, cell_x + 5, cell_y + cell_size - 5, rl::Color{r: 100, g: 0, b: 0, a: 150});
        }
        
        // Selection Logic
        if (has_block == 1) {
            if (clicked && mx >= cell_x && mx <= cell_x + cell_size && my >= cell_y && my <= cell_y + cell_size) {
                *selected_block = display_block;
            }
        }
        
        col = col + 1;
        if (col >= 4) {
            col = 0;
            row = row + 1;
        }
    }
    } else {
        // --- STRUCTURES TAB ---
        // Item 1: Power Source
        let obelisk_allowed = (get_total_obelisk_count(chunks, max_chunks) == 0);
        let ps_x = grid_start_x;
        let ps_y = grid_start_y;
        
        if (*selected_block == 21) {
             rl::DrawRectangle(ps_x - 3, ps_y - 3, cell_size + 6, cell_size + 6, rl::GOLD);
        }
        rl::DrawRectangleLines(ps_x, ps_y, cell_size, cell_size, rl::BLACK);
        
        // Icon (Purple Center)
        let ob_col = rl::PURPLE;
        if (obelisk_allowed == 0) {
            ob_col.r = (char)((int)ob_col.r / 4);
            ob_col.g = (char)((int)ob_col.g / 4);
            ob_col.b = (char)((int)ob_col.b / 4);
            ob_col.a = 200;
        }
        rl::DrawRectangle(ps_x + 5, ps_y + 5, cell_size - 10, cell_size - 10, ob_col);
        
        if (obelisk_allowed == 0) {
            rl::DrawLine(ps_x + 5, ps_y + 5, ps_x + cell_size - 5, ps_y + cell_size - 5, rl::Color{r: 100, g: 0, b: 0, a: 150});
            rl::DrawLine(ps_x + cell_size - 5, ps_y + 5, ps_x + 5, ps_y + cell_size - 5, rl::Color{r: 100, g: 0, b: 0, a: 150});
        }
        
        rl::DrawText("Obelisco", ps_x + 5, ps_y + cell_size + 5, 10, rl::BLACK);
        
        if (obelisk_allowed == 1) {
            if (clicked && mx >= ps_x && mx <= ps_x + cell_size && my >= ps_y && my <= ps_y + cell_size) {
                *selected_block = 21; // BLOCK_OBELISK
            }
        }
        
        // Item 2: Chest
        let ch_x = ps_x + cell_size + 10;
        let ch_y = ps_y;
        
        if (*selected_block == BLOCK_CHEST) {
             rl::DrawRectangle(ch_x - 3, ch_y - 3, cell_size + 6, cell_size + 6, rl::GOLD);
        }
        rl::DrawRectangleLines(ch_x, ch_y, cell_size, cell_size, rl::BLACK);
        rl::DrawRectangle(ch_x + 5, ch_y + 5, cell_size - 10, cell_size - 10, rl::Color{r: 160, g: 120, b: 50, a: 255});
        rl::DrawText("Chest", ch_x + 8, ch_y + cell_size + 5, 10, rl::BLACK);
        
        if (clicked && mx >= ch_x && mx <= ch_x + cell_size && my >= ch_y && my <= ch_y + cell_size) {
            *selected_block = BLOCK_CHEST;
        }
    }
    }
}

impl SpellbookState {
    static fn new() -> SpellbookState {
        let s: SpellbookState;
        s.show = 0;
        s.selected_spell = 0;
        s.current_tab = 0;
        s.hotbar[0] = 0; // Place Block
        s.hotbar[1] = 1; // Fireball
        s.hotbar[2] = 2; // Miner Banner
        s.hotbar[3] = 3; // Lumber Banner
        s.hotbar[4] = -1; // Empty
        s.hotbar[5] = -1;
        s.hotbar[6] = -1;
        s.hotbar_selected = 0;
        return s;
    }
    
    fn toggle(self) {
        self.show = !self.show;
        if self.show {
            rl::EnableCursor();
        } else {
            rl::DisableCursor();
        }
    }
}
