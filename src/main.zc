//> link: -lraylib -lm
raw {
    #define ZALLOC_IMPLEMENTATION
    #define ZALLOC_ENABLE_DEBUG
    
    #define Z_MALLOC(sz)      zdebug_malloc_loc(sz, __FILE__, __LINE__)
    #define Z_CALLOC(n,sz)    zdebug_calloc_loc(n, sz, __FILE__, __LINE__)
    #define Z_REALLOC(p,sz)   zdebug_realloc_loc(p, sz, __FILE__, __LINE__)
    #define Z_FREE(p)         zdebug_free(p)
    
    #include "src/zalloc.h"
    
    // Wrappers para ZALLOC en Zen-C
    void* sys_zdebug_malloc(int sz) { return zdebug_malloc((size_t)sz); }
    void sys_zdebug_free(void* p) { zdebug_free(p); }
    void sys_zdebug_register_atexit() { zdebug_register_atexit(); }
}

extern fn sys_zdebug_malloc(sz: int) -> any;
extern fn sys_zdebug_free(p: any);
extern fn sys_zdebug_register_atexit();

import "raylib.h" as rl;
import "rlgl.h";
import "math.h";

import "world/blocks.zc";
import "render/lighting.zc";
import "world/chunk_core.zc";
import "world/chunk_mesh.zc";
import "render/rendering.zc";
import "entities/player.zc";
import "world/persistence.zc";
import "ui/title_generator.zc";
import "entities/zibi.zc";
import "ui/banner_ui.zc";
import "render/grass_deco.zc";
import "render/particles.zc";
import "ui/spellbook.zc";
import "entities/fireball.zc";
import "entities/shadow_wolf.zc";
import "entities/player_interaction.zc";
import "entities/obelisk.zc";
import "ui/world_select_ui.zc";

// Import modules from the refactoring
import "ui/game_loading.zc";
import "ui/game_ui.zc";
import "render/bloom.zc";
import "ui/inventory.zc";
import "ui/chest_ui.zc";

def VERSION_TEXT = "v0.0.1.17 alpha-dev";
def MAX_ZIBIS = 10;
def MAX_WOLVES = 8;
def SAVE_DIR = "world";

def STATE_TITLE = 0;
def STATE_LOADING = 1;
def STATE_GAME = 2;
def STATE_WORLD_SELECT = 3;

fn main() {
    rl::SetTraceLogLevel(rl::LOG_WARNING);
    rl::InitWindow(SCREEN_WIDTH, SCREEN_HEIGHT, TITLE);
    rl::SetExitKey(0);
    rl::SetWindowState(rl::FLAG_WINDOW_RESIZABLE | rl::FLAG_VSYNC_HINT | rl::FLAG_WINDOW_ALWAYS_RUN);
    //rl::ToggleFullscreen();
    rl::SetTargetFPS(60);

    // --- Audio init ---
    rl::InitAudioDevice();
    let menu_music: rl::Music;
    let day_music: rl::Music;
    let night_music: rl::Music;
    // Load music files (streaming)
    menu_music = rl::LoadMusicStream("assets/music/Ethereal Sandbox Exploration.mp3");
    day_music = rl::LoadMusicStream("assets/music/Voxel Village Vibe.mp3");
    night_music = rl::LoadMusicStream("assets/music/Crystal Cavern Depths.mp3");
    let current_music_playing: int = 0; // 0=none,1=menu,2=day,3=night
    let fade_state: int = 0; // 0=play, 1=fade_out, 2=wait, 3=fade_in
    let fade_target_music: int = 0;
    let fade_timer: float = 0.0;
    let fade_vol: float = 0.0;

    init_textures();
    init_clouds();
    init_bloom(SCREEN_WIDTH, SCREEN_HEIGHT);
    
    // Array de chunks usando nuestro wrapper seguro
    let chunks = (Chunk*)sys_zdebug_malloc(sizeof(Chunk) * MAX_CHUNKS);
    sys_zdebug_register_atexit();
    init_persistence(chunks);

    let current_state = STATE_TITLE;
    let show_debug_info = 1;
    let first_frame = 1;
    
    let show_settings = 0;
    let draw_distance = 6;
    let grass_dist: float = 64.0;
    
    set_game_world_dir("titleworld");
    let title_cam = rl::Camera3D{ position: rl::Vector3{x: 8.0, y: 15.0, z: 25.0}, target: rl::Vector3{x: 8.0, y: 12.0, z: 0.0}, up: rl::Vector3{x: 0.0, y: 1.0, z: 0.0}, fovy: 50.0, projection: rl::CAMERA_PERSPECTIVE };
    
    let p: Player;
    let selected_block = BLOCK_STONE;
    let spellbook = SpellbookState::new();
    let show_spellbook = 0;
    let show_exit_confirm = 0;
    let zibis: Zibi[MAX_ZIBIS];
    let wolves: ShadowWolf[MAX_WOLVES];
    for wi in 0..MAX_WOLVES { wolves[wi].active = 0; }
    
    defer { 
        cleanup_persistence();
        sys_zdebug_free((any)chunks);
        // Stop and unload music
        rl::StopMusicStream(menu_music);
        rl::StopMusicStream(day_music);
        rl::StopMusicStream(night_music);
        rl::UnloadMusicStream(menu_music);
        rl::UnloadMusicStream(day_music);
        rl::UnloadMusicStream(night_music);
        rl::CloseAudioDevice();
        rl::CloseWindow();
    }

    for i in 0..MAX_CHUNKS { chunks[i].x = -9999; chunks[i].z = -9999; chunks[i].locked = 0; chunks[i].chest_count = 0; }
    scepter_init();
    
    let day_time = 0.2;
    let title_start_time = rl::GetTime();
    
    // --- Wave System ---
    let wave_number = 0;
    let wave_spawned_today = 0;
    let was_night = 0;

    while rl::WindowShouldClose() == 0 {
        if rl::IsMouseButtonPressed(rl::MOUSE_BUTTON_LEFT) {
            if current_state == STATE_GAME && show_settings == 0 && show_spellbook == 0 && is_chest_ui_open() == 0 && is_scepter_ui_open() == 0 && is_banner_ui_open() == 0 && show_exit_confirm == 0 { rl::DisableCursor(); }
        }

        let dt = rl::GetFrameTime();
        if dt > 0.1 { dt = 0.1; }
        
        if rl::IsKeyPressed(rl::KEY_F11) { rl::ToggleFullscreen(); }
        
        // --- Music Fade State Machine ---
        let target_music = 1; // Default to menu
        if current_state == STATE_GAME {
            let is_night = (day_time > 0.5);
            if is_night { target_music = 3; } else { target_music = 2; }
        } else if current_state == STATE_LOADING {
            target_music = 0; // Completely silence music during heavy generation
        }
        
        if fade_target_music != target_music {
            fade_target_music = target_music;
            if current_music_playing == 0 {
                fade_state = 3; // Fade-in immediately
                current_music_playing = target_music;
                if current_music_playing == 1 { rl::PlayMusicStream(menu_music); }
                else if current_music_playing == 2 { rl::PlayMusicStream(day_music); }
                else if current_music_playing == 3 { rl::PlayMusicStream(night_music); }
            } else {
                fade_state = 1; // Fade-out current track
            }
        }
        
        if fade_state == 1 { // FADE OUT
            fade_vol = fade_vol - dt * 0.5;
            if fade_vol <= 0.0 {
                fade_vol = 0.0;
                if current_music_playing == 1 { rl::StopMusicStream(menu_music); }
                else if current_music_playing == 2 { rl::StopMusicStream(day_music); }
                else if current_music_playing == 3 { rl::StopMusicStream(night_music); }
                current_music_playing = 0;
                fade_state = 2;
                fade_timer = 2.0; // Wait 2 seconds
            }
        } else if fade_state == 2 { // WAIT
            fade_timer = fade_timer - dt;
            if fade_timer <= 0.0 {
                fade_state = 3;
                current_music_playing = fade_target_music;
                if current_music_playing == 1 { rl::PlayMusicStream(menu_music); }
                else if current_music_playing == 2 { rl::PlayMusicStream(day_music); }
                else if current_music_playing == 3 { rl::PlayMusicStream(night_music); }
                fade_vol = 0.0;
            }
        } else if fade_state == 3 { // FADE IN
            fade_vol = fade_vol + dt * 0.5;
            if fade_vol >= 1.0 {
                fade_vol = 1.0;
                fade_state = 0;
            }
        }
        
        // Apply volume and update active stream
        if current_music_playing == 1 { rl::SetMusicVolume(menu_music, fade_vol); rl::UpdateMusicStream(menu_music); }
        else if current_music_playing == 2 { rl::SetMusicVolume(day_music, fade_vol); rl::UpdateMusicStream(day_music); }
        else if current_music_playing == 3 { rl::SetMusicVolume(night_music, fade_vol); rl::UpdateMusicStream(night_music); }
        
        // --- TITLE STATE ---
        if current_state == STATE_TITLE {
            update_day_night_cycle(0.12);
            
            if rl::IsKeyPressed(rl::KEY_ENTER) {
                current_state = STATE_WORLD_SELECT;
                init_world_select();
                continue;
            }

            update_title_screen(chunks, MAX_CHUNKS, dt);
            poll_async_results();
            for i in 0..MAX_CHUNKS {
                if chunks[i].x != -9999 && chunks[i].mesh_dirty != 0 && chunks[i].locked == 0 { request_mesh_async(i, 0); }
            }

            rl::BeginDrawing();
            rl::ClearBackground(rl::Color{r: 20, g: 20, b: 30, a: 255});

            let time = (float)rl::GetTime() - (float)title_start_time;
            title_cam.position.x = 8.0 + (float)sin(time * 0.2 - 1.57) * 40.0;
            title_cam.position.z = (float)cos(time * 0.2 - 1.57) * 40.0;
            title_cam.position.y = 14.0 + (float)sin(time * 0.1) * 2.0;
            
            update_frame_uniforms(title_cam.position, time);
            
            rl::BeginMode3D(title_cam);
            raw { rlDisableBackfaceCulling(); }
            let title_builds = 0;
            for i in 0..MAX_CHUNKS { if chunks[i].x != -9999 { chunks[i].draw_opaque(chunks, MAX_CHUNKS, &title_builds, 100, 8, 25); } }
            for i in 0..MAX_CHUNKS { if chunks[i].x != -9999 { chunks[i].draw_transparent(chunks, MAX_CHUNKS, 8, 25, grass_dist); } }
            rl::EndMode3D();
            
            rl::DrawText("ZEN CRAFT", SCREEN_WIDTH/2 - 250, 100, 80, rl::BLACK);
            rl::DrawText("ZEN CRAFT", SCREEN_WIDTH/2 - 245, 95, 80, rl::WHITE);
            rl::DrawText("Press ENTER to Start", SCREEN_WIDTH/2 - 120, SCREEN_HEIGHT - 100, 20, rl::RAYWHITE);
            rl::EndDrawing();
        }
        
        // --- WORLD SELECT STATE ---
        else if current_state == STATE_WORLD_SELECT {
            let selected_world: char[128];
            let selected_seed: char[64];
            let res = update_and_draw_world_select(selected_world, selected_seed);
            
            if res == 1 {
                // User picked a world, commence loading!
                current_state = STATE_LOADING;
                for i in 0..MAX_CHUNKS { chunks[i].x = -9999; chunks[i].z = -9999; chunks[i].mesh_built = 0; }
                
                // Force stop all music immediately to avoid audio stutter running during heavy blocking load
                rl::StopMusicStream(menu_music);
                rl::StopMusicStream(day_music);
                rl::StopMusicStream(night_music);
                current_music_playing = 0;
                fade_target_music = 0;
                fade_state = 0;
                fade_vol = 0.0;
                
                // Set directory and seed (if new world)
                set_game_world_dir(selected_world);
                set_game_world_seed(selected_world, selected_seed);
                
                rl::BeginDrawing();
                rl::ClearBackground(rl::BLACK);
                rl::DrawText("LOADING WORLD...", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2, 20, rl::WHITE);
                rl::EndDrawing();
                continue;
            } else if res == -1 {
                // User clicked BACK
                current_state = STATE_TITLE;
            }
        }
        
        // --- LOADING STATE ---
        else if current_state == STATE_LOADING {
            process_loading_step(chunks, draw_distance);
            draw_loading_screen();
            
            if loading_is_done == 1 {
                let px = load_start_x; let py = load_start_y; let pz = load_start_z;
                let pb = 1; let pyaw = load_start_yaw; let ppitch = load_start_pitch;
                
                let zibis_save: ZibiSaveData[64];
                let has_save = load_player_data(&px, &py, &pz, &pb, &pyaw, &ppitch, &wave_number, &wave_spawned_today, &day_time, &zibis_save);
                if has_save == 0 { py = 64.0; } else {
                    // Restore Zibis
                    for zi in 0..MAX_ZIBIS {
                        zibis[zi].active = zibis_save[zi].active;
                        zibis[zi].state = zibis_save[zi].state;
                        zibis[zi].hp = zibis_save[zi].hp;
                        zibis[zi].x = zibis_save[zi].x;
                        zibis[zi].y = zibis_save[zi].y;
                        zibis[zi].z = zibis_save[zi].z;
                        zibis[zi].vx = zibis_save[zi].vx;
                        zibis[zi].vz = zibis_save[zi].vz;
                        zibis[zi].yaw = zibis_save[zi].yaw;
                        zibis[zi].state_timer = zibis_save[zi].state_timer;
                        zibis[zi].work_timer = zibis_save[zi].work_timer;
                        zibis[zi].home_chunk_x = zibis_save[zi].home_chunk_x;
                        zibis[zi].home_chunk_z = zibis_save[zi].home_chunk_z;
                        zibis[zi].obelisk_idx = zibis_save[zi].obelisk_idx;
                        zibis[zi].mine_banner_x = zibis_save[zi].mine_banner_x;
                        zibis[zi].mine_banner_y = zibis_save[zi].mine_banner_y;
                        zibis[zi].mine_banner_z = zibis_save[zi].mine_banner_z;
                        zibis[zi].mine_target_y = -999;

                        // Reset navigation-related transient fields so loaded zibis recompute routes
                        zibis[zi].path_len = 0; zibis[zi].path_idx = 0; zibis[zi].path_timer = 0.0;
                        zibis[zi].waypoint_target_x = 0; zibis[zi].waypoint_target_y = 0; zibis[zi].waypoint_target_z = 0;
                        zibis[zi].stuck_timer = 0.0; zibis[zi].last_stuck_check_x = zibis[zi].x; zibis[zi].last_stuck_check_z = zibis[zi].z;

                        zibis[zi].hurt_flash = 0.0;
                        zibis[zi].anim_time = 0.0;
                        zibis[zi].combat_target_x = 0.0;
                        zibis[zi].combat_target_z = 0.0;
                        zibis[zi].combat_timer = 0.0;
                        zibis[zi].attack_cooldown = 0.0;
                        zibis[zi].prev_state = 0;
                        zibis[zi].invincibility_timer = 0.0;
                        
                        // Re-assign obelisk target so workers don't wander off
                        if zibis[zi].active == 1 {
                            if zibis[zi].state == ZIBI_WORKER || zibis[zi].state == ZIBI_WALK_TO_OBELISK {
                                if zibis[zi].find_obelisk(chunks, MAX_CHUNKS) == 0 {
                                    zibis[zi].state = ZIBI_FOLLOW_PLAYER;
                                    zibis[zi].state_timer = 3.0;
                                }
                            }
                        }
                    }
                }
                
                p = Player::new(px, py, pz);
                p.yaw = pyaw; p.pitch = ppitch;
                selected_block = pb;
                
                // Regenerate waypoints for all loaded chunks to ensure they exist after load
                for ci in 0..MAX_CHUNKS {
                    if chunks[ci].x != -9999 {
                        build_chunk_waypoints(chunks, MAX_CHUNKS, ci);
                    }
                }
                
                current_state = STATE_GAME;
                rl::DisableCursor();
            }
            draw_loading_screen();
        }
        
        // --- GAME STATE ---
        else {
            let pcx = (int)floor(p.x / 16.0);
            let pcz = (int)floor(p.z / 16.0);
            let unload_dist = draw_distance + 2;
            
            // Unload chunks
            for i in 0..MAX_CHUNKS {
                if chunks[i].x != -9999 && chunks[i].locked == 0 {
                    let dist_x = abs(chunks[i].x - pcx); let dist_z = abs(chunks[i].z - pcz);
                    if dist_x > unload_dist || dist_z > unload_dist {
                         request_save_async(&chunks[i]);
                         chunks[i].x = -9999; chunks[i].z = -9999;
                         chunks[i].mesh_built = 0; chunks[i].mesh_dirty = 0;
                    }
                }
            }

            for i in 0..MAX_CHUNKS { if chunks[i].x != -9999 && chunks[i].locked == 0 { tick_chunk(&chunks[i], chunks, MAX_CHUNKS); } }

            let requests_this_frame = 0;
            let max_req = 4;
            
            // Spiral Chunk Loading
            for dist in 0..(draw_distance + 1) {
                if requests_this_frame >= max_req { break; }
                if dist == 0 {
                    let idx = get_chunk_index(pcx, pcz);
                    if chunks[idx].x != pcx || chunks[idx].z != pcz {
                        if is_chunk_pending(pcx, pcz) == 0 && chunks[idx].locked == 0 {
                            if chunks[idx].x != -9999 { request_save_async(&chunks[idx]); }
                            chunks[idx].x = -9999;
                            request_load_async(idx, pcx, pcz, 0);
                            requests_this_frame++;
                        }
                    }
                    continue;
                }
                
                for side in 0..4 {
                    for step in 0..(dist * 2) {
                        if requests_this_frame >= max_req { break; }
                        let dx = 0; let dz = 0;
                        if side == 0 { dx = -dist + step; dz = -dist; }
                        else if side == 1 { dx = dist; dz = -dist + step; }
                        else if side == 2 { dx = dist - step; dz = dist; }
                        else { dx = -dist; dz = dist - step; }
                        
                        let cx = pcx + dx; let cz = pcz + dz;
                        let idx = get_chunk_index(cx, cz);
                        
                        if chunks[idx].x != cx || chunks[idx].z != cz {
                            if is_chunk_pending(cx, cz) == 0 && chunks[idx].locked == 0 {
                                if chunks[idx].x != -9999 { request_save_async(&chunks[idx]); }
                                chunks[idx].x = -9999;
                                request_load_async(idx, cx, cz, 0);
                                requests_this_frame++;
                            }
                        }
                    }
                }
            }
            
            if first_frame == 1 { init_particles(); first_frame = 0; }
            poll_async_results();
            update_particles(dt);
            update_fireballs(dt, chunks, MAX_CHUNKS, &wolves[0], MAX_WOLVES, &zibis[0], MAX_ZIBIS);
            update_obelisks(chunks, MAX_CHUNKS, dt);
            
            let mesh_requests = 0;
            for i in 0..MAX_CHUNKS {
                if mesh_requests >= 32 { break; }
                if chunks[i].x != -9999 && chunks[i].mesh_dirty != 0 && chunks[i].locked == 0 {
                    if request_mesh_async(i, 0) == 1 { mesh_requests++; }
                }
            }
            
            for i in 0..MAX_CHUNKS {
                 if chunks[i].x != -9999 && chunks[i].mesh_built != 0 && chunks[i].grass_deco_built == 0 {
                      if grass_dist > 0.0 { build_grass_decorations(&chunks[i], chunks, MAX_CHUNKS); }
                 }
            }
            
            if rl::IsKeyPressed(rl::KEY_ESCAPE) {
                if show_spellbook == 1 { show_spellbook = 0; rl::DisableCursor(); }
                else if show_settings == 1 { show_settings = 0; rl::DisableCursor(); }
                else if is_chest_ui_open() == 1 { /* handled in chest_ui close logic */ rl::DisableCursor(); }
                else if is_scepter_ui_open() == 1 { /* handled in inventory_ui close logic */ rl::DisableCursor(); }
                else if is_banner_ui_open() == 1 { /* handled in banner_ui close logic */ rl::DisableCursor(); }
                else if show_exit_confirm == 1 { show_exit_confirm = 0; rl::DisableCursor(); }
                else { show_exit_confirm = 1; rl::EnableCursor(); }
            }
            if show_exit_confirm == 1 {
                if rl::IsKeyPressed(rl::KEY_ENTER) {
                    break;
                }
            }
            
            if rl::IsKeyPressed(rl::KEY_E) {
                if show_exit_confirm == 0 && is_chest_ui_open() == 0 {
                    show_spellbook = !show_spellbook;
                    if show_spellbook { rl::EnableCursor(); } else { rl::DisableCursor(); }
                }
            }
            if rl::IsKeyPressed(rl::KEY_I) {
                if is_chest_ui_open() == 0 && show_spellbook == 0 && show_settings == 0 && is_banner_ui_open() == 0 && show_exit_confirm == 0 { // Don't allow overlapping UIs
                     toggle_scepter_ui();
                }
            }

            if show_settings == 0 && show_spellbook == 0 && is_scepter_ui_open() == 0 && is_chest_ui_open() == 0 && is_banner_ui_open() == 0 && show_exit_confirm == 0 {
                (&p).update(chunks, MAX_CHUNKS, dt);
            }
            
            let active_zibis = 0;
            let worker_count = 0;
            for i in 0..MAX_ZIBIS {
                if zibis[i].active == 1 {
                    active_zibis++;
                    if zibis[i].update(chunks, MAX_CHUNKS, dt, p.x, p.y, p.z, day_time, &wolves[0], MAX_WOLVES, &zibis[0], MAX_ZIBIS) == 0 { active_zibis--; }
                    if zibis[i].state == ZIBI_WORKER { worker_count++; }
                }
            }
            
            // --- Cage Break: Spawn freed Zibi ---
            if cage_break_pending == 1 {
                cage_break_pending = 0;
                let slot = -1;
                for i in 0..MAX_ZIBIS { if zibis[i].active == 0 { slot = i; break; } }
                if slot != -1 {
                    zibis[slot] = Zibi::new(cage_break_x, cage_break_y, cage_break_z, ZIBI_FREED);
                    spawn_explosion(cage_break_x, cage_break_y, cage_break_z, 15, rl::Color{r: 200, g: 255, b: 200, a: 200});
                }
            }

            // --- Wave-Based Night Spawning ---
            let is_night = (day_time > 0.5);  // Night is second half of day cycle
            
            let active_wolves = 0;
            for wi in 0..MAX_WOLVES { if wolves[wi].active == 1 { active_wolves++; } }
            
            // Detect night start: spawn wave
            if is_night && was_night == 0 {
                // Night just started! Spawn a wave.
                wave_number++;
                wave_spawned_today = 1;
                
                // Find highest obelisk level
                let max_obelisk_level = 0;
                for ci in 0..MAX_CHUNKS {
                    if chunks[ci].x == -9999 { continue; }
                    for si in 0..chunks[ci].obelisk_count {
                        if chunks[ci].obelisks[si].level > max_obelisk_level {
                            max_obelisk_level = chunks[ci].obelisks[si].level;
                        }
                    }
                }
                
                // Wave size: base 2 + obelisk_level * 1, capped at MAX_WOLVES
                let wave_size = 2 + max_obelisk_level;
                if wave_size > MAX_WOLVES { wave_size = MAX_WOLVES; }
                
                // Spawn all wolves at once in a ring around the player
                for ws in 0..wave_size {
                    let wolf_slot = -1;
                    for wi in 0..MAX_WOLVES { if wolves[wi].active == 0 { wolf_slot = wi; break; } }
                    if wolf_slot == -1 { break; } // No free slots
                    
                    let spawn_angle = ((float)ws / (float)wave_size) * 6.2832; // evenly distributed 360°
                    let spawn_dist = (float)rl::GetRandomValue(30, 50);
                    let sx = p.x + (float)cos(spawn_angle) * spawn_dist;
                    let sz = p.z + (float)sin(spawn_angle) * spawn_dist;
                    let wcx = (int)floor(sx / 16.0); let wcz = (int)floor(sz / 16.0);
                    let widx = get_chunk_index(wcx, wcz);
                    if chunks[widx].x == wcx && chunks[widx].z == wcz && chunks[widx].mesh_built == 1 {
                        let spawn_y = -1.0;
                        for sy_search in 0..CHUNK_HEIGHT {
                            let ry = (CHUNK_HEIGHT - 1) - sy_search;
                            let b = get_block(chunks, MAX_CHUNKS, (int)sx, ry, (int)sz);
                            if b != BLOCK_AIR && b != BLOCK_TALLGRASS && b != BLOCK_LEAVES && b != BLOCK_WATER {
                                spawn_y = (float)ry + 1.0;
                                break;
                            }
                        }
                        if spawn_y > 0.0 {
                            wolves[wolf_slot] = ShadowWolf::new(sx, spawn_y, sz);
                        }
                    }
                }
            }
            
            // Reset at dawn
            if !is_night && was_night == 1 {
                wave_spawned_today = 0;
            }
            was_night = is_night;
            
            // --- Update ShadowWolves ---
            for wi in 0..MAX_WOLVES {
                if wolves[wi].active == 1 {
                    let wolf_result = wolves[wi].update(chunks, MAX_CHUNKS, dt, p.x, p.y, p.z, day_time, draw_distance, &zibis[0], MAX_ZIBIS);
                    if wolf_result == 2 {
                        // Wolf hit the player!
                        p.health -= 5.0;
                        if p.health < 0.0 { p.health = 0.0; }
                    }
                }
            }
            
            if rl::IsKeyPressed(rl::KEY_F3) { show_debug_info = !show_debug_info; }
            if rl::IsKeyPressed(rl::KEY_F1) { 
                show_settings = !show_settings;
                if show_settings { rl::EnableCursor(); } else { rl::DisableCursor(); }
            }
            
            day_time = day_time + (dt / 2400.0); // 2400 seconds total for a full day+night cycle
            if day_time > 1.0 { day_time = day_time - 1.0; }
            update_day_night_cycle(day_time);
            
            let wind_time = (float)rl::GetTime();
            update_frame_uniforms(p.camera.position, wind_time);
            
            rl::BeginDrawing();
            
            let sky_r = 0; let sky_g = 0; let sky_b = 5;
            if day_time < 0.166 { let t = day_time / 0.166; sky_r = (int)(135.0 * t); sky_g = (int)(206.0 * t); sky_b = (int)(5.0 * (1.0 - t) + 235.0 * t); }
            else if day_time < 0.5 { sky_r = 135; sky_g = 206; sky_b = 235; }
            else if day_time < 0.666 { let t = (day_time - 0.5) / 0.166; sky_r = (int)(135.0 * (1.0 - t)); sky_g = (int)(206.0 * (1.0 - t)); sky_b = (int)(235.0 * (1.0 - t) + 5.0 * t); }

            rl::ClearBackground(rl::Color{r: sky_r, g: sky_g, b: sky_b, a: 255});
            draw_sky(p.camera, day_time); draw_clouds(p.camera, wind_time, day_time);
    
            // --- Begin bloom scene capture ---
            bloom_begin();
            rl::ClearBackground(rl::Color{r: sky_r, g: sky_g, b: sky_b, a: 255});
            draw_sky(p.camera, day_time); draw_clouds(p.camera, wind_time, day_time);
    
            rl::BeginMode3D(p.camera);
            raw { rlDisableBackfaceCulling(); rlEnableDepthTest(); rlSetBlendMode(BLEND_ALPHA); }
    
            let builds_in_frame = 0;
            let cam_fx = p.camera.target.x - p.camera.position.x; let cam_fz = p.camera.target.z - p.camera.position.z;
            let cam_len = sqrt(cam_fx * cam_fx + cam_fz * cam_fz);
            if cam_len > 0.001 { cam_fx = cam_fx / cam_len; cam_fz = cam_fz / cam_len; }
            
            // --- Collect Crystal Light Positions ---
            let crystal_points: float[48]; // 16 * 3 (vec3 array for shader)
            let crystal_count = 0;
            
            for i in 0..MAX_CHUNKS {
                let c = &chunks[i];
                if c.x != -9999 {
                    let dist_x = abs(c.x - pcx); let dist_z = abs(c.z - pcz);
                    if dist_x <= draw_distance && dist_z <= draw_distance && crystal_count < 16 {
                         for s in 0..c.obelisk_count {
                              if crystal_count >= 16 { break; }
                              // Position of the glowing crystal float
                              crystal_points[crystal_count * 3 + 0] = (float)(c.x * 16) + c.obelisks[s].x;
                              crystal_points[crystal_count * 3 + 1] = c.obelisks[s].y + 1.2;
                              crystal_points[crystal_count * 3 + 2] = (float)(c.z * 16) + c.obelisks[s].z;
                              crystal_count++;
                         }
                    }
                }
            }
            
            // Send to lighting shader
            let sh_light = get_shader_lighting();
            let loc_c_pts = get_loc_crystal_points();
            let loc_c_cnt = get_loc_crystal_count();
            if loc_c_cnt != -1 { rl::SetShaderValue(sh_light, loc_c_cnt, &crystal_count, rl::SHADER_UNIFORM_INT); }
            if loc_c_pts != -1 && crystal_count > 0 { rl::SetShaderValueV(sh_light, loc_c_pts, &crystal_points[0], rl::SHADER_UNIFORM_VEC3, crystal_count); }
            
            // Send to grass shader
            let sh_grass_fx = get_shader_grass();
            let loc_g_c_pts = get_loc_grass_crystal_points();
            let loc_g_c_cnt = get_loc_grass_crystal_count();
            if loc_g_c_cnt != -1 { rl::SetShaderValue(sh_grass_fx, loc_g_c_cnt, &crystal_count, rl::SHADER_UNIFORM_INT); }
            if loc_g_c_pts != -1 && crystal_count > 0 { rl::SetShaderValueV(sh_grass_fx, loc_g_c_pts, &crystal_points[0], rl::SHADER_UNIFORM_VEC3, crystal_count); }
            
            for i in 0..MAX_CHUNKS {
                let c = &chunks[i];
                if c.x != -9999 {
                    let dist_x = abs(c.x - pcx); let dist_z = abs(c.z - pcz);
                    if dist_x <= draw_distance && dist_z <= draw_distance {
                        if dist_x > 1 || dist_z > 1 {
                            let chunk_cx = (float)(c.x * 16 + 8) - p.camera.position.x; let chunk_cz = (float)(c.z * 16 + 8) - p.camera.position.z;
                            let chunk_dist = sqrt(chunk_cx * chunk_cx + chunk_cz * chunk_cz);
                            if chunk_dist > 0.001 { if ((cam_fx * chunk_cx + cam_fz * chunk_cz) / chunk_dist) < -0.2 { continue; } }
                        }
                        c.draw_opaque(chunks, MAX_CHUNKS, &builds_in_frame, 1, p.x, p.z);
                    }
                    
                    // Render Skulls
                    if dist_x <= draw_distance && dist_z <= draw_distance {
                         if c.skull_count > 0 {
                             let model = get_model_skull();
                             
                             let sh = get_shader_lighting();
                             rl::BeginShaderMode(sh);
                             
                             

                             let loc_entity_light = rl::GetShaderLocation(sh, "uEntityLight");
                             let loc_use_entity   = rl::GetShaderLocation(sh, "uUseEntityLight");
        
                             let use_ent = 1;
                             if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                             
                             for s in 0..c.skull_count {
                                 let pos = rl::Vector3{x: (float)(c.x * 16) + c.skulls[s].x, y: c.skulls[s].y + 0.1, z: (float)(c.z * 16) + c.skulls[s].z};
                                 
                                 let lx = (int)floor(pos.x); let ly = (int)floor(pos.y); let lz = (int)floor(pos.z);
                                 let packed_light = get_light_levels(chunks, MAX_CHUNKS, lx, ly, lz);
                                 
                                 let el = rl::Vector2{x: (float)(packed_light & 0xF) / 15.0, y: (float)((packed_light >> 4) & 0xF) / 15.0};
                                 if loc_entity_light != -1 { rl::SetShaderValue(sh, loc_entity_light, &el, rl::SHADER_UNIFORM_VEC2); }
                                 
                                 rl::DrawModelEx(model, pos, rl::Vector3{x: 0.0, y: 1.0, z: 0.0}, c.skulls[s].rotation, rl::Vector3{x: 1.0, y: 1.0, z: 1.0}, rl::WHITE);
                             }
                             
                             rl::EndShaderMode();
                             
                             use_ent = 0;
                             if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                        }
                    }

                    // Render Obelisks
                    if dist_x <= draw_distance && dist_z <= draw_distance {
                         if c.obelisk_count > 0 {
                             let model_base = get_model_obelisco_base();
                             let model_cristal = get_model_obelisco_cristal();
                             
                             let sh = get_shader_lighting();
                             rl::BeginShaderMode(sh);
                             
                             let loc_entity_light = rl::GetShaderLocation(sh, "uEntityLight");
                             let loc_use_entity   = rl::GetShaderLocation(sh, "uUseEntityLight");
                             
                             let sh_c = get_shader_crystal();
                             let loc_c_entity_light = rl::GetShaderLocation(sh_c, "uEntityLight");
                             let loc_c_use_entity   = rl::GetShaderLocation(sh_c, "uUseEntityLight");
        
                             let use_ent = 1;
                             if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                             if loc_c_use_entity != -1 { rl::SetShaderValue(sh_c, loc_c_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                             
                             let time_now = (float)rl::GetTime();
                             
                             for s in 0..c.obelisk_count {
                                 let pos = rl::Vector3{x: (float)(c.x * 16) + c.obelisks[s].x, y: c.obelisks[s].y, z: (float)(c.z * 16) + c.obelisks[s].z};
                                 
                                 let lx = (int)floor(pos.x); let ly = (int)floor(pos.y); let lz = (int)floor(pos.z);
                                 let packed_light = get_light_levels(chunks, MAX_CHUNKS, lx, ly, lz);
                                 
                                 let el = rl::Vector2{x: (float)(packed_light & 0xF) / 15.0, y: (float)((packed_light >> 4) & 0xF) / 15.0};
                                 if loc_entity_light != -1 { rl::SetShaderValue(sh, loc_entity_light, &el, rl::SHADER_UNIFORM_VEC2); }
                                 if loc_c_entity_light != -1 { rl::SetShaderValue(sh_c, loc_c_entity_light, &el, rl::SHADER_UNIFORM_VEC2); }
                                 
                                 rl::DrawModelEx(model_base, pos, rl::Vector3{x: 0.0, y: 1.0, z: 0.0}, 0.0, rl::Vector3{x: 1.0, y: 1.0, z: 1.0}, rl::WHITE);
                                 
                                 // Rotar en el eje Y (vertical) y hacer que flote arriba y abajo
                                 let hover_offset = (float)sin(time_now * 2.0 + (pos.x + pos.z)) * 0.15;
                                 let spin_angle = time_now * 50.0 + (pos.x + pos.z) * 10.0; // grados
                                 
                                 let cristal_pos = pos;
                                 cristal_pos.y = pos.y + 0.2 + hover_offset;
                                 
                                 // Check if this crystal is being recharged
                                 let emission_val: float = 0.0;
                                 
                                 let rx = get_recharge_target_x();
                                 let ry = get_recharge_target_y();
                                 let rz = get_recharge_target_z();
                                 
                                 let bcx = c.x * 16 + (int)c.obelisks[s].x;
                                 let bcy = (int)c.obelisks[s].y;
                                 let bcz = c.z * 16 + (int)c.obelisks[s].z;
                                 
                                 if bcx == rx && bcy == ry && bcz == rz {
                                     let r_timer = get_recharge_timer();
                                     emission_val = r_timer * 1.5;
                                     if emission_val > 2.0 { emission_val = 2.0; } // Max brightness limit
                                 }
                                 
                                 let loc_em = get_loc_emission();
                                 if loc_em != -1 { rl::SetShaderValue(sh, loc_em, &emission_val, rl::SHADER_UNIFORM_FLOAT); }
                                 let loc_c_em = get_loc_crystal_emission();
                                 if loc_c_em != -1 { rl::SetShaderValue(sh_c, loc_c_em, &emission_val, rl::SHADER_UNIFORM_FLOAT); }
                                 
                                 rl::DrawModelEx(model_cristal, cristal_pos, rl::Vector3{x: 0.0, y: 1.0, z: 0.0}, spin_angle, rl::Vector3{x: 1.0, y: 1.0, z: 1.0}, rl::WHITE);
                                 
                                 // Reset emission for next draw calls
                                 emission_val = 0.0;
                                 if loc_em != -1 { rl::SetShaderValue(sh, loc_em, &emission_val, rl::SHADER_UNIFORM_FLOAT); }
                                 if loc_c_em != -1 { rl::SetShaderValue(sh_c, loc_c_em, &emission_val, rl::SHADER_UNIFORM_FLOAT); }
                             }
                             
                             rl::EndShaderMode();
                             
                             use_ent = 0;
                             if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                             if loc_c_use_entity != -1 { rl::SetShaderValue(sh_c, loc_c_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                        }
                    }
                }
            }
            
            for i in 0..MAX_CHUNKS {
                let c = &chunks[i];
                if c.x != -9999 {
                    let dist_x = abs(c.x - pcx); let dist_z = abs(c.z - pcz);
                    if dist_x <= draw_distance && dist_z <= draw_distance {
                        if dist_x > 1 || dist_z > 1 {
                            let chunk_cx = (float)(c.x * 16 + 8) - p.camera.position.x; let chunk_cz = (float)(c.z * 16 + 8) - p.camera.position.z;
                            let chunk_dist = sqrt(chunk_cx * chunk_cx + chunk_cz * chunk_cz);
                            if chunk_dist > 0.001 { if ((cam_fx * chunk_cx + cam_fz * chunk_cz) / chunk_dist) < -0.2 { continue; } }
                        }
                       c.draw_transparent(chunks, MAX_CHUNKS, (int)p.x, (int)p.z, grass_dist);
                    }
                }
            }

            // Debug: draw chunk waypoints as small pegs when F3 debug view is enabled
            if show_debug_info {
                for i in 0..MAX_CHUNKS {
                    let c = &chunks[i];
                    if c.x == -9999 { continue; }
                    let dist_x = abs(c.x - pcx); let dist_z = abs(c.z - pcz);
                    if dist_x > draw_distance || dist_z > draw_distance { continue; }
                    for wi in 0..c.waypoint_count {
                        let wp = c.waypoints[wi];
                        // small vertical peg slightly sunk into ground
                        rl::DrawCube(rl::Vector3{x: (float)wp.x + 0.5, y: (float)wp.y + 0.02, z: (float)wp.z + 0.5}, 0.2, 0.04, 0.2, rl::Color{r:255, g:200, b:0, a:220});
                        rl::DrawCubeWires(rl::Vector3{x: (float)wp.x + 0.5, y: (float)wp.y + 0.02, z: (float)wp.z + 0.5}, 0.2, 0.04, 0.2, rl::BLACK);
                    }
                }
            }
            // Debug: per-zibi waypoint & path visualization
            for zi in 0..MAX_ZIBIS {
                let zb = &zibis[zi];
                if zb.active == 0 { continue; }
                // Show current waypoint target for WALK_TO_OBELISK state
                if zb.state == ZIBI_WALK_TO_OBELISK {
                    if !(zb.waypoint_target_x == 0 && zb.waypoint_target_y == 0 && zb.waypoint_target_z == 0) {
                        let wx = (float)zb.waypoint_target_x + 0.5;
                        let wy = (float)zb.waypoint_target_y + 0.5;
                        let wz = (float)zb.waypoint_target_z + 0.5;
                        rl::DrawCube(rl::Vector3{x: wx, y: wy, z: wz}, 0.35, 0.35, 0.35, rl::Color{r:0, g:220, b:0, a:200});
                        rl::DrawCubeWires(rl::Vector3{x: wx, y: wy, z: wz}, 0.35, 0.35, 0.35, rl::BLACK);
                        rl::DrawLine3D(rl::Vector3{x: zb.x, y: zb.y + 0.5, z: zb.z}, rl::Vector3{x: wx, y: wy, z: wz}, rl::Color{r:0, g:180, b:0, a:180});
                    }
                    // Draw A* path points if any
                    for pi in zb.path_idx..zb.path_len {
                        let pp = (&zb.path[0])[pi];
                        let px = (float)pp.x + 0.5; let py = (float)pp.y + 0.02; let pz = (float)pp.z + 0.5;
                        rl::DrawCube(rl::Vector3{x: px, y: py, z: pz}, 0.18, 0.04, 0.18, rl::Color{r:50, g:150, b:255, a:200});
                        rl::DrawCubeWires(rl::Vector3{x: px, y: py, z: pz}, 0.18, 0.04, 0.18, rl::BLACK);
                    }
                }
            }
            
            for i in 0..MAX_ZIBIS { zibis[i].draw(chunks, MAX_CHUNKS, day_time); }
            for wi in 0..MAX_WOLVES { wolves[wi].draw(chunks, MAX_CHUNKS, day_time); }
            draw_chests_3d(chunks, MAX_CHUNKS, day_time);
            draw_banners_3d(chunks, MAX_CHUNKS, day_time);
            draw_cages_3d(chunks, MAX_CHUNKS, day_time);
            draw_particles();
            draw_fireballs();
            
            if show_settings == 0 && show_spellbook == 0 && is_chest_ui_open() == 0 && is_scepter_ui_open() == 0 && is_banner_ui_open() == 0 && show_exit_confirm == 0 {
                // --- Hotbar Input ---
                // Keys 1-7
                if rl::IsKeyPressed(49) { spellbook.hotbar_selected = 0; } // KEY_ONE
                if rl::IsKeyPressed(50) { spellbook.hotbar_selected = 1; } // KEY_TWO
                if rl::IsKeyPressed(51) { spellbook.hotbar_selected = 2; } // KEY_THREE
                if rl::IsKeyPressed(52) { spellbook.hotbar_selected = 3; } // KEY_FOUR
                if rl::IsKeyPressed(53) { spellbook.hotbar_selected = 4; } // KEY_FIVE
                if rl::IsKeyPressed(54) { spellbook.hotbar_selected = 5; } // KEY_SIX
                if rl::IsKeyPressed(55) { spellbook.hotbar_selected = 6; } // KEY_SEVEN
                
                // Mouse wheel scroll
                let wheel = rl::GetMouseWheelMove();
                if wheel > 0.0 {
                    spellbook.hotbar_selected = spellbook.hotbar_selected - 1;
                    if spellbook.hotbar_selected < 0 { spellbook.hotbar_selected = 6; }
                }
                if wheel < 0.0 {
                    spellbook.hotbar_selected = spellbook.hotbar_selected + 1;
                    if spellbook.hotbar_selected > 6 { spellbook.hotbar_selected = 0; }
                }
                
                // Wire selected_spell from hotbar
                let hotbar_spell = spellbook.hotbar[spellbook.hotbar_selected];
                if hotbar_spell >= 0 {
                    spellbook.selected_spell = hotbar_spell;
                }
                
                handle_player_interaction(&p, chunks, dt, selected_block, spellbook.selected_spell, &wolves[0], MAX_WOLVES, &zibis[0], MAX_ZIBIS);
            }
            
            rl::EndMode3D();
            
            // --- End bloom scene capture and composite ---
            bloom_end_and_draw();
            
            (&p).draw_arm((float)rl::GetTime());
            draw_obelisk_ui(chunks, MAX_CHUNKS, &zibis[0], MAX_ZIBIS, p.camera);
            
            // Draw Entity HP Bars
            for i in 0..MAX_ZIBIS {
                if zibis[i].active == 1 && zibis[i].hp < 30 {
                   let ui_pos = rl::Vector3{x: zibis[i].x, y: zibis[i].y + 1.2, z: zibis[i].z};
                   let dx = ui_pos.x - p.camera.position.x; let dy = ui_pos.y - p.camera.position.y; let dz = ui_pos.z - p.camera.position.z;
                   let fwd_x = p.camera.target.x - p.camera.position.x; let fwd_y = p.camera.target.y - p.camera.position.y; let fwd_z = p.camera.target.z - p.camera.position.z;
                   if (dx*fwd_x + dy*fwd_y + dz*fwd_z) > 0.0 {
                       let screen_pos = rl::GetWorldToScreenEx(ui_pos, p.camera, SCREEN_WIDTH, SCREEN_HEIGHT);
                       let pct = (float)zibis[i].hp / 30.0;
                       if pct < 0.0 { pct = 0.0; }
                       let bw = 40; let bh = 6;
                       let bx = (int)screen_pos.x - bw/2; let by = (int)screen_pos.y;
                       rl::DrawRectangle(bx, by, bw, bh, rl::RED);
                       rl::DrawRectangle(bx, by, (int)((float)bw * pct), bh, rl::GREEN);
                   }
                }
            }
            for i in 0..MAX_WOLVES {
                if wolves[i].active == 1 && wolves[i].hp < 50 { // WOLF_HP isn't exported globally easily, hardcoded to 50
                   let ui_pos = rl::Vector3{x: wolves[i].x, y: wolves[i].y + 1.5, z: wolves[i].z};
                   let dx = ui_pos.x - p.camera.position.x; let dy = ui_pos.y - p.camera.position.y; let dz = ui_pos.z - p.camera.position.z;
                   let fwd_x = p.camera.target.x - p.camera.position.x; let fwd_y = p.camera.target.y - p.camera.position.y; let fwd_z = p.camera.target.z - p.camera.position.z;
                   if (dx*fwd_x + dy*fwd_y + dz*fwd_z) > 0.0 {
                       let screen_pos = rl::GetWorldToScreenEx(ui_pos, p.camera, SCREEN_WIDTH, SCREEN_HEIGHT);
                       let pct = (float)wolves[i].hp / 50.0;
                       if pct < 0.0 { pct = 0.0; }
                       let bw = 50; let bh = 8;
                       let bx = (int)screen_pos.x - bw/2; let by = (int)screen_pos.y;
                       rl::DrawRectangle(bx, by, bw, bh, rl::RED);
                       rl::DrawRectangle(bx, by, (int)((float)bw * pct), bh, rl::GREEN);
                   }
                }
            } // END OF MAX_WOLVES LOOP
            
            // HUD Layer
            
            let total_obelisks = get_total_obelisk_count(chunks, MAX_CHUNKS);
            if show_settings == 0 && show_exit_confirm == 0 {
                 draw_hud(&p, &spellbook, VERSION_TEXT, total_obelisks, day_time);
            }
            
            if show_debug_info { draw_debug_info(&p, chunks, dt, day_time, draw_distance, worker_count, active_wolves); }
            if show_settings { draw_settings_menu(&draw_distance, &grass_dist); }
            if show_spellbook { draw_spellbook(&spellbook, &selected_block, chunks, MAX_CHUNKS); }
            draw_chest_ui(chunks);
            let total_active_zibis = 0;
            for zi in 0..MAX_ZIBIS {
                if zibis[zi].active == 1 { total_active_zibis++; }
            }
            draw_banner_ui(chunks, MAX_CHUNKS, total_active_zibis);
            draw_scepter_ui();
            
            // --- Wave Counter HUD ---
            if wave_number > 0 {
                let screen_w = rl::GetScreenWidth();
                let wave_txt = rl::TextFormat("Wave %d", wave_number);
                let tw = rl::MeasureText(wave_txt, 24);
                let hx = screen_w - tw - 20;
                let hy = 15;
                
                // Background pill
                rl::DrawRectangle(hx - 10, hy - 5, tw + 20, 34, rl::Color{r: 20, g: 10, b: 30, a: 180});
                rl::DrawRectangleLines(hx - 10, hy - 5, tw + 20, 34, rl::Color{r: 180, g: 80, b: 80, a: 200});
                
                let wave_col = rl::Color{r: 255, g: 100, b: 100, a: 255};
                if active_wolves == 0 && is_night { wave_col = rl::Color{r: 100, g: 255, b: 100, a: 255}; } // Green if cleared
                rl::DrawText(wave_txt, hx, hy, 24, wave_col);
                
                // Show enemies remaining during night
                if is_night {
                    let enemies_txt = rl::TextFormat("Enemies: %d", active_wolves);
                    let etw = rl::MeasureText(enemies_txt, 16);
                    rl::DrawRectangle(screen_w - etw - 30, hy + 34, etw + 20, 24, rl::Color{r: 20, g: 10, b: 30, a: 150});
                    rl::DrawText(enemies_txt, screen_w - etw - 20, hy + 37, 16, rl::Color{r: 200, g: 200, b: 200, a: 220});
                }
            }

            // --- Exit Confirm Menu ---
            if show_exit_confirm == 1 {
                let screen_w = rl::GetScreenWidth();
                let screen_h = rl::GetScreenHeight();
                rl::DrawRectangle(0, 0, screen_w, screen_h, rl::Color{r: 0, g: 0, b: 0, a: 150});
                
                let box_w = 400; let box_h = 200;
                let box_x = (screen_w - box_w) / 2; let box_y = (screen_h - box_h) / 2;
                rl::DrawRectangle(box_x, box_y, box_w, box_h, rl::Color{r: 30, g: 30, b: 40, a: 240});
                rl::DrawRectangleLines(box_x, box_y, box_w, box_h, rl::GOLD);
                
                let text1 = "SALIR DEL JUEGO";
                let text2 = "Pulsa ENTER para confirmar";
                let text3 = "Pulsa ESCAPE para volver";
                
                rl::DrawText(text1, box_x + box_w/2 - rl::MeasureText(text1, 24)/2, box_y + 40, 24, rl::WHITE);
                rl::DrawText(text2, box_x + box_w/2 - rl::MeasureText(text2, 20)/2, box_y + 100, 20, rl::RED);
                rl::DrawText(text3, box_x + box_w/2 - rl::MeasureText(text3, 18)/2, box_y + 140, 18, rl::GRAY);
            }

            rl::EndDrawing();
        }
    }

    // Save all to disk at the end
    if current_state == STATE_GAME {
        let zibis_save: ZibiSaveData[64];
        for zi in 0..MAX_ZIBIS {
            zibis_save[zi].active = zibis[zi].active;
            zibis_save[zi].state = zibis[zi].state;
            zibis_save[zi].hp = zibis[zi].hp;
            zibis_save[zi].x = zibis[zi].x;
            zibis_save[zi].y = zibis[zi].y;
            zibis_save[zi].z = zibis[zi].z;
            zibis_save[zi].vx = zibis[zi].vx;
            zibis_save[zi].vz = zibis[zi].vz;
            zibis_save[zi].yaw = zibis[zi].yaw;
            zibis_save[zi].state_timer = zibis[zi].state_timer;
            zibis_save[zi].work_timer = zibis[zi].work_timer;
            zibis_save[zi].home_chunk_x = zibis[zi].home_chunk_x;
            zibis_save[zi].home_chunk_z = zibis[zi].home_chunk_z;
            zibis_save[zi].obelisk_idx = zibis[zi].obelisk_idx;
            zibis_save[zi].mine_banner_x = zibis[zi].mine_banner_x;
            zibis_save[zi].mine_banner_y = zibis[zi].mine_banner_y;
            zibis_save[zi].mine_banner_z = zibis[zi].mine_banner_z;
        }
        save_player_data(p.x, p.y, p.z, selected_block, p.yaw, p.pitch, wave_number, wave_spawned_today, day_time, &zibis_save);
        
        for i in 0..MAX_CHUNKS {
            if chunks[i].x != -9999 {
                 while get_pending_req_count() >= 250 {
                     rl::BeginDrawing(); rl::ClearBackground(rl::BLACK);
                     rl::DrawText("SAVING WORLD... QUEUE FULL", SCREEN_WIDTH/2 - 150, SCREEN_HEIGHT/2, 20, rl::WHITE);
                     rl::EndDrawing(); rl::WaitTime(0.01);
                 }
                request_save_async(&chunks[i]);
            }
        }
        
        let start_wait = rl::GetTime();
        while get_pending_req_count() > 0 && (rl::GetTime() - start_wait) < 5.0 {
            rl::BeginDrawing(); rl::ClearBackground(rl::BLACK);
            rl::DrawText("SAVING WORLD... DO NOT TURN OFF", SCREEN_WIDTH/2 - 150, SCREEN_HEIGHT/2, 20, rl::WHITE);
            rl::DrawText(rl::TextFormat("Pending: %d", get_pending_req_count()), SCREEN_WIDTH/2 - 50, SCREEN_HEIGHT/2 + 30, 20, rl::GRAY);
            rl::EndDrawing(); rl::WaitTime(0.01);
        }
    }
}