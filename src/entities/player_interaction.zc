//> Player Interactions & Scepter Mechanics
import "raylib.h" as rl;
import "rlgl.h";
import "math.h";
import "../entities/player.zc";
import "../world/chunk_core.zc";
import "../world/blocks.zc";
import "../world/raycast.zc";
import "../render/particles.zc";
import "../render/rendering.zc";
import "../world/persistence.zc";

extern fn get_total_obelisk_count(chunks: Chunk*, num_chunks: int) -> int;
extern fn get_snd_rayo_start() -> rl::Sound;
extern fn get_snd_rayo_loop() -> rl::Sound;
extern fn get_snd_rayo_end() -> rl::Sound;
extern fn get_sfx_vol() -> float;

let beam_sound_playing: int = 0;

let destroy_timer: float = 0.0;
let destroy_target_x: int = -999;
let destroy_target_y: int = -999;
let destroy_target_z: int = -999;
let recharge_timer: float = 0.0;
let recharge_target_x: int = -999;
let recharge_target_y: int = -999;
let recharge_target_z: int = -999;

fn get_recharge_timer() -> float { return recharge_timer; }
fn get_recharge_target_x() -> int { return recharge_target_x; }
fn get_recharge_target_y() -> int { return recharge_target_y; }
fn get_recharge_target_z() -> int { return recharge_target_z; }

fn handle_player_interaction(p: Player*, chunks: Chunk*, dt: float, selected_block: int, selected_spell: int, wolves: ShadowWolf*, max_wolves: int, zibis: Zibi*, max_zibis: int) {
    // --- Passive Mana Regeneration (0.5 mana/s when not using beam) ---
    if destroy_timer <= 0.0 && recharge_timer <= 0.0 {
        p.mana = p.mana + 0.5 * dt;
        if p.mana > 100.0 { p.mana = 100.0; }
    }
    
    let screen_center = rl::Vector2{ x: (float)rl::GetScreenWidth() / 2.0, y: (float)rl::GetScreenHeight() / 2.0 };
    let pick_ray = rl::GetScreenToWorldRay(screen_center, p.camera);

    let hit = raycast(chunks, MAX_CHUNKS, pick_ray.position.x, pick_ray.position.y, pick_ray.position.z, 
                      pick_ray.direction.x, pick_ray.direction.y, pick_ray.direction.z, 12.0);
                      
    // --- Fireball Launch (works even without block hit) ---
    if rl::IsMouseButtonPressed(rl::MOUSE_BUTTON_RIGHT) && selected_spell == 1 {
        if p.mana >= get_fireball_mana_cost() {
            p.mana = p.mana - get_fireball_mana_cost();
            spawn_fireball(1, pick_ray.position.x, pick_ray.position.y, pick_ray.position.z,
                           pick_ray.direction.x, pick_ray.direction.y, pick_ray.direction.z);
        }
    }
    
    // --- Banner UI Interaction ---
    // (Removed from here, moved to the main block interaction area)

    if hit.hit != 0 {
        let hx = (float)hit.x; let hy = (float)hit.y; let hz = (float)hit.z;
        rl::DrawCubeWires(rl::Vector3{x: hx + 0.5, y: hy + 0.5, z: hz + 0.5}, 1.01, 1.01, 1.01, rl::BLACK);
        
        if rl::IsMouseButtonDown(rl::MOUSE_BUTTON_LEFT) {
            let b_hit = get_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z);
            let base_x = hit.x; let base_y = hit.y; let base_z = hit.z;
            
            // If we hit the invisible crystal, find the base
            if b_hit == BLOCK_POWER_CRYSTAL {
                 let below1 = get_block(chunks, MAX_CHUNKS, hit.x, hit.y - 1, hit.z);
                 if below1 == BLOCK_OBELISK { base_y = hit.y - 1; }
                 else {
                     let below2 = get_block(chunks, MAX_CHUNKS, hit.x, hit.y - 2, hit.z);
                     if below2 == BLOCK_OBELISK { base_y = hit.y - 2; }
                 }
            } else if b_hit == BLOCK_OBELISK {
                base_y = hit.y;
            }
            
            let is_power_source = 0;
            if b_hit == BLOCK_OBELISK || b_hit == BLOCK_POWER_CRYSTAL {
                is_power_source = 1;
            }

            if is_power_source == 1 {
                destroy_timer = 0.0; destroy_target_x = -999;
                if hit.x == recharge_target_x && base_y == recharge_target_y && hit.z == recharge_target_z {
                    recharge_timer = recharge_timer + dt;
                } else {
                    recharge_target_x = hit.x; recharge_target_y = base_y; recharge_target_z = hit.z;
                    recharge_timer = 0.0;
                }

                let actual_drain = 0.0;
                let bcx = (int)floor((float)recharge_target_x / 16.0);
                let bcz = (int)floor((float)recharge_target_z / 16.0);
                let bidx = get_chunk_index(bcx, bcz);
                
                if chunks[bidx].x == bcx && chunks[bidx].z == bcz {
                    for si in 0..chunks[bidx].obelisk_count {
                        let rel_x = recharge_target_x - (bcx * 16);
                        let rel_z = recharge_target_z - (bcz * 16);
                        if (int)chunks[bidx].obelisks[si].x == rel_x && 
                           (int)chunks[bidx].obelisks[si].y == recharge_target_y && 
                           (int)chunks[bidx].obelisks[si].z == rel_z {
                            
                            let drain = 30.0 * dt;
                            let c_max_drain = 100.0 - p.mana;
                            if drain > c_max_drain { drain = c_max_drain; }
                            
                            let c_mana = chunks[bidx].obelisks[si].mana;
                            if c_mana >= drain {
                                c_mana -= drain;
                                actual_drain = drain;
                            } else {
                                actual_drain = c_mana;
                                c_mana = 0.0;
                            }
                            chunks[bidx].obelisks[si].mana = c_mana;
                            break;
                        }
                    }
                }
                
                if actual_drain > 0.0 {
                    p.mana = p.mana + actual_drain;
                    if p.mana > 100.0 { p.mana = 100.0; }
                }
                
                let s_vol = get_sfx_vol();
                if beam_sound_playing == 0 {
                    rl::SetSoundVolume(get_snd_rayo_start(), s_vol);
                    rl::PlaySound(get_snd_rayo_start());
                    beam_sound_playing = 1;
                }
                if !rl::IsSoundPlaying(get_snd_rayo_loop()) {
                    rl::SetSoundVolume(get_snd_rayo_loop(), s_vol);
                    rl::PlaySound(get_snd_rayo_loop());
                }
                
                // --- Recharge Beam Animation ---
                let cam_origin = p.camera.position;
                let start_pos = cam_origin;
                
                let cy = (float)cos(p.yaw); let sy = (float)sin(p.yaw);
                let cp = (float)cos(p.pitch); let sp = (float)sin(p.pitch);
                
                let fx = cy * cp; let fz = sy * cp; let fy = -sp;
                let rx = -fz; let ry = 0.0; let rz = fx;
                let ux = -fx * fy; let uy = fx * fx + fz * fz; let uz = -fz * fy;
                
                let off_r = 0.5; let off_u = 0.28; let off_f = 0.8; 
                let time = (float)rl::GetTime();
                
                if p.vx != 0.0 || p.vz != 0.0 {
                    off_r = off_r + (float)cos(time * 10.0) * 0.02;
                    off_u = off_u + (float)sin(time * 10.0) * 0.03;
                }
                
                start_pos.x = start_pos.x + rx * off_r + ux * off_u + fx * off_f;
                start_pos.y = start_pos.y + ry * off_r + uy * off_u + fy * off_f;
                start_pos.z = start_pos.z + rz * off_r + uz * off_u + fz * off_f;
                
                // End pos is the floating crystal (top block)
                let end_pos: rl::Vector3;
                let hover_offset = (float)sin(time * 2.0 + ((float)base_x + 0.5 + (float)base_z + 0.5)) * 0.15;
                end_pos.x = (float)base_x + 0.5;
                end_pos.y = (float)base_y + 2.2 + hover_offset; // Target the top crystal block
                end_pos.z = (float)base_z + 0.5;

                // Mana Beam colors (Bright Cyan/Purple)
                let core_col = rl::Color{ r: 255, g: 255, b: 255, a: 255 };
                let outer_col = rl::Color{ r: 0, g: 255, b: 0, a: 180 };
                
                let sh_beam = get_shader_beam();
                rl::BeginShaderMode(sh_beam);
                let loc_time = rl::GetShaderLocation(sh_beam, "time");
                rl::SetShaderValue(sh_beam, loc_time, &time, rl::SHADER_UNIFORM_FLOAT);
                
                rl::rlSetBlendMode(rl::BLEND_ADDITIVE); 
                rl::rlDisableDepthMask();
                
                // 4-layer beam for bloom: wide glow → outer → inner → white hot core
                rl::DrawCylinderEx(start_pos, end_pos, 0.25, 0.30, 8, rl::Color{r: 0, g: 80, b: 0, a: 40});
                rl::DrawCylinderEx(start_pos, end_pos, 0.12, 0.18, 8, rl::Color{r: 0, g: 200, b: 50, a: 120});
                rl::DrawCylinderEx(start_pos, end_pos, 0.06, 0.10, 8, rl::Color{r: 100, g: 255, b: 100, a: 200});
                rl::DrawCylinderEx(start_pos, end_pos, 0.02, 0.03, 8, rl::Color{r: 255, g: 255, b: 255, a: 255});
                
                // Dense particle spawning along beam path
                let dx = end_pos.x - start_pos.x; let dy = end_pos.y - start_pos.y; let dz = end_pos.z - start_pos.z;
                for pi in 0..3 {
                    let t = (float)rl::GetRandomValue(0, 100) / 100.0;
                    let px = start_pos.x + dx * t + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.3;
                    let py = start_pos.y + dy * t + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.3;
                    let pz = start_pos.z + dz * t + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.3;
                    spawn_particle(px, py, pz, rl::Color{r: 50, g: 255, b: 100, a: 255});
                }
                
                // Impact burst at crystal
                if rl::GetRandomValue(0, 10) < 6 {
                    spawn_particle(end_pos.x + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.5, 
                                   end_pos.y + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.5, 
                                   end_pos.z + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.5, 
                                   rl::Color{r: 150, g: 255, b: 150, a: 255});
                }
                
                rl::rlEnableDepthMask();
                rl::rlSetBlendMode(rl::BLEND_ALPHA);
                rl::EndShaderMode();
            } else {
                recharge_timer = 0.0; recharge_target_x = -999;
                
                if p.mana >= 1.0 {
                    let s_vol = get_sfx_vol();
                    if beam_sound_playing == 0 {
                        rl::SetSoundVolume(get_snd_rayo_start(), s_vol);
                        rl::PlaySound(get_snd_rayo_start());
                        beam_sound_playing = 1;
                    }
                    // Loop is simulated by restarting it if it falls silent while active
                    if !rl::IsSoundPlaying(get_snd_rayo_loop()) {
                        rl::SetSoundVolume(get_snd_rayo_loop(), s_vol);
                        rl::PlaySound(get_snd_rayo_loop());
                    }
                    
                    if base_x == destroy_target_x && base_y == destroy_target_y && base_z == destroy_target_z {
                        destroy_timer = destroy_timer + dt;
                        // Continuous mana drain while beam is active (3 mana/sec)
                        p.mana = p.mana - 3.0 * dt;
                        if p.mana < 0.0 { p.mana = 0.0; }
                    } else {
                        destroy_target_x = base_x; destroy_target_y = base_y; destroy_target_z = base_z;
                        destroy_timer = 0.0;
                    }
                    
                    // --- Scepter Beam Animation ---
                    let cam_origin = p.camera.position;
                    let start_pos = cam_origin;
                    
                    let cy = (float)cos(p.yaw); let sy = (float)sin(p.yaw);
                    let cp = (float)cos(p.pitch); let sp = (float)sin(p.pitch);
                    
                    let fx = cy * cp; let fz = sy * cp; let fy = -sp;
                    let rx = -fz; let ry = 0.0; let rz = fx;
                    let ux = -fx * fy; let uy = fx * fx + fz * fz; let uz = -fz * fy;
                    
                    // Push the beam start further forward so it doesn't overlap the scepter rendering
                    let off_r = 0.5; let off_u = 0.28; let off_f = 0.8; 
                    let time = (float)rl::GetTime();
                    
                    if p.vx != 0.0 || p.vz != 0.0 {
                        off_r = off_r + (float)cos(time * 10.0) * 0.02;
                        off_u = off_u + (float)sin(time * 10.0) * 0.03;
                    }
                    
                    start_pos.x = start_pos.x + rx * off_r + ux * off_u + fx * off_f;
                    start_pos.y = start_pos.y + ry * off_r + uy * off_u + fy * off_f;
                    start_pos.z = start_pos.z + rz * off_r + uz * off_u + fz * off_f;
                    
                    let end_pos: rl::Vector3;
                    if hit.hit == 1 {
                        end_pos.x = cam_origin.x + fx * hit.distance;
                        end_pos.y = cam_origin.y + fy * hit.distance;
                        end_pos.z = cam_origin.z + fz * hit.distance;
                    } else {
                        end_pos.x = cam_origin.x + fx * 8.0;
                        end_pos.y = cam_origin.y + fy * 8.0;
                        end_pos.z = cam_origin.z + fz * 8.0;
                    }

                    // Beam core
                    let core_col = rl::Color{ r: 200, g: 255, b: 255, a: 255 };
                    let outer_col = rl::Color{ r: 0, g: 150, b: 255, a: 160 };
                    
                    let sh_beam = get_shader_beam();
                    rl::BeginShaderMode(sh_beam);
                    let loc_time = rl::GetShaderLocation(sh_beam, "time");
                    rl::SetShaderValue(sh_beam, loc_time, &time, rl::SHADER_UNIFORM_FLOAT);
                    
                    rl::rlSetBlendMode(rl::BLEND_ADDITIVE); 
                    rl::rlDisableDepthMask();
                    
                    // 4-layer beam: wide glow → outer → inner → white hot core  
                    rl::DrawCylinderEx(start_pos, end_pos, 0.20, 0.25, 8, rl::Color{r: 0, g: 60, b: 120, a: 30});
                    rl::DrawCylinderEx(start_pos, end_pos, 0.10, 0.15, 8, rl::Color{r: 0, g: 150, b: 255, a: 120});
                    rl::DrawCylinderEx(start_pos, end_pos, 0.04, 0.08, 8, rl::Color{r: 100, g: 220, b: 255, a: 200});
                    rl::DrawCylinderEx(start_pos, end_pos, 0.015, 0.03, 8, rl::Color{r: 255, g: 255, b: 255, a: 255});
                    
                    // Dense particle spawning along beam
                    let bdx = end_pos.x - start_pos.x; let bdy = end_pos.y - start_pos.y; let bdz = end_pos.z - start_pos.z;
                    if rl::GetRandomValue(0, 10) < 7 {
                        for pi in 0..2 {
                            let t = (float)rl::GetRandomValue(0, 100) / 100.0;
                            let bpx = start_pos.x + bdx * t + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.2;
                            let bpy = start_pos.y + bdy * t + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.2;
                            let bpz = start_pos.z + bdz * t + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.2;
                            spawn_particle(bpx, bpy, bpz, rl::Color{r: 100, g: 200, b: 255, a: 255});
                        }
                    }
                    
                    // Impact particles at target block
                    if hit.hit == 1 && rl::GetRandomValue(0, 10) < 6 {
                        spawn_particle(end_pos.x + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.4, 
                                       end_pos.y + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.4, 
                                       end_pos.z + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 0.4, 
                                       rl::Color{r: 200, g: 230, b: 255, a: 255});
                    }
                    
                    rl::rlEnableDepthMask();
                    rl::rlSetBlendMode(rl::BLEND_ALPHA);
                    rl::EndShaderMode();
                    
                    // --- Beam Damage to Entities ---
                    let beam_dmg = 5.0 * dt; // small DPS
                    for wi in 0..max_wolves {
                        let dx = wolves[wi].x - end_pos.x;
                        let dy = wolves[wi].y - end_pos.y;
                        let dz = wolves[wi].z - end_pos.z;
                        if (dx*dx + dy*dy + dz*dz) < 2.25 { wolves[wi].take_damage((int)beam_dmg + 1); }
                    }
                    for zi in 0..max_zibis {
                        let dx = zibis[zi].x - end_pos.x;
                        let dy = zibis[zi].y - end_pos.y;
                        let dz = zibis[zi].z - end_pos.z;
                        if (dx*dx + dy*dy + dz*dz) < 2.25 { /* zibis aren't hurt by friendly fire! */ }
                    }
                    
                    // --- Block Shake & Feedback (Fortnite Style) ---
                    let progress = destroy_timer / 3.0;
                    if progress > 1.0 { progress = 1.0; }
                    
                    let center_x = (float)hit.x + 0.5;
                    let center_y = (float)hit.y + 0.5;
                    let center_z = (float)hit.z + 0.5;
                    
                    // Fortnite-style hit impact: block physically shrinks and shakes violently
                    let pop_scale = 1.0;
                    if progress > 0.9 {
                        // Sudden expansion right before breaking
                        pop_scale = 1.0 + (progress - 0.9) * 5.0; 
                    } else {
                        // Shrinks as it's damaged
                        pop_scale = 1.0 - (progress * 0.4); 
                    }
                    
                    let hit_pulse = (float)sin(time * 50.0) * 0.05 * progress;
                    let final_scale = pop_scale + hit_pulse;
                    
                    let shake_amp = 0.05 * progress;
                    let shake_x = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * shake_amp;
                    let shake_y = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * shake_amp;
                    let shake_z = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * shake_amp;
                    
                    // Erratic rotations
                    let rot_x = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 20.0 * progress;
                    let rot_y = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 20.0 * progress;
                    let rot_z = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 20.0 * progress;

                    rl::rlSetBlendMode(rl::BLEND_ADDITIVE);
                    rl::rlDisableDepthMask();
                    rl::rlDisableBackfaceCulling();
                    
                    rlPushMatrix();
                    rlTranslatef(center_x + shake_x, center_y + shake_y, center_z + shake_z);
                    
                    // Apply rotations
                    rl::rlRotatef(rot_x, 1.0, 0.0, 0.0);
                    rl::rlRotatef(rot_y, 0.0, 1.0, 0.0);
                    rl::rlRotatef(rot_z, 0.0, 0.0, 1.0);
                    
                    rlScalef(final_scale, final_scale, final_scale);
                    
                    // High-energy impact core
                    let core_alpha = (char)(150.0 * progress + 105.0);
                    let in_col = rl::Color{ r: 255, g: (char)(255.0 * (1.0 - progress)), b: (char)(255.0 * (1.0 - progress)), a: core_alpha };
                    
                    // Draw shrinking/shaking solid block
                    rl::DrawCube(rl::Vector3{x:0.0, y:0.0, z:0.0}, 1.01, 1.01, 1.01, in_col);
                    
                    // Draw expanding wireframe hit-marker cage
                    let wire_scale = 1.0 + (progress * 0.5) + ((float)sin(time * 20.0) * 0.1);
                    let wire_col = rl::Color{ r: 255, g: 200, b: 0, a: (char)(255.0 * (1.0 - progress)) };
                    rl::DrawCubeWires(rl::Vector3{x:0.0, y:0.0, z:0.0}, wire_scale, wire_scale, wire_scale, wire_col);
                    
                    // Energy sparks bursting out
                    if progress > 0.2 && rl::GetRandomValue(0, 100) < (int)(progress * 40.0) {
                         let sx = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 2.0;
                         let sy = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 2.0;
                         let sz = (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5) * 2.0;
                         rl::DrawLine3D(rl::Vector3{x:0.0, y:0.0, z:0.0}, rl::Vector3{x:sx, y:sy, z:sz}, rl::Color{r: 255, g: 150, b: 0, a: 200});
                    }
                    
                    rlPopMatrix();
                    rl::rlEnableBackfaceCulling();
                    rl::rlEnableDepthMask();
                    rl::rlSetBlendMode(rl::BLEND_ALPHA);
                    
                    // Show physical block particles breaking off
                    if rl::GetRandomValue(0, 10) < (int)(progress * 5.0) + 1 {
                        spawn_particle(center_x + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5), 
                                       center_y + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5), 
                                       center_z + (((float)rl::GetRandomValue(0, 100) / 100.0) - 0.5), 
                                       rl::Color{r: 150, g: 150, b: 150, a: 200});
                    }

                    // --- Block Destroy Event ---
                    if destroy_timer > 3.0 {
                        spawn_explosion((float)hit.x + 0.5, (float)hit.y + 0.5, (float)hit.z + 0.5, 20, rl::Color{r: 150, g: 150, b: 150, a: 200});
                        
                        let fill_block = BLOCK_AIR;
                        let n_up = get_block(chunks, MAX_CHUNKS, hit.x, hit.y + 1, hit.z);
                        let n_n = get_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z + 1);
                        let n_s = get_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z - 1);
                        let n_e = get_block(chunks, MAX_CHUNKS, hit.x + 1, hit.y, hit.z);
                        let n_w = get_block(chunks, MAX_CHUNKS, hit.x - 1, hit.y, hit.z);
                        
                        if n_up == BLOCK_WATER || n_up == BLOCK_WATER_1 || n_up == BLOCK_WATER_2 || n_up == BLOCK_WATER_0 ||
                           n_n == BLOCK_WATER || n_n == BLOCK_WATER_1 || n_n == BLOCK_WATER_2 || n_n == BLOCK_WATER_0 ||
                           n_s == BLOCK_WATER || n_s == BLOCK_WATER_1 || n_s == BLOCK_WATER_2 || n_s == BLOCK_WATER_0 ||
                           n_e == BLOCK_WATER || n_e == BLOCK_WATER_1 || n_e == BLOCK_WATER_2 || n_e == BLOCK_WATER_0 ||
                           n_w == BLOCK_WATER || n_w == BLOCK_WATER_1 || n_w == BLOCK_WATER_2 || n_w == BLOCK_WATER_0 {
                             fill_block = BLOCK_WATER;
                        }
                        set_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z, fill_block);
                        remove_plant_at(chunks, MAX_CHUNKS, hit.x, hit.y + 1, hit.z);
                        
                        // Collect block into scepter inventory
                        if b_hit != BLOCK_WATER && b_hit != BLOCK_WATER_0 && b_hit != BLOCK_WATER_1 && b_hit != BLOCK_WATER_2 && b_hit != BLOCK_OBELISK && b_hit != BLOCK_POWER_CRYSTAL && b_hit != BLOCK_AIR {
                            scepter_add_item(b_hit);
                        }
                        
                        let above = get_block(chunks, MAX_CHUNKS, hit.x, hit.y + 1, hit.z);
                        if above == BLOCK_TALLGRASS || above == 10 || above == BLOCK_LEAVES {
                            set_block(chunks, MAX_CHUNKS, hit.x, hit.y + 1, hit.z, BLOCK_AIR);
                            remove_plant_at(chunks, MAX_CHUNKS, hit.x, hit.y + 1, hit.z);
                        }
                        
                        // Destroy all 3 blocks if it was a power crystal setup
                        if b_hit == BLOCK_OBELISK || b_hit == BLOCK_POWER_CRYSTAL {
                             set_block(chunks, MAX_CHUNKS, hit.x, base_y + 1, hit.z, BLOCK_AIR);
                             set_block(chunks, MAX_CHUNKS, hit.x, base_y + 2, hit.z, BLOCK_AIR);
                             if b_hit == BLOCK_POWER_CRYSTAL { set_block(chunks, MAX_CHUNKS, hit.x, base_y, hit.z, BLOCK_AIR); }
                        }
                        
                        // Cage breaking — free a Zibi!
                        if b_hit == BLOCK_CAGE {
                            signal_cage_break((float)hit.x + 0.5, (float)hit.y, (float)hit.z + 0.5);
                        }
                        
                        if b_hit == BLOCK_CHEST {
                            remove_chest_at(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z);
                        }
                        
                        if b_hit == BLOCK_BANNER || b_hit == BLOCK_LUMBER_BANNER {
                            remove_banner_at(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z);
                        }
                        
                        if get_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z + 1) == 11 { set_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z + 1, BLOCK_AIR); }
                        if get_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z - 1) == 12 { set_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z - 1, BLOCK_AIR); }
                        if get_block(chunks, MAX_CHUNKS, hit.x + 1, hit.y, hit.z) == 13 { set_block(chunks, MAX_CHUNKS, hit.x + 1, hit.y, hit.z, BLOCK_AIR); }
                        if get_block(chunks, MAX_CHUNKS, hit.x - 1, hit.y, hit.z) == 14 { set_block(chunks, MAX_CHUNKS, hit.x - 1, hit.y, hit.z, BLOCK_AIR); }
                        
                        let cx = (int)floor((float)hit.x / 16.0); let cz = (int)floor((float)hit.z / 16.0);
                        let idx = get_chunk_index(cx, cz);
                        request_mesh_async(idx, 1);
                        request_light_async(idx, 4, 1);
                        chunks[idx].grass_deco_built = 0;
                        request_save_async(&chunks[idx]);
                        
                        let idx_xm = get_chunk_index(cx - 1, cz); let idx_xp = get_chunk_index(cx + 1, cz);
                        let idx_zm = get_chunk_index(cx, cz - 1); let idx_zp = get_chunk_index(cx, cz + 1);
                        
                        if chunks[idx_xm].x == cx - 1 && chunks[idx_xm].z == cz { request_mesh_async(idx_xm, 1); request_light_async(idx_xm, 4, 1); chunks[idx_xm].grass_deco_built = 0; }
                        if chunks[idx_xp].x == cx + 1 && chunks[idx_xp].z == cz { request_mesh_async(idx_xp, 1); request_light_async(idx_xp, 4, 1); chunks[idx_xp].grass_deco_built = 0; }
                        if chunks[idx_zm].x == cx && chunks[idx_zm].z == cz - 1 { request_mesh_async(idx_zm, 1); request_light_async(idx_zm, 4, 1); chunks[idx_zm].grass_deco_built = 0; }
                        if chunks[idx_zp].x == cx && chunks[idx_zp].z == cz + 1 { request_mesh_async(idx_zp, 1); request_light_async(idx_zp, 4, 1); chunks[idx_zp].grass_deco_built = 0; }
                        
                        destroy_timer = 0.0; destroy_target_x = -999;
                    }
                } else {
                    destroy_timer = 0.0; destroy_target_x = -999;
                    if beam_sound_playing == 1 {
                        rl::StopSound(get_snd_rayo_loop());
                        rl::PlaySound(get_snd_rayo_end());
                        beam_sound_playing = 0;
                    }
                }
            }
        } else {
            destroy_timer = 0.0; destroy_target_x = -999;
            if beam_sound_playing == 1 {
                rl::StopSound(get_snd_rayo_loop());
                rl::PlaySound(get_snd_rayo_end());
                beam_sound_playing = 0;
            }
        }
        
        // --- Block Placement / Chest / Banner Interaction ---
        if rl::IsMouseButtonPressed(rl::MOUSE_BUTTON_RIGHT) {
            let hit_block = get_block(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z);
            
            // Check for Banner first (regardless of spell)
            if hit_block == BLOCK_BANNER || hit_block == BLOCK_LUMBER_BANNER {
                let bcx = (int)floor((float)hit.x / 16.0);
                let bcz = (int)floor((float)hit.z / 16.0);
                let c_idx = get_chunk_index(bcx, bcz);
                if c_idx >= 0 {
                    let rel_x = hit.x - (bcx * 16);
                    let rel_z = hit.z - (bcz * 16);
                    for bi in 0..chunks[c_idx].banner_count {
                        if chunks[c_idx].banners[bi].x == rel_x && chunks[c_idx].banners[bi].y == hit.y && chunks[c_idx].banners[bi].z == rel_z {
                            open_banner_ui(c_idx, bi);
                            break;
                        }
                    }
                }
            }
            // Check for chest (only if spell 0 or just always allow it too?)
            // Let's allow chest interaction always too, makes sense for an RPG.
            else if hit_block == BLOCK_CHEST {
                let out_ci = 0;
                let out_chi = 0;
                if find_chest_at(chunks, MAX_CHUNKS, hit.x, hit.y, hit.z, &out_ci, &out_chi) == 1 {
                    open_chest_ui(out_ci, out_chi);
                }
            } 
            // Block Placement (only if spell == 0)
            else if selected_spell == 0 {
            let nx = hit.x + hit.face_x; let ny = hit.y + hit.face_y; let nz = hit.z + hit.face_z;
            let dist_x = p.x - ((float)nx + 0.5); let dist_y = p.y + 1.6 - ((float)ny + 0.5); let dist_z = p.z - ((float)nz + 0.5);
            
            let min_dist = 1.0;
            if selected_block == BLOCK_TORCH { min_dist = 0.5; }
            
            if (dist_x*dist_x + dist_y*dist_y + dist_z*dist_z) > min_dist {
                // Obelisks and Chests are magical invocations (mana cost, no inventory needed)
                let is_magical = 0;
                if selected_block == BLOCK_OBELISK || selected_block == BLOCK_CHEST { is_magical = 1; }
                
                let has_resource = 0;
                if is_magical == 1 {
                    if p.mana >= 10.0 { has_resource = 1; }
                } else {
                    // Normal blocks: must be in scepter inventory
                    if scepter_has_block(selected_block) == 1 { has_resource = 1; }
                }
                
                if has_resource == 1 {
                    let block_to_place = selected_block;
                    if block_to_place == BLOCK_GRASS { block_to_place = BLOCK_DIRT; }
                    
                    if selected_block == BLOCK_TORCH {
                        if hit.face_y == 1 { block_to_place = 10; }
                        else if hit.face_y == -1 { block_to_place = BLOCK_AIR; }
                        else {
                            if hit.face_z == 1 { block_to_place = 12; }
                            else if hit.face_z == -1 { block_to_place = 11; }
                            else if hit.face_x == 1 { block_to_place = 14; }
                            else if hit.face_x == -1 { block_to_place = 13; }
                        }
                    }
                    
                    let can_place = 1;
                    
                    let target_block = get_block(chunks, MAX_CHUNKS, nx, ny, nz);
                    if target_block != BLOCK_AIR && target_block != BLOCK_WATER && target_block != BLOCK_WATER_0 && target_block != BLOCK_WATER_1 && target_block != BLOCK_WATER_2 {
                        can_place = 0;
                    }
                    
                    if block_to_place == BLOCK_OBELISK {
                         // Only 1 obelisk allowed at a time
                         if get_total_obelisk_count(chunks, MAX_CHUNKS) >= 1 {
                             can_place = 0;
                         } else if ny + 2 >= CHUNK_HEIGHT { can_place = 0; }
                         else {
                              let up1 = get_block(chunks, MAX_CHUNKS, nx, ny + 1, nz);
                              let up2 = get_block(chunks, MAX_CHUNKS, nx, ny + 2, nz);
                              if up1 != BLOCK_AIR || up2 != BLOCK_AIR { can_place = 0; }
                         }
                    }

                    if can_place == 1 {
                        // Consume resource
                        if is_magical == 1 {
                            p.mana = p.mana - 10.0;
                        } else {
                            scepter_remove_block_type(selected_block);
                        }
                        
                        set_block(chunks, MAX_CHUNKS, nx, ny, nz, block_to_place);
                        if block_to_place == BLOCK_OBELISK {
                             set_block(chunks, MAX_CHUNKS, nx, ny + 1, nz, BLOCK_POWER_CRYSTAL);
                             set_block(chunks, MAX_CHUNKS, nx, ny + 2, nz, BLOCK_POWER_CRYSTAL);
                        }
                    
                    let cx = (int)floor((float)nx / 16.0); let cz = (int)floor((float)nz / 16.0);
                    let idx = get_chunk_index(cx, cz);
                    
                    request_mesh_async(idx, 1); request_light_async(idx, 4, 1); 
                    chunks[idx].grass_deco_built = 0; request_save_async(&chunks[idx]);
                    
                    let cx_nx = (int)floor((float)(nx+1) / 16.0); let idx_nx = get_chunk_index(cx_nx, cz);
                    if idx_nx != idx { request_mesh_async(idx_nx, 1); request_light_async(idx_nx, 4, 1); chunks[idx_nx].grass_deco_built = 0; }
                    
                    let cx_px = (int)floor((float)(nx-1) / 16.0); let idx_px = get_chunk_index(cx_px, cz);
                    if idx_px != idx { request_mesh_async(idx_px, 1); request_light_async(idx_px, 4, 1); chunks[idx_px].grass_deco_built = 0; }
                    
                    let cz_nz = (int)floor((float)(nz+1) / 16.0); let idx_nz = get_chunk_index(cx, cz_nz);
                    if idx_nz != idx { request_mesh_async(idx_nz, 1); request_light_async(idx_nz, 4, 1); chunks[idx_nz].grass_deco_built = 0; }
                    
                    let cz_pz = (int)floor((float)(nz-1) / 16.0); let idx_pz = get_chunk_index(cx, cz_pz);
                    if idx_pz != idx { request_mesh_async(idx_pz, 1); request_light_async(idx_pz, 4, 1); chunks[idx_pz].grass_deco_built = 0; }
                    
                    // Register chest placement
                    if block_to_place == BLOCK_CHEST {
                        place_chest(chunks, MAX_CHUNKS, nx, ny, nz, p.yaw);
                    }
                    }
                }
            }
            } // end else if spell == 0
            else if selected_spell == 2 {
            // MINER SPELL: Place Mining Banner
            if p.mana >= 15.0 {
                let nx = hit.x + hit.face_x; let ny = hit.y + hit.face_y; let nz = hit.z + hit.face_z;
                
                if get_block(chunks, MAX_CHUNKS, nx, ny, nz) == BLOCK_AIR {
                    let ny_bottom = ny - 1;
                    let b_below = get_block(chunks, MAX_CHUNKS, nx, ny_bottom, nz);
                    
                    // Banners must be placed on top of solid blocks
                    if b_below != BLOCK_AIR && b_below != BLOCK_WATER && b_below != BLOCK_WATER_0 && b_below != BLOCK_WATER_1 && b_below != BLOCK_WATER_2 {
                        let cx2 = (int)floor((float)nx / 16.0);
                        let cz2 = (int)floor((float)nz / 16.0);
                        let target_chunk = get_chunk_index(cx2, cz2);
                        
                        if target_chunk >= 0 && chunks[target_chunk].banner_count < 4 {
                            p.mana = p.mana - 15.0;
                            set_block(chunks, MAX_CHUNKS, nx, ny, nz, BLOCK_BANNER);
                            
                            let b_idx = chunks[target_chunk].banner_count;
                            chunks[target_chunk].banners[b_idx].x = nx - (cx2 * 16);
                            chunks[target_chunk].banners[b_idx].y = ny;
                            chunks[target_chunk].banners[b_idx].z = nz - (cz2 * 16);
                            
                            let yaw_norm = p.yaw;
                            while yaw_norm < 0.0 { yaw_norm = yaw_norm + 6.2831853; }
                            while yaw_norm >= 6.2831853 { yaw_norm = yaw_norm - 6.2831853; }
                            
                            let dir_idx = 0; // 0=East(+X), 1=South(+Z), 2=West(-X), 3=North(-Z)
                            if yaw_norm < 0.785398 || yaw_norm >= 5.497787 { dir_idx = 0; }
                            else if yaw_norm < 2.356194 { dir_idx = 1; }
                            else if yaw_norm < 3.926991 { dir_idx = 2; }
                            else { dir_idx = 3; }
                            
                            dir_idx = (dir_idx + 2) % 4;
                            
                            chunks[target_chunk].banners[b_idx].active = 1 + dir_idx;
                            chunks[target_chunk].banners[b_idx].assigned_zibis = 0;
                            chunks[target_chunk].banners[b_idx].priority_count = 0;
                            chunks[target_chunk].banner_count++;
                            
                            // Particle effect on spawn
                            for pi in 0..10 {
                                spawn_particle((float)nx + 0.5, (float)ny + 0.5, (float)nz + 0.5, rl::Color{r: 200, g: 180, b: 60, a: 255});
                            }
                            
                            // Rebuild mesh and save
                            request_mesh_async(target_chunk, 1);
                            request_light_async(target_chunk, 4, 1);
                            request_save_async(&chunks[target_chunk]);
                        }
                    }
                }
            }
            }
            else if selected_spell == 3 {
            // LUMBER SPELL: Place Lumber Banner
            if p.mana >= 15.0 {
                let nx = hit.x + hit.face_x; let ny = hit.y + hit.face_y; let nz = hit.z + hit.face_z;
                
                if get_block(chunks, MAX_CHUNKS, nx, ny, nz) == BLOCK_AIR {
                    let ny_bottom = ny - 1;
                    let b_below = get_block(chunks, MAX_CHUNKS, nx, ny_bottom, nz);
                    
                    if b_below != BLOCK_AIR && b_below != BLOCK_WATER && b_below != BLOCK_WATER_0 && b_below != BLOCK_WATER_1 && b_below != BLOCK_WATER_2 {
                        let cx2 = (int)floor((float)nx / 16.0);
                        let cz2 = (int)floor((float)nz / 16.0);
                        let target_chunk = get_chunk_index(cx2, cz2);
                        
                        if target_chunk >= 0 && chunks[target_chunk].banner_count < 4 {
                            p.mana = p.mana - 15.0;
                            set_block(chunks, MAX_CHUNKS, nx, ny, nz, BLOCK_LUMBER_BANNER);
                            
                            let b_idx = chunks[target_chunk].banner_count;
                            chunks[target_chunk].banners[b_idx].x = nx - (cx2 * 16);
                            chunks[target_chunk].banners[b_idx].y = ny;
                            chunks[target_chunk].banners[b_idx].z = nz - (cz2 * 16);
                            
                            let yaw_norm = p.yaw;
                            while yaw_norm < 0.0 { yaw_norm = yaw_norm + 6.2831853; }
                            while yaw_norm >= 6.2831853 { yaw_norm = yaw_norm - 6.2831853; }
                            
                            let dir_idx = 0;
                            if yaw_norm < 0.785398 || yaw_norm >= 5.497787 { dir_idx = 0; }
                            else if yaw_norm < 2.356194 { dir_idx = 1; }
                            else if yaw_norm < 3.926991 { dir_idx = 2; }
                            else { dir_idx = 3; }
                            
                            dir_idx = (dir_idx + 2) % 4;
                            
                            chunks[target_chunk].banners[b_idx].active = 1 + dir_idx;
                            chunks[target_chunk].banners[b_idx].assigned_zibis = 0;
                            chunks[target_chunk].banners[b_idx].priority_count = 0;
                            chunks[target_chunk].banners[b_idx].banner_type = 1; // Lumberjack
                            chunks[target_chunk].banner_count++;
                            
                            for pi in 0..10 {
                                spawn_particle((float)nx + 0.5, (float)ny + 0.5, (float)nz + 0.5, rl::Color{r: 60, g: 200, b: 60, a: 255});
                            }
                            
                            request_mesh_async(target_chunk, 1);
                            request_light_async(target_chunk, 4, 1);
                            request_save_async(&chunks[target_chunk]);
                        }
                    }
                }
            }
            }
        }
    } else {
        destroy_timer = 0.0; destroy_target_x = -999;
        if beam_sound_playing == 1 {
            rl::StopSound(get_snd_rayo_loop());
            rl::PlaySound(get_snd_rayo_end());
            beam_sound_playing = 0;
        }
    }
}