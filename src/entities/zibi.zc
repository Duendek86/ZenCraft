//> Zibi character implementation — Cage & Worker System
import "player.zc"; // Access to check_collision and chunk utilities
import "../world/chunk.zc";
import "raylib.h" as rl;
import "math.h";

// Zibi States
def ZIBI_FREED = 0;              // Just released from cage
def ZIBI_WALK_TO_OBELISK = 1;    // Walking toward obelisk
def ZIBI_WORKER = 2;             // Idle worker at obelisk
def ZIBI_FOLLOW_PLAYER = 3;      // No obelisk nearby, player follow mode
def ZIBI_COMBAT = 4;             // Fighting back against an attacker

struct Zibi {
    x: float;
    y: float;
    z: float;
    vx: float;
    vy: float;
    vz: float;
    yaw: float;
    
    // Behavior state
    state: int;
    state_timer: float;
    target_yaw: float;
    
    // Target obelisk position
    target_x: float;
    target_y: float;
    target_z: float;
    
    // Animation
    anim_time: float;
    
    // Lifecycle
    active: int;
    hp: int;
    hurt_flash: float;
    
    // Combat
    combat_target_x: float;
    combat_target_z: float;
    combat_timer: float;
    attack_cooldown: float;
    prev_state: int; // state to return to after combat
    
    // Worker fields
    work_timer: float;
    home_chunk_x: int;
    home_chunk_z: int;
    obelisk_idx: int;
    
    // Invincibility (post-cage-break)
    invincibility_timer: float;
}

// Zibi Constants
def ZIBI_WIDTH = 0.4;
def ZIBI_HEIGHT = 0.9;
def ZIBI_SPEED = 2.5;

// --- Global spawn signal from cage breaking ---
let cage_break_x: float = 0.0;
let cage_break_y: float = 0.0;
let cage_break_z: float = 0.0;
let cage_break_pending: int = 0;

fn signal_cage_break(x: float, y: float, z: float) {
    cage_break_x = x;
    cage_break_y = y;
    cage_break_z = z;
    cage_break_pending = 1;
}

impl Zibi {
    static fn new(x: float, y: float, z: float, state: int) -> Zibi {
        let inst: Zibi;
        inst.x = x;
        inst.y = y;
        inst.z = z;
        inst.vx = 0.0;
        inst.vy = 0.0;
        inst.vz = 0.0;
        inst.yaw = 0.0;
        inst.state = state;
        inst.state_timer = 2.0;
        inst.target_yaw = 0.0;
        inst.target_x = 0.0;
        inst.target_y = 0.0;
        inst.target_z = 0.0;
        inst.anim_time = 0.0;
        inst.active = 1;
        inst.hp = 30;
        inst.hurt_flash = 0.0;
        inst.combat_target_x = 0.0;
        inst.combat_target_z = 0.0;
        inst.combat_timer = 0.0;
        inst.attack_cooldown = 0.0;
        inst.prev_state = 0;
        inst.invincibility_timer = 0.0;
        if state == ZIBI_FREED { inst.invincibility_timer = 4.0; } // 4s invincibility after freeing
        return inst;
    }

    fn take_damage(self, amount: int) {
        if self.invincibility_timer > 0.0 { return; } // Immune!
        self.hp -= amount;
        self.hurt_flash = 0.3;
        if self.hp <= 0 {
            self.active = 0;
        }
    }

    fn take_damage_from(self, amount: int, attacker_x: float, attacker_z: float) {
        if self.invincibility_timer > 0.0 { return; } // Immune!
        self.hp -= amount;
        self.hurt_flash = 0.3;
        if self.hp <= 0 {
            self.active = 0;
            return;
        }
        // Enter combat mode — fight back!
        if self.state != ZIBI_COMBAT {
            self.prev_state = self.state;
        }
        self.state = ZIBI_COMBAT;
        self.combat_target_x = attacker_x;
        self.combat_target_z = attacker_z;
        self.combat_timer = 5.0; // stay in combat for 5s
    }

    // Find nearest obelisk, returns 1 if found
    fn find_obelisk(self, chunks: Chunk*, num_chunks: int) -> int {
        let best_dist = 99999.0;
        let found = 0;
        for i in 0..num_chunks {
            if chunks[i].x == -9999 { continue; }
            for s in 0..chunks[i].obelisk_count {
                let ox = (float)(chunks[i].x * 16) + chunks[i].obelisks[s].x;
                let oy = chunks[i].obelisks[s].y;
                let oz = (float)(chunks[i].z * 16) + chunks[i].obelisks[s].z;
                let dx = ox - self.x;
                let dy = oy - self.y;
                let dz = oz - self.z;
                let d = (float)sqrt(dx*dx + dy*dy + dz*dz);
                if d < best_dist {
                    best_dist = d;
                    self.target_x = ox;
                    self.target_y = oy;
                    self.target_z = oz;
                    found = 1;
                }
            }
        }
        return found;
    }

    // Returns 1 if still active, 0 if despawned
    fn update(self, chunks: Chunk*, num_chunks: int, dt: float,
              player_x: float, player_y: float, player_z: float, day_time: float,
              wolves: ShadowWolf*, max_wolves: int) -> int {
        if self.active == 0 { return 0; }
        if self.hurt_flash > 0.0 { self.hurt_flash -= dt; }
        if self.attack_cooldown > 0.0 { self.attack_cooldown -= dt; }
        if self.invincibility_timer > 0.0 { self.invincibility_timer -= dt; }
        
        // --- Check if in loaded chunk ---
        let cx = (int)floor(self.x / 16.0);
        let cz = (int)floor(self.z / 16.0);
        let idx = get_chunk_index(cx, cz);
        
        if idx < 0 || idx >= num_chunks {
            self.active = 0;
            return 0;
        }
        if chunks[idx].x != cx || chunks[idx].z != cz {
            self.active = 0;
            return 0;
        }

        self.anim_time += dt;
        self.state_timer -= dt;

        // === STATE: FREED — just released, decide what to do ===
        if self.state == ZIBI_FREED {
            if self.find_obelisk(chunks, num_chunks) == 1 {
                let obelisk_dist_dx = self.target_x - self.x;
                let obelisk_dist_dz = self.target_z - self.z;
                let obelisk_dist = (float)sqrt(obelisk_dist_dx*obelisk_dist_dx + obelisk_dist_dz*obelisk_dist_dz);
                if obelisk_dist < 120.0 {
                    // Obelisk nearby — walk to it
                    self.state = ZIBI_WALK_TO_OBELISK;
                } else {
                    // Too far — follow player
                    self.state = ZIBI_FOLLOW_PLAYER;
                    self.state_timer = 3.0;
                }
            } else {
                self.state = ZIBI_FOLLOW_PLAYER;
                self.state_timer = 3.0; // Check for obelisk every 3s while following
            }
        }

        // === STATE: WALK TO OBELISK ===
        if self.state == ZIBI_WALK_TO_OBELISK {
            let dx = self.target_x - self.x;
            let dz = self.target_z - self.z;
            let dist = (float)sqrt(dx*dx + dz*dz);
            
            if dist < 3.0 {
                // Arrived — become worker
                self.state = ZIBI_WORKER;
                self.vx = 0.0;
                self.vz = 0.0;
                return 1;
            }
            
            // Face and move toward obelisk
            self.yaw = (float)atan2(dz, dx);
            self.vx = (dx / dist) * ZIBI_SPEED;
            self.vz = (dz / dist) * ZIBI_SPEED;
        }

        // === STATE: WORKER — idle at obelisk ===
        if self.state == ZIBI_WORKER {
            // Small idle movement: occasionally shift position slightly
            if self.state_timer <= 0.0 {
                let r = rl::GetRandomValue(0, 100);
                if r < 30 {
                    // Idle stand
                    self.vx = 0.0;
                    self.vz = 0.0;
                    self.state_timer = (float)rl::GetRandomValue(20, 50) / 10.0;
                } else {
                    // Small wander near obelisk
                    self.state_timer = (float)rl::GetRandomValue(10, 25) / 10.0;
                    self.target_yaw = (float)rl::GetRandomValue(0, 360) * 0.0174533;
                    self.yaw = self.target_yaw;
                    self.vx = (float)cos(self.yaw) * ZIBI_SPEED * 0.3;
                    self.vz = (float)sin(self.yaw) * ZIBI_SPEED * 0.3;
                }
            }
            
            // Stay near obelisk — if too far, walk back
            let ox_diff = self.target_x - self.x;
            let oz_diff = self.target_z - self.z;
            let ob_dist = (float)sqrt(ox_diff*ox_diff + oz_diff*oz_diff);
            if ob_dist > 5.0 {
                self.yaw = (float)atan2(oz_diff, ox_diff);
                self.vx = (ox_diff / ob_dist) * ZIBI_SPEED * 0.5;
                self.vz = (oz_diff / ob_dist) * ZIBI_SPEED * 0.5;
            }
        }

        // === STATE: FOLLOW PLAYER — no obelisks nearby ===
        if self.state == ZIBI_FOLLOW_PLAYER {
            // Re-check for obelisks periodically
            if self.state_timer <= 0.0 {
                self.state_timer = 3.0;
                if self.find_obelisk(chunks, num_chunks) == 1 {
                    self.state = ZIBI_WALK_TO_OBELISK;
                }
            }
            
            let is_night = (day_time > 0.5);
            let found_light = 0;
            let target_lx = 0.0;
            let target_lz = 0.0;
            
            if is_night {
                let best_light = 0;
                let bx = (int)floor(self.x);
                let bz = (int)floor(self.z);
                let by = (int)floor(self.y + 0.8);
                
                // Scan 5x5 blocks around zibi for highest light level
                for sx in -6..7 {
                    for sz in -6..7 {
                        let packed_light = get_light_levels(chunks, num_chunks, bx + sx, by, bz + sz);
                        let l_val = packed_light & 0xF; // Extract single light component to judge brightness
                        if l_val > best_light {
                            best_light = l_val;
                            target_lx = (float)(bx + sx) + 0.5; // center of block
                            target_lz = (float)(bz + sz) + 0.5;
                        }
                    }
                }
                
                if best_light >= 8 {
                    found_light = 1;
                }
            }
            
            let dx = player_x - self.x;
            let dz = player_z - self.z;
            
            if found_light == 1 {
                // Ignore player, walk to light
                dx = target_lx - self.x;
                dz = target_lz - self.z;
            }
            
            let dist_to_target = (float)sqrt(dx*dx + dz*dz);
            
            if dist_to_target > 1.5 { // follow light or player if far
                self.yaw = (float)atan2(dz, dx);
                self.vx = (dx / dist_to_target) * ZIBI_SPEED * (found_light ? 1.0 : 1.5);
                self.vz = (dz / dist_to_target) * ZIBI_SPEED * (found_light ? 1.0 : 1.5);
            } else { // stop when close
                self.vx = 0.0;
                self.vz = 0.0;
                
                // turn to face randomly or stand still
                if rl::GetRandomValue(0, 100) < 5 {
                     self.yaw = (float)atan2(dz, dx);
                }
            }
            
            // Despawn if getting lost completely (only relative to player)
            let p_dx = player_x - self.x;
            let p_dz = player_z - self.z;
            if (float)sqrt(p_dx*p_dx + p_dz*p_dz) > 120.0 {
                 self.active = 0;
                 return 0;
            }
        }
        // === STATE: COMBAT — fight back against attacker ===
        if self.state == ZIBI_COMBAT {
            self.combat_timer -= dt;
            if self.combat_timer <= 0.0 {
                // Return to previous state
                self.state = self.prev_state;
            } else {
                let dx = self.combat_target_x - self.x;
                let dz = self.combat_target_z - self.z;
                let dist_to_target = (float)sqrt(dx*dx + dz*dz);
                
                if dist_to_target > 1.2 {
                    self.yaw = (float)atan2(dz, dx);
                    self.vx = (dx / dist_to_target) * ZIBI_SPEED * 1.8;
                    self.vz = (dz / dist_to_target) * ZIBI_SPEED * 1.8;
                } else {
                    self.vx = 0.0;
                    self.vz = 0.0;
                }
                
                // Attack nearby wolves
                if self.attack_cooldown <= 0.0 {
                    for wi in 0..max_wolves {
                        if wolves[wi].active == 1 {
                            let wdx = wolves[wi].x - self.x;
                            let wdz = wolves[wi].z - self.z;
                            let wdist = (float)sqrt(wdx*wdx + wdz*wdz);
                            if wdist < 1.5 {
                                wolves[wi].take_damage(3);
                                self.attack_cooldown = 1.0;
                                // Update combat target to this wolf
                                self.combat_target_x = wolves[wi].x;
                                self.combat_target_z = wolves[wi].z;
                                self.combat_timer = 5.0; // refresh combat
                                break;
                            }
                        }
                    }
                }
            }
        }

        // --- Physics & Movement ---
        if self.state == ZIBI_WALK_TO_OBELISK || self.state == ZIBI_FOLLOW_PLAYER || self.state == ZIBI_WORKER || self.state == ZIBI_COMBAT {
            // Smart obstacle avoidance
            let front_x = self.x + self.vx * 0.6;
            let front_z = self.z + self.vz * 0.6;
            
            if check_collision(chunks, num_chunks, front_x, self.y, front_z, ZIBI_WIDTH, ZIBI_HEIGHT) {
                // 1. Try to jump over 1-block walls
                if !check_collision(chunks, num_chunks, front_x, self.y + 1.2, front_z, ZIBI_WIDTH, ZIBI_HEIGHT) {
                    if check_collision(chunks, num_chunks, self.x, self.y - 0.1, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
                        self.vy = 7.0;
                    }
                } else {
                    // 2. Can't jump — try sliding around the obstacle
                    // Try perpendicular directions (left and right of current heading)
                    let perp_x = -self.vz; // Perpendicular vector
                    let perp_z = self.vx;
                    let speed = (float)sqrt(self.vx*self.vx + self.vz*self.vz);
                    if speed > 0.1 {
                        perp_x = perp_x / speed;
                        perp_z = perp_z / speed;
                    }
                    
                    // Try left slide
                    let try_lx = self.x + perp_x * 1.5;
                    let try_lz = self.z + perp_z * 1.5;
                    let left_clear = !check_collision(chunks, num_chunks, try_lx, self.y, try_lz, ZIBI_WIDTH, ZIBI_HEIGHT);
                    
                    // Try right slide
                    let try_rx = self.x - perp_x * 1.5;
                    let try_rz = self.z - perp_z * 1.5;
                    let right_clear = !check_collision(chunks, num_chunks, try_rx, self.y, try_rz, ZIBI_WIDTH, ZIBI_HEIGHT);
                    
                    if left_clear && !right_clear {
                        // Slide left
                        self.vx = perp_x * ZIBI_SPEED;
                        self.vz = perp_z * ZIBI_SPEED;
                        self.yaw = (float)atan2(perp_z, perp_x);
                    } else if right_clear && !left_clear {
                        // Slide right
                        self.vx = -perp_x * ZIBI_SPEED;
                        self.vz = -perp_z * ZIBI_SPEED;
                        self.yaw = (float)atan2(-perp_z, -perp_x);
                    } else if left_clear {
                        // Both clear, pick randomly
                        if rl::GetRandomValue(0, 1) == 0 {
                            self.vx = perp_x * ZIBI_SPEED;
                            self.vz = perp_z * ZIBI_SPEED;
                            self.yaw = (float)atan2(perp_z, perp_x);
                        } else {
                            self.vx = -perp_x * ZIBI_SPEED;
                            self.vz = -perp_z * ZIBI_SPEED;
                            self.yaw = (float)atan2(-perp_z, -perp_x);
                        }
                    } else {
                        // Completely blocked — random turn
                        self.yaw += (float)rl::GetRandomValue(90, 270) * 0.0174533;
                        self.vx = (float)cos(self.yaw) * ZIBI_SPEED;
                        self.vz = (float)sin(self.yaw) * ZIBI_SPEED;
                    }
                }
            }
        }
        
        // Gravity
        self.vy -= 18.0 * dt;
        
        // X movement
        self.x += self.vx * dt;
        if check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
            self.x -= self.vx * dt;
        }
        
        // Z movement
        self.z += self.vz * dt;
        if check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
            self.z -= self.vz * dt;
        }
        
        // Y movement
        self.y += self.vy * dt;
        if check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
            if self.vy < 0.0 { self.y -= self.vy * dt; }
            self.vy = 0.0;
        }
        
        return 1;
    }
    
    fn draw(self, chunks: Chunk*, num_chunks: int, day_time: float) {
        if self.active == 0 { return; }
        // --- ZIBI RENDERING ---
        
        // --- Lighting Calc ---
        let lx = (int)floor(self.x);
        let ly = (int)floor(self.y + 0.8);
        let lz = (int)floor(self.z);
        let packed_light = get_light_levels(chunks, num_chunks, lx, ly, lz);
        
        // Base Colors mapped for DrawCube
        let c_skin = rl::Color{ r: 108, g: 202, b: 85, a: 255 };
        let c_tunic = rl::Color{ r: 141, g: 90, b: 50, a: 255 };
        let c_pants = rl::Color{ r: 75, g: 50, b: 41, a: 255 };
        let c_shoes = rl::Color{ r: 56, g: 94, b: 46, a: 255 };
        let c_white = rl::WHITE;
        
        // Worker tint: golden tunic
        if self.state == ZIBI_WORKER || self.state == ZIBI_WALK_TO_OBELISK {
            c_tunic = rl::Color{ r: 200, g: 170, b: 60, a: 255 };
        }
        
        // Invincibility glow (golden shimmer)
        if self.invincibility_timer > 0.0 {
            let shimmer = (int)(180.0 + 75.0 * (float)sin(self.anim_time * 8.0));
            c_skin = rl::Color{ r: 255, g: shimmer, b: 50, a: 255 };
            c_tunic = rl::Color{ r: 255, g: shimmer, b: 80, a: 255 };
        }
        
        // Hurt flash
        if self.hurt_flash > 0.0 {
            c_skin = rl::Color{ r: 255, g: 100, b: 100, a: 255 };
        }
        
        let sh = get_shader_lighting();
        let loc_use_entity = rl::GetShaderLocation(sh, "uUseEntityLight");
        let loc_entity_light = rl::GetShaderLocation(sh, "uEntityLight");
        
        rl::BeginShaderMode(sh);
        
        let use_ent = 1;
        if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
        let el = rl::Vector2{x: (float)(packed_light & 0xF) / 15.0, y: (float)((packed_light >> 4) & 0xF) / 15.0};
        if loc_entity_light != -1 { rl::SetShaderValue(sh, loc_entity_light, &el, rl::SHADER_UNIFORM_VEC2); }
        
        // Animation variables
        let limb_swing = 0.0;
        let is_moving = (self.state == ZIBI_WALK_TO_OBELISK || self.state == ZIBI_COMBAT || (self.state == ZIBI_FOLLOW_PLAYER && (float)sqrt(self.vx*self.vx + self.vz*self.vz) > 0.3) || (self.state == ZIBI_WORKER && (float)sqrt(self.vx*self.vx + self.vz*self.vz) > 0.3));
        if is_moving { 
            limb_swing = (float)sin(self.anim_time * 12.0);
        }

        rl::rlPushMatrix();
        rl::rlTranslatef(self.x, self.y, self.z);
        rl::rlRotatef(self.yaw * 57.2958, 0.0, -1.0, 0.0);
        rl::rlScalef(0.5, 0.5, 0.5);
        
        // --- 1. LEGS (With Animation) ---
        // Left Leg (+Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 0.6, 0.15);
        rl::rlRotatef(limb_swing * 40.0, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.3, z: 0.0}, 0.25, 0.6, 0.2, c_pants);
        rl::DrawCube(rl::Vector3{x: 0.05, y: -0.65, z: 0.0}, 0.35, 0.1, 0.22, c_shoes);
        rl::rlPopMatrix();
        
        // Right Leg (-Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 0.6, -0.15);
        rl::rlRotatef(-limb_swing * 40.0, 0.0, 0.0, 1.0); 
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.3, z: 0.0}, 0.25, 0.6, 0.2, c_pants);
        rl::DrawCube(rl::Vector3{x: 0.05, y: -0.65, z: 0.0}, 0.35, 0.1, 0.22, c_shoes);
        rl::rlPopMatrix();

        // --- 2. BODY (Tunic) ---
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.95, z: 0.0}, 0.35, 0.7, 0.55, c_tunic);
        
        // --- 3. ARMS (With Animation) ---
        // Left Arm (+Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 1.2, 0.35);
        rl::rlRotatef(-limb_swing * 40.0, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.25, z: 0.0}, 0.18, 0.6, 0.18, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 0.2, 0.25, 0.2, c_tunic);
        rl::rlPopMatrix();
        
        // Right Arm (-Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 1.2, -0.35);
        rl::rlRotatef(limb_swing * 40.0, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.25, z: 0.0}, 0.18, 0.6, 0.18, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 0.2, 0.25, 0.2, c_tunic);
        
        // --- PICKAXE (only in combat) ---
        if self.state == ZIBI_COMBAT {
            // Handle (wooden stick)
            rl::DrawCube(rl::Vector3{x: 0.0, y: -0.7, z: 0.0}, 0.08, 0.8, 0.08, rl::Color{r: 139, g: 90, b: 43, a: 255});
            // Pickaxe head (iron-gray)
            rl::DrawCube(rl::Vector3{x: 0.0, y: -1.05, z: 0.0}, 0.4, 0.08, 0.12, rl::Color{r: 160, g: 170, b: 180, a: 255});
            // Pointed tip
            rl::DrawCube(rl::Vector3{x: 0.2, y: -1.1, z: 0.0}, 0.12, 0.06, 0.08, rl::Color{r: 140, g: 150, b: 160, a: 255});
        }
        
        rl::rlPopMatrix();

        // --- 4. HEAD ---
        let head_y = 1.55;
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y, z: 0.0}, 0.45, 0.55, 0.5, c_skin);
        
        // Ears
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: 0.3}, 0.08, 0.08, 0.2, c_skin); 
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: 0.4}, 0.15, 0.15, 0.05, c_skin); 
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: -0.3}, 0.08, 0.08, 0.2, c_skin); 
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: -0.4}, 0.15, 0.15, 0.05, c_skin); 

        // Eyes
        rl::DrawCube(rl::Vector3{x: 0.23, y: head_y + 0.05, z: 0.12}, 0.05, 0.12, 0.12, c_white);
        rl::DrawCube(rl::Vector3{x: 0.26, y: head_y + 0.05, z: 0.12}, 0.02, 0.04, 0.04, c_shoes); 
        rl::DrawCube(rl::Vector3{x: 0.23, y: head_y + 0.05, z: -0.12}, 0.05, 0.12, 0.12, c_white);
        rl::DrawCube(rl::Vector3{x: 0.26, y: head_y + 0.05, z: -0.12}, 0.02, 0.04, 0.04, c_shoes); 

        // Mouth
        rl::DrawCube(rl::Vector3{x: 0.235, y: head_y - 0.15, z: 0.0}, 0.03, 0.03, 0.2, c_shoes);
        
        rl::rlPopMatrix();
        
        rl::EndShaderMode();
        
        use_ent = 0;
        if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
    }
}