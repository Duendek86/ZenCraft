//> Zibi character implementation — Cage & Worker System
import "player.zc"; // Access to check_collision and chunk utilities
import "../world/chunk.zc";
import "../world/pathfinding.zc";
import "raylib.h" as rl;
import "arrows.zc";
import "math.h";

// Zibi States
def ZIBI_FREED = 0;              // Just released from cage
def ZIBI_WALK_TO_OBELISK = 1;    // Walking toward obelisk
def ZIBI_WORKER = 2;             // Idle worker at obelisk
def ZIBI_FOLLOW_PLAYER = 3;      // No obelisk nearby, player follow mode
def ZIBI_COMBAT = 4;             // Fighting back against an attacker
def ZIBI_MINING = 5;             // Active miner at a banner
def ZIBI_LUMBERJACK = 6;         // Active lumberjack at a lumber banner
def ZIBI_ARCHER = 7;

struct Zibi {
    x: float;
    y: float;
    z: float;
    vx: float;
    vy: float;
    vz: float;
    yaw: float;
    
    // Behavior state
    state: int;
    state_timer: float;
    target_yaw: float;
    
    // Target obelisk position
    target_x: float;
    target_y: float;
    target_z: float;
    
    // Animation
    anim_time: float;
    
    // Lifecycle
    active: int;
    hp: int;
    hurt_flash: float;
    
    // Combat
    combat_target_x: float;
    combat_target_z: float;
    combat_timer: float;
    attack_cooldown: float;
    prev_state: int; // state to return to after combat
    
    // Worker fields
    work_timer: float;
    home_chunk_x: int;
    home_chunk_z: int;
    obelisk_idx: int;
    
    // Invincibility (post-cage-break)
    invincibility_timer: float;
    
    // Mining
    mine_banner_x: int;
    mine_banner_y: int;
    mine_banner_z: int;
    mine_target_x: int;
    mine_target_y: int;
    mine_target_z: int;
    mine_timer: float;
    mine_carrying_block: int;
    mine_waiting_for_wood: int;
    mine_wait_timer: float;
    // Navigation path (A* on voxel grid) to respect jumps/steps
    path: PathPoint[64];
    path_len: int;
    path_idx: int;
    path_timer: float;
    path_fail_count: int;
    // Stuck detection: track position over time
    stuck_timer: float;
    last_stuck_check_x: float;
    last_stuck_check_z: float;
    // Waypoint navigation
    waypoint_target_x: int;
    waypoint_target_y: int;
    waypoint_target_z: int;
}

// Zibi Constants
def ZIBI_WIDTH = 0.4;
def ZIBI_HEIGHT = 0.9;
def ZIBI_SPEED = 2.5;

// --- Global spawn signal from cage breaking ---
let cage_break_x: float = 0.0;
let cage_break_y: float = 0.0;
let cage_break_z: float = 0.0;
let cage_break_pending: int = 0;

fn signal_cage_break(x: float, y: float, z: float) {
    cage_break_x = x;
    cage_break_y = y;
    cage_break_z = z;
    cage_break_pending = 1;
}

impl Zibi {
    static fn new(x: float, y: float, z: float, state: int) -> Zibi {
        let inst: Zibi;
        inst.x = x;
        inst.y = y;
        inst.z = z;
        inst.vx = 0.0;
        inst.vy = 0.0;
        inst.vz = 0.0;
        inst.yaw = 0.0;
        inst.state = state;
        inst.state_timer = 2.0;
        inst.target_yaw = 0.0;
        inst.target_x = 0.0;
        inst.target_y = 0.0;
        inst.target_z = 0.0;
        inst.anim_time = 0.0;
        inst.active = 1;
        inst.hp = 30;
        inst.hurt_flash = 0.0;
        inst.combat_target_x = 0.0;
        inst.combat_target_z = 0.0;
        inst.combat_timer = 0.0;
        inst.attack_cooldown = 0.0;
        inst.prev_state = 0;
        inst.invincibility_timer = 0.0;
        inst.mine_timer = 0.0;
        inst.mine_carrying_block = 0;
        inst.mine_waiting_for_wood = 0;
        inst.mine_wait_timer = 0.0;
        inst.path_len = 0;
        inst.path_idx = 0;
        inst.path_timer = 0.0;
        inst.path_fail_count = 0;
        inst.stuck_timer = 0.0;
        inst.last_stuck_check_x = x;
        inst.last_stuck_check_z = z;
        inst.waypoint_target_x = 0;
        inst.waypoint_target_y = 0;
        inst.waypoint_target_z = 0;
        if state == ZIBI_FREED { inst.invincibility_timer = 4.0; } // 4s invincibility after freeing
        return inst;
    }

    fn take_damage(self, amount: int) {
        if self.invincibility_timer > 0.0 { return; } // Immune!
        self.hp -= amount;
        self.hurt_flash = 0.3;
        if self.hp <= 0 {
            self.active = 0;
        }
    }

    fn take_damage_from(self, amount: int, attacker_x: float, attacker_z: float) {
        if self.invincibility_timer > 0.0 { return; } // Immune!
        self.hp -= amount;
        self.hurt_flash = 0.3;
        if self.hp <= 0 {
            self.active = 0;
            return;
        }
        // Enter combat mode — fight back!
        if self.state != ZIBI_COMBAT {
            self.prev_state = self.state;
        }
        self.state = ZIBI_COMBAT;
        self.combat_target_x = attacker_x;
        self.combat_target_z = attacker_z;
        self.combat_timer = 5.0; // stay in combat for 5s
    }

    // Find nearest obelisk, returns 1 if found
    fn find_obelisk(self, chunks: Chunk*, num_chunks: int) -> int {
        let best_dist = 99999.0;
        let found = 0;
        for i in 0..num_chunks {
            if chunks[i].x == -9999 { continue; }
            for s in 0..chunks[i].obelisk_count {
                let ox = (float)(chunks[i].x * 16) + chunks[i].obelisks[s].x;
                let oy = chunks[i].obelisks[s].y;
                let oz = (float)(chunks[i].z * 16) + chunks[i].obelisks[s].z;
                let dx = ox - self.x;
                let dy = oy - self.y;
                let dz = oz - self.z;
                let d = (float)sqrt(dx*dx + dy*dy + dz*dz);
                if d < best_dist {
                    best_dist = d;
                    self.target_x = ox;
                    self.target_y = oy;
                    self.target_z = oz;
                    found = 1;
                }
            }
        }
        return found;
    }

    // Returns 1 if still active, 0 if despawned
    fn update(self, chunks: Chunk*, num_chunks: int, dt: float,
              player_x: float, player_y: float, player_z: float, day_time: float,
              wolves: ShadowWolf*, max_wolves: int,
              zibis: Zibi*, max_zibis: int) -> int {
        if self.active == 0 { return 0; }
        if self.hurt_flash > 0.0 { self.hurt_flash -= dt; }
        if self.attack_cooldown > 0.0 { self.attack_cooldown -= dt; }
        if self.invincibility_timer > 0.0 { self.invincibility_timer -= dt; }
        
        // --- Check if in loaded chunk ---
        let cx = (int)floor(self.x / 16.0);
        let cz = (int)floor(self.z / 16.0);
        let idx = get_chunk_index(cx, cz);
        
        if idx < 0 || idx >= num_chunks {
            self.active = 0;
            return 0;
        }
        if chunks[idx].x != cx || chunks[idx].z != cz {
            self.active = 0;
            return 0;
        }

        self.anim_time += dt;
        self.state_timer -= dt;

        // === STATE: FREED — just released, decide what to do ===
        if self.state == ZIBI_FREED {
            if self.find_obelisk(chunks, num_chunks) == 1 {
                let obelisk_dist_dx = self.target_x - self.x;
                let obelisk_dist_dz = self.target_z - self.z;
                let obelisk_dist = (float)sqrt(obelisk_dist_dx*obelisk_dist_dx + obelisk_dist_dz*obelisk_dist_dz);
                if obelisk_dist < 120.0 {
                    // Obelisk nearby — walk to it
                    self.state = ZIBI_WALK_TO_OBELISK;
                } else {
                    // Too far — follow player
                    self.state = ZIBI_FOLLOW_PLAYER;
                    self.state_timer = 3.0;
                }
            } else {
                self.state = ZIBI_FOLLOW_PLAYER;
                self.state_timer = 3.0; // Check for obelisk every 3s while following
            }
        }

        // === STATE: WALK TO OBELISK ===
        if self.state == ZIBI_WALK_TO_OBELISK {
            let dx = self.target_x - self.x;
            let dz = self.target_z - self.z;
            let dist = (float)sqrt(dx*dx + dz*dz);
            if dist < 3.0 {
                // Arrived — become worker
                self.state = ZIBI_WORKER;
                self.vx = 0.0;
                self.vz = 0.0;
                self.waypoint_target_x = 0;
                self.waypoint_target_y = 0;
                self.waypoint_target_z = 0;
                return 1;
            }
            
            // Decrease path timer
            self.path_timer -= dt;

            // If no waypoint target set, start at nearest waypoint to our current position
            if self.waypoint_target_x == 0 && self.waypoint_target_y == 0 && self.waypoint_target_z == 0 {
                let wpx = 0; let wpy = 0; let wpz = 0;
                if find_nearest_waypoint(chunks, num_chunks, (int)floor(self.x), (int)floor(self.y), (int)floor(self.z), &wpx, &wpy, &wpz) == 1 {
                    self.waypoint_target_x = wpx;
                    self.waypoint_target_y = wpy;
                    self.waypoint_target_z = wpz;
                    // Immediately test reachability: compute a quick path to this waypoint
                    self.path_len = find_path(chunks, num_chunks,
                        (int)floor(self.x), (int)floor(self.y), (int)floor(self.z),
                        self.waypoint_target_x, self.waypoint_target_y, self.waypoint_target_z,
                        &self.path[0], MAX_PATH_LENGTH);
                    self.path_idx = (self.path_len > 0 ? 1 : 0);
                    if self.path_len == 0 {
                        // Attempt to find an alternative nearby reachable waypoint
                        let alt_x = 0; let alt_y = 0; let alt_z = 0;
                        if find_next_waypoint_towards_goal(chunks, num_chunks, self.waypoint_target_x, self.waypoint_target_y, self.waypoint_target_z,
                            (int)self.target_x, (int)self.target_y, (int)self.target_z, &alt_x, &alt_y, &alt_z) == 1 {
                            self.waypoint_target_x = alt_x; self.waypoint_target_y = alt_y; self.waypoint_target_z = alt_z;
                            self.path_len = find_path(chunks, num_chunks,
                                (int)floor(self.x), (int)floor(self.y), (int)floor(self.z),
                                self.waypoint_target_x, self.waypoint_target_y, self.waypoint_target_z,
                                &self.path[0], MAX_PATH_LENGTH);
                            self.path_idx = (self.path_len > 0 ? 1 : 0);
                        } else {
                            // leave waypoint_target as-is; pathing will be attempted later
                        }
                    }
                }
            }

            // If we have a path, follow it
            if self.path_idx < self.path_len {
                let wp = (&self.path[0])[self.path_idx];
                let tx = (float)wp.x + 0.5; let ty = (float)wp.y; let tz = (float)wp.z + 0.5;
                let pdx = tx - self.x; let pdz = tz - self.z;
                let pdist = (float)sqrt(pdx*pdx + pdz*pdz);
                if pdist > 0.3 {
                    self.yaw = (float)atan2(pdz, pdx);
                    self.vx = (pdx / pdist) * ZIBI_SPEED;
                    self.vz = (pdz / pdist) * ZIBI_SPEED;
                } else {
                    self.vx = 0.0; self.vz = 0.0;
                }

                // Advance when close enough (allow small vertical tolerance)
                if pdist < 0.6 && (float)fabs(ty - self.y) < 1.8 { self.path_idx++; }
            } else {
                // Path done or empty — check if close to waypoint target
                let wdx = (float)self.waypoint_target_x + 0.5 - self.x;
                let wdz = (float)self.waypoint_target_z + 0.5 - self.z;
                let wdist = (float)sqrt(wdx*wdx + wdz*wdz);
                
                if wdist < 1.5 {
                    // Reached waypoint — try to pick a nearby waypoint that is closer to the obelisk
                    let wpx = 0; let wpy = 0; let wpz = 0;
                    if find_next_waypoint_towards_goal(chunks, num_chunks,
                        self.waypoint_target_x, self.waypoint_target_y, self.waypoint_target_z,
                        (int)self.target_x, (int)self.target_y, (int)self.target_z,
                        &wpx, &wpy, &wpz) == 1 {
                        self.waypoint_target_x = wpx;
                        self.waypoint_target_y = wpy;
                        self.waypoint_target_z = wpz;
                        self.path_len = 0;
                        self.path_idx = 0;
                        self.path_timer = 0.0;
                    } else {
                        // Fallback: directly target the waypoint nearest the obelisk (goal side)
                        if find_nearest_waypoint(chunks, num_chunks, (int)self.target_x, (int)self.target_y, (int)self.target_z, &wpx, &wpy, &wpz) == 1 {
                            self.waypoint_target_x = wpx;
                            self.waypoint_target_y = wpy;
                            self.waypoint_target_z = wpz;
                            self.path_len = 0;
                            self.path_idx = 0;
                            self.path_timer = 0.0;
                        }
                    }
                } else if self.path_timer <= 0.0 {
                    // Compute path to current waypoint target (throttled)
                    self.path_timer = 1.5;
                    self.path_len = find_path(chunks, num_chunks,
                        (int)floor(self.x), (int)floor(self.y), (int)floor(self.z),
                        self.waypoint_target_x, self.waypoint_target_y, self.waypoint_target_z,
                        &self.path[0], MAX_PATH_LENGTH);
                    self.path_idx = 1; // skip start

                    // If path found, reset fail counter
                    if self.path_len > 0 { self.path_fail_count = 0; }

                    // If no path found to that waypoint, search nearby waypoints for a reachable one
                    if self.path_len == 0 {
                        let found_reachable = 0;
                        // scan surrounding chunks for candidate waypoints
                        let scx = (int)floor(self.x) >> 4; let scz = (int)floor(self.z) >> 4;
                        for cx_off in -1..2 {
                            for cz_off in -1..2 {
                                let ncx = scx + cx_off; let ncz = scz + cz_off;
                                let nidx = get_chunk_index(ncx, ncz);
                                if ncx < -32768 || ncz < -32768 { continue; }
                                if chunks[nidx].x != ncx || chunks[nidx].z != ncz { continue; }
                                let c = &chunks[nidx];
                                for wi in 0..c.waypoint_count {
                                    let wp = c.waypoints[wi];
                                    // skip if too far horizontally
                                    let ddx = wp.x - (int)floor(self.x); let ddz = wp.z - (int)floor(self.z);
                                    if (ddx*ddx + ddz*ddz) > (64*64) { continue; }
                                    let test_len = find_path(chunks, num_chunks,
                                        (int)floor(self.x), (int)floor(self.y), (int)floor(self.z),
                                        wp.x, wp.y, wp.z, &self.path[0], MAX_PATH_LENGTH);
                                    if test_len > 0 {
                                        // adopt this reachable waypoint
                                        self.waypoint_target_x = wp.x; self.waypoint_target_y = wp.y; self.waypoint_target_z = wp.z;
                                        self.path_len = test_len; self.path_idx = 1;
                                        self.path_fail_count = 0;
                                        found_reachable = 1; break;
                                    }
                                }
                                if found_reachable == 1 { break; }
                            }
                            if found_reachable == 1 { break; }
                        }

                        if found_reachable == 0 {
                            // As a last resort, try pathing directly to the obelisk target
                            let direct_len = find_path(chunks, num_chunks,
                                (int)floor(self.x), (int)floor(self.y), (int)floor(self.z),
                                (int)self.target_x, (int)self.target_y, (int)self.target_z,
                                &self.path[0], MAX_PATH_LENGTH);
                            if direct_len > 0 {
                                self.path_len = direct_len; self.path_idx = 1;
                                self.path_fail_count = 0;
                            } else {
                                // No reachable waypoint or direct path found: stop and retry later
                                self.vx = 0.0; self.vz = 0.0;
                                self.path_len = 0; self.path_idx = 0;
                                // Backoff: increase retry interval after repeated failures
                                self.path_fail_count++;
                                if self.path_fail_count >= 5 {
                                    self.path_timer = 5.0;
                                } else {
                                    self.path_timer = 1.5;
                                }
                            }
                        }
                    }
                }
            }
        }

        // === STATE: WORKER — idle at obelisk ===
        if self.state == ZIBI_WORKER {
            let time_up = 0;
            if self.state_timer <= 0.0 { time_up = 1; }
            
            // Small idle movement: occasionally shift position slightly
            if time_up == 1 {
                let r = rl::GetRandomValue(0, 100);
                if r < 30 {
                    // Idle stand
                    self.vx = 0.0;
                    self.vz = 0.0;
                    self.state_timer = (float)rl::GetRandomValue(20, 50) / 10.0;
                } else {
                    // Small wander near obelisk
                    self.state_timer = (float)rl::GetRandomValue(10, 25) / 10.0;
                    self.target_yaw = (float)rl::GetRandomValue(0, 360) * 0.0174533;
                    self.yaw = self.target_yaw;
                    self.vx = (float)cos(self.yaw) * ZIBI_SPEED * 0.3;
                    self.vz = (float)sin(self.yaw) * ZIBI_SPEED * 0.3;
                }
            }
            
            // Stay near obelisk — if too far, walk back
            let ox_diff = self.target_x - self.x;
            let oz_diff = self.target_z - self.z;
            let ob_dist = (float)sqrt(ox_diff*ox_diff + oz_diff*oz_diff);
            if ob_dist > 5.0 {
                self.yaw = (float)atan2(oz_diff, ox_diff);
                self.vx = (ox_diff / ob_dist) * ZIBI_SPEED * 0.5;
                self.vz = (oz_diff / ob_dist) * ZIBI_SPEED * 0.5;
            }
            
            // Look for mining banners nearby that need workers
            if time_up == 1 {
                let banner_found = 0;
                for sx in -4..5 {
                    for sz in -4..5 {
                        let c_idx = get_chunk_index(cx + sx, cz + sz);
                        if c_idx >= 0 {
                            for bi in 0..chunks[c_idx].banner_count {
                                if chunks[c_idx].banners[bi].active > 0 {
                                    // Check if this banner has fewer MINING zibis than assigned
                                    let active_miners = 0;
                                    let target_bx = chunks[c_idx].banners[bi].x + ((cx + sx) * 16);
                                    let target_by = chunks[c_idx].banners[bi].y;
                                    let target_bz = chunks[c_idx].banners[bi].z + ((cz + sz) * 16);
                                    
                                    for zi in 0..max_zibis {
                                        if zibis[zi].active == 1 && (zibis[zi].state == ZIBI_MINING || zibis[zi].state == ZIBI_LUMBERJACK) {
                                            if zibis[zi].mine_banner_x == target_bx && zibis[zi].mine_banner_y == target_by && zibis[zi].mine_banner_z == target_bz {
                                                active_miners++;
                                            }
                                        }
                                    }
                                    
                                    let target_assigned = chunks[c_idx].banners[bi].assigned_zibis;
                                    let target_priority_count = chunks[c_idx].banners[bi].priority_count;
                                    
                                    if active_miners < target_assigned {
                                        if rl::GetRandomValue(0, 100) < 30 {
                                            self.mine_banner_x = target_bx;
                                            self.mine_banner_y = target_by;
                                            self.mine_banner_z = target_bz;
                                            if chunks[c_idx].banners[bi].banner_type == 1 {
                                                self.state = ZIBI_LUMBERJACK;
                                            } else if chunks[c_idx].banners[bi].banner_type == 2 {
                                                self.state = ZIBI_ARCHER;
                                            } else {
                                                self.state = ZIBI_MINING;
                                            }
                                            self.mine_target_y = -999;
                                            self.mine_carrying_block = 0;
                                            banner_found = 1;
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                        if banner_found == 1 { break; }
                    }
                    if banner_found == 1 { break; }
                }
            }
        }

        // === STATE: FOLLOW PLAYER — no obelisks nearby ===
        if self.state == ZIBI_FOLLOW_PLAYER {
            // Re-check for obelisks periodically
            if self.state_timer <= 0.0 {
                self.state_timer = 3.0;
                if self.find_obelisk(chunks, num_chunks) == 1 {
                    self.state = ZIBI_WALK_TO_OBELISK;
                }
            }
            
            let is_night = (day_time > 0.5);
            let found_light = 0;
            let target_lx = 0.0;
            let target_lz = 0.0;
            
            if is_night {
                let best_light = 0;
                let bx = (int)floor(self.x);
                let bz = (int)floor(self.z);
                let by = (int)floor(self.y + 0.8);
                // Scan 5x5 blocks around zibi for highest light level
                for sx in -6..7 {
                    for sz in -6..7 {
                        let packed_light = get_light_levels(chunks, num_chunks, bx + sx, by, bz + sz);
                        let l_val = packed_light & 0xF; // Extract single light component to judge brightness
                        if l_val > best_light {
                            best_light = l_val;
                            target_lx = (float)(bx + sx) + 0.5; // center of block
                            target_lz = (float)(bz + sz) + 0.5;
                        }
                    }
                }
                
                if best_light >= 8 {
                    found_light = 1;
                }
            }
            
            let dx = player_x - self.x;
            let dz = player_z - self.z;
            
            if found_light == 1 {
                // Ignore player, walk to light
                dx = target_lx - self.x;
                dz = target_lz - self.z;
            }
            
            let dist_to_target = (float)sqrt(dx*dx + dz*dz);
            let min_dist = 1.5;
            if found_light == 0 { min_dist = 4.0; }
            
            // Decrease path timer
            self.path_timer -= dt;

            if dist_to_target > min_dist {
                // If moderately far enough, attempt pathing (throttled)
                if dist_to_target > 2.0 && self.path_timer <= 0.0 {
                    self.path_timer = 1.5;
                    self.path_len = find_path(chunks, num_chunks,
                        (int)floor(self.x), (int)floor(self.y), (int)floor(self.z),
                        (int)floor(player_x), (int)floor(player_y), (int)floor(player_z),
                        &self.path[0], MAX_PATH_LENGTH);
                    self.path_idx = 1;
                }

                if self.path_idx < self.path_len {
                    let wp = (&self.path[0])[self.path_idx];
                    let tx = (float)wp.x + 0.5; let tz = (float)wp.z + 0.5;
                    let pdx = tx - self.x; let pdz = tz - self.z;
                    let pdist = (float)sqrt(pdx*pdx + pdz*pdz);
                    if pdist > 0.3 {
                        self.yaw = (float)atan2(pdz, pdx);
                        self.vx = (pdx / pdist) * ZIBI_SPEED * (found_light ? 1.0 : 1.5);
                        self.vz = (pdz / pdist) * ZIBI_SPEED * (found_light ? 1.0 : 1.5);
                    } else { self.vx = 0.0; self.vz = 0.0; }
                    if pdist < 0.6 { self.path_idx++; }
                } else {
                    self.yaw = (float)atan2(dz, dx);
                    self.vx = (dx / dist_to_target) * ZIBI_SPEED * (found_light ? 1.0 : 1.5);
                    self.vz = (dz / dist_to_target) * ZIBI_SPEED * (found_light ? 1.0 : 1.5);
                }
            } else {
                self.vx = 0.0;
                self.vz = 0.0;
                if rl::GetRandomValue(0, 100) < 5 { self.yaw = (float)atan2(dz, dx); }
            }
            
            // Despawn if getting lost completely (only relative to player)
            let p_dx = player_x - self.x;
            let p_dz = player_z - self.z;
            if (float)sqrt(p_dx*p_dx + p_dz*p_dz) > 120.0 {
                 self.active = 0;
                 return 0;
            }
        }
        
        // === STATE: MINING ===
        if self.state == ZIBI_MINING {
            // Check if banner is still valid
            let bcx = (int)floor((float)self.mine_banner_x / 16.0);
            let bcz = (int)floor((float)self.mine_banner_z / 16.0);
            let target_chunk = get_chunk_index(bcx, bcz);
            
            let is_banner_valid = 0;
            let priority_count = 0;
            let priority_list: int[8];
            
            if target_chunk >= 0 {
                let bx_rel = self.mine_banner_x - (bcx * 16);
                let bz_rel = self.mine_banner_z - (bcz * 16);
                for bi in 0..chunks[target_chunk].banner_count {
                    if chunks[target_chunk].banners[bi].active > 0 &&
                       chunks[target_chunk].banners[bi].x == bx_rel && 
                       chunks[target_chunk].banners[bi].y == self.mine_banner_y && 
                       chunks[target_chunk].banners[bi].z == bz_rel {
                        is_banner_valid = 1;
                        
                        // [NEW] Check if we are still assigned to this banner
                        let active_miners = 0;
                        let my_idx_in_mining = -1;
                        for zi in 0..max_zibis {
                            if zibis[zi].active == 1 && zibis[zi].state == ZIBI_MINING {
                                if zibis[zi].mine_banner_x == self.mine_banner_x && 
                                   zibis[zi].mine_banner_y == self.mine_banner_y && 
                                   zibis[zi].mine_banner_z == self.mine_banner_z {
                                    
                                    if &zibis[zi] == self {
                                        my_idx_in_mining = active_miners;
                                    }
                                    active_miners++;
                                }
                            }
                        }
                        
                        if my_idx_in_mining >= chunks[target_chunk].banners[bi].assigned_zibis {
                            // Too many zibis mining here! I'll leave.
                            is_banner_valid = 0; 
                        }
                        
                        // Copy priorities
                        priority_count = chunks[target_chunk].banners[bi].priority_count;
                        for pi in 0..priority_count {
                            priority_list[pi] = chunks[target_chunk].banners[bi].priority_blocks[pi];
                        }
                        break;
                    }
                }
            }
            
            if is_banner_valid == 0 {
                // Banner destroyed or deactivated, return to work
                if self.find_obelisk(chunks, num_chunks) == 1 {
                    self.state = ZIBI_WALK_TO_OBELISK;
                } else {
                    self.state = ZIBI_FOLLOW_PLAYER;
                    self.state_timer = 2.0;
                }
                self.mine_target_y = -999;
                self.mine_timer = 0.0;
            } else {
                // Determine sub-state based on carrying
                if self.mine_carrying_block != 0 {
                    // CARRYING: Find chest and walk to it
                    let chest_found = 0;
                    let chest_x = 0; let chest_y = 0; let chest_z = 0;
                    
                    for sx in -8..9 {
                        for sy in -3..4 {
                            for sz in -8..9 {
                                let wx = self.mine_banner_x + sx;
                                let wy = self.mine_banner_y + sy;
                                let wz = self.mine_banner_z + sz;
                                if get_block(chunks, num_chunks, wx, wy, wz) == BLOCK_CHEST {
                                    chest_found = 1;
                                    chest_x = wx; chest_y = wy; chest_z = wz;
                                    break;
                                }
                            }
                            if chest_found == 1 { break; }
                        }
                        if chest_found == 1 { break; }
                    }
                    
                    if chest_found == 1 {
                        let cdx = (float)chest_x + 0.5 - self.x;
                        let cdz = (float)chest_z + 0.5 - self.z;
                        let cdist = (float)sqrt(cdx*cdx + cdz*cdz);
                        if cdist < 1.8 { // Generous distance to deposit
                            self.vx = 0.0;
                            self.vz = 0.0;
                            let ci = 0; let chi = 0;
                            if find_chest_at(chunks, num_chunks, chest_x, chest_y, chest_z, &ci, &chi) == 1 {
                                inv_add_item(&chunks[ci].chests[chi].items, self.mine_carrying_block);
                                self.mine_carrying_block = 0; // Empty hands
                            }
                        } else {
                            // Walk to chest
                            self.yaw = (float)atan2(cdz, cdx);
                            self.vx = (cdx / cdist) * ZIBI_SPEED;
                            self.vz = (cdz / cdist) * ZIBI_SPEED;
                        }
                    } else {
                        // Carrying block but no chest? Wait peacefully near banner
                        let bdx = (float)self.mine_banner_x + 0.5 - self.x;
                        let bdz = (float)self.mine_banner_z + 0.5 - self.z;
                        let bdist = (float)sqrt(bdx*bdx + bdz*bdz);
                        
                        if bdist > 3.0 {
                            self.yaw = (float)atan2(bdz, bdx);
                            self.vx = (bdx / bdist) * ZIBI_SPEED * 0.5;
                            self.vz = (bdz / bdist) * ZIBI_SPEED * 0.5;
                        } else {
                            // Peaceful wander while waiting
                            self.state_timer -= dt;
                            if self.state_timer <= 0.0 {
                                self.state_timer = (float)rl::GetRandomValue(15, 40) / 10.0;
                                self.yaw = (float)rl::GetRandomValue(0, 628) / 100.0;
                                self.vx = (float)cos(self.yaw) * ZIBI_SPEED * 0.4;
                                self.vz = (float)sin(self.yaw) * ZIBI_SPEED * 0.4;
                            }
                        }
                    }
                } else {
                    // NOT CARRYING: Mine
                    if self.mine_target_y == -999 {
                        // Find a new block to mine
                        let found = 0;
                        
                        // Determine mining direction (dig BACKWARDS from the banner's facing direction)
                        let dir_x = 0; let dir_z = 0;
                        let banner_dir = 0; // Default
                        let bcx = (int)floor((float)self.mine_banner_x / 16.0);
                        let bcz = (int)floor((float)self.mine_banner_z / 16.0);
                        let bidx = get_chunk_index(bcx, bcz);
                        if chunks[bidx].x == bcx && chunks[bidx].z == bcz {
                            for bi in 0..chunks[bidx].banner_count {
                                if chunks[bidx].banners[bi].x == (self.mine_banner_x - bcx * 16) &&
                                   chunks[bidx].banners[bi].y == self.mine_banner_y &&
                                   chunks[bidx].banners[bi].z == (self.mine_banner_z - bcz * 16) {
                                    banner_dir = chunks[bidx].banners[bi].active - 1;
                                    break;
                                }
                            }
                        }
                        
                        // Mine in the direction the banner is FACING
                        if banner_dir == 0 { dir_x = -1; dir_z = 0; }      
                        else if banner_dir == 1 { dir_x = 0; dir_z = -1; }  
                        else if banner_dir == 2 { dir_x = 1; dir_z = 0; } 
                        else if banner_dir == 3 { dir_x = 0; dir_z = 1; }
                        
                        if dir_x == 0 && dir_z == 0 { dir_x = 1; } // Fallback
                                                
                        let perp_x = -dir_z;
                        let perp_z = dir_x;
                        let target_wx = 0; let target_wy = 0; let target_wz = 0;
                        let is_priority_hit = 0;

                        // SEQUENTIAL SCAN: Ensures tunnel is dug in order and priority items are reached correctly
                        for d in 1..40 {
                            let floor_y = self.mine_banner_y - (d / 3);

                            // Decide lateral range: start galleries at depth >=6 and every 3 levels
                            let depth_level = self.mine_banner_y - floor_y;
                            let gallery_level = 0;
                            if depth_level >= 6 && ((depth_level - 6) % 3) == 0 { gallery_level = 1; }
                            let wmin = -1; let wmax = 2;
                            // If this depth is a gallery level, use width=3 and coordinate among assigned miners
                            if gallery_level == 1 {
                                let per_miner_width = 3; // each miner gets a 3-block-wide strip
                                // Find banner index in chunk to read assigned_zibis
                                let banner_idx = -1;
                                if target_chunk >= 0 {
                                    let bx_rel = self.mine_banner_x - (bcx * 16);
                                    let bz_rel = self.mine_banner_z - (bcz * 16);
                                    for bbi in 0..chunks[target_chunk].banner_count {
                                        if chunks[target_chunk].banners[bbi].active > 0 && chunks[target_chunk].banners[bbi].x == bx_rel && chunks[target_chunk].banners[bbi].y == self.mine_banner_y && chunks[target_chunk].banners[bbi].z == bz_rel {
                                            banner_idx = bbi; break;
                                        }
                                    }
                                }

                                let assigned_total = 1;
                                if banner_idx != -1 { assigned_total = chunks[target_chunk].banners[banner_idx].assigned_zibis; if assigned_total < 1 { assigned_total = 1; } }

                                // Compute this zibi's index among active miners for this banner
                                let my_idx = 0; let idx_cnt = 0;
                                for zi in 0..max_zibis {
                                    if zibis[zi].active == 1 && zibis[zi].state == ZIBI_MINING {
                                        if zibis[zi].mine_banner_x == self.mine_banner_x && zibis[zi].mine_banner_y == self.mine_banner_y && zibis[zi].mine_banner_z == self.mine_banner_z {
                                            if &zibis[zi] == self { my_idx = idx_cnt; }
                                            idx_cnt++;
                                        }
                                    }
                                }
                                if idx_cnt > 0 { if assigned_total < idx_cnt { assigned_total = idx_cnt; } }

                                // Center the strips around banner: compute starting offset for this miner
                                let center_off = -((assigned_total - 1) * per_miner_width) / 2;
                                let start = center_off + my_idx * per_miner_width;
                                wmin = start;
                                wmax = start + per_miner_width - 1;
                            }

                            // Check distance d for ANY solid block (scan wider for gallery levels)
                            let d_has_any_solid = 0;
                            for h in 0..4 {
                                for w in wmin..wmax {
                                    let wx = self.mine_banner_x + (dir_x * d) + (perp_x * w);
                                    let wy = floor_y + h;
                                    let wz = self.mine_banner_z + (dir_z * d) + (perp_z * w);
                                    let b = get_block(chunks, num_chunks, wx, wy, wz);
                                    if is_transparent(b) == 0 { d_has_any_solid = 1; break; }
                                }
                                if d_has_any_solid == 1 { break; }
                            }
                            
                            if d_has_any_solid == 1 {
                                // This distance is where the current wall is.
                                // Pass 1: Local priority at this distance
                                if priority_count > 0 {
                                    for h in 0..4 {
                                            for w in wmin..wmax {
                                                let wx = self.mine_banner_x + (dir_x * d) + (perp_x * w);
                                                let wy = floor_y + h;
                                                let wz = self.mine_banner_z + (dir_z * d) + (perp_z * w);
                                                let b = get_block(chunks, num_chunks, wx, wy, wz);
                                                for pi in 0..priority_count {
                                                    if b == priority_list[pi] {
                                                        if rl::GetRandomValue(0, 100) < 30 { continue; }
                                                        target_wx = wx; target_wy = wy; target_wz = wz;
                                                        found = 1; break;
                                                    }
                                                }
                                                if found == 1 { break; }
                                            }
                                            if found == 1 { break; }
                                        }
                                }
                                
                                // Pass 2: If no priority here, pick the first solid block at this distance (top down)
                                if found == 0 {
                                    for h in 0..4 {
                                            let real_h = 3 - h;
                                            for w in wmin..wmax {
                                                let wx = self.mine_banner_x + (dir_x * d) + (perp_x * w);
                                                let wy = floor_y + real_h;
                                                let wz = self.mine_banner_z + (dir_z * d) + (perp_z * w);
                                                let b = get_block(chunks, num_chunks, wx, wy, wz);
                                                if is_transparent(b) == 0 {
                                                    if rl::GetRandomValue(0, 100) < 30 { continue; }
                                                    target_wx = wx; target_wy = wy; target_wz = wz;
                                                    found = 1; break;
                                                }
                                            }
                                            if found == 1 { break; }
                                        }
                                }
                            }
                            
                            if found == 1 { break; }
                        }
                        
                        if found == 1 {
                            self.mine_target_x = target_wx;
                            self.mine_target_y = target_wy;
                            self.mine_target_z = target_wz;
                            self.mine_timer = 0.0;
                            self.state_timer = 20.0; // 20s to pathfind and mine
                            // reset any previous path so we'll compute a new one to the mine target
                            self.path_len = 0; self.path_idx = 0; self.path_timer = 0.0;
                        }
                        
                        // If really no block found at all, idle near banner
                        if found == 0 {
                            // Periodically scan for nearby dangerous holes and attempt to fill them
                            self.mine_wait_timer -= dt;
                            if self.mine_wait_timer <= 0.0 {
                                self.mine_wait_timer = 3.0; // throttle scanning
                                let hole_handled = 0;
                                // Scan a local area around the banner for a vertical shaft (a "hole")
                                for sx in -6..7 {
                                    for sz in -6..7 {
                                        for hy in (self.mine_banner_y - 8)..self.mine_banner_y {
                                            let wx = self.mine_banner_x + sx;
                                            let wy = hy;
                                            let wz = self.mine_banner_z + sz;
                                            // Define a hole as at least two empty blocks downward
                                            if get_block(chunks, num_chunks, wx, wy, wz) == BLOCK_AIR && get_block(chunks, num_chunks, wx, wy - 1, wz) == BLOCK_AIR {
                                                // Try to fetch wood from a nearby chest (within radius)
                                                let chest_found = 0;
                                                let chest_x = 0; let chest_y = 0; let chest_z = 0;
                                                for csx in -8..9 {
                                                    for csy in -3..4 {
                                                        for csz in -8..9 {
                                                            let cxw = self.mine_banner_x + csx;
                                                            let cyw = self.mine_banner_y + csy;
                                                            let czw = self.mine_banner_z + csz;
                                                            if get_block(chunks, num_chunks, cxw, cyw, czw) == BLOCK_CHEST {
                                                                chest_found = 1;
                                                                chest_x = cxw; chest_y = cyw; chest_z = czw;
                                                                break;
                                                            }
                                                        }
                                                        if chest_found == 1 { break; }
                                                    }
                                                    if chest_found == 1 { break; }
                                                }

                                                if chest_found == 1 {
                                                    let ci = 0; let chi = 0;
                                                    if find_chest_at(chunks, num_chunks, chest_x, chest_y, chest_z, &ci, &chi) == 1 {
                                                        // Look for wood (logs or planks)
                                                        let removed = 0;
                                                        for si in 0..INV_SLOTS {
                                                            let st = &chunks[ci].chests[chi].items.slots[si];
                                                            if st.block_type == BLOCK_LOG || st.block_type == BLOCK_PLANKS {
                                                                // Remove one item and place a plank at the hole top
                                                                let bgot = inv_remove_item(&chunks[ci].chests[chi].items, si);
                                                                if bgot != BLOCK_AIR {
                                                                    set_block(chunks, num_chunks, wx, wy, wz, BLOCK_PLANKS);
                                                                    self.mine_waiting_for_wood = 0;
                                                                    let mx = (int)floor((float)wx / 16.0);
                                                                    let mz = (int)floor((float)wz / 16.0);
                                                                    let midx = get_chunk_index(mx, mz);
                                                                    if midx >= 0 {
                                                                        request_mesh_async(midx, 1);
                                                                        request_light_async(midx, 4, 1);
                                                                        chunks[midx].grass_deco_built = 0;
                                                                        request_save_async(&chunks[midx]);
                                                                    }
                                                                    removed = 1;
                                                                        // Clear banner need flag since we placed wood
                                                                        if target_chunk >= 0 {
                                                                            let bx_rel2 = self.mine_banner_x - (bcx * 16);
                                                                            let bz_rel2 = self.mine_banner_z - (bcz * 16);
                                                                            for bbi2 in 0..chunks[target_chunk].banner_count {
                                                                                if chunks[target_chunk].banners[bbi2].active > 0 && chunks[target_chunk].banners[bbi2].x == bx_rel2 && chunks[target_chunk].banners[bbi2].y == self.mine_banner_y && chunks[target_chunk].banners[bbi2].z == bz_rel2 {
                                                                                    chunks[target_chunk].banners[bbi2].need_wood = 0;
                                                                                    chunks[target_chunk].banners[bbi2].need_timer = 0.0;
                                                                                    break;
                                                                                }
                                                                            }
                                                                        }
                                                                }
                                                            }
                                                            if removed == 1 { break; }
                                                        }

                                                        if removed == 1 {
                                                            hole_handled = 1;
                                                            break;
                                                        } else {
                                                            // Chest found but no wood — wait at banner and signal need
                                                            self.mine_waiting_for_wood = 1;
                                                            self.mine_wait_timer = 5.0;
                                                            // Move to banner position and stay there
                                                            let bdx = (float)self.mine_banner_x + 0.5 - self.x;
                                                            let bdz = (float)self.mine_banner_z + 0.5 - self.z;
                                                            let bdist = (float)sqrt(bdx*bdx + bdz*bdz);
                                                            if bdist > 1.5 {
                                                                self.yaw = (float)atan2(bdz, bdx);
                                                                self.vx = (bdx / bdist) * ZIBI_SPEED * 0.5;
                                                                self.vz = (bdz / bdist) * ZIBI_SPEED * 0.5;
                                                            } else {
                                                                self.vx = 0.0; self.vz = 0.0;
                                                            }
                                                            // Also mark the banner so UI/render can show indicator
                                                            if target_chunk >= 0 {
                                                                let bx_rel = self.mine_banner_x - (bcx * 16);
                                                                let bz_rel = self.mine_banner_z - (bcz * 16);
                                                                for bbi in 0..chunks[target_chunk].banner_count {
                                                                    if chunks[target_chunk].banners[bbi].active > 0 && chunks[target_chunk].banners[bbi].x == bx_rel && chunks[target_chunk].banners[bbi].y == self.mine_banner_y && chunks[target_chunk].banners[bbi].z == bz_rel {
                                                                        chunks[target_chunk].banners[bbi].need_wood = 1;
                                                                        chunks[target_chunk].banners[bbi].need_timer = 5.0;
                                                                        break;
                                                                    }
                                                                }
                                                            }
                                                            hole_handled = 1;
                                                            break;
                                                        }
                                                    }
                                                }

                                                if hole_handled == 1 { break; }
                                            }
                                        }
                                        if hole_handled == 1 { break; }
                                    }
                                    if hole_handled == 1 { break; }
                                }
                            }

                            // Default idle if nothing to do
                            if self.mine_waiting_for_wood == 0 {
                                let bdx = (float)self.mine_banner_x + 0.5 - self.x;
                                let bdz = (float)self.mine_banner_z + 0.5 - self.z;
                                let bdist = (float)sqrt(bdx*bdx + bdz*bdz);
                                if bdist > 3.0 {
                                    self.yaw = (float)atan2(bdz, bdx);
                                    self.vx = (bdx / bdist) * ZIBI_SPEED * 0.5;
                                    self.vz = (bdz / bdist) * ZIBI_SPEED * 0.5;
                                } else {
                                    self.vx = 0.0;
                                    self.vz = 0.0;
                                }
                            }
                        }
                    } else {
                        // Have a target, go mine it!
                        let tdx = (float)self.mine_target_x + 0.5 - self.x;
                        let tdy = (float)self.mine_target_y + 0.5 - self.y;
                        let tdz = (float)self.mine_target_z + 0.5 - self.z;
                        let tdist_3d = (float)sqrt(tdx*tdx + tdy*tdy + tdz*tdz);
                        let b = get_block(chunks, num_chunks, self.mine_target_x, self.mine_target_y, self.mine_target_z);
                        
                        if b == BLOCK_AIR {
                            // Target is gone (mined by someone else?)
                            self.mine_target_y = -999;
                        } else if tdist_3d < 2.0 { // Strict 3D distance check to prevent mining through walls
                            // Close enough to mine!
                            self.vx = 0.0; self.vz = 0.0;
                            self.yaw = (float)atan2(tdz, tdx);
                            self.mine_timer += dt; 
                            
                            if self.mine_timer > 3.0 { // takes 3s to mine
                                // Final check of what is currently at target
                                let final_b = get_block(chunks, num_chunks, self.mine_target_x, self.mine_target_y, self.mine_target_z);
                                if final_b == BLOCK_AIR { self.mine_target_y = -999; self.mine_timer = 0.0; return 1; }

                                self.mine_carrying_block = final_b;
                                set_block(chunks, MAX_CHUNKS, self.mine_target_x, self.mine_target_y, self.mine_target_z, BLOCK_AIR);
                                spawn_explosion((float)self.mine_target_x+0.5, (float)self.mine_target_y+0.5, (float)self.mine_target_z+0.5, 5, rl::GRAY);
                                
                                // Also destroy any plants or decorations resting on top of this block
                                let top_b = get_block(chunks, num_chunks, self.mine_target_x, self.mine_target_y + 1, self.mine_target_z);
                                if top_b == BLOCK_TALLGRASS || top_b == BLOCK_CACTUS || top_b == BLOCK_SNOW || top_b == BLOCK_TORCH || top_b == BLOCK_TORCH_N || top_b == BLOCK_TORCH_S || top_b == BLOCK_TORCH_E || top_b == BLOCK_TORCH_W {
                                    set_block(chunks, MAX_CHUNKS, self.mine_target_x, self.mine_target_y + 1, self.mine_target_z, BLOCK_AIR);
                                    spawn_explosion((float)self.mine_target_x+0.5, (float)self.mine_target_y+1.5, (float)self.mine_target_z+0.5, 3, rl::GREEN);
                                }
                                
                                // Reset mesh
                                let mx = (int)floor((float)self.mine_target_x / 16.0);
                                let mz = (int)floor((float)self.mine_target_z / 16.0);
                                let midx = get_chunk_index(mx, mz);
                                if midx >= 0 {
                                    request_mesh_async(midx, 1);
                                    request_light_async(midx, 4, 1);
                                    chunks[midx].grass_deco_built = 0;
                                    request_save_async(&chunks[midx]);
                                }
                                
                                let idx_xm = get_chunk_index(mx - 1, mz); let idx_xp = get_chunk_index(mx + 1, mz);
                                let idx_zm = get_chunk_index(mx, mz - 1); let idx_zp = get_chunk_index(mx, mz + 1);
                                
                                if idx_xm >= 0 && chunks[idx_xm].x == mx - 1 && chunks[idx_xm].z == mz { request_mesh_async(idx_xm, 1); request_light_async(idx_xm, 4, 1); chunks[idx_xm].grass_deco_built = 0; }
                                if idx_xp >= 0 && chunks[idx_xp].x == mx + 1 && chunks[idx_xp].z == mz { request_mesh_async(idx_xp, 1); request_light_async(idx_xp, 4, 1); chunks[idx_xp].grass_deco_built = 0; }
                                if idx_zm >= 0 && chunks[idx_zm].x == mx && chunks[idx_zm].z == mz - 1 { request_mesh_async(idx_zm, 1); request_light_async(idx_zm, 4, 1); chunks[idx_zm].grass_deco_built = 0; }
                                if idx_zp >= 0 && chunks[idx_zp].x == mx && chunks[idx_zp].z == mz + 1 { request_mesh_async(idx_zp, 1); request_light_async(idx_zp, 4, 1); chunks[idx_zp].grass_deco_built = 0; }
                                
                                self.mine_target_y = -999; // Reset target
                                self.mine_timer = 0.0;
                            }
                        } else {
                            // Use pathfinding to approach mine target (throttled)
                            self.path_timer -= dt;
                            if self.path_idx < self.path_len {
                                let wp = (&self.path[0])[self.path_idx];
                                let tx = (float)wp.x + 0.5; let ty = (float)wp.y; let tz = (float)wp.z + 0.5;
                                let pdx = tx - self.x; let pdz = tz - self.z;
                                let pdist = (float)sqrt(pdx*pdx + pdz*pdz);
                                if pdist > 0.3 {
                                    self.yaw = (float)atan2(pdz, pdx);
                                    self.vx = (pdx / pdist) * ZIBI_SPEED;
                                    self.vz = (pdz / pdist) * ZIBI_SPEED;
                                } else { self.vx = 0.0; self.vz = 0.0; }
                                if pdist < 0.6 && (float)fabs(ty - self.y) < 1.8 { self.path_idx++; }
                            } else {
                                if self.mine_target_y != -999 && self.path_timer <= 0.0 {
                                    self.path_timer = 1.5;
                                    self.path_len = find_path(chunks, num_chunks,
                                        (int)floor(self.x), (int)floor(self.y), (int)floor(self.z),
                                        self.mine_target_x, self.mine_target_y, self.mine_target_z,
                                        &self.path[0], MAX_PATH_LENGTH);
                                    self.path_idx = 1;
                                }

                                // Fallback direct movement if no path
                                if self.path_len == 0 {
                                    self.yaw = (float)atan2(tdz, tdx);
                                    self.vx = (tdx / tdist_3d) * ZIBI_SPEED;
                                    self.vz = (tdz / tdist_3d) * ZIBI_SPEED;
                                }
                            }

                            // Use state_timer as a pathing timeout
                            self.state_timer -= dt;
                            if self.state_timer <= 0.0 {
                                self.mine_target_y = -999; // Give up
                            }
                        }
                    }
                }
            }
        }
        
        // === STATE: LUMBERJACK — chop trees near lumber banner ===
        if self.state == ZIBI_LUMBERJACK {
            // Check if lumber banner still exists
            let bcx = (int)floor((float)self.mine_banner_x / 16.0);
            let bcz = (int)floor((float)self.mine_banner_z / 16.0);
            let target_chunk = get_chunk_index(bcx, bcz);
            
            let is_banner_valid = 0;
            if target_chunk >= 0 {
                let bx_rel = self.mine_banner_x - (bcx * 16);
                let bz_rel = self.mine_banner_z - (bcz * 16);
                for bi in 0..chunks[target_chunk].banner_count {
                    if chunks[target_chunk].banners[bi].active > 0 &&
                       chunks[target_chunk].banners[bi].banner_type == 1 &&
                       chunks[target_chunk].banners[bi].x == bx_rel && 
                       chunks[target_chunk].banners[bi].y == self.mine_banner_y && 
                       chunks[target_chunk].banners[bi].z == bz_rel {
                        is_banner_valid = 1;
                        break;
                    }
                }
            }
            
            if is_banner_valid == 0 {
                // Banner gone, return to obelisk
                if self.find_obelisk(chunks, num_chunks) == 1 {
                    self.state = ZIBI_WALK_TO_OBELISK;
                } else {
                    self.state = ZIBI_FOLLOW_PLAYER;
                    self.state_timer = 2.0;
                }
                self.mine_target_y = -999;
                self.mine_carrying_block = 0;
            } else {
                if self.mine_carrying_block != 0 {
                    // CARRYING: Find chest and walk to it (same as mining)
                    let chest_found = 0;
                    let chest_x = 0; let chest_y = 0; let chest_z = 0;
                    
                    for sx in -8..9 {
                        for sy in -3..4 {
                            for sz in -8..9 {
                                let wx = self.mine_banner_x + sx;
                                let wy = self.mine_banner_y + sy;
                                let wz = self.mine_banner_z + sz;
                                if get_block(chunks, num_chunks, wx, wy, wz) == BLOCK_CHEST {
                                    chest_found = 1;
                                    chest_x = wx; chest_y = wy; chest_z = wz;
                                    break;
                                }
                            }
                            if chest_found == 1 { break; }
                        }
                        if chest_found == 1 { break; }
                    }
                    
                    if chest_found == 1 {
                        let cdx = (float)chest_x + 0.5 - self.x;
                        let cdz = (float)chest_z + 0.5 - self.z;
                        let cdist = (float)sqrt(cdx*cdx + cdz*cdz);
                        
                        if cdist < 1.8 {
                            // Deposit block
                            let out_ci = 0; let out_chi = 0;
                            if find_chest_at(chunks, num_chunks, chest_x, chest_y, chest_z, &out_ci, &out_chi) == 1 {
                                inv_add_item(&chunks[out_ci].chests[out_chi].items, self.mine_carrying_block);
                            }
                            self.mine_carrying_block = 0;
                            self.vx = 0.0; self.vz = 0.0;
                        } else {
                            self.yaw = (float)atan2(cdz, cdx);
                            self.vx = (cdx / cdist) * ZIBI_SPEED;
                            self.vz = (cdz / cdist) * ZIBI_SPEED;
                        }
                    } else {
                        // No chest, wander near banner
                        self.state_timer -= dt;
                        if self.state_timer <= 0.0 {
                            self.state_timer = (float)rl::GetRandomValue(20, 40) / 10.0;
                            self.yaw = (float)rl::GetRandomValue(0, 628) / 100.0;
                            self.vx = (float)cos(self.yaw) * ZIBI_SPEED * 0.3;
                            self.vz = (float)sin(self.yaw) * ZIBI_SPEED * 0.3;
                        }
                    }
                } else {
                    // NOT CARRYING: Find a LOG block to chop
                    if self.mine_target_y == -999 {
                        // Search for nearest LOG block within 20 blocks of banner
                        let best_dist = 999.0;
                        let found = 0;
                        let tx = 0; let ty = 0; let tz = 0;
                        
                        for dx in -20..21 {
                            for dz in -20..21 {
                                for dy in -5..30 {
                                    let wx = self.mine_banner_x + dx;
                                    let wy = self.mine_banner_y + dy;
                                    let wz = self.mine_banner_z + dz;
                                    let b = get_block(chunks, num_chunks, wx, wy, wz);
                                    if b == BLOCK_LOG {
                                        let fdx = (float)wx + 0.5 - self.x;
                                        let fdz = (float)wz + 0.5 - self.z;
                                        let d = (float)sqrt(fdx*fdx + fdz*fdz);
                                        if d < best_dist {
                                            best_dist = d;
                                            tx = wx; ty = wy; tz = wz;
                                            found = 1;
                                        }
                                    }
                                }
                            }
                        }
                        
                        if found == 1 {
                            self.mine_target_y = ty;
                            self.mine_timer = 0.0;
                            // Store target X/Z in waypoint_target fields temporarily
                            self.waypoint_target_x = tx;
                            self.waypoint_target_z = tz;
                            self.state_timer = 15.0; // Timeout
                        } else {
                            // No trees found, idle near banner
                            self.state_timer -= dt;
                            if self.state_timer <= 0.0 {
                                self.state_timer = (float)rl::GetRandomValue(30, 60) / 10.0;
                                self.yaw = (float)rl::GetRandomValue(0, 628) / 100.0;
                                self.vx = (float)cos(self.yaw) * ZIBI_SPEED * 0.3;
                                self.vz = (float)sin(self.yaw) * ZIBI_SPEED * 0.3;
                            }
                        }
                    } else {
                        // Walk to target LOG block
                        let tdx = (float)self.waypoint_target_x + 0.5 - self.x;
                        let tdz = (float)self.waypoint_target_z + 0.5 - self.z;
                        let tdist = (float)sqrt(tdx*tdx + tdz*tdz);
                        
                        // Verify the block is still LOG
                        let current_b = get_block(chunks, num_chunks, self.waypoint_target_x, self.mine_target_y, self.waypoint_target_z);
                        if current_b != BLOCK_LOG {
                            self.mine_target_y = -999; // Target gone, find new one
                            self.vx = 0.0; self.vz = 0.0;
                        } else if tdist < 2.5 {
                            // Close enough, chop!
                            self.vx = 0.0; self.vz = 0.0;
                            self.yaw = (float)atan2(tdz, tdx);
                            self.mine_timer += dt;
                            if self.mine_timer >= 1.5 {
                                // Chop the block!
                                set_block(chunks, num_chunks, self.waypoint_target_x, self.mine_target_y, self.waypoint_target_z, BLOCK_AIR);
                                self.mine_carrying_block = BLOCK_LOG;
                                self.mine_target_y = -999;
                                self.mine_timer = 0.0;
                                
                                // Spawn particles
                                spawn_particle(
                                    (float)self.waypoint_target_x + 0.5, 
                                    (float)self.mine_target_y + 0.5, 
                                    (float)self.waypoint_target_z + 0.5, 
                                    rl::Color{r: 101, g: 67, b: 33, a: 255}
                                );
                                
                                // Rebuild mesh
                                let mcx = (int)floor((float)self.waypoint_target_x / 16.0);
                                let mcz = (int)floor((float)self.waypoint_target_z / 16.0);
                                let mi = get_chunk_index(mcx, mcz);
                                if mi >= 0 {
                                    request_mesh_async(mi, 1);
                                    request_light_async(mi, 4, 1);
                                    request_save_async(&chunks[mi]);
                                }
                            }
                        } else {
                            // Walk toward tree
                            self.yaw = (float)atan2(tdz, tdx);
                            self.vx = (tdx / tdist) * ZIBI_SPEED;
                            self.vz = (tdz / tdist) * ZIBI_SPEED;
                        }
                        
                        self.state_timer -= dt;
                        if self.state_timer <= 0.0 {
                            self.mine_target_y = -999; // Timeout, find new target
                        }
                    }
                }
            }
        }
        
        // === STATE: COMBAT — fight back against attacker ===
        if self.state == ZIBI_COMBAT {
            self.combat_timer -= dt;
            if self.combat_timer <= 0.0 {
                // Return to previous state
                self.state = self.prev_state;
            } else {
                let dx = self.combat_target_x - self.x;
                let dz = self.combat_target_z - self.z;
                let dist_to_target = (float)sqrt(dx*dx + dz*dz);
                if dist_to_target > 1.2 {
                    self.yaw = (float)atan2(dz, dx);
                    self.vx = (dx / dist_to_target) * ZIBI_SPEED * 1.8;
                    self.vz = (dz / dist_to_target) * ZIBI_SPEED * 1.8;
                } else {
                    self.vx = 0.0;
                    self.vz = 0.0;
                }
                
                // Attack nearby wolves
                if self.attack_cooldown <= 0.0 {
                    for wi in 0..max_wolves {
                        if wolves[wi].active == 1 {
                            let wdx = wolves[wi].x - self.x;
                            let wdz = wolves[wi].z - self.z;
                            let wdist = (float)sqrt(wdx*wdx + wdz*wdz);
                            if wdist < 1.5 {
                                wolves[wi].take_damage(3);
                                self.attack_cooldown = 1.0;
                                // Update combat target to this wolf
                                self.combat_target_x = wolves[wi].x;
                                self.combat_target_z = wolves[wi].z;
                                self.combat_timer = 5.0; // refresh combat
                                break;
                            }
                        }
                    }
                }
            }
        }

        // --- Physics & Movement ---
        if self.state == ZIBI_WALK_TO_OBELISK || self.state == ZIBI_FOLLOW_PLAYER || self.state == ZIBI_WORKER || self.state == ZIBI_COMBAT || self.state == ZIBI_MINING || self.state == ZIBI_LUMBERJACK {
            // Smart obstacle avoidance
            let front_x = self.x + self.vx * 0.6;
            let front_z = self.z + self.vz * 0.6;
            
            if check_collision(chunks, num_chunks, front_x, self.y, front_z, ZIBI_WIDTH, ZIBI_HEIGHT) {
                // 1. Try to jump over 1-block walls
                let space_above = check_collision(chunks, num_chunks, self.x, self.y + 1.8, self.z, ZIBI_WIDTH, 0.4) == 0;
                if (space_above && check_collision(chunks, num_chunks, front_x, self.y + 1.2, front_z, ZIBI_WIDTH, ZIBI_HEIGHT) == 0) {
                    if (check_collision(chunks, num_chunks, self.x, self.y - 0.1, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) != 0) {
                        self.vy = 7.5; // Jump!
                    }
                } else {
                    // 2. Can't jump — try sliding around the obstacle
                    // Try perpendicular directions (left and right of current heading)
                    let perp_x = -self.vz; // Perpendicular vector
                    let perp_z = self.vx;
                    let speed = (float)sqrt(self.vx*self.vx + self.vz*self.vz);
                    if speed > 0.1 {
                        perp_x = perp_x / speed;
                        perp_z = perp_z / speed;
                    }
                    
                    // Try left slide
                    let try_lx = self.x + perp_x * 1.5;
                    let try_lz = self.z + perp_z * 1.5;
                    let left_clear = check_collision(chunks, num_chunks, try_lx, self.y, try_lz, ZIBI_WIDTH, ZIBI_HEIGHT) == 0;
                    
                    // Try right slide
                    let try_rx = self.x - perp_x * 1.5;
                    let try_rz = self.z - perp_z * 1.5;
                    let right_clear = check_collision(chunks, num_chunks, try_rx, self.y, try_rz, ZIBI_WIDTH, ZIBI_HEIGHT) == 0;
                    
                    if left_clear && !right_clear {
                        // Slide left
                        self.vx = perp_x * ZIBI_SPEED;
                        self.vz = perp_z * ZIBI_SPEED;
                        self.yaw = (float)atan2(perp_z, perp_x);
                    } else if right_clear && !left_clear {
                        // Slide right
                        self.vx = -perp_x * ZIBI_SPEED;
                        self.vz = -perp_z * ZIBI_SPEED;
                        self.yaw = (float)atan2(-perp_z, -perp_x);
                    } else if left_clear {
                        // Both clear, pick randomly
                        if rl::GetRandomValue(0, 1) == 0 {
                            self.vx = perp_x * ZIBI_SPEED;
                            self.vz = perp_z * ZIBI_SPEED;
                            self.yaw = (float)atan2(perp_z, perp_x);
                        } else {
                            self.vx = -perp_x * ZIBI_SPEED;
                            self.vz = -perp_z * ZIBI_SPEED;
                            self.yaw = (float)atan2(-perp_z, -perp_x);
                        }
                    } else {
                        // 3. Completely blocked — SUPER JUMP to escape holes
                        self.vx = 0.0;
                        self.vz = 0.0;
                        if (self.vy == 0.0) { 
                            let space_above = check_collision(chunks, num_chunks, self.x, self.y + 1.8, self.z, ZIBI_WIDTH, 0.4) == 0;
                            if (space_above) {
                                self.vy = 9.0; // Higher jump to escape 2-block deep quarries
                            }
                        }
                    }
                }
            }
        }
        
        // --- Boids: Separation ---
        let sep_x = 0.0;
        let sep_z = 0.0;
        let neighbors = 0;
        for zi in 0..max_zibis {
            if zibis[zi].active == 0 { continue; }
            if zibis[zi].x == self.x && zibis[zi].z == self.z { continue; } // skip self
            
            let cdx = self.x - zibis[zi].x;
            let cdz = self.z - zibis[zi].z;
            let cdist_sq = cdx*cdx + cdz*cdz;
            if cdist_sq > 0.001 && cdist_sq < 1.0 { // 1 block radius
                let cdist = (float)sqrt(cdist_sq);
                let push_strength = 1.0 - cdist; // stronger when closer
                sep_x += (cdx / cdist) * push_strength;
                sep_z += (cdz / cdist) * push_strength;
                neighbors++;
            }
        }
        
        if neighbors > 0 {
            self.vx += sep_x * 2.0; // apply push
            self.vz += sep_z * 2.0;
            // Optionally clamp velocity so they don't fly off
            let v_mag = (float)sqrt(self.vx*self.vx + self.vz*self.vz);
            if v_mag > ZIBI_SPEED * 1.5 {
                 self.vx = (self.vx / v_mag) * ZIBI_SPEED * 1.5;
                 self.vz = (self.vz / v_mag) * ZIBI_SPEED * 1.5;
            }
        }

        // --- Stuck Detection: Force path recalc if not moving enough ---
        if self.state == ZIBI_WALK_TO_OBELISK || self.state == ZIBI_FOLLOW_PLAYER {
            self.stuck_timer += dt;
            if self.stuck_timer >= 2.0 {
                // Check if we've moved significantly since last check
                let check_dx = self.x - self.last_stuck_check_x;
                let check_dz = self.z - self.last_stuck_check_z;
                let moved = (float)sqrt(check_dx*check_dx + check_dz*check_dz);
                
                if moved < 1.0 {
                    // Stuck! Clear path and force immediate recalc
                    self.path_len = 0;
                    self.path_idx = 0;
                    self.path_timer = 0.0;
                }
                
                self.stuck_timer = 0.0;
                self.last_stuck_check_x = self.x;
                self.last_stuck_check_z = self.z;
            }
        }

        // Gravity
        self.vy -= 18.0 * dt;
        
        // X movement
        let moved_x = self.vx * dt;
        self.x += moved_x;
        let blocked_x = 0;
        if check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
            self.x -= moved_x;
            blocked_x = 1;
        }
        
        // Z movement
        let moved_z = self.vz * dt;
        self.z += moved_z;
        let blocked_z = 0;
        if check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT) {
            self.z -= moved_z;
            blocked_z = 1;
        }
        
        // --- Jumping Logic ---
        // If we are grounded (vy == 0) and we got blocked moving forward, try to jump
        if (blocked_x == 1 || blocked_z == 1) && self.vy == 0.0 {
            // Check if jumping 1.1 blocks high would clear the obstacle in the direction we want to go
            let test_x = self.x;
            if blocked_x == 1 { test_x += moved_x; }
            let test_z = self.z;
            if blocked_z == 1 { test_z += moved_z; }
            
            let space_above = check_collision(chunks, num_chunks, self.x, self.y + 1.8, self.z, ZIBI_WIDTH, 0.4) == 0;
            if (space_above && check_collision(chunks, num_chunks, test_x, self.y + 1.2, test_z, ZIBI_WIDTH, ZIBI_HEIGHT) == 0) {
                self.vy = 7.5; // Jump!
            }
        }
        
        // Y movement
        self.y += self.vy * dt;
        if (check_collision(chunks, num_chunks, self.x, self.y, self.z, ZIBI_WIDTH, ZIBI_HEIGHT)) {
            self.y -= self.vy * dt; // Always revert position on Y collision
            self.vy = 0.0;
        }
        
        return 1;
    }
    
    fn draw(self, chunks: Chunk*, num_chunks: int, day_time: float) {
        if self.active == 0 { return; }
        // --- ZIBI RENDERING ---
        
        // --- Lighting Calc ---
        let lx = (int)floor(self.x);
        let ly = (int)floor(self.y + 0.8);
        let lz = (int)floor(self.z);
        let packed_light = get_light_levels(chunks, num_chunks, lx, ly, lz);
        
        // Base Colors mapped for DrawCube
        let c_skin = rl::Color{ r: 108, g: 202, b: 85, a: 255 };
        let c_tunic = rl::Color{ r: 141, g: 90, b: 50, a: 255 };
        let c_pants = rl::Color{ r: 75, g: 50, b: 41, a: 255 };
        let c_shoes = rl::Color{ r: 56, g: 94, b: 46, a: 255 };
        let c_white = rl::WHITE;
        
        // Worker tint: golden tunic
        if self.state == ZIBI_WORKER || self.state == ZIBI_WALK_TO_OBELISK {
            c_tunic = rl::Color{ r: 200, g: 170, b: 60, a: 255 };
        }
        
        // Invincibility glow (golden shimmer)
        if self.invincibility_timer > 0.0 {
            let shimmer = (int)(180.0 + 75.0 * (float)sin(self.anim_time * 8.0));
            c_skin = rl::Color{ r: 255, g: (char)shimmer, b: 50, a: 255 };
            c_tunic = rl::Color{ r: 255, g: (char)shimmer, b: 80, a: 255 };
        }
        
        // Hurt flash
        if self.hurt_flash > 0.0 {
            c_skin = rl::Color{ r: 255, g: 100, b: 100, a: 255 };
        }
        
        let sh = get_shader_lighting();
        let loc_use_entity = rl::GetShaderLocation(sh, "uUseEntityLight");
        let loc_entity_light = rl::GetShaderLocation(sh, "uEntityLight");
        
        rl::BeginShaderMode(sh);
        
        let use_ent = 1;
        if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, (any)&use_ent, rl::SHADER_UNIFORM_INT); }
        let el = rl::Vector2{x: (float)(packed_light & 0xF) / 15.0, y: (float)((packed_light >> 4) & 0xF) / 15.0};
        if loc_entity_light != -1 { rl::SetShaderValue(sh, loc_entity_light, (any)&el, rl::SHADER_UNIFORM_VEC2); }
        
        // Animation variables
        let limb_swing = 0.0;
        let is_moving = (self.state == ZIBI_WALK_TO_OBELISK || self.state == ZIBI_COMBAT || (self.state == ZIBI_MINING && (float)sqrt(self.vx*self.vx + self.vz*self.vz) > 0.3) || (self.state == ZIBI_LUMBERJACK && (float)sqrt(self.vx*self.vx + self.vz*self.vz) > 0.3) || (self.state == ZIBI_FOLLOW_PLAYER && (float)sqrt(self.vx*self.vx + self.vz*self.vz) > 0.3) || (self.state == ZIBI_WORKER && (float)sqrt(self.vx*self.vx + self.vz*self.vz) > 0.3));
        if is_moving { 
            limb_swing = (float)sin(self.anim_time * 12.0);
        }

        rl::rlPushMatrix();
        rl::rlTranslatef(self.x, self.y, self.z);
        rl::rlRotatef(self.yaw * 57.2958, 0.0, -1.0, 0.0);
        rl::rlScalef(0.5, 0.5, 0.5);
        
        // --- 1. LEGS (With Animation) ---
        // Left Leg (+Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 0.6, 0.15);
        rl::rlRotatef(limb_swing * 40.0, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.3, z: 0.0}, 0.25, 0.6, 0.2, c_pants);
        rl::DrawCube(rl::Vector3{x: 0.05, y: -0.65, z: 0.0}, 0.35, 0.1, 0.22, c_shoes);
        rl::rlPopMatrix();
        
        // Right Leg (-Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 0.6, -0.15);
        rl::rlRotatef(-limb_swing * 40.0, 0.0, 0.0, 1.0); 
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.3, z: 0.0}, 0.25, 0.6, 0.2, c_pants);
        rl::DrawCube(rl::Vector3{x: 0.05, y: -0.65, z: 0.0}, 0.35, 0.1, 0.22, c_shoes);
        rl::rlPopMatrix();
        
        // --- 2. BODY (Tunic) ---
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.95, z: 0.0}, 0.35, 0.7, 0.55, c_tunic);
        
        // --- 3. ARMS (With Animation) ---
        // Left Arm (+Z)
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 1.2, 0.35);
        rl::rlRotatef(-limb_swing * 40.0, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.25, z: 0.0}, 0.18, 0.6, 0.18, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 0.2, 0.25, 0.2, c_tunic);
        rl::rlPopMatrix();
        
        // Right Arm (-Z)
        let right_arm_swing = limb_swing * 40.0;
        if (self.state == ZIBI_MINING || self.state == ZIBI_LUMBERJACK) && self.mine_carrying_block == 0 && self.vx == 0.0 && self.vz == 0.0 && self.mine_target_y != -999 {
            right_arm_swing = 45.0 + (float)sin(self.anim_time * 20.0) * 45.0; // Rapid chop
        }
        
        rl::rlPushMatrix();
        rl::rlTranslatef(0.0, 1.2, -0.35);
        rl::rlRotatef(right_arm_swing, 0.0, 0.0, 1.0);
        rl::DrawCube(rl::Vector3{x: 0.0, y: -0.25, z: 0.0}, 0.18, 0.6, 0.18, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 0.2, 0.25, 0.2, c_tunic);
        
        // --- TOOL (only in combat, mining, or lumberjack) ---
        if self.state == ZIBI_COMBAT || ((self.state == ZIBI_MINING || self.state == ZIBI_LUMBERJACK) && self.mine_carrying_block == 0) {
            // Handle (wooden stick)
            rl::DrawCube(rl::Vector3{x: 0.0, y: -0.7, z: 0.0}, 0.08, 0.8, 0.08, rl::Color{r: 139, g: 90, b: 43, a: 255});
            // Pickaxe head (iron-gray)
            rl::DrawCube(rl::Vector3{x: 0.0, y: -1.05, z: 0.0}, 0.4, 0.08, 0.12, rl::Color{r: 160, g: 170, b: 180, a: 255});
            // Pointed tip
            rl::DrawCube(rl::Vector3{x: 0.2, y: -1.1, z: 0.0}, 0.12, 0.06, 0.08, rl::Color{r: 140, g: 150, b: 160, a: 255});
        }
        
        rl::rlPopMatrix();
        
        // --- CARRIED BLOCK ---
        if self.mine_carrying_block != 0 {
             rl::rlPushMatrix();
             rl::rlTranslatef(0.0, 1.25, 0.45);
             rl::rlScalef(0.4, 0.4, 0.4);
             let b_col = get_block_color(self.mine_carrying_block);
             rl::DrawCube(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 1.0, 1.0, 1.0, b_col);
             rl::DrawCubeWires(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 1.0, 1.0, 1.0, rl::BLACK);
             rl::rlPopMatrix();
        }

        // --- 4. HEAD ---
        let head_y = 1.55;
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y, z: 0.0}, 0.45, 0.55, 0.5, c_skin);
        
        // Ears
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: 0.3}, 0.08, 0.08, 0.2, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: 0.4}, 0.15, 0.15, 0.05, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: -0.3}, 0.08, 0.08, 0.2, c_skin);
        rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: -0.4}, 0.15, 0.15, 0.05, c_skin);
        
        // Eyes
        rl::DrawCube(rl::Vector3{x: 0.23, y: head_y + 0.05, z: 0.12}, 0.05, 0.12, 0.12, c_white);
        rl::DrawCube(rl::Vector3{x: 0.26, y: head_y + 0.05, z: 0.12}, 0.02, 0.04, 0.04, c_shoes);
        rl::DrawCube(rl::Vector3{x: 0.23, y: head_y + 0.05, z: -0.12}, 0.05, 0.12, 0.12, c_white);
        rl::DrawCube(rl::Vector3{x: 0.26, y: head_y + 0.05, z: -0.12}, 0.02, 0.04, 0.04, c_shoes);
        
        // Mouth
        rl::DrawCube(rl::Vector3{x: 0.235, y: head_y - 0.15, z: 0.0}, 0.03, 0.03, 0.2, c_shoes);
        
        rl::rlPopMatrix();
        
        rl::EndShaderMode();
        
        use_ent = 0;
        if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, (any)&use_ent, rl::SHADER_UNIFORM_INT); }
    }
}

// Draw 3D cages and the Zibis inside them
fn draw_cages_3d(chunks: Chunk*, num_chunks: int, day_time: float) {
    let sh = get_shader_lighting();
    let loc_use_entity = rl::GetShaderLocation(sh, "uUseEntityLight");
    let loc_entity_light = rl::GetShaderLocation(sh, "uEntityLight");
    
    rl::BeginShaderMode(sh);
    let use_ent = 1;
    if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, (any)&use_ent, rl::SHADER_UNIFORM_INT); }
    
    for ci in 0..num_chunks {
        if chunks[ci].x == -9999 { continue; }
        if chunks[ci].cage_count <= 0 { continue; }
        
        let cx = (float)(chunks[ci].x * 16);
        let cz = (float)(chunks[ci].z * 16);
        
        for i in 0..chunks[ci].cage_count {
            let wx = cx + chunks[ci].cages[i].x;
            let wy = chunks[ci].cages[i].y;
            let wz = cz + chunks[ci].cages[i].z;
            
            // Re-verify it's actually a cage (in case it was broken but mesh hasn't rebuilt yet)
            let lx = (int)(chunks[ci].cages[i].x - 0.5); // cages x/z are +0.5 from mesh_blocks
            let lz = (int)(chunks[ci].cages[i].z - 0.5);
            let ly = (int)chunks[ci].cages[i].y;
            if chunks[ci].blocks[lx][ly][lz] != BLOCK_CAGE { continue; }
            
            // Lighting
            let packed_light = get_light_levels(chunks, num_chunks, (int)floor(wx), (int)floor(wy), (int)floor(wz));
            let el = rl::Vector2{x: (float)(packed_light & 0xF) / 15.0, y: (float)((packed_light >> 4) & 0xF) / 15.0};
            if loc_entity_light != -1 { rl::SetShaderValue(sh, loc_entity_light, (any)&el, rl::SHADER_UNIFORM_VEC2); }
            
            rl::rlPushMatrix();
            rl::rlTranslatef(wx, wy + 0.5, wz);
            
            // === DRAW CAGE EXTERIOR ===
            let c_iron = rl::Color{r: 90, g: 90, b: 90, a: 255};
            let c_iron_dark = rl::Color{r: 60, g: 60, b: 60, a: 255};
            
            // Base plate
            rl::DrawCube(rl::Vector3{x: 0.0, y: -0.45, z: 0.0}, 0.9, 0.1, 0.9, c_iron_dark);
            // Top plate
            rl::DrawCube(rl::Vector3{x: 0.0, y: 0.45, z: 0.0}, 0.9, 0.1, 0.9, c_iron_dark);
            
            // Vertical Bars
            for bx in -1..2 {
                for bz in -1..2 {
                    if abs(bx) == 1 || abs(bz) == 1 {
                        rl::DrawCube(rl::Vector3{x: (float)bx * 0.4, y: 0.0, z: (float)bz * 0.4}, 0.05, 0.9, 0.05, c_iron);
                    }
                }
            }
            
            // === DRAW ZIBI INSIDE ===
            rl::rlPushMatrix();
            rl::rlScalef(0.35, 0.35, 0.35); 
            rl::rlTranslatef(0.0, -0.6, 0.0); 
            
            let c_skin = rl::Color{ r: 108, g: 202, b: 85, a: 255 };
            let c_tunic = rl::Color{ r: 141, g: 90, b: 50, a: 255 };
            let c_pants = rl::Color{ r: 75, g: 50, b: 41, a: 255 };
            let c_shoes = rl::Color{ r: 56, g: 94, b: 46, a: 255 };
            let c_white = rl::WHITE;
            
            let anim_t = day_time * 100.0 + wx * 10.0;
            let breathe = (float)sin(anim_t * 2.0) * 0.05;
            
            rl::DrawCube(rl::Vector3{x: 0.15, y: 0.1, z: 0.0}, 0.25, 0.4, 0.4, c_pants);
            rl::DrawCube(rl::Vector3{x: -0.15, y: 0.1, z: 0.0}, 0.25, 0.4, 0.4, c_pants);
            rl::DrawCube(rl::Vector3{x: 0.0, y: 0.8 + breathe, z: 0.1}, 0.35, 0.7, 0.55, c_tunic);
            rl::DrawCube(rl::Vector3{x: 0.35, y: 0.8 + breathe, z: 0.2}, 0.18, 0.6, 0.18, c_skin);
            rl::DrawCube(rl::Vector3{x: -0.35, y: 0.8 + breathe, z: 0.2}, 0.18, 0.6, 0.18, c_skin);
            
            rl::rlPushMatrix();
            rl::rlTranslatef(0.0, 1.2 + breathe, 0.2);
            rl::rlRotatef(20.0, 1.0, 0.0, 0.0); 
            
            let head_y = 0.0;
            rl::DrawCube(rl::Vector3{x: 0.0, y: head_y, z: 0.0}, 0.45, 0.55, 0.5, c_skin);
            rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: 0.3}, 0.08, 0.08, 0.2, c_skin);
            rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: 0.4}, 0.15, 0.15, 0.05, c_skin);
            rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: -0.3}, 0.08, 0.08, 0.2, c_skin);
            rl::DrawCube(rl::Vector3{x: 0.0, y: head_y + 0.1, z: -0.4}, 0.15, 0.15, 0.05, c_skin);
            rl::DrawCube(rl::Vector3{x: 0.23, y: head_y + 0.05, z: 0.12}, 0.05, 0.12, 0.12, c_white);
            rl::DrawCube(rl::Vector3{x: 0.26, y: head_y + 0.05, z: 0.12}, 0.02, 0.04, 0.04, c_shoes);
            rl::DrawCube(rl::Vector3{x: 0.23, y: head_y + 0.05, z: -0.12}, 0.05, 0.12, 0.12, c_white);
            rl::DrawCube(rl::Vector3{x: 0.26, y: head_y + 0.05, z: -0.12}, 0.02, 0.04, 0.04, c_shoes); 
            rl::rlPopMatrix();
            
            rl::rlPopMatrix();
            rl::rlPopMatrix();
        }
    }
    
    rl::EndShaderMode();
    use_ent = 0;
    if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, (any)&use_ent, rl::SHADER_UNIFORM_INT); }
}