
// Constants (Assuming available from chunk.zc or similar)
// If not, we might need to import here.
// import "chunk.zc"; // Let's rely on persistence.zc importing this first.

import "persistence_defs.zc";
import "chunk.zc"; // for BLOCK_* and CHUNK_HEIGHT
import "raylib.h" as rl;
let global_world_seed: int = 1337;

// Thread-safe pseudo-random number generator
// Linear Congruential Generator
fn my_rand(seed: int*) -> int {
    raw {
        *seed = (*seed * 1103515245 + 12345) & 0x7fffffff;
        return *seed;
    }
    return 0; // Unreachable
}

// Spatial Hash for deterministic procedural generation
fn hash_int2(x: int, y: int) -> int {
    let n = x * 131071 + y * 956873; // Large primes
    // Bit mix
    n = n ^ (n << 13);
    n = n ^ (n >> 17);
    return abs(n);
}

// =====================================================
// NEW GENERATOR: FRACTAL VALUE NOISE (MINECRAFT 1.18 STYLE)
// =====================================================

fn hash_u32(x: int, y: int, z: int, seed: int) -> int {
    let result = 0;
    raw {
        unsigned int h = (unsigned int)seed;
        h ^= (unsigned int)x * 374761393u;
        h ^= (unsigned int)y * 668265263u;
        h ^= (unsigned int)z * 2147483647u;
        h = (h ^ (h >> 13u)) * 1274126177u;
        result = (int)h;
    }
    return result;
}

fn hash_float(x: int, y: int, z: int, seed: int) -> float {
    let result = 0.0;
    let h = hash_u32(x,y,z,seed);
    raw {
        unsigned int u = (unsigned int)h;
        result = (float)(u & 0xffffu) / 65535.0f;
    }
    return result;
}

fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t;
}

fn smooth(t: float) -> float {
    return t * t * (3.0 - 2.0 * t);
}

fn noise2d(x: float, z: float, seed: int) -> float {
    let xi = (int)floor(x);
    let zi = (int)floor(z);

    let xf = smooth(x - (float)xi);
    let zf = smooth(z - (float)zi);

    let v00 = hash_float(xi, 0, zi, seed);
    let v10 = hash_float(xi + 1, 0, zi, seed);
    let v01 = hash_float(xi, 0, zi + 1, seed);
    let v11 = hash_float(xi + 1, 0, zi + 1, seed);

    let i1 = lerp(v00, v10, xf);
    let i2 = lerp(v01, v11, xf);

    return lerp(i1, i2, zf);
}

fn noise3d(x: float, y: float, z: float, seed: int) -> float {
    let xi = (int)floor(x);
    let yi = (int)floor(y);
    let zi = (int)floor(z);

    let xf = smooth(x - (float)xi);
    let yf = smooth(y - (float)yi);
    let zf = smooth(z - (float)zi);

    let c000 = hash_float(xi, yi, zi, seed);
    let c100 = hash_float(xi + 1, yi, zi, seed);
    let c010 = hash_float(xi, yi + 1, zi, seed);
    let c110 = hash_float(xi + 1, yi + 1, zi, seed);

    let c001 = hash_float(xi, yi, zi + 1, seed);
    let c101 = hash_float(xi + 1, yi, zi + 1, seed);
    let c011 = hash_float(xi, yi + 1, zi + 1, seed);
    let c111 = hash_float(xi + 1, yi + 1, zi + 1, seed);

    let x00 = lerp(c000, c100, xf);
    let x10 = lerp(c010, c110, xf);
    let x01 = lerp(c001, c101, xf);
    let x11 = lerp(c011, c111, xf);

    let y0 = lerp(x00, x10, yf);
    let y1 = lerp(x01, x11, yf);

    return lerp(y0, y1, zf);
}

fn fractal2d(x: float, z: float, seed: int) -> float {
    let total = 0.0;
    let amp = 1.0;
    let freq = 1.0;
    let max = 0.0;

    for i in 0..5 {
        total = total + noise2d(x * freq, z * freq, seed + i * 100) * amp;
        max = max + amp;
        amp = amp * 0.5;
        freq = freq * 2.0;
    }

    return total / max;
}

// ======================================================================
// NOISE HELPERS (thread-safe, no raylib dependency for core noise)
// ======================================================================

// Sample a 16x16 Perlin noise tile from raylib and return a single float 0..1
fn sample_perlin(wx: int, wz: int, scale: float) -> float {
    let result = 0.0;
    raw {
        Image noise = GenImagePerlinNoise(1, 1, wx, wz, scale);
        Color* pixels = LoadImageColors(noise);
        result = (float)pixels[0].r / 255.0;
        UnloadImageColors(pixels);
        UnloadImage(noise);
    }
    return result;
}

// Sample a full 16x16 tile of Perlin noise into an array (with world-space offset)
fn sample_perlin_16_offset(out: float*, cx: int, cz: int, scale: float, off_x: int, off_z: int) {
    raw {
        Image noise = GenImagePerlinNoise(16, 16, cx * 16 + off_x, cz * 16 + off_z, scale);
        Color* pixels = LoadImageColors(noise);
        for(int j = 0; j < 16; j++) {
            for(int i = 0; i < 16; i++) {
                out[j * 16 + i] = (float)pixels[j * 16 + i].r / 255.0;
            }
        }
        UnloadImageColors(pixels);
        UnloadImage(noise);
    }
}

// Helper to determine if a chunk is a village center (0.5% chance)
fn is_village_center(cx: int, cz: int) -> int {
    let h = hash_int2(cx, cz);
    if (h % 200) < 1 { return 1; }
    return 0;
}

// ======================================================================
// BIOME SYSTEM & TERRAIN SHAPING
// ======================================================================
def BIOME_PLAINS = 0;
def BIOME_FOREST = 1;
def BIOME_DESERT = 2;
def BIOME_FROZEN = 3;

def SEA_LEVEL = 30; // Kept original to preserve world scale

fn get_biome_new(wx: int, wz: int, height: int, seed: int) -> int {
    let temp = fractal2d((float)wx * 0.002, (float)wz * 0.002, seed + 2000);
    let hum = fractal2d((float)wx * 0.002, (float)wz * 0.002, seed + 3000);

    if temp > 0.7 && hum < 0.3 {
        return BIOME_DESERT;
    }

    if temp < 0.3 {
        return BIOME_FROZEN;
    }

    if hum > 0.6 {
        return BIOME_FOREST;
    }

    return BIOME_PLAINS;
}

fn terrain_height(wx: int, wz: int, seed: int) -> int {
    // Continentalness (-1 to 1 mapped from 0..1)
    let cont = fractal2d((float)wx * 0.0015, (float)wz * 0.0015, seed);
    let c = (cont - 0.5) * 2.0;
    
    // Erosion / Hills (-1 to 1) 
    let ero = fractal2d((float)wx * 0.008, (float)wz * 0.008, seed + 1000);
    let e = (ero - 0.5) * 2.0;

    // Base height (creates oceans and continents)
    let h = (float)SEA_LEVEL + (c * 40.0);
    
    // Apply heavy hills only on continent/coast, smooth seabed
    if h > (float)(SEA_LEVEL - 5) {
        h = h + (e * 25.0);
    } else {
        h = h + (e * 5.0);
    }

    // Rivers
    let river = fractal2d((float)wx * 0.005, (float)wz * 0.005, seed + 4000);
    let river_val = (float)fabs(river - 0.5) * 2.0;
    
    // Smooth river carving instead of sheer drop
    if river_val < 0.08 {
        let t = 1.0 - (river_val / 0.08); // 1 at center, 0 at edge
        t = t * t * (3.0 - 2.0 * t); // smoothstep
        let river_bottom = (float)(SEA_LEVEL - 2);
        if h > river_bottom {
            h = lerp(h, river_bottom, t);
        }
    }

    let ih = (int)h;
    if ih < 1 { ih = 1; }
    if ih > CHUNK_HEIGHT - 1 { ih = CHUNK_HEIGHT - 1; }
    return ih;
}

fn is_cave(wx: int, wy: int, wz: int, seed: int) -> int {
    let cheese = noise3d((float)wx * 0.03, (float)wy * 0.03, (float)wz * 0.03, seed + 5000);
    let spaghetti = noise3d((float)wx * 0.06, (float)wy * 0.06, (float)wz * 0.06, seed + 6000);

    // Carve tubular "worm" tunnels where value noise is near 0.5 (edges of blocks)
    let spag_val = (float)fabs(spaghetti - 0.5);
    if spag_val < 0.03 {
        return 1;
    }
    
    // Occasional very rare giant caverns
    if cheese > 0.85 {
        return 1;
    }
    return 0;
}

// ======================================================================
// MAIN GENERATION
// ======================================================================

fn generate_chunk_data(data: ChunkData*, x: int, z: int) {
    rl::TraceLog(rl::LOG_INFO, "Generating chunk data for %d, %d", x, z);
    
    let world_seed = global_world_seed; 
    
    let heights: int[16][16];
    let biomes: int[16][16];
    
    // --- HEIGHTMAP & BIOMES ---
    for i in 0..16 {
        for j in 0..16 {
            let wx = x * 16 + i;
            let wz = z * 16 + j;
            
            let h = terrain_height(wx, wz, world_seed);
            heights[i][j] = h;
            biomes[i][j] = get_biome_new(wx, wz, h, world_seed);
        }
    }
    
    // --- FILL BLOCKS & CAVES ---
    for cx in 0..16 {
        for cz in 0..16 {
            let wx = x * 16 + cx;
            let wz = z * 16 + cz;
            let h = heights[cx][cz];
            let biome = biomes[cx][cz];
            
            for cy in 0..CHUNK_HEIGHT {
                let l = 0;
                
                if cy > h {
                    if cy <= SEA_LEVEL {
                        if biome == BIOME_FROZEN && cy == SEA_LEVEL {
                            data.blocks[cx][cy][cz] = BLOCK_ICE;
                        } else {
                            data.blocks[cx][cy][cz] = BLOCK_WATER;
                        }
                    } else {
                        data.blocks[cx][cy][cz] = BLOCK_AIR;
                        l = 240;
                    }
                } else if cy > 10 && cy < h - 4 && is_cave(wx, cy, wz, world_seed) == 1 {
                    data.blocks[cx][cy][cz] = BLOCK_AIR;
                } else if cy > 1 && cy <= 10 && is_cave(wx, cy, wz, world_seed) == 1 { // Deep caves
                    data.blocks[cx][cy][cz] = BLOCK_AIR;
                } else if cy == h {
                    if h < SEA_LEVEL {
                        // Underwater floor
                        if biome == BIOME_FROZEN {
                            data.blocks[cx][cy][cz] = BLOCK_DIRT; // or gravel
                        } else {
                            data.blocks[cx][cy][cz] = BLOCK_SAND;
                        }
                    } else if biome == BIOME_DESERT {
                        data.blocks[cx][cy][cz] = BLOCK_SAND;
                    } else if biome == BIOME_FROZEN {
                        data.blocks[cx][cy][cz] = BLOCK_SNOW;
                    } else {
                        data.blocks[cx][cy][cz] = BLOCK_GRASS;
                    }
                    if h >= CHUNK_HEIGHT - 1 { l = 240; }
                } else if cy > h - 4 {
                    // Sub-surface
                    if h < SEA_LEVEL {
                        data.blocks[cx][cy][cz] = BLOCK_SAND;
                    } else if biome == BIOME_DESERT {
                        data.blocks[cx][cy][cz] = BLOCK_SAND;
                    } else {
                        data.blocks[cx][cy][cz] = BLOCK_DIRT;
                    }
                } else {
                    let b = BLOCK_STONE;
                    if cy > 20 && cy <= 30 {
                        let dirt_noise = noise3d((float)wx * 0.1f, (float)cy * 0.1f, (float)wz * 0.1f, world_seed + 7000);
                        if dirt_noise > 0.7f { b = BLOCK_DIRT; }
                    } else if cy > 10 && cy <= 20 {
                        let cobble_noise = noise3d((float)wx * 0.1f, (float)cy * 0.1f, (float)wz * 0.1f, world_seed + 8000);
                        if cobble_noise > 0.65f { b = BLOCK_COBBLESTONE; }
                    }
                    data.blocks[cx][cy][cz] = b;
                }
                
                data.light[cx][cy][cz] = l;
            }
        }
    }
    
    // --- GOLD ORE (near caves, underground) ---
    let ore_seed = x * 73856093 ^ z * 19349663;
    for cx in 0..16 {
        for cz in 0..16 {
            for cy in 1..30 {
                if data.blocks[cx][cy][cz] == BLOCK_STONE || data.blocks[cx][cy][cz] == BLOCK_COBBLESTONE {
                    let chance = 200; // 0.5%
                    if cy <= 10 {
                        chance = 60; // ~1.6%
                    } else if cy <= 20 {
                        chance = 120; // ~0.8%
                    }
                    
                    let r = my_rand(&ore_seed) % chance;
                    if r == 0 {
                        data.blocks[cx][cy][cz] = BLOCK_GOLD_ORE;
                    }
                }
            }
        }
    }
    
    // --- DEEP UNDERGROUND ENTITIES (Crystals & Cages) ---
    for cx in 0..16 {
        for cz in 0..16 {
             for cy in 1..10 {
                 if data.blocks[cx][cy][cz] == BLOCK_AIR && data.blocks[cx][cy-1][cz] != BLOCK_AIR {
                      let r = my_rand(&ore_seed) % 1000;
                      if r < 5 { // 0.5% chance per floor block
                           data.blocks[cx][cy][cz] = BLOCK_CRYSTAL;
                      } else if r < 8 { // 0.3% chance per floor block
                           data.blocks[cx][cy][cz] = BLOCK_CAGE;
                      }
                 }
             }
        }
    }
    
    // --- ABANDONED MINES (Mid underground) ---
    for cx in 2..14 {
        for cz in 2..14 {
             for cy in 11..20 {
                  // Find cave walls
                  if data.blocks[cx][cy][cz] == BLOCK_AIR && data.blocks[cx][cy-1][cz] != BLOCK_AIR {
                       let r = my_rand(&ore_seed) % 2000;
                       if r < 5 { // 0.25% chance to spawn a small shelter
                            // Generate a 3x3x3 shelter
                            for sx in -1..2 {
                                 for sz in -1..2 {
                                      for sy in 0..3 {
                                           let tx = cx + sx; let ty = cy + sy; let tz = cz + sz;
                                           if tx >= 0 && tx < 16 && tz >= 0 && tz < 16 && ty < CHUNK_HEIGHT {
                                                if sy == 0 {
                                                     data.blocks[tx][ty-1][tz] = BLOCK_COBBLESTONE; // Floor
                                                }
                                                if sy == 2 || sx == -1 || sx == 1 || sz == -1 || sz == 1 {
                                                     if sy == 1 && (sx == 0 || sz == 0) && (my_rand(&ore_seed) % 2 == 0) {
                                                          data.blocks[tx][ty][tz] = BLOCK_GLASS_PANE; // Window
                                                     } else if data.blocks[tx][ty][tz] == BLOCK_AIR {
                                                          data.blocks[tx][ty][tz] = BLOCK_PLANKS; // Walls & Roof
                                                     }
                                                } else {
                                                     data.blocks[tx][ty][tz] = BLOCK_AIR; // Inside
                                                }
                                           }
                                      }
                                 }
                            }
                       }
                  }
             }
        }
    }
    
    // --- TREES & VEGETATION ---
    data.plant_count = 0;
    let seed = x * 73856093 ^ z * 19349663 ^ 1234567;
    
    for cx in 0..16 {
        for cz in 0..16 {
            let h = heights[cx][cz];
            let biome = biomes[cx][cz];
            let surface = data.blocks[cx][h][cz];
            
            // Skip if underwater
            if h < SEA_LEVEL { continue; }
            if h >= CHUNK_HEIGHT - 15 { continue; }
            
            let r = my_rand(&seed) % 1000;
            
            if biome == BIOME_FOREST {
                // Dense trees (12% chance)
                if r < 120 && surface == BLOCK_GRASS {
                    if cx >= 2 && cx <= 13 && cz >= 2 && cz <= 13 {
                        let tree_h = 5 + (my_rand(&seed) % 4);
                        // Oak tree
                        for th in 0..tree_h {
                            if h + 1 + th < CHUNK_HEIGHT { 
                                data.blocks[cx][h + 1 + th][cz] = BLOCK_LOG; 
                            }
                        }
                        let top = h + 1 + tree_h;
                        for ly in 0..4 {
                            let radius = 2;
                            if ly == 0 || ly == 3 { radius = 1; }
                            for lx in -radius..radius+1 {
                                for lz in -radius..radius+1 {
                                    if radius == 2 && abs(lx) == 2 && abs(lz) == 2 { continue; }
                                    if lx == 0 && lz == 0 && ly < 3 { continue; }
                                    if (top - ly) <= (h + 2) { continue; }
                                    let tx = cx + lx; let tz = cz + lz; let ty = top - ly;
                                    if tx >= 0 && tx < 16 && tz >= 0 && tz < 16 && ty < CHUNK_HEIGHT {
                                        if data.blocks[tx][ty][tz] == BLOCK_AIR {
                                            data.blocks[tx][ty][tz] = BLOCK_LEAVES;
                                        }
                                    }
                                }
                            }
                        }
                        if top + 1 < CHUNK_HEIGHT {
                            if data.blocks[cx][top+1][cz] == BLOCK_AIR { data.blocks[cx][top+1][cz] = BLOCK_LEAVES; }
                        }
                    }
                } else if r < 250 && surface == BLOCK_GRASS {
                    // Tall grass (frequent in forest)
                    if data.plant_count < 64 {
                        data.plants[data.plant_count].x = (float)cx + 0.5;
                        data.plants[data.plant_count].y = (float)(h + 1);
                        data.plants[data.plant_count].z = (float)cz + 0.5;
                        data.plants[data.plant_count].plant_type = BLOCK_TALLGRASS;
                        data.plant_count = data.plant_count + 1;
                    }
                }
            } else if biome == BIOME_PLAINS {
                // Sparse trees (2%)
                if r < 20 && surface == BLOCK_GRASS {
                    if cx >= 2 && cx <= 13 && cz >= 2 && cz <= 13 {
                        let tree_h = 4 + (my_rand(&seed) % 3);
                        for th in 0..tree_h {
                            if h + 1 + th < CHUNK_HEIGHT { data.blocks[cx][h + 1 + th][cz] = BLOCK_LOG; }
                        }
                        let top = h + 1 + tree_h;
                        for ly in 0..3 {
                            let radius = 2;
                            if ly == 0 || ly == 2 { radius = 1; }
                            for lx in -radius..radius+1 {
                                for lz in -radius..radius+1 {
                                    if radius == 2 && abs(lx) == 2 && abs(lz) == 2 { continue; }
                                    if lx == 0 && lz == 0 && ly < 2 { continue; }
                                    let tx = cx + lx; let tz = cz + lz; let ty = top - ly;
                                    if tx >= 0 && tx < 16 && tz >= 0 && tz < 16 && ty < CHUNK_HEIGHT && ty > h {
                                        if data.blocks[tx][ty][tz] == BLOCK_AIR { data.blocks[tx][ty][tz] = BLOCK_LEAVES; }
                                    }
                                }
                            }
                        }
                    }
                } else if r < 80 && surface == BLOCK_GRASS {
                    // Tall grass
                    if data.plant_count < 64 {
                        data.plants[data.plant_count].x = (float)cx + 0.5;
                        data.plants[data.plant_count].y = (float)(h + 1);
                        data.plants[data.plant_count].z = (float)cz + 0.5;
                        data.plants[data.plant_count].plant_type = BLOCK_TALLGRASS;
                        data.plant_count = data.plant_count + 1;
                    }
                }
            } else if biome == BIOME_DESERT {
                // Cactus (3% chance)
                if r < 30 && surface == BLOCK_SAND {
                    let cactus_h = 2 + (my_rand(&seed) % 3); // 2-4 tall
                    for th in 0..cactus_h {
                        if h + 1 + th < CHUNK_HEIGHT {
                            data.blocks[cx][h + 1 + th][cz] = BLOCK_CACTUS;
                        }
                    }
                }
            } else if biome == BIOME_FROZEN {
                // Sparse spruce-like trees (4%)
                if r < 40 && surface == BLOCK_SNOW {
                    if cx >= 2 && cx <= 13 && cz >= 2 && cz <= 13 {
                        let tree_h = 6 + (my_rand(&seed) % 3); // Taller spruce
                        // Trunk
                        for th in 0..tree_h {
                            if h + 1 + th < CHUNK_HEIGHT { data.blocks[cx][h + 1 + th][cz] = BLOCK_LOG; }
                        }
                        // Conical leaves (narrow at top, wide at bottom)
                        let top = h + 1 + tree_h;
                        for ly in 0..5 {
                            let radius = ly / 2; // 0, 0, 1, 1, 2
                            if ly == 0 { radius = 0; }
                            for lx in -radius..radius+1 {
                                for lz in -radius..radius+1 {
                                    // Diamond shape
                                    if abs(lx) + abs(lz) > radius { continue; }
                                    let tx = cx + lx; let tz = cz + lz; let ty = top - ly;
                                    if tx >= 0 && tx < 16 && tz >= 0 && tz < 16 && ty < CHUNK_HEIGHT && ty > h + 2 {
                                        if data.blocks[tx][ty][tz] == BLOCK_AIR {
                                            data.blocks[tx][ty][tz] = BLOCK_LEAVES;
                                        }
                                    }
                                }
                            }
                        }
                        // Top cap
                        if top + 1 < CHUNK_HEIGHT {
                            if data.blocks[cx][top+1][cz] == BLOCK_AIR { data.blocks[cx][top+1][cz] = BLOCK_LEAVES; }
                        }
                    }
                }
            }
        }
    }

    // --- Skull Generation ---
    data.skull_count = 0;
    if (rl::GetRandomValue(0, 100) < 30) { // 30% chance per chunk
        let sx = rl::GetRandomValue(1, 14);
        let sz = rl::GetRandomValue(1, 14);
        let h = heights[sx][sz];
        
        // Ensure valid ground (grass or sand) and air above
        if (h > 30 && h < CHUNK_HEIGHT - 1) {
            let ground = data.blocks[sx][h][sz];
            if ((ground == BLOCK_GRASS || ground == BLOCK_SAND || ground == BLOCK_SNOW) && data.blocks[sx][h+1][sz] == BLOCK_AIR) {
                data.skulls[data.skull_count].x = (float)sx + 0.5;
                data.skulls[data.skull_count].y = (float)(h + 1);
                data.skulls[data.skull_count].z = (float)sz + 0.5;
                data.skulls[data.skull_count].rotation = (float)rl::GetRandomValue(0, 360);
                data.skull_count++;
                rl::TraceLog(rl::LOG_INFO, "Skull [PERSISTENCE] generated at Chunk[%d, %d] Local[%d, %d, %d]", x, z, sx, h+1, sz);
            }
        }
    }

    // --- Cage Generation (Zibi Cages) ---
    if (rl::GetRandomValue(0, 100) < 20) { // 20% chance per chunk
        let cage_x = rl::GetRandomValue(2, 13);
        let cage_z = rl::GetRandomValue(2, 13);
        let cage_h = heights[cage_x][cage_z];
        
        if (cage_h > 31 && cage_h < CHUNK_HEIGHT - 3) {
            let cage_ground = data.blocks[cage_x][cage_h][cage_z];
            if ((cage_ground == BLOCK_GRASS || cage_ground == BLOCK_SAND || cage_ground == BLOCK_SNOW || cage_ground == BLOCK_STONE) && data.blocks[cage_x][cage_h+1][cage_z] == BLOCK_AIR) {
                // Place 1-tall cage
                data.blocks[cage_x][cage_h + 1][cage_z] = BLOCK_CAGE;
            }
        }
    }

    // --- VILLAGE GENERATION ---
    // Check this chunk and neighbors (3x3 area) for village centers.
    // If a neighbor is a center, generate its houses and draw the parts that fall in THIS chunk.
    
    // Define bounds of current chunk
    let my_cx_min = x * 16;
    let my_cx_max = x * 16 + 15;
    let my_cz_min = z * 16;
    let my_cz_max = z * 16 + 15;
    
    for dx in -1..2 {
        for dz in -1..2 {
            let ncx = x + dx;
            let ncz = z + dz;
            
            if is_village_center(ncx, ncz) {
                // This neighbor (or self) is a village center.
                // Generate the village layout deterministically.
                let v_seed = hash_int2(ncx, ncz);
                
                // Village properties
                let num_houses = 4 + (v_seed % 3); // 4 to 6 houses
                let center_x = ncx * 16 + 8;
                let center_z = ncz * 16 + 8;
                
                // Get ground height at village center (approximate)
                let center_h = 0;
                raw {
                    Image noise = GenImagePerlinNoise(1, 1, ncx * 16 + 8, ncz * 16 + 8, 0.05f);
                    Color* pixels = LoadImageColors(noise);
                    float base_val = (float)pixels[0].r / 255.0;
                    float h_f = 8.0 + (base_val * 30.0); // Match terrain gen
                    center_h = (int)h_f;
                    UnloadImageColors(pixels);
                    UnloadImage(noise);
                }
                if center_h < 4 { center_h = 4; } // Safety
                
                // Generate Houses
                for i in 0..num_houses {
                    // Update seed for each house
                    v_seed = hash_int2(v_seed, i);
                    
                    let angle = (float)(v_seed % 360) * 0.01745; // Radians
                    let dist = 10.0 + (float)(v_seed % 15); // Distance from center 10..24
                    
                    let hx = center_x + (int)((float)cos(angle) * dist);
                    let hz = center_z + (int)((float)sin(angle) * dist);
                    
                    let house_w = 5 + (v_seed % 3); // 5..7
                    let house_d = 5 + ((v_seed / 10) % 3); // 5..7
                    let house_h = 4;
                    
                    let hy = center_h; // Place at village center height for simplicity (or raycast if we had data)

                    // House Bounds
                    let hw_half = house_w / 2;
                    let hd_half = house_d / 2;
                    let min_x = hx - hw_half;
                    let max_x = hx + hw_half;
                    let min_z = hz - hd_half;
                    let max_z = hz + hd_half;
                    let max_y = hy + house_h + 2; // Roof

                    // Check if house intersects CURRENT chunk
                    if max_x < my_cx_min || min_x > my_cx_max || max_z < my_cz_min || min_z > my_cz_max {
                        continue; // House is completely outside
                    }

                    // DRAW HOUSE
                    for bx in min_x..(max_x + 1) {
                        for bz in min_z..(max_z + 1) {
                            if bx < my_cx_min || bx > my_cx_max || bz < my_cz_min || bz > my_cz_max { continue; }

                            // Convert to local chunk coords
                            let lx = bx - my_cx_min;
                            let lz = bz - my_cz_min;
                            
                            // Draw Walls & Interior
                            for by in hy..(hy + house_h + 1) {
                                if by >= CHUNK_HEIGHT { continue; }
                                
                                // Floor
                                if by == hy {
                                     data.blocks[lx][by][lz] = BLOCK_COBBLESTONE; // Cobble Floor (or Planks)
                                     continue;
                                }
                                
                                // Walls
                                let is_wall = (bx == min_x || bx == max_x || bz == min_z || bz == max_z);
                                if is_wall {
                                    // Corners
                                    let is_corner = (bx == min_x || bx == max_x) && (bz == min_z || bz == max_z);
                                    if is_corner {
                                        data.blocks[lx][by][lz] = BLOCK_LOG;
                                    } else {
                                        // Windows: Middle of wall, height +2
                                        if by == hy + 2 && (bx == hx || bz == hz) {
                                             data.blocks[lx][by][lz] = BLOCK_GLASS_PANE; // Window
                                        } else {
                                             data.blocks[lx][by][lz] = BLOCK_PLANKS; // Plank Walls
                                        }
                                    }
                                } else {
                                    // Interior Air
                                    data.blocks[lx][by][lz] = BLOCK_AIR; 
                                }
                            }
                            
                            // Roof (Simple Slab/Flat for now or Pyramid)
                            let roof_y = hy + house_h;

                            if roof_y < CHUNK_HEIGHT {
                                data.blocks[lx][roof_y][lz] = BLOCK_COBBLESTONE; // Flat roof
                                
                                // Decorative Crystal on center of roof
                                if bx == hx && bz == hz && (roof_y + 1) < CHUNK_HEIGHT {
                                    data.blocks[lx][roof_y + 1][lz] = BLOCK_CRYSTAL;
                                }
                            }
                            
                            // Foundation (Down to -4 from floor)
                             for k in 1..5 {
                                let fy = hy - k;
                                if fy >= 0 {
                                    let existing = data.blocks[lx][fy][lz];
                                    if existing == BLOCK_AIR || existing == BLOCK_WATER || existing == BLOCK_TALLGRASS {
                                        data.blocks[lx][fy][lz] = BLOCK_COBBLESTONE; // Cobble foundation
                                    } else {
                                        break; // Hit ground
                                    }
                                }
                             }
                        }
                    }
                    
                    // Door (cut hole)
                    if hx >= my_cx_min && hx <= my_cx_max && min_z >= my_cz_min && min_z <= my_cz_max {
                         let lx = hx - my_cx_min;
                         let lz = min_z - my_cz_min;
                         if hy + 1 < CHUNK_HEIGHT { data.blocks[lx][hy+1][lz] = BLOCK_AIR; }
                         if hy + 2 < CHUNK_HEIGHT { data.blocks[lx][hy+2][lz] = BLOCK_AIR; }
                    }
                }
            }
        }
    }
    
    data.light_calculated = 1;
    rl::TraceLog(rl::LOG_INFO, "Chunk %d, %d generation complete", x, z);
}
