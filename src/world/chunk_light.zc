//> Chunk Lighting Engine
import "src/zalloc.h";
import "../render/lighting.zc";
import "../world/chunk_core.zc";

fn get_light_levels(chunks: Chunk*, num_chunks: int, x: int, y: int, z: int) -> int {
    if y < 0 || y >= CHUNK_HEIGHT { return 240; } 

    // 🚀 ULTRA FAST BITWISE MATH
    let cx = x >> 4; let cz = z >> 4;
    let lx = x & 15; let lz = z & 15;

    let idx = get_chunk_index(cx, cz);
    if chunks[idx].x == cx && chunks[idx].z == cz { return chunks[idx].light[lx][y][lz]; }
    return 240;
}

fn get_light_global(chunks: Chunk*, num_chunks: int, x: int, y: int, z: int, channel: int) -> int {
    if y < 0 || y >= CHUNK_HEIGHT { if channel == 0 { return 15; } return 0; }
    
    let cx = x >> 4; let cz = z >> 4;
    let idx = get_chunk_index(cx, cz);
    
    if chunks[idx].x == cx && chunks[idx].z == cz {
        let lx = x & 15; let lz = z & 15;
        let val = chunks[idx].light[lx][y][lz];
        if channel == 0 { return (val >> 4) & 0xF; } 
        else { return val & 0xF; }
    }
    if channel == 0 && y > 16 { return 15; }
    return 0;
}

fn set_light_global(chunks: Chunk*, num_chunks: int, x: int, y: int, z: int, val: int, channel: int) {
    if y < 0 || y >= CHUNK_HEIGHT { return; }

    let cx = x >> 4; let cz = z >> 4;
    let idx = get_chunk_index(cx, cz);
    
    if chunks[idx].x == cx && chunks[idx].z == cz {
        let lx = x & 15; let lz = z & 15;
        let current = chunks[idx].light[lx][y][lz];
        if channel == 0 { chunks[idx].light[lx][y][lz] = (current & 0x0F) | ((val & 0xF) << 4); } 
        else { chunks[idx].light[lx][y][lz] = (current & 0xF0) | (val & 0xF); }
    }
}

fn update_sunlight_column(chunks: Chunk*, num_chunks: int, x: int, z: int) {
    let casting_shadow = 0;
    for i in 0..CHUNK_HEIGHT {
        let y = (CHUNK_HEIGHT - 1) - i;
        let blk = get_block(chunks, num_chunks, x, y, z);
        
        if casting_shadow == 0 {
             if is_transparent(blk) == 0 {
                 set_light_global(chunks, num_chunks, x, y, z, 0, 0);
                 casting_shadow = 1;
             } else { set_light_global(chunks, num_chunks, x, y, z, 15, 0); }
        } else { set_light_global(chunks, num_chunks, x, y, z, 0, 0); }
        set_light_global(chunks, num_chunks, x, y, z, 0, 1);
    }
}

fn propagate_light_internal(c: Chunk*, chunks: Chunk*, num_chunks: int, channel: int) {
    let gx_base = c.x * 16; let gz_base = c.z * 16;
    let arena: zarena; zarena_init(&arena);
    
    let q_ptr = (LightQueue*)zarena_alloc(&arena, sizeof(LightQueue));
    if q_ptr == NULL { zarena_free(&arena); return; }
    
    (*q_ptr).head = 0; (*q_ptr).tail = 0;
    
    for x in 0..16 {
        for y in 0..CHUNK_HEIGHT {
            for z in 0..16 {
                let current_light = 0;
                let val = c.light[x][y][z];
                
                if channel == 0 { current_light = (val >> 4) & 0xF; } 
                else { current_light = val & 0xF; }
                
                if current_light > 0 { queue_push(q_ptr, gx_base + x, y, gz_base + z); } 
                else if is_transparent(c.blocks[x][y][z]) == 1 {
                    let gx = gx_base + x; let gz = gz_base + z; let max_n = 0;
                    
                    let l_px = get_light_global(chunks, num_chunks, gx + 1, y, gz, channel); if l_px > max_n { max_n = l_px; }
                    let l_nx = get_light_global(chunks, num_chunks, gx - 1, y, gz, channel); if l_nx > max_n { max_n = l_nx; }
                    let l_py = get_light_global(chunks, num_chunks, gx, y + 1, gz, channel); if l_py > max_n { max_n = l_py; }
                    let l_ny = get_light_global(chunks, num_chunks, gx, y - 1, gz, channel); if l_ny > max_n { max_n = l_ny; }
                    let l_pz = get_light_global(chunks, num_chunks, gx, y, gz + 1, channel); if l_pz > max_n { max_n = l_pz; }
                    let l_nz = get_light_global(chunks, num_chunks, gx, y, gz - 1, channel); if l_nz > max_n { max_n = l_nz; }
                    
                    if max_n > 1 {
                        let old_val = c.light[x][y][z];
                        if channel == 0 { c.light[x][y][z] = (old_val & 0x0F) | (((max_n - 1) & 0xF) << 4); } 
                        else { c.light[x][y][z] = (old_val & 0xF0) | ((max_n - 1) & 0xF); }
                        c.mesh_dirty = 1; queue_push(q_ptr, gx, y, gz);
                    }
                }
            }
        }
    }
    
    while !queue_is_empty(q_ptr) {
        let node = queue_pop(q_ptr);
        let light = get_light_global(chunks, num_chunks, node.x, node.y, node.z, channel);
        if light <= 1 { continue; } 
        
        let nx = 0; let ny = 0; let nz = 0;
        let cx_n = 0; let cz_n = 0; let idx_n = 0;
        
        nx = node.x + 1; ny = node.y; nz = node.z;
        if is_transparent(get_block(chunks, num_chunks, nx, ny, nz)) == 1 {
             if get_light_global(chunks, num_chunks, nx, ny, nz, channel) < light - 1 {
                 set_light_global(chunks, num_chunks, nx, ny, nz, light - 1, channel);
                 cx_n = nx >> 4; cz_n = nz >> 4; // 🚀 BITWISE
                 idx_n = get_chunk_index(cx_n, cz_n);
                 if chunks[idx_n].x == cx_n && chunks[idx_n].z == cz_n { chunks[idx_n].mesh_dirty = 1; }
                 queue_push(q_ptr, nx, ny, nz);
             }
        }
        nx = node.x - 1; ny = node.y; nz = node.z;
        if is_transparent(get_block(chunks, num_chunks, nx, ny, nz)) == 1 {
             if get_light_global(chunks, num_chunks, nx, ny, nz, channel) < light - 1 {
                 set_light_global(chunks, num_chunks, nx, ny, nz, light - 1, channel);
                 cx_n = nx >> 4; cz_n = nz >> 4; // 🚀 BITWISE
                 idx_n = get_chunk_index(cx_n, cz_n);
                 if chunks[idx_n].x == cx_n && chunks[idx_n].z == cz_n { chunks[idx_n].mesh_dirty = 1; }
                 queue_push(q_ptr, nx, ny, nz);
             }
        }
        nx = node.x; ny = node.y + 1; nz = node.z;
        if is_transparent(get_block(chunks, num_chunks, nx, ny, nz)) == 1 {
             if get_light_global(chunks, num_chunks, nx, ny, nz, channel) < light - 1 {
                 set_light_global(chunks, num_chunks, nx, ny, nz, light - 1, channel);
                 cx_n = nx >> 4; cz_n = nz >> 4; // 🚀 BITWISE
                 idx_n = get_chunk_index(cx_n, cz_n);
                 if chunks[idx_n].x == cx_n && chunks[idx_n].z == cz_n { chunks[idx_n].mesh_dirty = 1; }
                 queue_push(q_ptr, nx, ny, nz);
             }
        }
        nx = node.x; ny = node.y - 1; nz = node.z;
        if is_transparent(get_block(chunks, num_chunks, nx, ny, nz)) == 1 {
             if get_light_global(chunks, num_chunks, nx, ny, nz, channel) < light - 1 {
                 set_light_global(chunks, num_chunks, nx, ny, nz, light - 1, channel);
                 cx_n = nx >> 4; cz_n = nz >> 4; // 🚀 BITWISE
                 idx_n = get_chunk_index(cx_n, cz_n);
                 if chunks[idx_n].x == cx_n && chunks[idx_n].z == cz_n { chunks[idx_n].mesh_dirty = 1; }
                 queue_push(q_ptr, nx, ny, nz);
             }
        }
        nx = node.x; ny = node.y; nz = node.z + 1;
        if is_transparent(get_block(chunks, num_chunks, nx, ny, nz)) == 1 {
             if get_light_global(chunks, num_chunks, nx, ny, nz, channel) < light - 1 {
                 set_light_global(chunks, num_chunks, nx, ny, nz, light - 1, channel);
                 cx_n = nx >> 4; cz_n = nz >> 4; // 🚀 BITWISE
                 idx_n = get_chunk_index(cx_n, cz_n);
                 if chunks[idx_n].x == cx_n && chunks[idx_n].z == cz_n { chunks[idx_n].mesh_dirty = 1; }
                 queue_push(q_ptr, nx, ny, nz);
             }
        }
        nx = node.x; ny = node.y; nz = node.z - 1;
        if is_transparent(get_block(chunks, num_chunks, nx, ny, nz)) == 1 {
             if get_light_global(chunks, num_chunks, nx, ny, nz, channel) < light - 1 {
                 set_light_global(chunks, num_chunks, nx, ny, nz, light - 1, channel);
                 cx_n = nx >> 4; cz_n = nz >> 4; // 🚀 BITWISE
                 idx_n = get_chunk_index(cx_n, cz_n);
                 if chunks[idx_n].x == cx_n && chunks[idx_n].z == cz_n { chunks[idx_n].mesh_dirty = 1; }
                 queue_push(q_ptr, nx, ny, nz);
             }
        }
    }
    zarena_free(&arena);
}

fn propagate_light_in_chunk(c: Chunk*, chunks: Chunk*, num_chunks: int) {
    propagate_light_internal(c, chunks, num_chunks, 0);
    propagate_light_internal(c, chunks, num_chunks, 1);
}

fn recalculate_chunk_lighting(c: Chunk*, chunks: Chunk*, num_chunks: int) {
    let gx_base = c.x * 16; let gz_base = c.z * 16;
    
    let lx = 0;
    while lx < 16 {
        let lz = 0;
        while lz < 16 { update_sunlight_column(chunks, num_chunks, gx_base + lx, gz_base + lz); lz = lz + 1; }
        lx = lx + 1;
    }
    lx = 0;
    while lx < 16 {
        let ly = 0;
        while ly < CHUNK_HEIGHT {
            let lz = 0;
            while lz < 16 {
                let blk = c.blocks[lx][ly][lz];
                if blk >= 10 && blk <= 14 {
                    let current = c.light[lx][ly][lz];
                    c.light[lx][ly][lz] = (current & 0xF0) | 8;
                }
                lz = lz + 1;
            }
            ly = ly + 1;
        }
        lx = lx + 1;
    }
    propagate_light_in_chunk(c, chunks, num_chunks);
}