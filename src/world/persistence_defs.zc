//> Persistence Definitions & Structures
import "raylib.h" as rl;
import "chunk_core.zc";

// Constants for Async System
def MAX_PENDING_IO = 512;

// Request Types
def REQ_NONE = 0;
def REQ_SAVE = 1;
def REQ_LOAD = 2;
def REQ_BUILD_MESH = 3;
def REQ_LIGHT_RECALC = 4;
def REQ_LIGHT_PROPAGATE = 5;

// Request Status
def IO_STATUS_FREE = 0;
def IO_STATUS_PENDING = 1;
def IO_STATUS_COMPLETED = 2;
def IO_STATUS_FAILED = 3;

struct ChunkData {
    blocks: int[16][128][16];
    light: int[16][128][16];
    plant_count: int;
    plants: Plant[64];
    skulls: Skull[4];
    skull_count: int;
    light_calculated: int; 
    obelisk_count: int;
    obelisks: Obelisk[32];
    chest_count: int;
    chests: ChestData[8];
    banner_count: int;
    banners: BannerData[4];
}

struct Skull {
    x: float; y: float; z: float;
    rotation: float;
}

struct IORequest {
    io_status: int; // Thread-safe flag (Implicit memory barrier via sleep)
    type: int;      
    cx: int;
    cz: int;
    target_idx: int;
    data: ChunkData;
    mesh_data: ChunkMeshes;
    plant_mesh: rl::Mesh;
    priority: int; 
}

struct ProfilingStats {
    mesh_ms: float;
    gen_ms: float;
    prop_ms: float;
}

struct PlayerSaveData {
    x: float; 
    y: float; 
    z: float;
    selected_block: int;
    yaw: float; 
    pitch: float;
    
    // Wave state
    wave_number: int;
    wave_spawned_today: int;
    day_time: float;
    
    // Global entities
    zibis: ZibiSaveData[64];
}

struct ZibiSaveData {
    active: int;
    state: int;
    hp: int;
    x: float;
    y: float;
    z: float;
    vx: float;
    vz: float;
    yaw: float;
    state_timer: float;
    work_timer: float;
    home_chunk_x: int;
    home_chunk_z: int;
    obelisk_idx: int;
    mine_banner_x: int;
    mine_banner_y: int;
    mine_banner_z: int;
}

struct WorkerConfig {
    queue: IORequest*;
    size: int;
    id: int;
}