// persistence_gen.zc
// GENERADOR AVANZADO ESTILO MINECRAFT 1.18
// altura maxima 128

const WORLD_HEIGHT = 128;
const SEA_LEVEL = 62;
const SEED = 1337;


// =====================================================
// HASH GLOBAL DETERMINISTA
// =====================================================

fn hash_u32(x: int, y: int, z: int, seed: int) -> uint
{
    var h = seed as uint;

    h ^= x * 374761393u;
    h ^= y * 668265263u;
    h ^= z * 2147483647u;

    h = (h ^ (h >> 13u)) * 1274126177u;

    return h;
}

fn hash_float(x: int, y: int, z: int, seed: int) -> float
{
    return (hash_u32(x,y,z,seed) & 0xffffu) as float / 65535.0;
}


// =====================================================
// MATH
// =====================================================

fn lerp(a: float, b: float, t: float) -> float
{
    return a + (b - a) * t;
}

fn smooth(t: float) -> float
{
    return t*t*(3.0 - 2.0*t);
}


// =====================================================
// VALUE NOISE 2D
// =====================================================

fn noise2d(x: float, z: float, seed: int) -> float
{
    let xi = floor(x) as int;
    let zi = floor(z) as int;

    let xf = smooth(x - xi);
    let zf = smooth(z - zi);

    let v00 = hash_float(xi,0,zi,seed);
    let v10 = hash_float(xi+1,0,zi,seed);
    let v01 = hash_float(xi,0,zi+1,seed);
    let v11 = hash_float(xi+1,0,zi+1,seed);

    let i1 = lerp(v00,v10,xf);
    let i2 = lerp(v01,v11,xf);

    return lerp(i1,i2,zf);
}


// =====================================================
// VALUE NOISE 3D
// =====================================================

fn noise3d(x: float, y: float, z: float, seed: int) -> float
{
    let xi = floor(x) as int;
    let yi = floor(y) as int;
    let zi = floor(z) as int;

    let xf = smooth(x - xi);
    let yf = smooth(y - yi);
    let zf = smooth(z - zi);

    let c000 = hash_float(xi,yi,zi,seed);
    let c100 = hash_float(xi+1,yi,zi,seed);
    let c010 = hash_float(xi,yi+1,zi,seed);
    let c110 = hash_float(xi+1,yi+1,zi,seed);

    let c001 = hash_float(xi,yi,zi+1,seed);
    let c101 = hash_float(xi+1,yi,zi+1,seed);
    let c011 = hash_float(xi,yi+1,zi+1,seed);
    let c111 = hash_float(xi+1,yi+1,zi+1,seed);

    let x00 = lerp(c000,c100,xf);
    let x10 = lerp(c010,c110,xf);
    let x01 = lerp(c001,c101,xf);
    let x11 = lerp(c011,c111,xf);

    let y0 = lerp(x00,x10,yf);
    let y1 = lerp(x01,x11,yf);

    return lerp(y0,y1,zf);
}


// =====================================================
// FRACTAL NOISE
// =====================================================

fn fractal2d(x: float, z: float, seed: int) -> float
{
    var total = 0.0;
    var amp = 1.0;
    var freq = 1.0;
    var max = 0.0;

    for(var i=0;i<5;i+=1)
    {
        total += noise2d(x*freq,z*freq,seed+i*100)*amp;
        max += amp;
        amp *= 0.5;
        freq *= 2.0;
    }

    return total/max;
}


// =====================================================
// CONTINENTES
// =====================================================

fn continental(wx: int, wz: int) -> float
{
    return fractal2d(wx*0.001,wz*0.001,SEED);
}


// =====================================================
// EROSION
// =====================================================

fn erosion(wx: int, wz: int) -> float
{
    return fractal2d(wx*0.01,wz*0.01,SEED+1000);
}


// =====================================================
// TEMPERATURA Y HUMEDAD
// =====================================================

fn temperature(wx: int, wz: int) -> float
{
    return fractal2d(wx*0.002,wz*0.002,SEED+2000);
}

fn humidity(wx: int, wz: int) -> float
{
    return fractal2d(wx*0.002,wz*0.002,SEED+3000);
}


// =====================================================
// RIOS
// =====================================================

fn river(wx: int, wz: int) -> float
{
    let r = fractal2d(wx*0.01,wz*0.01,SEED+4000);
    return abs(r-0.5)*2.0;
}


// =====================================================
// ALTURA FINAL
// =====================================================

fn terrain_height(wx: int, wz: int) -> int
{
    let cont = continental(wx,wz);
    let ero = erosion(wx,wz);

    var h = SEA_LEVEL;

    h += cont*50;
    h += ero*30;

    if(river(wx,wz)<0.05)
        h = SEA_LEVEL-2;

    return clamp(h as int,1,WORLD_HEIGHT-1);
}


// =====================================================
// BIOMAS
// =====================================================

enum Biome
{
    OCEAN,
    PLAINS,
    DESERT,
    FOREST,
    SNOW
}

fn get_biome(wx: int, wz: int, height: int) -> Biome
{
    if(height < SEA_LEVEL-4)
        return OCEAN;

    let temp = temperature(wx,wz);
    let hum = humidity(wx,wz);

    if(temp > 0.7 && hum < 0.3)
        return DESERT;

    if(temp < 0.3)
        return SNOW;

    if(hum > 0.6)
        return FOREST;

    return PLAINS;
}


// =====================================================
// CUEVAS
// =====================================================

fn cave(wx: int, wy: int, wz: int) -> bool
{
    let cheese = noise3d(wx*0.04,wy*0.04,wz*0.04,SEED+5000);

    let spaghetti = noise3d(wx*0.1,wy*0.1,wz*0.1,SEED+6000);

    return cheese > 0.65 || spaghetti > 0.72;
}


// =====================================================
// ARBOLES
// =====================================================

fn place_tree(chunk, lx: int, y: int, lz: int, wx: int, wz: int)
{
    let h = 4 + (hash_u32(wx,0,wz,SEED)%3);

    for(var i=0;i<h;i+=1)
        chunk.set_block(lx,y+i,lz,BLOCK_LOG);

    for(var dx=-2;dx<=2;dx+=1)
    for(var dz=-2;dz<=2;dz+=1)
    for(var dy=h-2;dy<=h;dy+=1)
    {
        if(abs(dx)+abs(dz)<4)
            chunk.set_block(lx+dx,y+dy,lz+dz,BLOCK_LEAVES);
    }
}


// =====================================================
// GENERACION CHUNK
// =====================================================

fn generate_chunk(chunk_x: int, chunk_z: int, chunk)
{
    for(var lx=0;lx<16;lx+=1)
    for(var lz=0;lz<16;lz+=1)
    {
        let wx = chunk_x*16+lx;
        let wz = chunk_z*16+lz;

        let height = terrain_height(wx,wz);

        let biome = get_biome(wx,wz,height);

        for(var y=0;y<WORLD_HEIGHT;y+=1)
        {
            if(y>height)
            {
                if(y<=SEA_LEVEL)
                    chunk.set_block(lx,y,lz,BLOCK_WATER);
                else
                    chunk.set_block(lx,y,lz,BLOCK_AIR);

                continue;
            }

            if(y>10 && cave(wx,y,wz))
            {
                chunk.set_block(lx,y,lz,BLOCK_AIR);
                continue;
            }

            if(y==height)
            {
                switch(biome)
                {
                    case DESERT:
                        chunk.set_block(lx,y,lz,BLOCK_SAND);
                        break;

                    case SNOW:
                        chunk.set_block(lx,y,lz,BLOCK_SNOW);
                        break;

                    default:
                        chunk.set_block(lx,y,lz,BLOCK_GRASS);
                        break;
                }
            }
            else if(y>height-4)
                chunk.set_block(lx,y,lz,BLOCK_DIRT);
            else
                chunk.set_block(lx,y,lz,BLOCK_STONE);
        }

        if(biome==FOREST)
        {
            if(hash_u32(wx,0,wz,SEED)%100<3)
                place_tree(chunk,lx,height+1,lz,wx,wz);
        }
    }
}