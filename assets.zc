//> Assets and Shader Management
import "raylib.h" as rl;
import "math.h";
import "string.h";
import "zalloc.h"; // Integrated Z-ARENA for safe temporary allocations

// Screen configuration
def SCREEN_WIDTH = 1920;
def SCREEN_HEIGHT = 1080;
def TITLE = "Zen Craft";

// Global textures and shaders
let tex_atlas: rl::Texture2D;
let tex_grass: rl::Texture2D;
let tex_sun: rl::Texture2D;
let tex_moon: rl::Texture2D;
let sh_lighting: rl::Shader;
let sh_grass: rl::Shader; 
let sh_beam: rl::Shader;
let model_skull: rl::Model;

// Uniform Locations (Lighting)
let loc_light_dir: int;
let loc_light_col: int;
let loc_ambient: int;
let loc_view_pos: int;
let loc_time: int;

// Uniform Locations (Grass)
let loc_grass_light_dir: int;
let loc_grass_light_col: int;
let loc_grass_ambient: int;
let loc_grass_view_pos: int;
let loc_grass_time: int;
let loc_grass_use_tex: int;

fn load_texture_from_memory(_data: char*, _len: int) -> rl::Texture2D {
    let img = rl::LoadImageFromMemory(".png", _data, _len);
    let tex = rl::LoadTextureFromImage(img);
    rl::SetTextureFilter(tex, rl::TEXTURE_FILTER_POINT);
    rl::UnloadImage(img);
    return tex;
}

fn load_shader_from_memory(_vs: char*, _vs_len: int, _fs: char*, _fs_len: int) -> rl::Shader {
    // --- USING Z-ARENA ---
    // Perfect use case for temporary allocations!
    let arena: zarena;
    zarena_init(&arena);

    // Allocate and null-terminate Vertex Shader
    let vs = (char*)zarena_alloc(&arena, _vs_len + 1);
    memcpy(vs, _vs, _vs_len);
    vs[_vs_len] = '\0';

    // Allocate and null-terminate Fragment Shader
    let fs = (char*)zarena_alloc(&arena, _fs_len + 1);
    memcpy(fs, _fs, _fs_len);
    fs[_fs_len] = '\0';

    let sh = rl::LoadShaderFromMemory(vs, fs);
    
    // Free everything at once (O(1))
    zarena_free(&arena);
    
    return sh;
}

fn init_textures() {
    // Load individual images
    let dirt_data = embed "./assets/dirt.png";
    let grass_side_data = embed "./assets/grass_side.png";
    let grass_top_data = embed "./assets/grass.png";
    let stone_data = embed "./assets/stone.png";
    let log_data = embed "./assets/log.png";
    let leaves_data = embed "./assets/leaves.png";
    
    let sun_data = embed "./assets/sun.png";
    let moon_data = embed "./assets/moon.png";
    let plant_data = embed "./assets/hierba_sprite.png";
    
    let vs_data = embed "./assets/lighting.vs";
    let fs_data = embed "./assets/lighting.fs";
    let vs_grass_data = embed "./assets/grass.vs";
    let fs_grass_data = embed "./assets/grass.fs";
    let vs_beam_data = embed "./assets/beam.vs";
    let fs_beam_data = embed "./assets/beam.fs";

    let img_dirt = rl::LoadImageFromMemory(".png", dirt_data.data, dirt_data.len);
    let img_grass_s = rl::LoadImageFromMemory(".png", grass_side_data.data, grass_side_data.len);
    let img_grass_t = rl::LoadImageFromMemory(".png", grass_top_data.data, grass_top_data.len);
    let img_stone = rl::LoadImageFromMemory(".png", stone_data.data, stone_data.len);
    let img_log = rl::LoadImageFromMemory(".png", log_data.data, log_data.len);
    let img_leaves = rl::LoadImageFromMemory(".png", leaves_data.data, leaves_data.len);
    
    let w = img_dirt.width;
    let h = img_dirt.height;
    
    // Create Atlas: 4 * w, 4 * h
    let atlas = rl::GenImageColor(w * 4, h * 4, rl::BLANK);
    
    // Row 0 (Top half)
    rl::ImageDraw(&atlas, img_dirt, rl::Rectangle{x: 0.0, y: 0.0, width: (float)w, height: (float)h}, rl::Rectangle{x: 0.0, y: 0.0, width: (float)w, height: (float)h}, rl::WHITE);
    rl::ImageDraw(&atlas, img_grass_t, rl::Rectangle{x: 0.0, y: 0.0, width: (float)w, height: (float)h}, rl::Rectangle{x: (float)w, y: 0.0, width: (float)w, height: (float)h}, rl::WHITE);
    rl::ImageDraw(&atlas, img_log, rl::Rectangle{x: 0.0, y: 0.0, width: (float)w, height: (float)h}, rl::Rectangle{x: (float)(w*2), y: 0.0, width: (float)w, height: (float)h}, rl::WHITE);
    rl::ImageDraw(&atlas, img_log, rl::Rectangle{x: 0.0, y: 0.0, width: (float)w, height: (float)h}, rl::Rectangle{x: (float)(w*3), y: 0.0, width: (float)w, height: (float)h}, rl::WHITE);
    
    // Row 1 (Bottom half)
    rl::ImageDraw(&atlas, img_grass_s, rl::Rectangle{x: 0.0, y: 0.0, width: (float)w, height: (float)h}, rl::Rectangle{x: 0.0, y: (float)h, width: (float)w, height: (float)h}, rl::WHITE);
    rl::ImageDraw(&atlas, img_stone, rl::Rectangle{x: 0.0, y: 0.0, width: (float)w, height: (float)h}, rl::Rectangle{x: (float)w, y: (float)h, width: (float)w, height: (float)h}, rl::WHITE);
    rl::ImageDraw(&atlas, img_leaves, rl::Rectangle{x: 0.0, y: 0.0, width: (float)w, height: (float)h}, rl::Rectangle{x: (float)(w*2), y: (float)h, width: (float)w, height: (float)h}, rl::WHITE);
    
    // Procedural Torch
    rl::ImageDrawRectangle(&atlas, w*3, h, w, h, rl::Color{r: 40, g: 30, b: 20, a: 255});
    rl::ImageDrawRectangle(&atlas, w*3 + 2, h + 4, w-4, h-8, rl::Color{r: 101, g: 67, b: 33, a: 255});
    rl::ImageDrawRectangle(&atlas, w*3 + 3, h + 2, w-6, 6, rl::ORANGE);
    rl::ImageDrawRectangle(&atlas, w*3 + 4, h + 1, w-8, 3, rl::YELLOW);

    // Row 2
    if !rl::FileExists("assets/sand.png") {
         let sand_base = rl::Color{r: 237, g: 201, b: 145, a: 255};
         let gen_sand = rl::GenImageColor(16, 16, sand_base);
         
         for i in 0..40 {
             let nx = rl::GetRandomValue(0, 15);
             let ny = rl::GetRandomValue(0, 15);
             rl::ImageDrawPixel(&gen_sand, nx, ny, rl::Color{r: 210, g: 180, b: 140, a: 255});
         }
         for i in 0..20 {
             let nx = rl::GetRandomValue(0, 15);
             let ny = rl::GetRandomValue(0, 15);
             rl::ImageDrawPixel(&gen_sand, nx, ny, rl::Color{r: 245, g: 222, b: 179, a: 255});
         }
         
         rl::ExportImage(gen_sand, "assets/sand.png");
         rl::UnloadImage(gen_sand);
    }

    let img_sand = rl::LoadImage("assets/sand.png");
    if img_sand.data == NULL {
        rl::ImageDrawRectangle(&atlas, 0, h*2, w, h, rl::Color{r: 237, g: 201, b: 145, a: 255});
    } else {
        rl::ImageDraw(&atlas, img_sand, rl::Rectangle{x: 0.0, y: 0.0, width: (float)img_sand.width, height: (float)img_sand.height}, rl::Rectangle{x: 0.0, y: (float)(h*2), width: (float)w, height: (float)h}, rl::WHITE);
        rl::UnloadImage(img_sand);
    }

    // Glass Texture (Procedural)
    let gx = w;
    let gy = h * 2;
    rl::ImageDrawRectangle(&atlas, gx, gy, w, h, rl::Color{r: 200, g: 230, b: 255, a: 40});
    rl::ImageDrawRectangle(&atlas, gx, gy, w, 1, rl::Color{r: 220, g: 240, b: 255, a: 180});
    rl::ImageDrawRectangle(&atlas, gx, gy + h - 1, w, 1, rl::Color{r: 220, g: 240, b: 255, a: 180});
    rl::ImageDrawRectangle(&atlas, gx, gy, 1, h, rl::Color{r: 220, g: 240, b: 255, a: 180});
    rl::ImageDrawRectangle(&atlas, gx + w - 1, gy, 1, h, rl::Color{r: 220, g: 240, b: 255, a: 180});
    rl::ImageDrawLine(&atlas, gx + 3, gy + 3, gx + 6, gy + 6, rl::Color{r: 240, g: 250, b: 255, a: 160});
    rl::ImageDrawLine(&atlas, gx + 4, gy + 3, gx + 7, gy + 6, rl::Color{r: 240, g: 250, b: 255, a: 100});
    rl::ImageDrawLine(&atlas, gx + 10, gy + 8, gx + 13, gy + 11, rl::Color{r: 240, g: 250, b: 255, a: 160});
    
    // Planks (Procedural)
    let px = w * 2;
    let py = h * 2;
    rl::ImageDrawRectangle(&atlas, px, py, w, h, rl::Color{r: 160, g: 100, b: 50, a: 255});
    rl::ImageDrawLine(&atlas, px, py + 4, px + w, py + 4, rl::Color{r: 130, g: 80, b: 40, a: 255});
    rl::ImageDrawLine(&atlas, px, py + 8, px + w, py + 8, rl::Color{r: 130, g: 80, b: 40, a: 255});
    rl::ImageDrawLine(&atlas, px, py + 12, px + w, py + 12, rl::Color{r: 130, g: 80, b: 40, a: 255});
    for i in 0..30 {
        let rx = rl::GetRandomValue(0, w - 1);
        let ry = rl::GetRandomValue(0, h - 1);
        rl::ImageDrawPixel(&atlas, px+rx, py+ry, rl::Color{r: 140, g: 90, b: 45, a: 255});
    }
    
    // Cobblestone (Procedural)
    let bx = w * 3;
    let by = h * 2;
    rl::ImageDrawRectangle(&atlas, bx, by, w, h, rl::Color{r: 100, g: 100, b: 100, a: 255});
    for i in 0..(w*h) {
        let rx = i % w;
        let ry = i / w;
        if (rx + ry) % 2 == 0 {
             rl::ImageDrawPixel(&atlas, bx+rx, by+ry, rl::Color{r: 90, g: 90, b: 90, a: 255});
        }
    }
    for k in 0..10 {
        let cx = rl::GetRandomValue(1, w - 2);
        let cy = rl::GetRandomValue(1, h - 2);
        rl::ImageDrawRectangle(&atlas, bx+cx, by+cy, 2, 2, rl::Color{r: 80, g: 80, b: 80, a: 255});
        rl::ImageDrawRectangle(&atlas, bx+cx+1, by+cy+1, 2, 2, rl::Color{r: 120, g: 120, b: 120, a: 255});
    }

    // Row 3
    // Crystal (Procedural)
    let cx = 0;
    let cy_pos = h * 3;
    rl::ImageDrawRectangle(&atlas, cx, cy_pos, w, h, rl::Color{r: 200, g: 0, b: 255, a: 180});
    rl::ImageDrawRectangle(&atlas, cx+4, cy_pos+4, w-8, h-8, rl::Color{r: 0, g: 255, b: 255, a: 200});
    rl::ImageDrawRectangle(&atlas, cx+2, cy_pos+2, 2, 2, rl::WHITE);
    rl::ImageDrawRectangle(&atlas, cx+w-4, cy_pos+h-4, 2, 2, rl::WHITE);

    tex_atlas = rl::LoadTextureFromImage(atlas);
    rl::SetTextureFilter(tex_atlas, rl::TEXTURE_FILTER_POINT);
    
    // Cleanup Images
    rl::UnloadImage(img_dirt);
    rl::UnloadImage(img_grass_s);
    rl::UnloadImage(img_grass_t);
    rl::UnloadImage(img_stone);
    rl::UnloadImage(img_log);
    rl::UnloadImage(img_leaves);
    rl::UnloadImage(atlas);

    tex_grass = load_texture_from_memory(plant_data.data, plant_data.len);
    tex_sun = load_texture_from_memory(sun_data.data, sun_data.len);
    tex_moon = load_texture_from_memory(moon_data.data, moon_data.len);
    
    sh_lighting = load_shader_from_memory(vs_data.data, vs_data.len, fs_data.data, fs_data.len);
    sh_grass = load_shader_from_memory(vs_grass_data.data, vs_grass_data.len, fs_grass_data.data, fs_grass_data.len);
    sh_beam = load_shader_from_memory(vs_beam_data.data, vs_beam_data.len, fs_beam_data.data, fs_beam_data.len);

    // Get Uniform Locations
    loc_light_dir = rl::GetShaderLocation(sh_lighting, "uLightDir");
    loc_light_col = rl::GetShaderLocation(sh_lighting, "uLightCol");
    loc_ambient = rl::GetShaderLocation(sh_lighting, "uAmbient");
    loc_view_pos = rl::GetShaderLocation(sh_lighting, "viewPos");
    loc_time = rl::GetShaderLocation(sh_lighting, "time");
    
    loc_grass_light_dir = rl::GetShaderLocation(sh_grass, "uLightDir");
    loc_grass_light_col = rl::GetShaderLocation(sh_grass, "uLightCol");
    loc_grass_ambient = rl::GetShaderLocation(sh_grass, "uAmbient");
    loc_grass_view_pos = rl::GetShaderLocation(sh_grass, "viewPos");
    loc_grass_time = rl::GetShaderLocation(sh_grass, "time");
    loc_grass_use_tex = rl::GetShaderLocation(sh_grass, "uUseTex");

    // Set default values (Mid-day)
    let d = rl::Vector3{x: 0.8, y: 1.0, z: 0.5};
    let c = rl::Vector3{x: 0.9, y: 0.9, z: 0.85};
    let a = rl::Vector3{x: 0.5, y: 0.5, z: 0.55};
    
    rl::SetShaderValue(sh_lighting, loc_light_dir, &d, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_lighting, loc_light_col, &c, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_lighting, loc_ambient, &a, rl::SHADER_UNIFORM_VEC3);
    
    rl::SetShaderValue(sh_grass, loc_grass_light_dir, &d, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_grass, loc_grass_light_col, &c, rl::SHADER_UNIFORM_VEC3);
    rl::SetShaderValue(sh_grass, loc_grass_ambient, &a, rl::SHADER_UNIFORM_VEC3);

    model_skull = rl::LoadModel("assets/3DModels/skull.glb");
    model_skull.materials[0].shader = sh_lighting;
}

fn get_tex_atlas() -> rl::Texture2D { return tex_atlas; }
fn get_tex_grass() -> rl::Texture2D { return tex_grass; }
fn get_shader_lighting() -> rl::Shader { return sh_lighting; }
fn get_shader_grass() -> rl::Shader { return sh_grass; }
fn get_shader_beam() -> rl::Shader { return sh_beam; }
fn get_model_skull() -> rl::Model { return model_skull; }