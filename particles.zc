//> Particle System Engine
import "raylib.h" as rl;
import "rlgl.h";
import "math.h";

struct Particle {
    x: float; y: float; z: float;
    vx: float; vy: float; vz: float;
    life: float;
    color: rl::Color;
    size: float;
    active: int;
}

def MAX_PARTICLES = 500;
let particles: Particle[500];

fn init_particles() {
    for i in 0..MAX_PARTICLES {
        particles[i].active = 0;
    }
}

fn spawn_particle(x: float, y: float, z: float, color: rl::Color) {
    // Find free slot
    for i in 0..MAX_PARTICLES {
        if particles[i].active == 0 {
            particles[i].x = x;
            particles[i].y = y;
            particles[i].z = z;
            
            // Random velocity (Explosion math 100% native)
            particles[i].vx = ((float)rl::GetRandomValue(-100, 100) / 100.0) * 4.0;
            particles[i].vy = ((float)rl::GetRandomValue(-50, 200) / 100.0) * 3.0; 
            particles[i].vz = ((float)rl::GetRandomValue(-100, 100) / 100.0) * 4.0;
            
            particles[i].life = 1.0; // 1 second
            particles[i].color = color;
            
            // Unified RNG (No more rand() from C)
            particles[i].size = 0.1 + ((float)rl::GetRandomValue(0, 10) / 50.0);
            particles[i].active = 1;
            return;
        }
    }
}

fn spawn_explosion(x: float, y: float, z: float, count: int, color: rl::Color) {
    for i in 0..count {
        spawn_particle(x, y, z, color);
    }
}

fn update_particles(dt: float) {
   for i in 0..MAX_PARTICLES {
       if particles[i].active == 1 {
           particles[i].x = particles[i].x + (particles[i].vx * dt);
           particles[i].y = particles[i].y + (particles[i].vy * dt);
           particles[i].z = particles[i].z + (particles[i].vz * dt);
           
           particles[i].vy = particles[i].vy - (9.0 * dt); // Gravity
           
           particles[i].life = particles[i].life - (dt * 1.5); // Fade faster
           if particles[i].life <= 0.0 {
               particles[i].active = 0;
           }
       }
   }
}

fn draw_particles() {
    // Enable proper transparency rendering without breaking the Z-Buffer
    rlDisableDepthMask(); 
    
    for i in 0..MAX_PARTICLES {
        if particles[i].active == 1 {
            let col = particles[i].color;
            let alpha = particles[i].life;
            
            if alpha < 0.0 { alpha = 0.0; }
            if alpha > 1.0 { alpha = 1.0; }
            
            // Native cast to char (0-255) for the alpha channel
            col.a = (char)(alpha * 255.0);
            
            // Safe struct instantiation
            let pos: rl::Vector3;
            pos.x = particles[i].x;
            pos.y = particles[i].y;
            pos.z = particles[i].z;
            
            rl::DrawCube(pos, particles[i].size, particles[i].size, particles[i].size, col);
        }
    }
    
    // Restore Z-Buffer writing
    rlEnableDepthMask();
}