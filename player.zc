//> This file contains player-related structures and physics

import "raylib.h" as rl;
import "rlgl.h";
import "math.h";
import "chunk.zc";
import "blocks.zc";

// Physics Constants
def GRAVITY = 18.0;
def JUMP_FORCE = 8.0;
def MOVE_SPEED = 5.0;

struct Player {
    x: float;
    y: float;
    z: float;
    vx: float;
    vy: float;
    vz: float;
    yaw: float;
    pitch: float;
    camera: rl::Camera3D;
    
    // Movement State
    is_flying: int;
    last_jump_time: double;
    is_crouching: int;
    
    // Stats
    health: float;
    mana: float;
}

fn check_collision(chunks: Chunk*, num_chunks: int, x: float, y: float, z: float, w: float, h: float) -> int {
    let min_x = (int)floor(x - w/2.0);
    let max_x = (int)floor(x + w/2.0);
    let min_y = (int)floor(y);
    let max_y = (int)floor(y + h);
    let min_z = (int)floor(z - w/2.0);
    let max_z = (int)floor(z + w/2.0);

    for ix in min_x..max_x+1 {
        for iy in min_y..max_y+1 {
            for iz in min_z..max_z+1 {
                let block = get_block(chunks, num_chunks, ix, iy, iz);
                
                // Tall grass, torches, and all water levels are non-solid
                if block != BLOCK_AIR && block != BLOCK_TALLGRASS && !(block >= 10 && block <= 14) && block != BLOCK_WATER && block != BLOCK_WATER_2 && block != BLOCK_WATER_1 {
                    return 1;
                }
            }
        }
    }
    return 0;
}

impl Player {
    static fn new(x: float, y: float, z: float) -> Player {
        let p: Player;
        p.x = x;
        p.y = y;
        p.z = z;
        p.vx = 0.0;
        p.vy = 0.0;
        p.vz = 0.0;
        p.yaw = 0.0;
        p.pitch = 0.0;
        
        p.is_flying = 0;
        p.last_jump_time = 0.0;
        p.is_crouching = 0;
        
        p.health = 100.0;
        p.mana = 100.0;

        p.camera = rl::Camera3D{
            position: rl::Vector3{x: x, y: y, z: z},
            target: rl::Vector3{x: x+1.0, y: y, z: z},
            up: rl::Vector3{x: 0.0, y: 1.0, z: 0.0},
            fovy: 70.0,
            projection: rl::CAMERA_PERSPECTIVE
        };
        
        return p;
    }

    fn update(self, chunks: Chunk*, num_chunks: int, dt: float) {
        // Mouse look
        let mouse_delta = rl::GetMouseDelta();
        self.yaw += mouse_delta.x * 0.003;
        self.pitch += mouse_delta.y * 0.003;

        if self.pitch > 1.5 { self.pitch = 1.5; }
        if self.pitch < -1.5 { self.pitch = -1.5; }

        // Check if current chunk is loaded
        let cx = (int)floor(self.x / 16.0);
        let cz = (int)floor(self.z / 16.0);
        let idx = get_chunk_index(cx, cz);
        
        // If chunk is not loaded, don't apply physics (gravity/movement)
        // This prevents falling through the world while waiting for async load
        // Check light sentinel (-1 means requested but not loaded)
        if chunks[idx].x == cx && chunks[idx].z == cz && chunks[idx].light[0][0][0] != -1 {
            // Movement input
            let dx = 0.0;
            let dz = 0.0;
            if rl::IsKeyDown(rl::KEY_W) { dx += 1.0; }
            if rl::IsKeyDown(rl::KEY_S) { dx -= 1.0; }
            if rl::IsKeyDown(rl::KEY_A) { dz -= 1.0; }
            if rl::IsKeyDown(rl::KEY_D) { dz += 1.0; }

            let fx = (float)cos(self.yaw);
            let fz = (float)sin(self.yaw);
            // FIXED: Cast to float first, then negate to avoid transpiler confusion
            let rx = -(float)sin(self.yaw);
            let rz = (float)cos(self.yaw);

            let move_x = fx * dx + rx * dz;
            let move_z = fz * dx + rz * dz;
            
            // Check if player is in water (check at player center)
            let player_block = get_block(chunks, num_chunks, (int)floor(self.x), (int)floor(self.y + 0.9), (int)floor(self.z));
            let in_water = (player_block == BLOCK_WATER);
            
            // Input Detection
            
            // 1. Crouch / Fly Cancel
            self.is_crouching = 0;
            if rl::IsKeyDown(rl::KEY_LEFT_CONTROL) {
                if self.is_flying {
                    self.is_flying = 0; // Cancel flight
                } else {
                    self.is_crouching = 1;
                }
            }

            // 2. Double Jump (Fly Toggle)
            if rl::IsKeyPressed(rl::KEY_SPACE) {
                let time = rl::GetTime();
                if time - self.last_jump_time < 0.3 {
                    self.is_flying = !self.is_flying;
                    self.vy = 0.0; // Reset velocity on toggle
                }
                self.last_jump_time = time;
                
                // Jump if walking
                if !self.is_flying && check_collision(chunks, num_chunks, self.x, self.y - 0.1, self.z, 0.6, 1.8) {
                     self.vy = JUMP_FORCE;
                }
            }
            
            // Movement speed modifier
            let speed_mult = 1.0;
            if self.is_flying { 
                speed_mult = 2.0;
            } else if self.is_crouching {
                speed_mult = 0.3;
            } else if in_water {
                speed_mult = 0.5; // Slower in water
            }

            let mlen = (float)sqrt(move_x*move_x + move_z*move_z);
            if mlen > 0.001 {
                move_x /= mlen;
                move_z /= mlen;
                self.vx = move_x * MOVE_SPEED * speed_mult;
                self.vz = move_z * MOVE_SPEED * speed_mult;
            } else {
                self.vx = 0.0;
                self.vz = 0.0;
            }

            // Vertical Movement & Gravity
            if self.is_flying {
                // Flying Physics
                self.vy = 0.0; // No gravity
                if rl::IsKeyDown(rl::KEY_SPACE) { self.vy = MOVE_SPEED * speed_mult; }
                if rl::IsKeyDown(rl::KEY_LEFT_SHIFT) { self.vy = -MOVE_SPEED * speed_mult; }
                
            } else {
                // Walking Physics
                let gravity_mult = 1.0;
                if in_water {
                    gravity_mult = 0.3; // Buoyancy effect
                }
                self.vy -= (float)GRAVITY * dt * gravity_mult;
            }

            // Physics integration (Separate Axes)
            let box_w = 0.6;
            let box_h = 1.8;

            // X axis
            self.x += self.vx * dt;
            if check_collision(chunks, num_chunks, self.x, self.y, self.z, box_w, box_h) {
                self.x -= self.vx * dt; // Revert
                self.vx = 0.0;
            }

            // Z axis
            self.z += self.vz * dt;
            if check_collision(chunks, num_chunks, self.x, self.y, self.z, box_w, box_h) {
                self.z -= self.vz * dt; // Revert
                self.vz = 0.0;
            }

            // Y axis
            self.y += self.vy * dt;
            if check_collision(chunks, num_chunks, self.x, self.y, self.z, box_w, box_h) {
                self.y -= self.vy * dt; // Revert
                self.vy = 0.0;
            }

            // Check World Floor (Void Safety)
            if self.y < -30.0 {
                // Assuming CHUNK_HEIGHT is 32 (or similar from chunk.zc), using a fallback height
                self.y = 32.0 + 20.0; 
                self.vy = 0.0;
            }
        } else {
            // Optional: Apply minimal damping or zero velocity to stop sliding if we entered void
            self.vx = 0.0;
            self.vy = 0.0;
            self.vz = 0.0;
        }

        // Sync Camera
        let view_x = (float)(cos(self.yaw) * cos(self.pitch));
        let view_z = (float)(sin(self.yaw) * cos(self.pitch));
        // FIXED: Same transpiler fix for view_y
        let view_y = -(float)sin(self.pitch);

        self.camera.position.x = self.x;
        
        // Camera Height
        let eye_height = 1.6;
        if self.is_crouching { eye_height = 1.3; }
        
        self.camera.position.y = self.y + eye_height;
        self.camera.position.z = self.z;

        self.camera.target.x = self.camera.position.x + view_x;
        self.camera.target.y = self.camera.position.y + view_y;
        self.camera.target.z = self.camera.position.z + view_z;
    }
    
    fn draw_arm(self, time: float) {
        // Use a separate 3D camera pass for the weapon (standard FPS technique)
        // This camera sits at origin and looks forward, with the arm placed relative to it.
        let bob_y: float = 0.0;
        let bob_x: float = 0.0;
        let v_len = (float)sqrt(self.vx * self.vx + self.vz * self.vz);
        
        if v_len > 0.1 {
            bob_y = (float)sin(time * 10.0) * 0.03;
            bob_x = (float)cos(time * 10.0) * 0.02;
        }
        
        // Create a dedicated "weapon camera" at origin looking down -Z
        let arm_cam = rl::Camera3D{
            position: rl::Vector3{x: 0.0, y: 0.0, z: 0.0},
            target: rl::Vector3{x: 0.0, y: 0.0, z: -1.0},
            up: rl::Vector3{x: 0.0, y: 1.0, z: 0.0},
            fovy: 70.0,
            projection: rl::CAMERA_PERSPECTIVE
        };
        
        // Clear depth buffer so arm always draws on top of world
        rl::rlDisableDepthTest();
        
        rl::BeginMode3D(arm_cam);
        
        // Arm offset: Right, Down, Forward (-Z)
        // Adjusted for vertical hold
        let ax = 0.5 + bob_x; // Further right
        let ay = -0.4 + bob_y; // Lower down
        let az = -0.6; // Close to camera
        
        // --- DRAW ARM (Skin) ---
        // Arm Mesh (angled from bottom right corner)
        rl::rlPushMatrix();
        rl::rlTranslatef(ax + 0.2, ay - 0.2, az + 0.2);
        rl::rlRotatef(-45.0, 0.0, 0.0, 1.0); // Tilt arm
        rl::rlRotatef(20.0, 1.0, 0.0, 0.0); // Pitch arm
        rl::DrawCube(rl::Vector3{x: 0.0, y: 0.0, z: 0.0}, 0.12, 0.6, 0.12, rl::Color{r: 220, g: 180, b: 150, a: 255}); // Forearm
        rl::rlPopMatrix();
        
        // Hand (holding scepter)
        rl::DrawCube(rl::Vector3{x: ax, y: ay, z: az}, 0.1, 0.1, 0.1, rl::Color{r: 220, g: 180, b: 150, a: 255});
        
        // --- DRAW SCEPTER (Vertical) ---
        // Handle (Dark Wood) - Base at hand height, extending up
        rl::DrawCube(rl::Vector3{x: ax, y: ay + 0.3, z: az}, 0.04, 0.7, 0.04, rl::Color{r: 80, g: 50, b: 25, a: 255});
        
        // Handle Rings
        rl::DrawCube(rl::Vector3{x: ax, y: ay + 0.15, z: az}, 0.05, 0.02, 0.05, rl::Color{r: 180, g: 150, b: 50, a: 255});
        rl::DrawCube(rl::Vector3{x: ax, y: ay + 0.55, z: az}, 0.05, 0.02, 0.05, rl::Color{r: 180, g: 150, b: 50, a: 255});
        
        // Head Mount (Gold) - Top of handle
        rl::DrawCube(rl::Vector3{x: ax, y: ay + 0.68, z: az}, 0.12, 0.12, 0.12, rl::Color{r: 255, g: 215, b: 0, a: 255});
        
        // Gem (Glowing Crystal) - Floating/Mounted on top
        let pulse = 0.7 + 0.3 * (float)sin(time * 3.0);
        let gem_alpha = (int)(180.0 + 75.0 * pulse);
        let gem_size = 0.08 + 0.01 * pulse;
        let gem_g = (int)(200.0 * pulse);
        
        rl::DrawCube(rl::Vector3{x: ax, y: ay + 0.68, z: az}, gem_size, gem_size + 0.05, gem_size, rl::Color{r: 0, g: gem_g, b: 255, a: gem_alpha});
        
        rl::EndMode3D();
        
        // Re-enable depth testing for the rest of the engine
        rl::rlEnableDepthTest();
    }
}