//> link: -lraylib -lm
raw {
    #define ZALLOC_IMPLEMENTATION
    #define ZALLOC_ENABLE_DEBUG
    
    #define Z_MALLOC(sz)      zdebug_malloc_loc(sz, __FILE__, __LINE__)
    #define Z_CALLOC(n,sz)    zdebug_calloc_loc(n, sz, __FILE__, __LINE__)
    #define Z_REALLOC(p,sz)   zdebug_realloc_loc(p, sz, __FILE__, __LINE__)
    #define Z_FREE(p)         zdebug_free(p)
    
    #include "zalloc.h"
    
    // Wrappers para ZALLOC en Zen-C
    void* sys_zdebug_malloc(int sz) { return zdebug_malloc((size_t)sz); }
    void sys_zdebug_free(void* p) { zdebug_free(p); }
    void sys_zdebug_register_atexit() { zdebug_register_atexit(); }
}

extern fn sys_zdebug_malloc(sz: int) -> any;
extern fn sys_zdebug_free(p: any);
extern fn sys_zdebug_register_atexit();

import "raylib.h" as rl;
import "rlgl.h";
import "math.h";

import "blocks.zc";
import "lighting.zc";
import "chunk_core.zc";
import "chunk_mesh.zc";
import "rendering.zc";
import "player.zc";
import "persistence.zc";
import "title_generator.zc";
import "zibi.zc";
import "grass_deco.zc";
import "particles.zc";
import "spellbook.zc";
import "player_interaction.zc";

// Import modules from the refactoring
import "game_loading.zc";
import "game_ui.zc";
import "player_interaction.zc";
import "bloom.zc";

def VERSION_TEXT = "v0.0.1.14 alpha-dev";
def MAX_ZIBIS = 10;
def SAVE_DIR = "world";

def STATE_TITLE = 0;
def STATE_LOADING = 1;
def STATE_GAME = 2;

fn main() {
    rl::SetTraceLogLevel(rl::LOG_WARNING);
    rl::InitWindow(SCREEN_WIDTH, SCREEN_HEIGHT, TITLE);
    rl::SetWindowState(rl::FLAG_WINDOW_RESIZABLE | rl::FLAG_VSYNC_HINT | rl::FLAG_WINDOW_ALWAYS_RUN);
    //rl::ToggleFullscreen();
    rl::SetTargetFPS(60);

    init_textures();
    init_clouds();
    init_bloom(SCREEN_WIDTH, SCREEN_HEIGHT);
    
    // Array de chunks usando nuestro wrapper seguro
    let chunks = (Chunk*)sys_zdebug_malloc(sizeof(Chunk) * MAX_CHUNKS);
    sys_zdebug_register_atexit();
    init_persistence(chunks);

    let current_state = STATE_TITLE;
    let show_debug_info = 1;
    let first_frame = 1;
    
    let show_settings = 0;
    let draw_distance = 6;
    let grass_dist: float = 64.0;
    
    set_game_world_dir("titleworld");
    let title_cam = rl::Camera3D{ position: rl::Vector3{x: 8.0, y: 15.0, z: 25.0}, target: rl::Vector3{x: 8.0, y: 12.0, z: 0.0}, up: rl::Vector3{x: 0.0, y: 1.0, z: 0.0}, fovy: 50.0, projection: rl::CAMERA_PERSPECTIVE };
    
    let p: Player;
    let selected_block = BLOCK_STONE;
    let spellbook = SpellbookState::new();
    let show_spellbook = 0;
    let zibis: Zibi[MAX_ZIBIS];
    
    defer { 
        cleanup_persistence();
        sys_zdebug_free((any)chunks);
        rl::CloseWindow();
    }

    for i in 0..MAX_CHUNKS { chunks[i].x = -9999; chunks[i].z = -9999; chunks[i].locked = 0; }
    
    let day_time = 0.2;
    let title_start_time = rl::GetTime();

    while rl::WindowShouldClose() == 0 {
        if rl::IsMouseButtonPressed(rl::MOUSE_BUTTON_LEFT) {
            if show_settings == 0 && show_spellbook == 0 { rl::DisableCursor(); }
        }

        let dt = rl::GetFrameTime();
        if dt > 0.1 { dt = 0.1; }
        
        // --- TITLE STATE ---
        if current_state == STATE_TITLE {
            update_day_night_cycle(0.12);
            
            if rl::IsKeyPressed(rl::KEY_ENTER) {
                current_state = STATE_LOADING;
                for i in 0..MAX_CHUNKS { chunks[i].x = -9999; chunks[i].z = -9999; chunks[i].mesh_built = 0; }
                set_game_world_dir(SAVE_DIR);
                
                rl::BeginDrawing();
                rl::ClearBackground(rl::BLACK);
                rl::DrawText("GENERATING WORLD...", SCREEN_WIDTH/2 - 100, SCREEN_HEIGHT/2, 20, rl::WHITE);
                rl::EndDrawing();
                continue;
            }

            update_title_screen(chunks, MAX_CHUNKS, dt);
            poll_async_results();
            for i in 0..MAX_CHUNKS {
                if chunks[i].x != -9999 && chunks[i].mesh_dirty != 0 && chunks[i].locked == 0 { request_mesh_async(i, 0); }
            }

            rl::BeginDrawing();
            rl::ClearBackground(rl::Color{r: 20, g: 20, b: 30, a: 255});

            let time = (float)rl::GetTime() - (float)title_start_time;
            title_cam.position.x = 8.0 + (float)sin(time * 0.2 - 1.57) * 40.0;
            title_cam.position.z = (float)cos(time * 0.2 - 1.57) * 40.0;
            title_cam.position.y = 14.0 + (float)sin(time * 0.1) * 2.0;
            
            update_frame_uniforms(title_cam.position, time);
            
            rl::BeginMode3D(title_cam);
            raw { rlDisableBackfaceCulling(); }
            let title_builds = 0;
            for i in 0..MAX_CHUNKS { if chunks[i].x != -9999 { chunks[i].draw_opaque(chunks, MAX_CHUNKS, &title_builds, 100, 8, 25); } }
            for i in 0..MAX_CHUNKS { if chunks[i].x != -9999 { chunks[i].draw_transparent(chunks, MAX_CHUNKS, 8, 25, grass_dist); } }
            rl::EndMode3D();
            
            rl::DrawText("ZEN CRAFT", 100, 100, 60, rl::WHITE);
            rl::DrawText(VERSION_TEXT, 100, 160, 20, rl::WHITE);
            rl::DrawText("Press ENTER to Play", 150, 400, 30, rl::LIGHTGRAY);
            rl::EndDrawing();
        }
        
        // --- LOADING STATE ---
        else if current_state == STATE_LOADING {
            process_loading_step(chunks, draw_distance);
            
            if loading_is_done == 1 {
                p = Player::new(load_start_x, load_start_y, load_start_z);
                p.yaw = load_start_yaw; p.pitch = load_start_pitch;
                for i in 0..MAX_ZIBIS { zibis[i].active = 0; }
                current_state = STATE_GAME;
                rl::DisableCursor();
            }
            draw_loading_screen();
        }
        
        // --- GAME STATE ---
        else {
            let pcx = (int)floor(p.x / 16.0);
            let pcz = (int)floor(p.z / 16.0);
            let unload_dist = draw_distance + 2;
            
            // Unload chunks
            for i in 0..MAX_CHUNKS {
                if chunks[i].x != -9999 && chunks[i].locked == 0 {
                    let dist_x = abs(chunks[i].x - pcx); let dist_z = abs(chunks[i].z - pcz);
                    if dist_x > unload_dist || dist_z > unload_dist {
                         request_save_async(&chunks[i]);
                         chunks[i].x = -9999; chunks[i].z = -9999;
                         chunks[i].mesh_built = 0; chunks[i].mesh_dirty = 0;
                    }
                }
            }

            for i in 0..MAX_CHUNKS { if chunks[i].x != -9999 && chunks[i].locked == 0 { tick_chunk(&chunks[i], chunks, MAX_CHUNKS); } }

            let requests_this_frame = 0;
            let max_req = 4;
            
            // Spiral Chunk Loading
            for dist in 0..(draw_distance + 1) {
                if requests_this_frame >= max_req { break; }
                if dist == 0 {
                    let idx = get_chunk_index(pcx, pcz);
                    if chunks[idx].x != pcx || chunks[idx].z != pcz {
                        if is_chunk_pending(pcx, pcz) == 0 && chunks[idx].locked == 0 {
                            if chunks[idx].x != -9999 { request_save_async(&chunks[idx]); }
                            chunks[idx].x = -9999;
                            request_load_async(idx, pcx, pcz, 0);
                            requests_this_frame++;
                        }
                    }
                    continue;
                }
                
                for side in 0..4 {
                    for step in 0..(dist * 2) {
                        if requests_this_frame >= max_req { break; }
                        let dx = 0; let dz = 0;
                        if side == 0 { dx = -dist + step; dz = -dist; }
                        else if side == 1 { dx = dist; dz = -dist + step; }
                        else if side == 2 { dx = dist - step; dz = dist; }
                        else { dx = -dist; dz = dist - step; }
                        
                        let cx = pcx + dx; let cz = pcz + dz;
                        let idx = get_chunk_index(cx, cz);
                        
                        if chunks[idx].x != cx || chunks[idx].z != cz {
                            if is_chunk_pending(cx, cz) == 0 && chunks[idx].locked == 0 {
                                if chunks[idx].x != -9999 { request_save_async(&chunks[idx]); }
                                chunks[idx].x = -9999;
                                request_load_async(idx, cx, cz, 0);
                                requests_this_frame++;
                            }
                        }
                    }
                }
            }
            
            if first_frame == 1 { init_particles(); first_frame = 0; }
            poll_async_results();
            update_particles(dt);
            
            let mesh_requests = 0;
            for i in 0..MAX_CHUNKS {
                if mesh_requests >= 16 { break; }
                if chunks[i].x != -9999 && chunks[i].mesh_dirty != 0 && chunks[i].locked == 0 {
                    if request_mesh_async(i, 0) == 1 { mesh_requests++; }
                }
            }
            
            for i in 0..MAX_CHUNKS {
                 if chunks[i].x != -9999 && chunks[i].mesh_built != 0 && chunks[i].grass_deco_built == 0 {
                      if grass_dist > 0.0 { build_grass_decorations(&chunks[i], chunks, MAX_CHUNKS); }
                 }
            }
            
            if rl::IsKeyPressed(rl::KEY_E) {
                show_spellbook = !show_spellbook;
                if show_spellbook { rl::EnableCursor(); } else { rl::DisableCursor(); }
            }

            if show_settings == 0 && show_spellbook == 0 {
                (&p).update(chunks, MAX_CHUNKS, dt);
                
                if rl::IsKeyPressed(rl::KEY_ONE) { selected_block = BLOCK_DIRT; }
                if rl::IsKeyPressed(rl::KEY_TWO) { selected_block = BLOCK_GRASS; }
                if rl::IsKeyPressed(rl::KEY_THREE) { selected_block = BLOCK_STONE; } 
                if rl::IsKeyPressed(rl::KEY_FOUR) { selected_block = BLOCK_LOG; }
                if rl::IsKeyPressed(rl::KEY_FIVE) { selected_block = BLOCK_LEAVES; }
                if rl::IsKeyPressed(rl::KEY_SIX) { selected_block = BLOCK_TORCH; }
                if rl::IsKeyPressed(rl::KEY_SEVEN) { selected_block = BLOCK_WATER; }
                if rl::IsKeyPressed(rl::KEY_EIGHT) { selected_block = BLOCK_GLASS_PANE; }
            }
            
            let active_zibis = 0;
            for i in 0..MAX_ZIBIS {
                if zibis[i].active == 1 {
                    active_zibis++;
                    if zibis[i].update(chunks, MAX_CHUNKS, dt) == 0 { active_zibis--; }
                }
            }
            
            if active_zibis < MAX_ZIBIS && rl::GetRandomValue(0, 100) < 5 {
                let slot = -1;
                for i in 0..MAX_ZIBIS { if zibis[i].active == 0 { slot = i; break; } }
                if slot != -1 {
                    let angle = ((float)rl::GetRandomValue(0, 360)) * 0.0174533;
                    let dist = (float)rl::GetRandomValue(20, 60);
                    let sx = p.x + (float)cos(angle) * dist; let sz = p.z + (float)sin(angle) * dist;
                    let cx = (int)floor(sx / 16.0); let cz = (int)floor(sz / 16.0);
                    let idx = get_chunk_index(cx, cz);
                    
                    if chunks[idx].x == cx && chunks[idx].z == cz && chunks[idx].mesh_built == 1 {
                         let ground_y = -1.0;
                         for y in 0..CHUNK_HEIGHT {
                             let ry = (CHUNK_HEIGHT - 1) - y;
                             let b = get_block(chunks, MAX_CHUNKS, (int)sx, ry, (int)sz);
                             if b != BLOCK_AIR && b != BLOCK_TALLGRASS && b != BLOCK_LEAVES && b != 10 { ground_y = (float)ry; break; }
                         }
                         if ground_y > 0.0 {
                             let surf = get_block(chunks, MAX_CHUNKS, (int)sx, (int)ground_y, (int)sz);
                             if surf != BLOCK_WATER && surf != BLOCK_LEAVES { zibis[slot] = Zibi::new(sx, ground_y + 2.0, sz); }
                         }
                    }
                }
            }

            if rl::IsKeyPressed(rl::KEY_F3) { show_debug_info = !show_debug_info; }
            if rl::IsKeyPressed(rl::KEY_F11) { rl::ToggleFullscreen(); }
            if rl::IsKeyPressed(rl::KEY_F1) { 
                show_settings = !show_settings;
                if show_settings { rl::EnableCursor(); } else { rl::DisableCursor(); }
            }
            
            day_time = day_time + (dt / 240.0); // 240 seconds total for a full day+night cycle
            if day_time > 1.0 { day_time = day_time - 1.0; }
            update_day_night_cycle(day_time);
            
            let wind_time = (float)rl::GetTime();
            update_frame_uniforms(p.camera.position, wind_time);
            
            rl::BeginDrawing();
            
            let sky_r = 0; let sky_g = 0; let sky_b = 5;
            if day_time < 0.166 { let t = day_time / 0.166; sky_r = (int)(135.0 * t); sky_g = (int)(206.0 * t); sky_b = (int)(5.0 * (1.0 - t) + 235.0 * t); }
            else if day_time < 0.5 { sky_r = 135; sky_g = 206; sky_b = 235; }
            else if day_time < 0.666 { let t = (day_time - 0.5) / 0.166; sky_r = (int)(135.0 * (1.0 - t)); sky_g = (int)(206.0 * (1.0 - t)); sky_b = (int)(235.0 * (1.0 - t) + 5.0 * t); }

            rl::ClearBackground(rl::Color{r: sky_r, g: sky_g, b: sky_b, a: 255});
            draw_sky(p.camera, day_time); draw_clouds(p.camera, wind_time, day_time);
    
            // --- Begin bloom scene capture ---
            bloom_begin();
            rl::ClearBackground(rl::Color{r: sky_r, g: sky_g, b: sky_b, a: 255});
            draw_sky(p.camera, day_time); draw_clouds(p.camera, wind_time, day_time);
    
            rl::BeginMode3D(p.camera);
            raw { rlDisableBackfaceCulling(); rlEnableDepthTest(); rlSetBlendMode(BLEND_ALPHA); }
    
            let builds_in_frame = 0;
            let cam_fx = p.camera.target.x - p.camera.position.x; let cam_fz = p.camera.target.z - p.camera.position.z;
            let cam_len = sqrt(cam_fx * cam_fx + cam_fz * cam_fz);
            if cam_len > 0.001 { cam_fx = cam_fx / cam_len; cam_fz = cam_fz / cam_len; }
            
            // --- Collect Crystal Light Positions ---
            let crystal_points: float[48]; // 16 * 3 (vec3 array for shader)
            let crystal_count = 0;
            
            for i in 0..MAX_CHUNKS {
                let c = &chunks[i];
                if c.x != -9999 {
                    let dist_x = abs(c.x - pcx); let dist_z = abs(c.z - pcz);
                    if dist_x <= draw_distance && dist_z <= draw_distance && crystal_count < 16 {
                         for s in 0..c.power_source_count {
                              if crystal_count >= 16 { break; }
                              // Position of the glowing crystal float
                              crystal_points[crystal_count * 3 + 0] = (float)(c.x * 16) + c.power_sources[s].x;
                              crystal_points[crystal_count * 3 + 1] = c.power_sources[s].y + 1.2;
                              crystal_points[crystal_count * 3 + 2] = (float)(c.z * 16) + c.power_sources[s].z;
                              crystal_count++;
                         }
                    }
                }
            }
            
            // Send to lighting shader
            let sh_light = get_shader_lighting();
            let loc_c_pts = get_loc_crystal_points();
            let loc_c_cnt = get_loc_crystal_count();
            if loc_c_cnt != -1 { rl::SetShaderValue(sh_light, loc_c_cnt, &crystal_count, rl::SHADER_UNIFORM_INT); }
            if loc_c_pts != -1 && crystal_count > 0 { rl::SetShaderValueV(sh_light, loc_c_pts, &crystal_points[0], rl::SHADER_UNIFORM_VEC3, crystal_count); }
            
            // Send to grass shader
            let sh_grass_fx = get_shader_grass();
            let loc_g_c_pts = get_loc_grass_crystal_points();
            let loc_g_c_cnt = get_loc_grass_crystal_count();
            if loc_g_c_cnt != -1 { rl::SetShaderValue(sh_grass_fx, loc_g_c_cnt, &crystal_count, rl::SHADER_UNIFORM_INT); }
            if loc_g_c_pts != -1 && crystal_count > 0 { rl::SetShaderValueV(sh_grass_fx, loc_g_c_pts, &crystal_points[0], rl::SHADER_UNIFORM_VEC3, crystal_count); }
            
            for i in 0..MAX_CHUNKS {
                let c = &chunks[i];
                if c.x != -9999 {
                    let dist_x = abs(c.x - pcx); let dist_z = abs(c.z - pcz);
                    if dist_x <= draw_distance && dist_z <= draw_distance {
                        if dist_x > 1 || dist_z > 1 {
                            let chunk_cx = (float)(c.x * 16 + 8) - p.camera.position.x; let chunk_cz = (float)(c.z * 16 + 8) - p.camera.position.z;
                            let chunk_dist = sqrt(chunk_cx * chunk_cx + chunk_cz * chunk_cz);
                            if chunk_dist > 0.001 { if ((cam_fx * chunk_cx + cam_fz * chunk_cz) / chunk_dist) < -0.2 { continue; } }
                        }
                        c.draw_opaque(chunks, MAX_CHUNKS, &builds_in_frame, 1, p.x, p.z);
                    }
                    
                    // Render Skulls
                    if dist_x <= draw_distance && dist_z <= draw_distance {
                         if c.skull_count > 0 {
                             let model = get_model_skull();
                             
                             let sh = get_shader_lighting();
                             rl::BeginShaderMode(sh);
                             
                             

                             let loc_entity_light = rl::GetShaderLocation(sh, "uEntityLight");
                             let loc_use_entity   = rl::GetShaderLocation(sh, "uUseEntityLight");
        
                             let use_ent = 1;
                             if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                             
                             for s in 0..c.skull_count {
                                 let pos = rl::Vector3{x: (float)(c.x * 16) + c.skulls[s].x, y: c.skulls[s].y + 0.1, z: (float)(c.z * 16) + c.skulls[s].z};
                                 
                                 let lx = (int)floor(pos.x); let ly = (int)floor(pos.y); let lz = (int)floor(pos.z);
                                 let packed_light = get_light_levels(chunks, MAX_CHUNKS, lx, ly, lz);
                                 
                                 let el = rl::Vector2{x: (float)(packed_light & 0xF) / 15.0, y: (float)((packed_light >> 4) & 0xF) / 15.0};
                                 if loc_entity_light != -1 { rl::SetShaderValue(sh, loc_entity_light, &el, rl::SHADER_UNIFORM_VEC2); }
                                 
                                 rl::DrawModelEx(model, pos, rl::Vector3{x: 0.0, y: 1.0, z: 0.0}, c.skulls[s].rotation, rl::Vector3{x: 1.0, y: 1.0, z: 1.0}, rl::WHITE);
                             }
                             
                             rl::EndShaderMode();
                             
                             use_ent = 0;
                             if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                        }
                    }

                    // Render Power Sources
                    if dist_x <= draw_distance && dist_z <= draw_distance {
                         if c.power_source_count > 0 {
                             let model_base = get_model_obelisco_base();
                             let model_cristal = get_model_obelisco_cristal();
                             
                             let sh = get_shader_lighting();
                             rl::BeginShaderMode(sh);
                             
                             let loc_entity_light = rl::GetShaderLocation(sh, "uEntityLight");
                             let loc_use_entity   = rl::GetShaderLocation(sh, "uUseEntityLight");
                             
                             let sh_c = get_shader_crystal();
                             let loc_c_entity_light = rl::GetShaderLocation(sh_c, "uEntityLight");
                             let loc_c_use_entity   = rl::GetShaderLocation(sh_c, "uUseEntityLight");
        
                             let use_ent = 1;
                             if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                             if loc_c_use_entity != -1 { rl::SetShaderValue(sh_c, loc_c_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                             
                             let time_now = (float)rl::GetTime();
                             
                             for s in 0..c.power_source_count {
                                 let pos = rl::Vector3{x: (float)(c.x * 16) + c.power_sources[s].x, y: c.power_sources[s].y, z: (float)(c.z * 16) + c.power_sources[s].z};
                                 
                                 let lx = (int)floor(pos.x); let ly = (int)floor(pos.y); let lz = (int)floor(pos.z);
                                 let packed_light = get_light_levels(chunks, MAX_CHUNKS, lx, ly, lz);
                                 
                                 let el = rl::Vector2{x: (float)(packed_light & 0xF) / 15.0, y: (float)((packed_light >> 4) & 0xF) / 15.0};
                                 if loc_entity_light != -1 { rl::SetShaderValue(sh, loc_entity_light, &el, rl::SHADER_UNIFORM_VEC2); }
                                 if loc_c_entity_light != -1 { rl::SetShaderValue(sh_c, loc_c_entity_light, &el, rl::SHADER_UNIFORM_VEC2); }
                                 
                                 rl::DrawModelEx(model_base, pos, rl::Vector3{x: 0.0, y: 1.0, z: 0.0}, 0.0, rl::Vector3{x: 1.0, y: 1.0, z: 1.0}, rl::WHITE);
                                 
                                 // Rotar en el eje Y (vertical) y hacer que flote arriba y abajo
                                 let hover_offset = (float)sin(time_now * 2.0 + (pos.x + pos.z)) * 0.15;
                                 let spin_angle = time_now * 50.0 + (pos.x + pos.z) * 10.0; // grados
                                 
                                 let cristal_pos = pos;
                                 cristal_pos.y = pos.y + 0.2 + hover_offset;
                                 
                                 // Check if this crystal is being recharged
                                 let emission_val: float = 0.0;
                                 
                                 let rx = get_recharge_target_x();
                                 let ry = get_recharge_target_y();
                                 let rz = get_recharge_target_z();
                                 
                                 let bcx = c.x * 16 + (int)c.power_sources[s].x;
                                 let bcy = (int)c.power_sources[s].y;
                                 let bcz = c.z * 16 + (int)c.power_sources[s].z;
                                 
                                 if bcx == rx && bcy == ry && bcz == rz {
                                     let r_timer = get_recharge_timer();
                                     emission_val = r_timer * 1.5;
                                     if emission_val > 2.0 { emission_val = 2.0; } // Max brightness limit
                                 }
                                 
                                 let loc_em = get_loc_emission();
                                 if loc_em != -1 { rl::SetShaderValue(sh, loc_em, &emission_val, rl::SHADER_UNIFORM_FLOAT); }
                                 let loc_c_em = get_loc_crystal_emission();
                                 if loc_c_em != -1 { rl::SetShaderValue(sh_c, loc_c_em, &emission_val, rl::SHADER_UNIFORM_FLOAT); }
                                 
                                 rl::DrawModelEx(model_cristal, cristal_pos, rl::Vector3{x: 0.0, y: 1.0, z: 0.0}, spin_angle, rl::Vector3{x: 1.0, y: 1.0, z: 1.0}, rl::WHITE);
                                 
                                 // Reset emission for next draw calls
                                 emission_val = 0.0;
                                 if loc_em != -1 { rl::SetShaderValue(sh, loc_em, &emission_val, rl::SHADER_UNIFORM_FLOAT); }
                                 if loc_c_em != -1 { rl::SetShaderValue(sh_c, loc_c_em, &emission_val, rl::SHADER_UNIFORM_FLOAT); }
                             }
                             
                             rl::EndShaderMode();
                             
                             use_ent = 0;
                             if loc_use_entity != -1 { rl::SetShaderValue(sh, loc_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                             if loc_c_use_entity != -1 { rl::SetShaderValue(sh_c, loc_c_use_entity, &use_ent, rl::SHADER_UNIFORM_INT); }
                        }
                    }
                }
            }
            
            for i in 0..MAX_CHUNKS {
                let c = &chunks[i];
                if c.x != -9999 {
                    let dist_x = abs(c.x - pcx); let dist_z = abs(c.z - pcz);
                    if dist_x <= draw_distance && dist_z <= draw_distance {
                        if dist_x > 1 || dist_z > 1 {
                            let chunk_cx = (float)(c.x * 16 + 8) - p.camera.position.x; let chunk_cz = (float)(c.z * 16 + 8) - p.camera.position.z;
                            let chunk_dist = sqrt(chunk_cx * chunk_cx + chunk_cz * chunk_cz);
                            if chunk_dist > 0.001 { if ((cam_fx * chunk_cx + cam_fz * chunk_cz) / chunk_dist) < -0.2 { continue; } }
                        }
                       c.draw_transparent(chunks, MAX_CHUNKS, (int)p.x, (int)p.z, grass_dist);
                    }
                }
            }
            
            for i in 0..MAX_ZIBIS { zibis[i].draw(chunks, MAX_CHUNKS, day_time); }
            draw_particles();
            
            if show_settings == 0 && show_spellbook == 0 {
                handle_player_interaction(&p, chunks, dt, selected_block);
            }
            
            rl::EndMode3D();
            
            // --- End bloom scene capture and composite ---
            bloom_end_and_draw();
            
            (&p).draw_arm((float)rl::GetTime());
            draw_hud(&p, selected_block, VERSION_TEXT);
            
            if show_debug_info { draw_debug_info(&p, chunks, dt, day_time, draw_distance, MAX_ZIBIS); }
            if show_settings { draw_settings_menu(&draw_distance, &grass_dist); }
            if show_spellbook { draw_spellbook(&spellbook, &selected_block); }

            rl::EndDrawing();
        }
    }

    if current_state == STATE_GAME { save_player_data(p.x, p.y, p.z, selected_block, p.yaw, p.pitch); }
    
    for i in 0..MAX_CHUNKS {
        if chunks[i].x != -9999 {
             while get_pending_req_count() >= 250 {
                 rl::BeginDrawing(); rl::ClearBackground(rl::BLACK);
                 rl::DrawText("SAVING WORLD... QUEUE FULL", SCREEN_WIDTH/2 - 150, SCREEN_HEIGHT/2, 20, rl::WHITE);
                 rl::EndDrawing(); rl::WaitTime(0.01);
             }
            request_save_async(&chunks[i]);
        }
    }
    
    let start_wait = rl::GetTime();
    while get_pending_req_count() > 0 && (rl::GetTime() - start_wait) < 5.0 {
        rl::BeginDrawing(); rl::ClearBackground(rl::BLACK);
        rl::DrawText("SAVING WORLD... DO NOT TURN OFF", SCREEN_WIDTH/2 - 150, SCREEN_HEIGHT/2, 20, rl::WHITE);
        rl::DrawText(rl::TextFormat("Pending: %d", get_pending_req_count()), SCREEN_WIDTH/2 - 50, SCREEN_HEIGHT/2 + 30, 20, rl::GRAY);
        rl::EndDrawing(); rl::WaitTime(0.01);
    }
}