//> Build grass decoration mesh for a chunk (LOD)
import "raylib.h" as rl;
import "math.h";
import "string.h";
import "blocks.zc";
import "chunk_core.zc";
import "chunk_light.zc";
import "rendering.zc";

struct DecoVertexData {
    vertices: float*; normals: float*;
    texcoords: float*; colors: char*;
    idx: int; max_verts: int;
}

fn push_deco_v(vd: DecoVertexData*, px: float, py: float, pz: float, u: float, v: float, light_r: char, light_g: char, flag: char) {
    if vd.idx >= vd.max_verts { return; }
    let i = vd.idx;
    vd.vertices[i * 3 + 0] = px; vd.vertices[i * 3 + 1] = py; vd.vertices[i * 3 + 2] = pz;
    vd.normals[i * 3 + 0] = 0.0; vd.normals[i * 3 + 1] = 1.0; vd.normals[i * 3 + 2] = 0.0;
    vd.texcoords[i * 2 + 0] = u; vd.texcoords[i * 2 + 1] = v;
    vd.colors[i * 4 + 0] = light_r; vd.colors[i * 4 + 1] = light_g; vd.colors[i * 4 + 2] = flag; vd.colors[i * 4 + 3] = (char)255;
    vd.idx = i + 1;
}

fn get_foliage_noise(x: float, z: float) -> float {
    let n1 = (float)sin(x * 0.05 + z * 0.05);
    let n2 = (float)sin(x * 0.2 - z * 0.1) * 0.5;
    let n3 = (float)cos(x * 0.1 + z * 0.2) * 0.25;
    let total = (n1 + n2 + n3) / 1.75; 
    return (total + 1.0) * 0.5;
}

fn build_grass_decorations(c: Chunk*, chunks: Chunk*, num_chunks: int) {
    let grass_count = 0;
    for x in 0..16 {
        for y in 0..CHUNK_HEIGHT - 1 {
            for z in 0..16 {
                if c.blocks[x][y][z] == BLOCK_GRASS {
                    let above = c.blocks[x][y + 1][z];
                    if above == BLOCK_AIR || above == BLOCK_WATER || above == BLOCK_WATER_1 || above == BLOCK_WATER_2 || above == BLOCK_WATER_0 {
                        grass_count++;
                    }
                }
            }
        }
    }
    
    if grass_count == 0 { c.grass_deco_built = 1; return; }
    
    let num_decorations = grass_count * 28;
    let vertex_count = num_decorations * 6; 
    
    let vd: DecoVertexData; vd.max_verts = vertex_count; vd.idx = 0;
    vd.vertices = (float*)rl::MemAlloc(vertex_count * 3 * 4);
    vd.normals = (float*)rl::MemAlloc(vertex_count * 3 * 4);
    vd.texcoords = (float*)rl::MemAlloc(vertex_count * 2 * 4);
    vd.colors = (char*)rl::MemAlloc(vertex_count * 4);
    
    let gx_base = c.x * 16; let gz_base = c.z * 16;
    
    for x in 0..16 {
        for y in 0..CHUNK_HEIGHT - 1 {
            for z in 0..16 {
                if c.blocks[x][y][z] == BLOCK_GRASS {
                    let above = c.blocks[x][y + 1][z];
                    if above == BLOCK_AIR || above == BLOCK_WATER || above == BLOCK_WATER_1 || above == BLOCK_WATER_2 || above == BLOCK_WATER_0 {
                        
                        let light_val = get_light_levels(chunks, num_chunks, gx_base + x, y + 1, gz_base + z);
                        let r_raw = (light_val & 0xF) * 17;
                        let g_raw = ((light_val >> 4) & 0xF) * 17;
                        
                        let light_r = (char)r_raw; let light_g = (char)g_raw;
                        let base_r = light_r; let base_g = light_g;
                        
                        let seed = (gx_base + x) * 31337 + (gz_base + z) * 4231 + y * 739;
                        
                        for i in 0..12 {
                            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF; let ox = (float)(seed % 1000) / 1000.0;
                            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF; let oz = (float)(seed % 1000) / 1000.0;
                            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF; let scale_rnd = (float)(seed % 1000) / 1000.0;
                            let height = 0.15 + (scale_rnd * 0.15); let width = 0.10 + (scale_rnd * 0.05);  
                            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF; let angle = (float)(seed % 360) * 0.0174533; 
                            
                            let px = (float)x + ox; let py = (float)y + 1.0; let pz = (float)z + oz;
                            let sa = (float)sin(angle) * width; let ca = (float)cos(angle) * width;
                            
                            push_deco_v(&vd, px - ca, py, pz - sa, 0.0, 1.0, base_r, base_g, (char)0);
                            push_deco_v(&vd, px + ca, py, pz + sa, 1.0, 1.0, base_r, base_g, (char)0);
                            push_deco_v(&vd, px + ca, py + height, pz + sa, 1.0, 0.0, light_r, light_g, (char)100);
                            push_deco_v(&vd, px - ca, py, pz - sa, 0.0, 1.0, base_r, base_g, (char)0);
                            push_deco_v(&vd, px + ca, py + height, pz + sa, 1.0, 0.0, light_r, light_g, (char)100);
                            push_deco_v(&vd, px - ca, py + height, pz - sa, 0.0, 0.0, light_r, light_g, (char)100);
                        }
                        
                        let noise = get_foliage_noise((float)(gx_base + x), (float)(gz_base + z));
                        if noise > 0.50 { 
                            let tall_blades = (int)((noise - 0.50) * 32.0); 
                            if tall_blades > 16 { tall_blades = 16; } 
                            
                            for i in 0..tall_blades {
                                seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF; let ox = (float)(seed % 1000) / 1000.0;
                                seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF; let oz = (float)(seed % 1000) / 1000.0;
                                seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF; let scale_rnd = (float)(seed % 1000) / 1000.0;
                                let height = 0.35 + (scale_rnd * 0.3) + (noise * 0.2); let width = 0.12 + (scale_rnd * 0.08); 
                                seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF; let angle = (float)(seed % 360) * 0.0174533; 
                                
                                let px = (float)x + ox; let py = (float)y + 1.0; let pz = (float)z + oz;
                                let sa = (float)sin(angle) * width; let ca = (float)cos(angle) * width;
                                
                                push_deco_v(&vd, px - ca, py, pz - sa, 0.0, 1.0, base_r, base_g, (char)0);
                                push_deco_v(&vd, px + ca, py, pz + sa, 1.0, 1.0, base_r, base_g, (char)0);
                                push_deco_v(&vd, px + ca, py + height, pz + sa, 1.0, 0.0, light_r, light_g, (char)100);
                                push_deco_v(&vd, px - ca, py, pz - sa, 0.0, 1.0, base_r, base_g, (char)0);
                                push_deco_v(&vd, px + ca, py + height, pz + sa, 1.0, 0.0, light_r, light_g, (char)100);
                                push_deco_v(&vd, px - ca, py + height, pz - sa, 0.0, 0.0, light_r, light_g, (char)100);
                            }
                        }
                    }
                }
            }
        }
    }
    
    let mesh: rl::Mesh;
    memset(&mesh, 0, sizeof(rl::Mesh));
    mesh.triangleCount = vd.idx / 3; mesh.vertexCount = vd.idx;
    mesh.vertices = vd.vertices; mesh.normals = vd.normals;
    mesh.texcoords = vd.texcoords; mesh.colors = (void*)vd.colors;
    
    rl::SetTraceLogLevel(rl::LOG_WARNING);
    rl::UploadMesh(&mesh, false);
    
    c.grass_deco_mesh = mesh; c.grass_deco_model = rl::LoadModelFromMesh(mesh); c.grass_deco_built = 1;
    c.grass_deco_model.materials[0].shader = get_shader_grass();
    c.grass_deco_model.materials[0].maps[rl::MATERIAL_MAP_DIFFUSE].texture = get_tex_grass();
}