//> Game UI, HUD & Settings Menu
import "raylib.h" as rl;
import "rlgl.h";
import "player.zc";
import "chunk_core.zc";
import "persistence.zc";

fn draw_hud(p: Player*, selected_block: int, version: char*) {
    raw { rlDisableDepthTest(); }
    let screen_w = rl::GetScreenWidth(); let screen_h = rl::GetScreenHeight();
    let cx = screen_w / 2; let cy = screen_h / 2;
    
    // Crosshair
    rl::DrawRectangle(cx - 6, cy - 2, 12, 4, rl::BLACK);
    rl::DrawRectangle(cx - 2, cy - 6, 4, 12, rl::BLACK);
    rl::DrawRectangle(cx - 5, cy - 1, 10, 2, rl::WHITE);
    rl::DrawRectangle(cx - 1, cy - 5, 2, 10, rl::WHITE);

    rl::DrawText("Zen Craft", 10, 10, 40, rl::WHITE);
    
    // Stats Bars
    let bar_w = 200; let bar_h = 20; let bar_x = 20;
    let bar_y_health = screen_h - 50; let bar_y_mana = screen_h - 25;
    
    rl::DrawRectangle(bar_x, bar_y_health, bar_w, bar_h, rl::GRAY);
    rl::DrawRectangle(bar_x, bar_y_health, (int)((float)bar_w * (p.health / 100.0)), bar_h, rl::RED);
    rl::DrawRectangleLines(bar_x, bar_y_health, bar_w, bar_h, rl::BLACK);
    rl::DrawText(rl::TextFormat("%.0f", p.health), bar_x + 5, bar_y_health + 2, 20, rl::WHITE);

    rl::DrawRectangle(bar_x, bar_y_mana, bar_w, bar_h, rl::GRAY);
    rl::DrawRectangle(bar_x, bar_y_mana, (int)((float)bar_w * (p.mana / 100.0)), bar_h, rl::BLUE);
    rl::DrawRectangleLines(bar_x, bar_y_mana, bar_w, bar_h, rl::BLACK);
    rl::DrawText(rl::TextFormat("%.0f", p.mana), bar_x + 5, bar_y_mana + 2, 20, rl::WHITE);

    let v_width = rl::MeasureText(version, 20);
    rl::DrawText(version, screen_w - v_width - 10, 10, 20, rl::WHITE);

    rl::DrawText("Select: 1-8", 10, 60, 20, rl::WHITE);
    rl::DrawText(rl::TextFormat("Block: %d", selected_block), 10, 90, 20, rl::WHITE);
}

fn draw_debug_info(p: Player*, chunks: Chunk*, dt: float, day_time: float, draw_distance: int, worker_count: int, wolf_count: int) {
    let loaded_chunks = 0;
    for i in 0..MAX_CHUNKS { if chunks[i].x != -9999 { loaded_chunks++; } }
    
    let dy = 120;
    rl::DrawFPS(10, dy); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Chunks: %d / %d", loaded_chunks, MAX_CHUNKS), 10, dy, 20, rl::LIME); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Workers: %d", worker_count), 10, dy, 20, rl::LIME); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Wolves: %d", wolf_count), 10, dy, 20, rl::Color{ r: 255, g: 80, b: 80, a: 255 }); dy = dy + 25;
    rl::DrawText(rl::TextFormat("XYZ: %.2f, %.2f, %.2f", p.x, p.y, p.z), 10, dy, 20, rl::LIME); dy = dy + 25;
    
    let frame_time_ms = dt * 1000.0;
    
    let pending_load = get_pending_load_count();
    let pending_mesh = get_pending_mesh_count();
    
    rl::DrawText(rl::TextFormat("Frame: %.2f ms", frame_time_ms), 10, dy, 20, rl::YELLOW); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Load/Gen Q: %d", pending_load), 10, dy, 20, rl::YELLOW); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Mesh Q: %d", pending_mesh), 10, dy, 20, rl::YELLOW); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Draw Dist: %d", draw_distance), 10, dy, 20, rl::YELLOW); dy = dy + 30;
    
    let hour_float = (day_time * 24.0) + 6.0;
    if hour_float >= 24.0 { hour_float = hour_float - 24.0; }
    let hour = (int)hour_float;
    let minute = (int)((hour_float - (float)hour) * 60.0);
    
    if hour == 0 { rl::DrawText(rl::TextFormat("Time: 12:%02d AM", minute), 10, dy, 20, rl::WHITE); } 
    else if hour < 12 { rl::DrawText(rl::TextFormat("Time: %d:%02d AM", hour, minute), 10, dy, 20, rl::WHITE); } 
    else if hour == 12 { rl::DrawText(rl::TextFormat("Time: 12:%02d PM", minute), 10, dy, 20, rl::WHITE); } 
    else { rl::DrawText(rl::TextFormat("Time: %d:%02d PM", hour - 12, minute), 10, dy, 20, rl::WHITE); }
    dy = dy + 30;
    
    let prof = get_profiling_stats();
    rl::DrawText("Profiling (Last Op):", 10, dy, 20, rl::ORANGE); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Mesh Gen: %.2f ms", prof.mesh_ms), 20, dy, 20, rl::ORANGE); dy = dy + 25;
    rl::DrawText(rl::TextFormat("World Gen: %.2f ms", prof.gen_ms), 20, dy, 20, rl::ORANGE); dy = dy + 25;
    rl::DrawText(rl::TextFormat("Light Prop: %.2f ms", prof.prop_ms), 20, dy, 20, rl::ORANGE);
}

fn draw_settings_menu(draw_distance: int*, grass_dist: float*) {
    let screen_w = rl::GetScreenWidth(); let screen_h = rl::GetScreenHeight();
    let mx = rl::GetMouseX(); let my = rl::GetMouseY();
    let clicked = rl::IsMouseButtonPressed(rl::MOUSE_BUTTON_LEFT);
    let click_held = rl::IsMouseButtonDown(rl::MOUSE_BUTTON_LEFT);
    
    // Centered, larger main panel
    let menu_w = 400; let menu_h = 240;
    let menu_x = screen_w/2 - menu_w/2; let menu_y = screen_h/2 - menu_h/2;
    
    // Background with soft gradient (simulated via semi-transparent rectangles)
    rl::DrawRectangle(menu_x, menu_y, menu_w, menu_h, rl::Color{r: 30, g: 30, b: 35, a: 230});
    rl::DrawRectangleLines(menu_x, menu_y, menu_w, menu_h, rl::Color{r: 100, g: 100, b: 110, a: 255});
    rl::DrawRectangleLines(menu_x - 1, menu_y - 1, menu_w + 2, menu_h + 2, rl::BLACK); // Shadow border
    
    // Header
    rl::DrawRectangle(menu_x, menu_y, menu_w, 40, rl::Color{r: 45, g: 45, b: 55, a: 255});
    rl::DrawText("GAME SETTINGS", menu_x + menu_w/2 - rl::MeasureText("GAME SETTINGS", 20)/2, menu_y + 10, 20, rl::RAYWHITE);
    rl::DrawLine(menu_x, menu_y + 40, menu_x + menu_w, menu_y + 40, rl::Color{r: 100, g: 100, b: 110, a: 255});
    
    // --- Grass Deco Toggle ---
    rl::DrawText("Grass Decorations", menu_x + 30, menu_y + 80, 20, rl::LIGHTGRAY);
    let is_on = *grass_dist > 0.1;
    
    let btn_grass_rect = rl::Rectangle{x: (float)(menu_x + 280), y: (float)(menu_y + 75), width: 80.0, height: 30.0};
    let btn_grass_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_grass_rect);
    
    let g_col = rl::RED; let g_text = "OFF";
    if is_on { g_col = rl::LIME; g_text = "ON"; }
    
    // Button background & hover effect
    if btn_grass_hover { rl::DrawRectangleRec(btn_grass_rect, rl::ColorTint(g_col, rl::WHITE)); }
    else { rl::DrawRectangleRec(btn_grass_rect, g_col); }
    
    rl::DrawRectangleLinesEx(btn_grass_rect, 2.0, rl::BLACK);
    rl::DrawText(g_text, (int)btn_grass_rect.x + 40 - rl::MeasureText(g_text, 18)/2, (int)btn_grass_rect.y + 6, 18, rl::BLACK);
    
    if clicked == 1 && btn_grass_hover {
        if is_on { *grass_dist = 0.0; } else { *grass_dist = 64.0; } // Safe grass distance
    }
    
    // --- Render Distance ---
    rl::DrawText("Render Distance", menu_x + 30, menu_y + 130, 20, rl::LIGHTGRAY);
    rl::DrawText(rl::TextFormat("%d Chunks", *draw_distance), menu_x + 30, menu_y + 155, 15, rl::GRAY);
    
    let btn_minus_rect = rl::Rectangle{x: (float)(menu_x + 240), y: (float)(menu_y + 125), width: 40.0, height: 40.0};
    let btn_plus_rect = rl::Rectangle{x: (float)(menu_x + 320), y: (float)(menu_y + 125), width: 40.0, height: 40.0};
    
    let minus_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_minus_rect);
    let plus_hover = rl::CheckCollisionPointRec(rl::Vector2{x: (float)mx, y: (float)my}, btn_plus_rect);
    
    // Minus Button
    if minus_hover { rl::DrawRectangleRec(btn_minus_rect, rl::LIGHTGRAY); } else { rl::DrawRectangleRec(btn_minus_rect, rl::GRAY); }
    rl::DrawRectangleLinesEx(btn_minus_rect, 2.0, rl::BLACK);
    rl::DrawText("-", (int)btn_minus_rect.x + 20 - rl::MeasureText("-", 20)/2, (int)btn_minus_rect.y + 10, 20, rl::BLACK);
    
    // Plus Button
    if plus_hover { rl::DrawRectangleRec(btn_plus_rect, rl::LIGHTGRAY); } else { rl::DrawRectangleRec(btn_plus_rect, rl::GRAY); }
    rl::DrawRectangleLinesEx(btn_plus_rect, 2.0, rl::BLACK);
    rl::DrawText("+", (int)btn_plus_rect.x + 20 - rl::MeasureText("+", 20)/2, (int)btn_plus_rect.y + 10, 20, rl::BLACK);
    
    // Current Value display
    rl::DrawText(rl::TextFormat("%d", *draw_distance), (int)btn_minus_rect.x + 55, (int)btn_minus_rect.y + 10, 20, rl::WHITE);
    
    if clicked == 1 {
        if minus_hover && *draw_distance > 2 { *draw_distance = *draw_distance - 1; }
        // Clamp to 10 to prevent exceeding 1024 MAX_CHUNKS (10 radius = 21x21 = 441 chunks)
        // With unload_dist = 12 -> 25x25 = 625 slots needed. Very safe.
        if plus_hover && *draw_distance < 10 { *draw_distance = *draw_distance + 1; }
    }
    
    // --- Footer ---
    rl::DrawLine(menu_x, menu_y + menu_h - 40, menu_x + menu_w, menu_y + menu_h - 40, rl::Color{r: 100, g: 100, b: 110, a: 255});
    rl::DrawText("Press F1 to Resume", menu_x + menu_w/2 - rl::MeasureText("Press F1 to Resume", 15)/2, menu_y + menu_h - 25, 15, rl::GRAY);
}